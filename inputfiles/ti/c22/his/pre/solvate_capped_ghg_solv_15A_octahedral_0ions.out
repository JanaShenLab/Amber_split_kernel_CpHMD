 CHARMM>    ! Previous script only joined WZ1/WZ2 and left WZ3 behind.
 CHARMM>    ! This joins every generated WZ layer through Znum.
 CHARMM>     
  
 CHARMM>    set J4 2
 Parameter: J4 <- "2"
  
 CHARMM>    label JOINWZ
  
 CHARMM>    if @J4 .le. @Znum then
