source leaprc.protein.ff14SB
loadoff /home/wayyne/cphmd/amber24/ff14/parmfiles/phmd.lib
loadamberparams /home/wayyne/cphmd/amber24/ff14/parmfiles/frcmod.phmd_barrier
loadamberparams /home/wayyne/cphmd/amber24/ff14/parmfiles/ff14sb_pme_dayhoff_dev.parm

coreseq = { LYS VAL PHE GLY ARG CYX GL2 LEU ALA ALA ALA MET LYS ARG HIP GLY LEU AS2 ASN TYR ARG GLY TYR SER LEU GLY ASN TRP VAL CYX ALA ALA LYS PHE GL2 SER ASN PHE ASN THR GLN ALA THR ASN ARG ASN THR AS2 GLY SER THR AS2 TYR GLY ILE LEU GLN ILE ASN SER ARG TRP TRP CYX ASN AS2 GLY ARG THR PRO GLY SER ARG ASN LEU CYX ASN ILE PRO CYX SER ALA LEU LEU SER SER AS2 ILE THR ALA SER VAL ASN CYX ALA LYS LYS ILE VAL SER AS2 GLY ASN GLY MET ASN ALA TRP VAL ALA TRP ARG ASN ARG CYX LYS GLY THR AS2 VAL GLN ALA TRP ILE ARG GLY CYX ARG LEU }
core = loadPdbUsingSeq /state/partition1/home/wayyne/cphmd/amber24/ff14/ti/harris_2022/prot/hewl/pre/2lzt_a_amber_clean.pdb coreseq

bond core.6.SG core.127.SG
bond core.30.SG core.115.SG
bond core.64.SG core.80.SG
bond core.76.SG core.94.SG

ncap = sequence { ACE }
ccap = sequence { NHE }
system = combine { ncap core ccap }
bond system.1.C system.2.N
bond system.130.C system.131.N

check system
charge system

saveamberparm system /state/partition1/home/wayyne/cphmd/amber24/ff14/ti/harris_2022/prot/hewl/pre/capped_2lzt_a.parm7 /tmp/gen_pdb_amber.prgcBj/capped_2lzt_a_premin.rst7
savepdb system /tmp/gen_pdb_amber.prgcBj/capped_2lzt_a_premin.pdb

quit
