+__global__ void
+kPMEPHMDReduceThetaFromAccumulators_kernel(const PMEAccumulator* __restrict__ dph,
+                                           const PMEAccumulator* __restrict__ dphPlus,
+                                           PMEFloat* __restrict__ theta,
+                                           const int2* __restrict__ presbounds,
+                                           const int* __restrict__ psp_grp,
+                                           const unsigned int* __restrict__ pImageAtomLookup,
+                                           unsigned int thetaCount,
+                                           int useNeighborList)
+{
+  for (unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+       pos < thetaCount;
+       pos += blockDim.x * gridDim.x) {
+
+    const int restype = psp_grp[pos];
+    const bool usePlus = !(restype == 0 || restype == 1 || restype == 3);
+
+    const int respos = usePlus ? static_cast<int>(pos) - 1
+                               : static_cast<int>(pos);
+
+    if (respos < 0) {
+      theta[pos] = static_cast<PMEFloat>(0.0);
+      continue;
+    }
+
+    const int lowerbound = presbounds[respos].x - 1;
+    const int upperbound = presbounds[respos].y - 1;
+
+    double sum = 0.0;
+
+    for (int atmX = lowerbound; atmX <= upperbound; atmX++) {
+      const unsigned int accIndex = useNeighborList ?
+                              pImageAtomLookup[atmX] :
+                              static_cast<unsigned int>(atmX);
+
+      if (usePlus) {
+        sum += static_cast<double>(dphPlus[accIndex]) *
+               static_cast<double>(ONEOVERFORCESCALE);
+      }
+      else {
+        sum += static_cast<double>(dph[accIndex]) *
+               static_cast<double>(ONEOVERFORCESCALE);
+      }
+    }
+
+    theta[pos] = static_cast<PMEFloat>(sum);
+  }
+}
