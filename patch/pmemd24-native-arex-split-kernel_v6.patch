+__global__ void
+kUpdateForcesLangevin_PHMDNL_kernel(PMEDouble dtx, int rpos)
+{
+  const unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+
+  if (pos >= static_cast<unsigned int>(cSim.ntitr)) {
+    return;
+  }
+
+  int restype = cSim.psp_grp[pos];
+// __global__ void
+// kUpdateForcesLangevin_PHMDNL_kernel(PMEDouble dtx, int rpos)
+// {
+//   unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+//
+//   int restype = cSim.psp_grp[pos];
+  int lowerbound, upperbound;
+
+  if (restype == 0 || restype == 1 || restype == 3) {
+    lowerbound = cSim.presbounds[pos].x - 1;
+    upperbound = cSim.presbounds[pos].y - 1;
+  }
+  else {
+    lowerbound = cSim.presbounds[pos - 1].x - 1;
+    upperbound = cSim.presbounds[pos - 1].y - 1;
+  }
+
+  // Preserve the old sequence:
+  //   kUpdateForces_PHMDNL_kernel accumulates into cSim.pdph_theta[pos]
+  //   kLangevinUpdatePHMD_kernel then reads cSim.pdph_theta[pos] as PMEFloat
+  PMEDouble dph_theta_accum = cSim.pdph_theta[pos];
+
+  for (int atmX = lowerbound; atmX <= upperbound; atmX++) {
+    int patmX = cSim.pImageAtomLookup[atmX];
+    if (restype == 0 || restype == 1 || restype == 3) {
+      dph_theta_accum +=
+        (PMEDouble)cSim.pdph_accumulator[patmX] * (PMEDouble)ONEOVERFORCESCALE;
+    }
+    else {
+      dph_theta_accum +=
+        (PMEDouble)cSim.pdph_plus_accumulator[patmX] * (PMEDouble)ONEOVERFORCESCALE;
+    }
+  }
+
+  PMEFloat kbt = KB_VAL * cSim.temp_phmd;
+  PMEFloat gam = 0.0488882 * cSim.phbeta * dtx;
+  PMEFloat mass = cSim.qmass_phmd;
+  PMEFloat rfd = sqrt(2.0 * mass * gam * kbt) / dtx;
+
+  PMEFloat dph_theta = (PMEFloat)dph_theta_accum;
+
+  cSim.pdudls[pos] = dph_theta;
+
+  if (!cSim.use_forces) {
+    dph_theta = 0;
+  }
+
+  dph_theta *= sin(2.0 * cSim.pph_theta[pos]);
+
+  if (pos < cSim.ntitr) {
+    dph_theta += rfd * cSim.pRandomPHMD[rpos * cSim.phmd_padded_ntitr + pos];
+  }
+
+  PMEFloat dph_theta_old = dph_theta;
+
+  cSim.pvph_theta[pos] =
+    cSim.pvphold[pos] -
+    0.5 * dtx * dph_theta / mass -
+    0.5 * dtx * cSim.pdphold[pos] / mass;
+
+  PMEFloat pvph_theta = (1.0 - gam) * cSim.pvph_theta[pos];
+
+  cSim.pph_theta[pos] +=
+    pvph_theta * dtx -
+    dph_theta * dtx * dtx / (2.0 * mass);
+
+  cSim.pdphold[pos] = dph_theta_old;
+  cSim.pvphold[pos] = pvph_theta;
+  cSim.pdph_theta[pos] = dph_theta;
+  cSim.pvph_theta[pos] = pvph_theta;
+}
