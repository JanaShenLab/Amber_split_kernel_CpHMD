+  use netcdf
+  use AmberNetcdf_mod, only : NC_create, NC_defineRemdIndices, checkNCerror, &
+                              NC_openWrite, NC_setupRestart, NC_setupBox
+  use arex_io_mod, only : arex_io_get_active_restart_initialized, &
+                          arex_io_set_active_restart_initialized
+  use file_io_dat_mod, only : mdout
+  use pmemd_lib_mod,   only : mexit
+  implicit none
+
+  character(len=*), intent(in) :: filename
+  character(len=*), intent(in) :: title
+  character, intent(in)        :: owrite
+  integer, intent(in)          :: natom, ntb, imin
+#ifdef MPI
+  integer, intent(in)               :: remd_method, remd_dimension
+  integer, intent(in), dimension(:) :: remd_types
+#endif
+  integer, intent(out)         :: ncid
+
+  integer :: frcVID
+  integer :: ncatom_restart
+  integer :: ncerr
+  integer :: io_ierr
+  logical :: restart_initialized
+  logical :: has1DRemdValues
+  character(len=80)  :: restart_title_read
+  character(len=256) :: io_message
+  double precision :: restart_time_read
+
+  has1DRemdValues = .false.
+#ifdef MPI
+  has1DRemdValues = (remd_method.gt.0)
+#endif
+
+  call arex_io_get_active_restart_initialized(restart_initialized, io_ierr, io_message)
+  if (io_ierr /= 0) then
+    write(mdout,'(a)') trim(io_message)
+    call mexit(mdout,1)
+  end if
+
+  if (.not. restart_initialized) then
+    ! Fresh AREX slot output.  Use NC_create with the caller's owrite flag so
+    ! stale files are protected unless the user requested overwrite with -O.
+    if (NC_create(filename, owrite, .true., natom, .true., &
+                  (imin.eq.0), (ntb.gt.0), has1DRemdValues, .true., .false., &
+                  title, ncid, timeVID, coordVID, velocityVID, frcVID, &
+                  cellLengthVID, cellAngleVID, remd_values_var_id)) call mexit(mdout,1)
+#ifdef MPI
+    ! Preserve the existing NetCDF REMD metadata definition behavior.  AREX does
+    ! not use REMD scheduling, but this keeps the create path structurally
+    ! identical to the normal restart setup.
+    if (NC_defineRemdIndices(ncid, remd_dimension, remd_indices_var_id,&
+                               repidx_var_id, crdidx_var_id,&
+                               remd_types, .true., (remd_method .ne. 0),&
+                               (remd_method .eq. -1),&
+                               remd_groupsVID=remd_groups_var_id,&
+                               remd_valuesVID=remd_values_var_id,&
+                               remd_typesVID=remd_types_var_id ))&
+      call mexit(mdout,1)
+#endif
+
+  else
+    ! Existing AREX slot output.  Reopen the slot file and rebuild the NetCDF
+    ! variable IDs needed by the write path below.
+    if (NC_openWrite(filename, ncid)) then
+      write(mdout,'(a)') 'arex_setup_nc_restart(): Could not open slot restart'
+      call mexit(mdout,1)
+    end if
+
+    restart_title_read = ''
+    restart_time_read = 0.0d0
+    ncatom_restart = 0
+
+    timeVID = -1
+    coordVID = -1
+    velocityVID = -1
+    cellLengthVID = -1
+    cellAngleVID = -1
+    remd_values_var_id = -1
+
+    if (NC_setupRestart(ncid, restart_title_read, ncatom_restart, coordVID, &
+                        velocityVID, remd_values_var_id, restart_time_read)) &
+      call mexit(mdout,1)
+
+    if (ncatom_restart .ne. natom) then
+      write(mdout,'(a,i0,a,i0)') &
+        'arex_setup_nc_restart(): NATOM mismatch reopening slot restart; file has ', &
+        ncatom_restart, ', expected ', natom
+      call mexit(mdout,1)
+    end if
+
+    if (imin .eq. 0 .and. velocityVID .eq. -1) then
+      write(mdout,'(a)') &
+        'arex_setup_nc_restart(): existing AREX slot restart has no velocities'
+      call mexit(mdout,1)
+    end if
+
+    ! NC_setupRestart reads the time value but does not return the time variable
+    ! ID.  The write path needs the ID to update the restart time.
+    ncerr = nf90_inq_varid(ncid, 'time', timeVID)
+    if (ncerr /= nf90_noerr) then
+      call checkNCerror(ncerr, 'locate restart time')
+      call mexit(mdout,1)
+    end if
+
+    ! NC_setupRestart does not return box variable IDs.  Rebuild them only when
+    ! this run will write periodic box information.
+    if (ntb > 0) then
+      call NC_setupBox(ncid, cellLengthVID, cellAngleVID)
+      if (cellLengthVID .eq. -1 .or. cellAngleVID .eq. -1) then
+        write(mdout,'(a)') &
+          'arex_setup_nc_restart(): existing AREX slot restart has no box variables'
+        call mexit(mdout,1)
+      end if
+    end if
+  end if
+
+  call arex_io_set_active_restart_initialized(.true., io_ierr, io_message)
+  if (io_ierr /= 0) then
+    write(mdout,'(a)') trim(io_message)
+    call mexit(mdout,1)
+  end if
+
+end subroutine arex_setup_nc_restart
+
