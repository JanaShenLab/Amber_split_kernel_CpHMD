+#include "copyright.i"
+
+!*******************************************************************************
+!
+! Module: arex_io_mod
+!
+! Description:
+!   AREX-specific output/context manager.
+!
+!   This module owns per-slot output contexts for slot-owned PHREX production
+!   output and AREX-aware output rebinding. It is intentionally separate from
+!   bintraj/runfiles/phmd so those modules can stay mostly generic.
+!
+!   Responsibilities:
+!     * capture base output filenames from file_io_dat_mod
+!     * derive per-slot filenames
+!     * bind the active slot context into file_io_dat_mod globals
+!     * retain per-slot PHMD restart/open state
+!     * retain per-slot binary trajectory state for bintraj handoff
+!
+!   This module does not itself perform I/O. Existing open/write/close code
+!   continues to live in master_setup.F90, runmd.F90, pmemd.F90, bintraj.F90,
+!   and phmd.F90.
+!
+!*******************************************************************************
+
+module arex_io_mod
+
+  use file_io_dat_mod, only : max_fn_len, &
+                              mdcrd_name, mdvel_name, mdfrc_name, restrt_name, &
+                              phmdout_name, phmdrestrt_out_name
+  use mdin_ctrl_dat_mod, only : arex_ladder, arex_ladder_unset, t, dt
+
+  implicit none
+
+  private
+
+  integer, parameter, public :: AREX_IO_OK          = 0
+  integer, parameter, public :: AREX_IO_ERR_INVALID = 1
+  integer, parameter, public :: AREX_IO_ERR_ALLOC   = 2
+
+  type, public :: arex_io_bintraj_state_t
+    logical :: valid = .false.
+
+    integer :: mdcrd_ncid          = -1
+    integer :: coord_var_id        = -1
+    integer :: cell_length_var_id  = -1
+    integer :: cell_angle_var_id   = -1
+    integer :: mdcrd_time_var_id   = -1
+    integer :: mdcrd_veloc_var_id  = -1
+    integer :: mdcrd_frc_var_id    = -1
+    integer :: mdcrd_frame         = 1
+    ! Logical MD time accumulated by this slot-owned coordinate trajectory.
+    ! AREX slot output must be keyed to slot time, not worker wall time.
+    integer :: mdcrd_logical_steps = 0
+    ! Cumulative step at which this output PART began. Used only for file
+    ! frame indices; logical steps and MD time never reset on continuation.
+    integer :: part_start_step     = 0
+    double precision :: mdcrd_time_origin_ps  = 0.0d0
+    double precision :: mdcrd_logical_time_ps = 0.0d0
+
+    integer :: remd_indices_var_id = -1
+    integer :: remd_values_var_id  = -1
+    integer :: remd_types_var_id   = -1
+    integer :: repidx_var_id       = -1
+    integer :: crdidx_var_id       = -1
+    integer :: frame_dim_id        = -1
+
+    integer :: mdvel_ncid          = -1
+    integer :: mdvel_time_var_id   = -1
+    integer :: mdvel_veloc_var_id  = -1
+    integer :: mdvel_frame         = 1
+
+    integer :: mdfrc_ncid          = -1
+    integer :: mdfrc_time_var_id   = -1
+    integer :: mdfrc_frc_var_id    = -1
+    integer :: mdfrc_frame         = 1
+
+    integer :: atom_wrt_cnt        = 0
+  end type arex_io_bintraj_state_t
+
+  type :: arex_io_slot_ctx_t
+    logical :: names_ready                = .false.
+    logical :: restart_initialized        = .false.
+    logical :: phmd_output_initialized    = .false.
+    logical :: phmd_first_restart         = .true.
+    logical :: binary_files_initialized   = .false.
+    integer :: slot_id                    = 0
+
+    character(len=max_fn_len) :: mdcrd_name       = ''
+    character(len=max_fn_len) :: mdvel_name       = ''
+    character(len=max_fn_len) :: mdfrc_name       = ''
+    character(len=max_fn_len) :: restrt_name      = ''
+    character(len=max_fn_len) :: phmdout_name     = ''
+    character(len=max_fn_len) :: phmdrestrt_out_name = ''
+
+    type(arex_io_bintraj_state_t) :: bintraj
+  end type arex_io_slot_ctx_t
+
+  logical, save :: arex_io_initialized   = .false.
+  logical, save :: arex_io_enabled_flag  = .false.
+  logical, save :: base_names_captured   = .false.
+
+  integer, save :: arex_io_nslots        = 0
+  integer, save :: arex_io_active_slot   = 0
+
+  character(len=max_fn_len), save :: base_mdcrd_name      = ''
+  character(len=max_fn_len), save :: base_mdvel_name      = ''
+  character(len=max_fn_len), save :: base_mdfrc_name      = ''
+  character(len=max_fn_len), save :: base_restrt_name     = ''
+  character(len=max_fn_len), save :: base_phmdout_name    = ''
+  character(len=max_fn_len), save :: base_phmdrestrt_out_name = ''
+
+  type(arex_io_slot_ctx_t), allocatable, save :: slot_ctx(:)
+
+  public :: arex_io_init
+  public :: arex_io_finalize
+  public :: arex_io_is_enabled
+  public :: arex_io_get_active_slot
+  public :: arex_io_bind_slot
+  public :: arex_io_restore_base_names
+  public :: arex_io_get_slot_names
+  public :: arex_io_get_names_for_ladder_value
+
+  public :: arex_io_get_active_restart_initialized
+  public :: arex_io_set_active_restart_initialized
+  public :: arex_io_get_slot_restart_initialized
+  public :: arex_io_set_slot_restart_initialized
+
+  public :: arex_io_get_active_phmd_first_restart
+  public :: arex_io_set_active_phmd_first_restart
+
+  public :: arex_io_get_active_binary_initialized
+  public :: arex_io_set_active_binary_initialized
+
+  public :: arex_io_get_active_bintraj_state
+  public :: arex_io_set_active_bintraj_state
+  public :: arex_io_active_slot_hits_freq
+  public :: arex_io_active_slot_time
+  public :: arex_io_advance_active_mdcrd_logical_steps
+
+  public :: arex_io_get_slot_count
+  public :: arex_io_get_slot_bintraj_state
+  public :: arex_io_set_slot_bintraj_state
+
+  public :: arex_io_get_active_phmd_output_initialized
+  public :: arex_io_set_active_phmd_output_initialized
+  public :: arex_io_get_slot_phmd_output_initialized
+  public :: arex_io_set_slot_phmd_output_initialized
+  public :: arex_io_active_slot_logical_step
+contains
+
+!*******************************************************************************
+! Initialize AREX output contexts.
+!*******************************************************************************
+subroutine arex_io_init(nslots, enabled, ierr, message)
+  integer, intent(in) :: nslots
+  logical, intent(in) :: enabled
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: alloc_stat
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (arex_io_initialized) then
+    call arex_io_finalize(ierr, message)
+    if (ierr /= AREX_IO_OK) return
+  end if
+
+  call arex_io_capture_base_names()
+
+  arex_io_initialized  = .true.
+  arex_io_enabled_flag = enabled
+  arex_io_nslots       = 0
+  arex_io_active_slot  = 0
+
+  if (.not. enabled) return
+
+  if (nslots <= 0) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_init: nslots must be > 0 when AREX output is enabled'
+    return
+  end if
+
+  allocate(slot_ctx(nslots), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    ierr = AREX_IO_ERR_ALLOC
+    message = 'arex_io_init: failed to allocate slot output contexts'
+    arex_io_enabled_flag = .false.
+    return
+  end if
+
+  arex_io_nslots = nslots
+
+  do i = 1, nslots
+    slot_ctx(i)%slot_id = i
+
+    call arex_io_make_slot_name(base_mdcrd_name,      i, slot_ctx(i)%mdcrd_name)
+    call arex_io_make_slot_name(base_mdvel_name,      i, slot_ctx(i)%mdvel_name)
+    call arex_io_make_slot_name(base_mdfrc_name,      i, slot_ctx(i)%mdfrc_name)
+    call arex_io_make_slot_name(base_restrt_name,     i, slot_ctx(i)%restrt_name)
+    call arex_io_make_slot_name(base_phmdout_name,    i, slot_ctx(i)%phmdout_name)
+    call arex_io_make_slot_name(base_phmdrestrt_out_name, i, slot_ctx(i)%phmdrestrt_out_name)
+
+    slot_ctx(i)%names_ready              = .true.
+    slot_ctx(i)%restart_initialized      = .false.
+    slot_ctx(i)%phmd_first_restart       = .true.
+    slot_ctx(i)%binary_files_initialized = .false.
+    slot_ctx(i)%phmd_output_initialized  = .false.
+    slot_ctx(i)%bintraj%valid                 = .false.
+    slot_ctx(i)%bintraj%mdcrd_logical_steps   = 0
+    slot_ctx(i)%bintraj%mdcrd_time_origin_ps  = t
+    slot_ctx(i)%bintraj%mdcrd_logical_time_ps = t
+  end do
+
+end subroutine arex_io_init
+
+!*******************************************************************************
+! Finalize AREX output contexts and restore base filenames.
+!*******************************************************************************
+subroutine arex_io_finalize(ierr, message)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (allocated(slot_ctx)) deallocate(slot_ctx)
+
+  if (base_names_captured) then
+    call arex_io_restore_base_names(ierr, message)
+    if (ierr /= AREX_IO_OK) return
+  end if
+
+  arex_io_initialized  = .false.
+  arex_io_enabled_flag = .false.
+  arex_io_nslots       = 0
+  arex_io_active_slot  = 0
+
+end subroutine arex_io_finalize
+
+!*******************************************************************************
+! Return whether AREX output mode is active.
+!*******************************************************************************
+logical function arex_io_is_enabled()
+  arex_io_is_enabled = arex_io_initialized .and. arex_io_enabled_flag
+end function arex_io_is_enabled
+
+!*******************************************************************************
+! Return currently bound slot id. 0 means base/global names are active.
+!*******************************************************************************
+subroutine arex_io_get_active_slot(slot_id)
+  integer, intent(out) :: slot_id
+  slot_id = arex_io_active_slot
+end subroutine arex_io_get_active_slot
+
+!*******************************************************************************
+! Bind active filename globals to a specific slot context.
+!*******************************************************************************
+subroutine arex_io_bind_slot(slot_id, ierr, message)
+  integer, intent(in) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (.not. arex_io_initialized) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_bind_slot: module not initialized'
+    return
+  end if
+
+  if (.not. arex_io_enabled_flag) then
+    arex_io_active_slot = 0
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > arex_io_nslots) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_bind_slot: invalid slot_id'
+    return
+  end if
+
+  if (.not. slot_ctx(slot_id)%names_ready) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_bind_slot: slot context names are not ready'
+    return
+  end if
+
+  mdcrd_name      = slot_ctx(slot_id)%mdcrd_name
+  mdvel_name      = slot_ctx(slot_id)%mdvel_name
+  mdfrc_name      = slot_ctx(slot_id)%mdfrc_name
+  restrt_name     = slot_ctx(slot_id)%restrt_name
+  phmdout_name    = slot_ctx(slot_id)%phmdout_name
+  phmdrestrt_out_name = slot_ctx(slot_id)%phmdrestrt_out_name
+
+  arex_io_active_slot = slot_id
+
+end subroutine arex_io_bind_slot
+
+!*******************************************************************************
+! Restore active filename globals to the base non-slot-specific names.
+!*******************************************************************************
+subroutine arex_io_restore_base_names(ierr, message)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (.not. base_names_captured) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_restore_base_names: base names were not captured'
+    return
+  end if
+
+  mdcrd_name      = base_mdcrd_name
+  mdvel_name      = base_mdvel_name
+  mdfrc_name      = base_mdfrc_name
+  restrt_name     = base_restrt_name
+  phmdout_name    = base_phmdout_name
+  phmdrestrt_out_name = base_phmdrestrt_out_name
+
+  arex_io_active_slot = 0
+
+end subroutine arex_io_restore_base_names
+
+!*******************************************************************************
+! Fetch slot-derived names for a specific slot without rebinding globals.
+!*******************************************************************************
+subroutine arex_io_get_slot_names(slot_id, mdcrd_name_out, mdvel_name_out, mdfrc_name_out, &
+                                  restrt_name_out, phmdout_name_out, phmdrestrt_out_name_out, &
+                                  ierr, message)
+  integer, intent(in) :: slot_id
+  character(len=*), intent(out) :: mdcrd_name_out
+  character(len=*), intent(out) :: mdvel_name_out
+  character(len=*), intent(out) :: mdfrc_name_out
+  character(len=*), intent(out) :: restrt_name_out
+  character(len=*), intent(out) :: phmdout_name_out
+  character(len=*), intent(out) :: phmdrestrt_out_name_out
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  mdcrd_name_out      = ''
+  mdvel_name_out      = ''
+  mdfrc_name_out      = ''
+  restrt_name_out     = ''
+  phmdout_name_out    = ''
+  phmdrestrt_out_name_out = ''
+
+  if (.not. arex_io_initialized) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_get_slot_names: module not initialized'
+    return
+  end if
+
+  if (.not. arex_io_enabled_flag) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_get_slot_names: AREX output mode is not enabled'
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > arex_io_nslots) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_get_slot_names: invalid slot_id'
+    return
+  end if
+
+  mdcrd_name_out      = slot_ctx(slot_id)%mdcrd_name
+  mdvel_name_out      = slot_ctx(slot_id)%mdvel_name
+  mdfrc_name_out      = slot_ctx(slot_id)%mdfrc_name
+  restrt_name_out     = slot_ctx(slot_id)%restrt_name
+  phmdout_name_out    = slot_ctx(slot_id)%phmdout_name
+  phmdrestrt_out_name_out = slot_ctx(slot_id)%phmdrestrt_out_name
+
+end subroutine arex_io_get_slot_names
+
+!*******************************************************************************
+! Derive slot-scoped names for an explicit ladder value. This is used by AREX
+! continuation when the checkpoint ladder differs from the current input.
+!*******************************************************************************
+subroutine arex_io_get_names_for_ladder_value(ladder_value, mdcrd_name_out, mdvel_name_out, &
+                                               mdfrc_name_out, restrt_name_out, phmdout_name_out, &
+                                               phmdrestrt_out_name_out, ierr, message)
+  double precision, intent(in) :: ladder_value
+  character(len=*), intent(out) :: mdcrd_name_out
+  character(len=*), intent(out) :: mdvel_name_out
+  character(len=*), intent(out) :: mdfrc_name_out
+  character(len=*), intent(out) :: restrt_name_out
+  character(len=*), intent(out) :: phmdout_name_out
+  character(len=*), intent(out) :: phmdrestrt_out_name_out
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (.not. arex_io_initialized .or. .not. base_names_captured) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_get_names_for_ladder_value: AREX I/O base names are not initialized'
+    return
+  end if
+
+  call arex_io_make_ladder_name(base_mdcrd_name, ladder_value, mdcrd_name_out)
+  call arex_io_make_ladder_name(base_mdvel_name, ladder_value, mdvel_name_out)
+  call arex_io_make_ladder_name(base_mdfrc_name, ladder_value, mdfrc_name_out)
+  call arex_io_make_ladder_name(base_restrt_name, ladder_value, restrt_name_out)
+  call arex_io_make_ladder_name(base_phmdout_name, ladder_value, phmdout_name_out)
+  call arex_io_make_ladder_name(base_phmdrestrt_out_name, ladder_value, phmdrestrt_out_name_out)
+end subroutine arex_io_get_names_for_ladder_value
+
+!*******************************************************************************
+! Common restart file lifecycle helpers.
+!
+! This state tracks whether the active AREX slot restart file has already been
+! created or restored for the current run.  It is intentionally separate from
+! file existence so that fresh AREX runs still honor normal -O / owrite behavior.
+!*******************************************************************************
+subroutine arex_io_get_active_restart_initialized(initialized, ierr, message)
+  logical, intent(out) :: initialized
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  initialized = .false.
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (.not. arex_io_initialized) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_get_active_restart_initialized: module not initialized'
+    return
+  end if
+
+  if (.not. arex_io_enabled_flag) then
+    initialized = .false.
+    return
+  end if
+
