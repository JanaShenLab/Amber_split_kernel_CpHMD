+__global__ void
+kChargeUpdatePHMDNLSumOneBlock_kernel(PMEDouble2* __restrict__ pResult)
+{
+  extern __shared__ PMEDouble2 sSum[];
+
+  const unsigned int tid = threadIdx.x;
+
+  double sumq = 0.0;
+  double sumq2 = 0.0;
+
+  unsigned int idx = tid;
+  if (idx < (unsigned int)cSim.nPHMDChargeAtoms) {
+    const int atom = cSim.pPHMDChargeAtoms[idx];
+    const PMEDouble2 q = kUpdateOnePHMDNLChargeAndGetSum(atom);
+    sumq += q.x;
+    sumq2 += q.y;
+  }
+
+  idx = tid + blockDim.x;
+  if (idx < (unsigned int)cSim.nPHMDChargeAtoms) {
+    const int atom = cSim.pPHMDChargeAtoms[idx];
+    const PMEDouble2 q = kUpdateOnePHMDNLChargeAndGetSum(atom);
+    sumq += q.x;
+    sumq2 += q.y;
+  }
+
+  sSum[tid].x = sumq;
+  sSum[tid].y = sumq2;
+
+  __syncthreads();
+
+  for (unsigned int offset = blockDim.x >> 1; offset > 0u; offset >>= 1) {
+    if (tid < offset) {
+      sSum[tid].x += sSum[tid + offset].x;
+      sSum[tid].y += sSum[tid + offset].y;
+    }
+    __syncthreads();
+  }
+
+  if (tid == 0u) {
+    pResult[0].x = sSum[0].x + cSim.phmdBaseSumQ;
+    pResult[0].y = sSum[0].y + cSim.phmdBaseSumQ2;
+  }
+}
+
+static void
+kPHMDSumChargesOnGPU(gpuContext gpu)
+{
+  if (gpu == nullptr) {
+    return;
+  }
+
+  if (gpu->pbPHMDSumChargeBuffer == nullptr ||
+      gpu->pbPHMDSumChargeResult == nullptr) {
+    fprintf(stderr,
+            "kPHMDSumChargesOnGPU: PHMD charge-sum buffers are null. "
+            "Did you allocate pbPHMDSumChargeBuffer and pbPHMDSumChargeResult?\n");
+    abort();
+  }
+
+  const unsigned int threads = PHMD_SUMQ_THREADS_PER_BLOCK;
+  const unsigned int blocks = gpu->phmdSumChargeBlocks;
+  const size_t sharedBytes = static_cast<size_t>(threads) * sizeof(PMEDouble2);
+
+  kPHMDSumChargePartial_kernel<<<blocks, threads, sharedBytes>>>(
+    gpu->pbPHMDSumChargeBuffer->_pDevData
+  );
+  LAUNCHERROR("kPHMDSumChargePartial_kernel");
+
+  kPHMDSumChargeFinal_kernel<<<1, threads, sharedBytes>>>(
+    gpu->pbPHMDSumChargeBuffer->_pDevData,
+    gpu->pbPHMDSumChargeResult->_pDevData,
+    blocks
+  );
+  LAUNCHERROR("kPHMDSumChargeFinal_kernel");
+
+  PMEDouble2 hResult;
+
+  cudaError_t status =
+    cudaMemcpy(&hResult,
+               gpu->pbPHMDSumChargeResult->_pDevData,
+               sizeof(PMEDouble2),
+               cudaMemcpyDeviceToHost);
+
+  RTERROR(status, "kPHMDSumChargesOnGPU cudaMemcpy failed");
+
+  gpu->sumq = static_cast<double>(hResult.x);
+  gpu->sumq2 = static_cast<double>(hResult.y);
+}
+
+static void
+kPHMDUpdateChargesAndSumSparseOnGPU(gpuContext gpu)
+{
+  if (gpu == nullptr) {
+    return;
+  }
+
+  if (gpu->pbPHMDSumChargeBuffer == nullptr ||
+      gpu->pbPHMDSumChargeResult == nullptr ||
+      gpu->phmdChargeAtoms == nullptr) {
+    fprintf(stderr,
+            "kPHMDUpdateChargesAndSumSparseOnGPU: required PHMD sparse charge buffers are null.\n");
+    abort();
+  }
+
+  const unsigned int threads = PHMD_SUMQ_THREADS_PER_BLOCK;
+  const unsigned int blocks = gpu->phmdSparseSumChargeBlocks;
+  const size_t sharedBytes = static_cast<size_t>(threads) * sizeof(PMEDouble2);
+
+  if (gpu->phmdChargeAtomCount <= 2u * threads) {
+    kChargeUpdatePHMDNLSumOneBlock_kernel<<<1, threads, sharedBytes>>>(
+      gpu->pbPHMDSumChargeResult->_pDevData
+    );
+    LAUNCHERROR("kChargeUpdatePHMDNLSumOneBlock_kernel");
+  }
+  else {
+    kChargeUpdatePHMDNLSumPartial_kernel<<<blocks, threads, sharedBytes>>>(
+      gpu->pbPHMDSumChargeBuffer->_pDevData
+    );
+    LAUNCHERROR("kChargeUpdatePHMDNLSumPartial_kernel");
+
+    kPHMDSumChargeFinalWithBase_kernel<<<1, threads, sharedBytes>>>(
+      gpu->pbPHMDSumChargeBuffer->_pDevData,
+      gpu->pbPHMDSumChargeResult->_pDevData,
+      blocks
+    );
+    LAUNCHERROR("kPHMDSumChargeFinalWithBase_kernel");
+  }
+
+  PMEDouble2 hResult;
+
+  cudaError_t status =
+    cudaMemcpy(&hResult,
+               gpu->pbPHMDSumChargeResult->_pDevData,
+               sizeof(PMEDouble2),
+               cudaMemcpyDeviceToHost);
+
+  RTERROR(status, "kPHMDUpdateChargesAndSumSparseOnGPU cudaMemcpy failed");
+
+  gpu->sumq = static_cast<double>(hResult.x);
+  gpu->sumq2 = static_cast<double>(hResult.y);
+}
