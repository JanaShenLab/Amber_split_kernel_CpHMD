+!*******************************************************************************
+! AREX binary trajectory context handoff.
+!
+! bintraj_mod owns the active NetCDF IDs, variable IDs, frame counters, and
+! atom count as private module state.  AREX therefore needs a small adapter
+! here to save/restore that private state for the currently bound AREX slot.
+! These helpers do not run for normal pmemd unless AREX I/O is enabled.
+!*******************************************************************************
+subroutine arex_bintraj_load_active_context(ierr, message)
+  type(arex_io_bintraj_state_t) :: state
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = 0
+  message = ''
+
+  call arex_io_get_active_bintraj_state(state, ierr, message)
+  if (ierr .ne. 0) return
+
+  ! If the slot was marked initialized but has no valid bintraj state,
+  ! continuing would reuse stale NetCDF handles from another slot.
+  if (.not. state%valid) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_bintraj_load_active_context: active slot has invalid binary trajectory state'
+    return
+  end if
+
+  mdcrd_ncid          = state%mdcrd_ncid
+  coord_var_id        = state%coord_var_id
+  cell_length_var_id  = state%cell_length_var_id
+  cell_angle_var_id   = state%cell_angle_var_id
+  mdcrd_time_var_id   = state%mdcrd_time_var_id
+  mdcrd_veloc_var_id  = state%mdcrd_veloc_var_id
+  mdcrd_frc_var_id    = state%mdcrd_frc_var_id
+  mdcrd_frame         = state%mdcrd_frame
+
+  remd_indices_var_id = state%remd_indices_var_id
+  remd_values_var_id  = state%remd_values_var_id
+  remd_types_var_id   = state%remd_types_var_id
+  repidx_var_id       = state%repidx_var_id
+  crdidx_var_id       = state%crdidx_var_id
+  frame_dim_id        = state%frame_dim_id
+
+  mdvel_ncid          = state%mdvel_ncid
+  mdvel_time_var_id   = state%mdvel_time_var_id
+  mdvel_veloc_var_id  = state%mdvel_veloc_var_id
+  mdvel_frame         = state%mdvel_frame
+
+  mdfrc_ncid          = state%mdfrc_ncid
+  mdfrc_time_var_id   = state%mdfrc_time_var_id
+  mdfrc_frc_var_id    = state%mdfrc_frc_var_id
+  mdfrc_frame         = state%mdfrc_frame
+
+  atom_wrt_cnt        = state%atom_wrt_cnt
+end subroutine arex_bintraj_load_active_context
+
+subroutine arex_bintraj_save_active_context(ierr, message)
+  type(arex_io_bintraj_state_t) :: state
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = 0
+  message = ''
+
+  call arex_io_get_active_bintraj_state(state, ierr, message)
+  if (ierr .ne. 0) return
+
+  ! Preserve AREX-owned logical time fields already stored in state.
+  ! bintraj_mod only owns NetCDF handles, variable IDs, frame counters,
+  ! and atom_wrt_cnt.
+  state%valid              = .true.
+  state%mdcrd_ncid         = mdcrd_ncid
+  state%coord_var_id       = coord_var_id
+  state%cell_length_var_id = cell_length_var_id
+  state%cell_angle_var_id  = cell_angle_var_id
+  state%mdcrd_time_var_id  = mdcrd_time_var_id
+  state%mdcrd_veloc_var_id = mdcrd_veloc_var_id
+  state%mdcrd_frc_var_id   = mdcrd_frc_var_id
+  state%mdcrd_frame        = mdcrd_frame
+
+  state%remd_indices_var_id = remd_indices_var_id
+  state%remd_values_var_id  = remd_values_var_id
+  state%remd_types_var_id   = remd_types_var_id
+  state%repidx_var_id       = repidx_var_id
+  state%crdidx_var_id       = crdidx_var_id
+  state%frame_dim_id        = frame_dim_id
+
+  state%mdvel_ncid         = mdvel_ncid
+  state%mdvel_time_var_id  = mdvel_time_var_id
+  state%mdvel_veloc_var_id = mdvel_veloc_var_id
+  state%mdvel_frame        = mdvel_frame
+
+  state%mdfrc_ncid         = mdfrc_ncid
+  state%mdfrc_time_var_id  = mdfrc_time_var_id
+  state%mdfrc_frc_var_id   = mdfrc_frc_var_id
+  state%mdfrc_frame        = mdfrc_frame
+
+  state%atom_wrt_cnt       = atom_wrt_cnt
+
+  call arex_io_set_active_bintraj_state(state, ierr, message)
+end subroutine arex_bintraj_save_active_context
+
+subroutine arex_bintraj_ensure_active_context(ierr, message)
+  logical :: initialized
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = 0
+  message = ''
+
+  if (.not. arex_io_is_enabled()) return
+
+  call arex_io_get_active_binary_initialized(initialized, ierr, message)
+  if (ierr .ne. 0) return
+
+  if (.not. initialized) then
+    call open_binary_files
+    call arex_io_get_active_binary_initialized(initialized, ierr, message)
+    if (ierr .ne. 0) return
+
+    if (.not. initialized) then
+      ierr = AREX_IO_ERR_INVALID
+      message = 'arex_bintraj_ensure_active_context: active binary files were not initialized'
+    end if
+    return
+  end if
+
+  call arex_bintraj_load_active_context(ierr, message)
+end subroutine arex_bintraj_ensure_active_context
+
+subroutine arex_bintraj_require_active_context(caller)
+  use pmemd_lib_mod, only : mexit
+  character(len=*), intent(in) :: caller
+
+  integer :: ierr
+  character(len=256) :: message
+
+  if (.not. arex_io_is_enabled()) return
+
+  ierr = 0
+  message = ''
+  call arex_bintraj_ensure_active_context(ierr, message)
+
+  if (ierr .ne. 0) then
+    write(mdout, '(a,a,a)') trim(caller), ': ', trim(message)
+    call mexit(mdout, 1)
+  end if
+end subroutine arex_bintraj_require_active_context
+
+subroutine arex_bintraj_save_active_context_or_die(caller)
+  use pmemd_lib_mod, only : mexit
+  character(len=*), intent(in) :: caller
+
+  integer :: ierr
+  character(len=256) :: message
+
+  if (.not. arex_io_is_enabled()) return
+
+  ierr = 0
+  message = ''
+  call arex_bintraj_save_active_context(ierr, message)
+
+  if (ierr .ne. 0) then
+    write(mdout, '(a,a,a)') trim(caller), ': ', trim(message)
+    call mexit(mdout, 1)
+  end if
+end subroutine arex_bintraj_save_active_context_or_die
+
