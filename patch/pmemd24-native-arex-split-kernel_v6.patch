+  if (ios == 0) read(u,'(a)',iostat=ios) discarded  ! dimensions
+  if (ios == 0) read(u,'(a)',iostat=ios) discarded  ! warmup progress
+  if (ios == 0) read(u,'(a)',iostat=ios) discarded  ! next replica UID
+  if (ios == 0) read(u,'(a)',iostat=ios) discarded  ! history generation
+  prior_part = 0
