+  std::printf("  tolerance:             %llu fixed-point units\n", tolerance);
+  std::printf("  max abs difference:    %llu fixed-point units\n", hResult[0]);
+  std::printf("  count above tolerance: %llu\n", hResult[1]);
+  std::fflush(stdout);
+}
