+//---------------------------------------------------------------------------------------------
+// gpu_constraints_update_weights_: update only the stiffness component of already initialized
+//                                  positional restraints.
+//
+// This routine does not change restraint atom IDs, reference coordinates, buffer allocations,
+// device pointers, or simulation constants.
+//
+// ierr values:
+//   0: success
+//   1: invalid argument or restraint count
+//   2: restraint GPU buffer is not initialized
+//   3: simulation/buffer restraint-count mismatch
+//---------------------------------------------------------------------------------------------
+// GPU-only stiffness update, implemented in kForcesUpdate.cu.  The CUDA
+// barostat owns the current device reference coordinates: never overwrite them
+// with the potentially stale host shadow during an AREX stiffness update.
+extern "C" cudaError_t gpu_arex_set_constraint_stiffness_cuda(
+    int n, PMEDouble k, PMEDouble2* master,
+    const unsigned int* packed_index, PMEDouble2* packed);
+
+extern "C" void gpu_constraints_update_weights_(int* natc, double* atm_weight,
+                                                int* ierr)
+{
+  PRINTMETHOD("gpu_constraints_update_weights");
+
+  if (ierr == NULL) {
+    return;
+  }
+
+  *ierr = 0;
+
+  if ((natc == NULL) || (atm_weight == NULL) || (*natc <= 0)) {
+    *ierr = 1;
+    return;
+  }
+
+  if ((gpu == NULL) ||
+      (gpu->pbConstraint1 == NULL) ||
+      (!gpu->pbConstraint1->_bSysMem) ||
+      (gpu->pbConstraint1->_pSysData == NULL) ||
+      (gpu->pbConstraint1->_pDevData == NULL)) {
+    *ierr = 2;
+    return;
+  }
+
+  const int constraints = *natc;
+
+  if ((gpu->sim.constraints != constraints) ||
+      (gpu->pbConstraint1->_length != static_cast<size_t>(constraints))) {
+    *ierr = 3;
+    return;
+  }
+
+  // Both representations must exist.  The packed representation is what
+  // kBWU_cnst.h actually uses to compute positional-restraint forces.
+  if (gpu->pbBondWorkUnitUINT == NULL ||
+      gpu->pbBondWorkUnitDBL2 == NULL ||
+      gpu->sim.pBwuCnstUpdateIdx == NULL ||
+      gpu->sim.pBwuCnst == NULL) {
+    *ierr = 2;
+    return;
+  }
+
+  // The AREX scheduler guarantees uniform weights for this call.
+  const PMEDouble k = static_cast<PMEDouble>(atm_weight[0]);
+
+  // One launch per *force change*, never on a normal MD timestep.
+  // Alter only .x (stiffness) in both GPU representations, preserving all
+  // device-adjusted reference coordinates (.y and pConstraint2).
+  cudaError_t status = gpu_arex_set_constraint_stiffness_cuda(
+      constraints, k,
+      gpu->pbConstraint1->_pDevData,
+      gpu->sim.pBwuCnstUpdateIdx,
+      gpu->sim.pBwuCnst);
+  RTERROR(status, "AREX restraint stiffness kernel launch failed");
+
+  // Preserve completed-on-return behavior of the old synchronous Upload().
+  // This is at the infrequent schedule boundary, NOT in the MD hot path.
+  status = cudaStreamSynchronize(0);
+  RTERROR(status, "AREX restraint stiffness kernel execution failed");
+
+  // bondRemap.cpp repacks from this master host shadow.  Update the host
+  // stiffness but NEVER upload its stale reference-coordinate component.
+  for (int i = 0; i < constraints; ++i) {
+    gpu->pbConstraint1->_pSysData[i].x = atm_weight[i];
+  }
+}
