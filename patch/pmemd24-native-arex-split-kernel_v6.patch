+!*******************************************************************************
+! Module: arex_pay_phrex_mod
+!
+! PHREX-specific AREX payload implementation.
+!*******************************************************************************
+module arex_pay_phrex_mod
+
+  use arex_arm_mod, only : arm_payload_api_t, dp, ARM_OK, ARM_ERR_INVALID, &
+                           ARM_ERR_ALLOC
+  use arex_pay_common_mod, only : arex_pay_set_status
+  use file_io_dat_mod, only : mdout
+  use phmd_mod, only : ntitr, sp_grp, grplist, linkgrplist, ph_theta,        &
+                       dph_theta, vph_theta, dphold, vphold, iupdate,         &
+                       charge_phmd, qstate1, qstate2, qstate1_md, qstate2_md,&
+                       reset_park, qsetlam, phkin
+  use mdin_ctrl_dat_mod, only : iphmd, solvph, arex, arex_type, arex_seed,   &
+                                arex_segment_steps, arex_warmup_segments, &
+                                arex_chkfrq, arex_ladder, arex_ladder_unset, &
+                                arex_emulate_restart
+  use prmtop_dat_mod, only : natom, atm_qterm
+
+#ifdef MPI
+  use parallel_dat_mod
+#endif
+
+  implicit none
+  private
+
+  public :: arex_pay_phrex_build_api
+  public :: arex_pay_phrex_init_authoritative_storage
+  public :: arex_pay_phrex_capture_from_worker
+  public :: arex_pay_phrex_sync_assigned_replica
+  public :: arex_pay_phrex_send_assigned_replica_to_worker
+  public :: arex_pay_phrex_recv_assigned_replica_from_global
+  public :: arex_pay_phrex_send_completed_replica_to_scheduler
+  public :: arex_pay_phrex_recv_completed_replica_from_worker
+  public :: arex_pay_phrex_get_checkpoint_shape
+  public :: arex_pay_phrex_export_slot_ladder
+  public :: arex_pay_phrex_export_checkpoint_state
+  public :: arex_pay_phrex_import_checkpoint_state
+  public :: arex_pay_phrex_import_checkpoint_state_mapped
+  public :: arex_pay_phrex_seed_all_replicas
+  public :: arex_pay_phrex_seed_replica_from_restart
+
+  logical, save :: phrex_initialized = .false.
+  integer, save :: phrex_nreplicas   = 0
+  integer, save :: phrex_nslots      = 0
+  integer, save :: phrex_ntitr       = 0
+  integer, save :: phrex_ntheta      = 0
+
+#ifdef CUDA
+  integer, save :: phrex_random_buffer_size = 0
+#endif
+
+  logical, allocatable, save :: phrex_replica_valid(:)
+
+  real(dp), allocatable, save :: phrex_slot_ladder(:)   ! (nslots)
+
+  ! Use (ntheta, nreplicas) so slices (:, replica_id) are contiguous.
+  real(dp), allocatable, save :: phrex_theta(:,:)        ! (ntheta, nreplicas)
+  real(dp), allocatable, save :: phrex_dtheta(:,:)       ! (ntheta, nreplicas)
+  real(dp), allocatable, save :: phrex_vtheta(:,:)       ! (ntheta, nreplicas)
+  real(dp), allocatable, save :: phrex_dphold(:,:)       ! (ntheta, nreplicas)
+  real(dp), allocatable, save :: phrex_vphold(:,:)       ! (ntheta, nreplicas)
+  real(dp), allocatable, save :: phrex_proton_count(:)   ! (nreplicas)
+
+  integer, allocatable, save :: phrex_iupdate(:)         ! (nreplicas)
+
+#ifdef CUDA
+  integer, allocatable, save :: phrex_random_counter(:)  ! (nreplicas)
+  real(dp), allocatable, save :: phrex_random(:,:)       ! (nrandom, nreplicas)
+#endif
+
+#ifdef MPI
+  integer, parameter :: AREX_PHREX_MPI_TAG_STATE = 8401
+  integer, parameter :: AREX_PHREX_MPI_TAG_COMPLETE = 8402
+#endif
+  integer, parameter :: AREX_PHREX_SYNC_FULL      = 0
+  integer, parameter :: AREX_PHREX_SYNC_SLOT_ONLY = 1
+  integer, parameter :: AREX_PHREX_SYNC_NOOP      = 2
+
+contains
+
+subroutine arex_pay_phrex_build_api(api, ierr, message)
+  type(arm_payload_api_t), intent(out) :: api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  api%initialize          => arex_pay_phrex_initialize
+  api%finalize            => arex_pay_phrex_finalize
+  api%restore_to_worker   => arex_pay_phrex_restore_to_worker
+  api%capture_from_worker => arex_pay_phrex_capture_from_worker
+  api%evaluate_exchange   => arex_pay_phrex_evaluate_exchange
+  api%post_exchange       => arex_pay_phrex_post_exchange
+  api%checkpoint_replica  => arex_pay_phrex_checkpoint_replica
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+end subroutine arex_pay_phrex_build_api
+
+subroutine arex_pay_phrex_get_ladder_count(ladder_count, ierr, message)
+  integer, intent(out) :: ladder_count
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+
+  ladder_count = 0
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  do i = 1, size(arex_ladder)
+    if (arex_ladder(i) == arex_ladder_unset) exit
+    ladder_count = ladder_count + 1
+  end do
+
+  if (ladder_count <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_get_ladder_count: arex_ladder is empty in &cntrl')
+    return
+  end if
+end subroutine arex_pay_phrex_get_ladder_count
+
+subroutine arex_pay_phrex_report_configuration(nreplicas, nslots)
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nslots
+
+  integer :: i
+  integer :: ladder_count
+  integer :: ierr_local
+  character(len=256) :: message_local
+
+  call arex_pay_phrex_get_ladder_count(ladder_count, ierr_local, message_local)
+  if (ierr_local /= ARM_OK) return
+
+  write(mdout,'(a)')    ' AREX> async replica exchange enabled.'
+  write(mdout,'(a,a)')  ' AREX> payload type       = ', trim(adjustl(arex_type))
+  write(mdout,'(a,i0)') ' AREX> replicas          = ', nreplicas
+  write(mdout,'(a,i0)') ' AREX> slots             = ', nslots
+  write(mdout,'(a,i0)') ' AREX> segment steps     = ', arex_segment_steps
+  write(mdout,'(a,i0)') ' AREX> warmup segments   = ', arex_warmup_segments
+  write(mdout,'(a,i0)') ' AREX> checkpoint freq   = ', arex_chkfrq
+  write(mdout,'(a,i0)') ' AREX> seed              = ', arex_seed
+  write(mdout,'(a,i0)') ' AREX> ladder entries    = ', ladder_count
+
+  do i = 1, ladder_count
+    write(mdout,'(a,i0,a,f10.4)') ' AREX> ladder(', i, ')        = ', arex_ladder(i)
+  end do
+end subroutine arex_pay_phrex_report_configuration
+
+subroutine arex_pay_phrex_init_authoritative_storage(nreplicas, nslots, ntheta_in, &
+                                                     ntitr_in, slot_ladder_in,     &
+                                                     random_buffer_size_in, ierr,  &
+                                                     message)
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nslots
+  integer, intent(in) :: ntheta_in
+  integer, intent(in) :: ntitr_in
+  real(dp), intent(in) :: slot_ladder_in(:)
+  integer, intent(in) :: random_buffer_size_in
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: alloc_stat
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  call arex_pay_phrex_release_storage()
+
+  if (nreplicas <= 0 .or. nslots <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: nreplicas/nslots must be > 0')
+    return
+  end if
+
+  if (nreplicas /= nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: PHREX requires nreplicas == nslots')
+    return
+  end if
+
+  if (ntheta_in <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: ntheta_in must be > 0')
+    return
+  end if
+
+  if (ntitr_in <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: ntitr_in must be > 0')
+    return
+  end if
+
+  if (size(slot_ladder_in) /= nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: slot_ladder_in size mismatch')
+    return
+  end if
+
+#ifdef CUDA
+  if (random_buffer_size_in <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_init_authoritative_storage: random_buffer_size_in must be > 0 in CUDA builds')
+    return
+  end if
+#endif
+
+  allocate(phrex_replica_valid(nreplicas),                    &
+           phrex_slot_ladder(nslots),                         &
+           phrex_theta(ntheta_in, nreplicas),                 &
+           phrex_dtheta(ntheta_in, nreplicas),                &
+           phrex_vtheta(ntheta_in, nreplicas),                &
+           phrex_dphold(ntheta_in, nreplicas),                &
+           phrex_vphold(ntheta_in, nreplicas),                &
+           phrex_proton_count(nreplicas),                     &
+           phrex_iupdate(nreplicas),                          &
+           stat=alloc_stat)
+
+  if (alloc_stat /= 0) then
+    call arex_pay_phrex_release_storage()
+    call arex_pay_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arex_pay_phrex_init_authoritative_storage: allocation failed')
+    return
+  end if
+
+#ifdef CUDA
+  allocate(phrex_random_counter(nreplicas),                         &
+           phrex_random(random_buffer_size_in, nreplicas),          &
+           stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_pay_phrex_release_storage()
+    call arex_pay_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arex_pay_phrex_init_authoritative_storage: CUDA random-state allocation failed')
+    return
+  end if
+  phrex_random_buffer_size = random_buffer_size_in
+#endif
+
+  phrex_replica_valid(:) = .false.
+  phrex_slot_ladder(:)   = slot_ladder_in(:)
+  phrex_theta(:,:)       = 0.0_dp
+  phrex_dtheta(:,:)      = 0.0_dp
+  phrex_vtheta(:,:)      = 0.0_dp
+  phrex_dphold(:,:)      = 0.0_dp
+  phrex_vphold(:,:)      = 0.0_dp
+  phrex_proton_count(:)  = 0.0_dp
+  phrex_iupdate(:)       = 0
+
+#ifdef CUDA
+  phrex_random_counter(:) = 0
+  phrex_random(:,:)       = 0.0_dp
+#endif
+
+  phrex_nreplicas   = nreplicas
+  phrex_nslots      = nslots
+  phrex_ntitr       = ntitr_in
+  phrex_ntheta      = ntheta_in
+  phrex_initialized = .true.
+end subroutine arex_pay_phrex_init_authoritative_storage
+
+subroutine arex_pay_phrex_seed_all_replicas(theta_in, dtheta_in, vtheta_in, &
+                                            dphold_in, vphold_in, iupdate_in, &
+                                            random_counter_in, random_in, &
+                                            ierr, message)
+  real(dp), intent(in) :: theta_in(:,:)
+  real(dp), intent(in) :: dtheta_in(:,:)
+  real(dp), intent(in) :: vtheta_in(:,:)
+  real(dp), intent(in) :: dphold_in(:,:)
+  real(dp), intent(in) :: vphold_in(:,:)
+  integer, intent(in) :: iupdate_in
+  integer, intent(in) :: random_counter_in
+  real(dp), intent(in) :: random_in(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: replica_id
+  integer :: ncopy
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_seed_all_replicas: payload not initialized')
+    return
+  end if
+
+  if (phrex_nreplicas <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_seed_all_replicas: no replicas allocated')
+    return
+  end if
+
+  if (phrex_ntheta <= 0 .or. phrex_ntitr <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_seed_all_replicas: invalid theta dimensions')
+    return
+  end if
+
+  if (size(theta_in,1) < phrex_ntitr .or. size(theta_in,2) < phrex_nreplicas .or. &
+      size(dtheta_in,1) < phrex_ntitr .or. size(dtheta_in,2) < phrex_nreplicas .or. &
+      size(vtheta_in,1) < phrex_ntitr .or. size(vtheta_in,2) < phrex_nreplicas .or. &
+      size(dphold_in,1) < phrex_ntitr .or. size(dphold_in,2) < phrex_nreplicas .or. &
+      size(vphold_in,1) < phrex_ntitr .or. size(vphold_in,2) < phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_seed_all_replicas: input PHREX arrays are too small')
+    return
+  end if
+
+#ifdef CUDA
+  if (phrex_random_buffer_size > 0 .and. size(random_in) < phrex_random_buffer_size) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_seed_all_replicas: random buffer is too small')
+    return
+  end if
+#endif
+
+  ncopy = min(phrex_ntitr, phrex_ntheta)
+
+  do replica_id = 1, phrex_nreplicas
+    phrex_theta(:, replica_id)  = 0.0_dp
+    phrex_dtheta(:, replica_id) = 0.0_dp
+    phrex_vtheta(:, replica_id) = 0.0_dp
+    phrex_dphold(:, replica_id) = 0.0_dp
+    phrex_vphold(:, replica_id) = 0.0_dp
+
+    phrex_theta(1:ncopy, replica_id)  = theta_in(1:ncopy, replica_id)
+    phrex_dtheta(1:ncopy, replica_id) = dtheta_in(1:ncopy, replica_id)
+    phrex_vtheta(1:ncopy, replica_id) = vtheta_in(1:ncopy, replica_id)
+    phrex_dphold(1:ncopy, replica_id) = dphold_in(1:ncopy, replica_id)
+    phrex_vphold(1:ncopy, replica_id) = vphold_in(1:ncopy, replica_id)
+
+    phrex_iupdate(replica_id) = iupdate_in
+    phrex_proton_count(replica_id) = 0.0_dp
+    phrex_replica_valid(replica_id) = .true.
+
+#ifdef CUDA
+    if (phrex_random_buffer_size > 0) then
+      phrex_random_counter(replica_id) = random_counter_in
+      phrex_random(1:phrex_random_buffer_size, replica_id) = &
+        random_in(1:phrex_random_buffer_size)
+    end if
+#endif
+  end do
+end subroutine arex_pay_phrex_seed_all_replicas
+
+subroutine arex_pay_phrex_initialize(nreplicas, nslots, ierr, message)
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nslots
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: alloc_stat
+  integer :: ntheta
+  integer :: ladder_count
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_random_buffer_size(nrandom)
+      integer, intent(out) :: nrandom
+    end subroutine gpu_pharex_random_buffer_size
+  end interface
+#endif
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  call arex_pay_phrex_release_storage()
+
+  if (nreplicas <= 0 .or. nslots <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: nreplicas/nslots must be > 0')
+    return
+  end if
+
+  if (arex == 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: arex must be enabled in &cntrl')
+    return
+  end if
+
+  if (trim(adjustl(arex_type)) /= 'phrex') then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: arex_type must be ''phrex''')
+    return
+  end if
+
+  call arex_pay_phrex_get_ladder_count(ladder_count, ierr, message)
+  if (ierr /= ARM_OK) return
+
+  if (ladder_count /= nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: arex_ladder length does not match AREX slot count')
+    return
+  end if
+
+  if (nreplicas /= nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: PHREX requires nreplicas == nslots')
+    return
+  end if
+
+  if (.not. allocated(sp_grp)) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: CpHMD topology is not initialized (sp_grp not allocated)')
+    return
+  end if
+
+  if (ntitr <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: ntitr must be > 0 for PHREX')
+    return
+  end if
+
+  if (.not. allocated(charge_phmd)) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: charge_phmd is not allocated')
+    return
+  end if
+
+  ntheta = size(ph_theta)
+
+#ifdef CUDA
+  call gpu_pharex_random_buffer_size(phrex_random_buffer_size)
+  if (phrex_random_buffer_size <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_initialize: invalid CUDA PHREX random buffer size')
+    return
+  end if
+#endif
+
+  allocate(phrex_replica_valid(nreplicas),                    &
+           phrex_slot_ladder(nslots),                         &
+           phrex_theta(ntheta, nreplicas),                    &
+           phrex_dtheta(ntheta, nreplicas),                   &
+           phrex_vtheta(ntheta, nreplicas),                   &
+           phrex_dphold(ntheta, nreplicas),                   &
+           phrex_vphold(ntheta, nreplicas),                   &
+           phrex_proton_count(nreplicas),                     &
+           phrex_iupdate(nreplicas),                          &
+           stat=alloc_stat)
+
+  if (alloc_stat /= 0) then
+    call arex_pay_phrex_release_storage()
+    call arex_pay_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arex_pay_phrex_initialize: allocation failed')
+    return
+  end if
+
+#ifdef CUDA
+  allocate(phrex_random_counter(nreplicas),                  &
+           phrex_random(phrex_random_buffer_size, nreplicas),&
+           stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_pay_phrex_release_storage()
+    call arex_pay_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arex_pay_phrex_initialize: CUDA random-state allocation failed')
+    return
+  end if
+#endif
+
+  phrex_replica_valid(:) = .false.
+  phrex_slot_ladder(:)   = arex_ladder(1:nslots)
+  phrex_theta(:,:)       = 0.0_dp
+  phrex_dtheta(:,:)      = 0.0_dp
+  phrex_vtheta(:,:)      = 0.0_dp
+  phrex_dphold(:,:)      = 0.0_dp
+  phrex_vphold(:,:)      = 0.0_dp
+  phrex_proton_count(:)  = 0.0_dp
+  phrex_iupdate(:)       = 0
+
+#ifdef CUDA
+  phrex_random_counter(:) = 0
+  phrex_random(:,:)       = 0.0_dp
+#endif
+
+  phrex_nreplicas   = nreplicas
+  phrex_nslots      = nslots
+  phrex_ntitr       = ntitr
+  phrex_ntheta      = ntheta
+  phrex_initialized = .true.
+
+  call arex_pay_phrex_seed_rng(ierr, message)
+  if (ierr /= ARM_OK) then
+    call arex_pay_phrex_release_storage()
+    return
+  end if
+
+  call arex_pay_phrex_report_configuration(nreplicas, nslots)
+end subroutine arex_pay_phrex_initialize
+
+subroutine arex_pay_phrex_finalize(ierr, message)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_pay_phrex_release_storage()
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+end subroutine arex_pay_phrex_finalize
+
+subroutine arex_pay_phrex_restore_to_worker(replica_id, slot_id, worker_id, ierr, message)
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+#ifdef CUDA
+#ifdef AREX_DEBUG
+  real(dp), allocatable :: dbg_theta(:)
+  real(dp), allocatable :: dbg_dtheta(:)
+  real(dp), allocatable :: dbg_vtheta(:)
+  real(dp), allocatable :: dbg_dphold(:)
+  real(dp), allocatable :: dbg_vphold(:)
+  real(dp), allocatable :: dbg_random(:)
+  integer :: dbg_random_counter
+#endif
+#endif
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_restore(ph_theta_in, dph_theta_in, vph_theta_in, &
+                                  dphold_in, vphold_in, charge_phmd_in,    &
+                                  random_counter_in, random_in)
+      import dp
+      real(dp), intent(in) :: ph_theta_in(*)
+      real(dp), intent(in) :: dph_theta_in(*)
+      real(dp), intent(in) :: vph_theta_in(*)
+      real(dp), intent(in) :: dphold_in(*)
+      real(dp), intent(in) :: vphold_in(*)
+      real(dp), intent(in) :: charge_phmd_in(*)
+      integer, intent(in) :: random_counter_in
+      real(dp), intent(in) :: random_in(*)
+    end subroutine gpu_pharex_restore
+
+    subroutine gpu_pharex_capture(ph_theta_out, dph_theta_out, vph_theta_out, &
+                                  dphold_out, vphold_out, random_counter_out, &
+                                  random_out)
+      import dp
+      real(dp), intent(out) :: ph_theta_out(*)
+      real(dp), intent(out) :: dph_theta_out(*)
+      real(dp), intent(out) :: vph_theta_out(*)
+      real(dp), intent(out) :: dphold_out(*)
+      real(dp), intent(out) :: vphold_out(*)
+      integer, intent(out) :: random_counter_out
+      real(dp), intent(out) :: random_out(*)
+    end subroutine gpu_pharex_capture
+
+    subroutine gpu_upload_charges_pme_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_pme_cph
+
+    subroutine gpu_upload_charges_gb_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_gb_cph
+  end interface
+#endif
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_restore_to_worker: payload not initialized')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_restore_to_worker: invalid replica_id')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_restore_to_worker: invalid slot_id')
+    return
+  end if
+
+  if (worker_id <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_restore_to_worker: invalid worker_id')
+    return
+  end if
+
+  if (ntitr /= phrex_ntitr) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_restore_to_worker: ntitr changed after initialization')
+    return
+  end if
+
+  ! Preserve the current live worker state until initial snapshot seeding exists.
+  if (.not. phrex_replica_valid(replica_id)) then
+    call arex_pay_set_status(ierr, message, ARM_OK, '')
+    return
+  end if
+
+  if (arex_emulate_restart == 1) then
+    call arex_pay_phrex_emulate_restart_boundary(replica_id, slot_id, ierr, message)
+    return
+  end if
+
+  ph_theta(:)  = 0.0_dp
+  dph_theta(:) = 0.0_dp
+  vph_theta(:) = 0.0_dp
+  dphold(:)    = 0.0_dp
+  vphold(:)    = 0.0_dp
+
+  ph_theta(1:ntitr)  = phrex_theta(1:ntitr, replica_id)
+  dph_theta(1:ntitr) = phrex_dtheta(1:ntitr, replica_id)
+  vph_theta(1:ntitr) = phrex_vtheta(1:ntitr, replica_id)
+  dphold(1:ntitr)    = phrex_dphold(1:ntitr, replica_id)
+  vphold(1:ntitr)    = phrex_vphold(1:ntitr, replica_id)
+  iupdate            = phrex_iupdate(replica_id)
+
+  ! Slot condition is the active pH condition for this worker assignment.
+  solvph = phrex_slot_ladder(slot_id)
+  call reset_park()
+
+  call arex_pay_phrex_refresh_live_charges(ierr, message)
+  if (ierr /= ARM_OK) return
+
+#ifdef CUDA
+#ifdef AREX_DEBUG
+  if (replica_id == 2 .and. slot_id == 2) then
+    write(0,'(a,i0,a,i0,a,f8.3,a,f12.6,a,f12.6,a,f12.6,a,f12.6)') &
+         'AREX DBG PHREX RESTORE PRE_GPU replica ', replica_id, &
+         ' slot ', slot_id, &
+         ' solvph ', solvph, &
+         ' host_theta1 ', ph_theta(1), &
+         ' host_lambda1 ', sin(ph_theta(1))**2, &
+         ' stored_theta1 ', phrex_theta(1, replica_id), &
+         ' stored_lambda1 ', sin(phrex_theta(1, replica_id))**2
+    call flush(0)
+  end if
+#endif
+
+  call gpu_pharex_restore(phrex_theta(:, replica_id),                  &
+                          phrex_dtheta(:, replica_id),                 &
+                          phrex_vtheta(:, replica_id),                 &
+                          phrex_dphold(:, replica_id),                 &
+                          phrex_vphold(:, replica_id),                 &
+                          charge_phmd,                                 &
+                          phrex_random_counter(replica_id),            &
+                          phrex_random(:, replica_id))
+#ifdef AREX_DEBUG
+  if (replica_id == 2 .and. slot_id == 2) then
+    allocate(dbg_theta(phrex_ntheta),                                  &
+             dbg_dtheta(phrex_ntheta),                                 &
+             dbg_vtheta(phrex_ntheta),                                 &
+             dbg_dphold(phrex_ntheta),                                 &
+             dbg_vphold(phrex_ntheta),                                 &
+             dbg_random(max(1, phrex_random_buffer_size)))
+
+    dbg_theta(:)  = 0.0_dp
+    dbg_dtheta(:) = 0.0_dp
+    dbg_vtheta(:) = 0.0_dp
+    dbg_dphold(:) = 0.0_dp
+    dbg_vphold(:) = 0.0_dp
+    dbg_random(:) = 0.0_dp
+    dbg_random_counter = 0
+
+    call gpu_pharex_capture(dbg_theta, dbg_dtheta, dbg_vtheta,         &
+                            dbg_dphold, dbg_vphold,                    &
+                            dbg_random_counter, dbg_random)
+
+    write(0,'(a,i0,a,i0,a,f8.3,a,f12.6,a,f12.6,a,i0)') &
+         'AREX DBG PHREX RESTORE POST_GPU replica ', replica_id, &
+         ' slot ', slot_id, &
+         ' solvph ', solvph, &
+         ' gpu_theta1 ', dbg_theta(1), &
+         ' gpu_lambda1 ', sin(dbg_theta(1))**2, &
+         ' random_counter ', dbg_random_counter
+    call flush(0)
+
+    deallocate(dbg_theta, dbg_dtheta, dbg_vtheta, dbg_dphold,          &
+               dbg_vphold, dbg_random)
+  end if
+#endif
+
+  if (iphmd == 3) then
+    call gpu_upload_charges_pme_cph(atm_qterm)
+  else
+    call gpu_upload_charges_gb_cph(atm_qterm)
+  end if
+#endif
+
+#ifdef AREX_DEBUG
+if (replica_id == 2 .and. slot_id == 2) then
+  write(0,'(a,i0,a,i0,a,f10.4,a,f10.4,a,f10.4)') &
+       'AREX DBG PHREX RESTORE_TO_WORKER replica ', replica_id, &
+       ' slot ', slot_id, &
+       ' solvph ', solvph, &
+       ' theta1 ', ph_theta(1), &
+       ' lambda1 ', sin(ph_theta(1))**2
+  call flush(0)
+end if
+#endif
+end subroutine arex_pay_phrex_restore_to_worker
+
+subroutine arex_pay_phrex_capture_from_worker(replica_id, slot_id, worker_id, ierr, message)
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_capture(ph_theta_out, dph_theta_out, vph_theta_out, &
+                                  dphold_out, vphold_out, random_counter_out,  &
+                                  random_out)
+      import dp
+      real(dp), intent(out) :: ph_theta_out(*)
+      real(dp), intent(out) :: dph_theta_out(*)
+      real(dp), intent(out) :: vph_theta_out(*)
+      real(dp), intent(out) :: dphold_out(*)
+      real(dp), intent(out) :: vphold_out(*)
+      integer, intent(out) :: random_counter_out
+      real(dp), intent(out) :: random_out(*)
+    end subroutine gpu_pharex_capture
+  end interface
+#endif
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_capture_from_worker: payload not initialized')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_capture_from_worker: invalid replica_id')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_capture_from_worker: invalid slot_id')
+    return
+  end if
+
+  if (worker_id <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_capture_from_worker: invalid worker_id')
+    return
+  end if
+
+  if (ntitr /= phrex_ntitr) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_capture_from_worker: ntitr changed after initialization')
+    return
+  end if
+
+  phrex_theta(:, replica_id)  = 0.0_dp
+  phrex_dtheta(:, replica_id) = 0.0_dp
+  phrex_vtheta(:, replica_id) = 0.0_dp
+  phrex_dphold(:, replica_id) = 0.0_dp
+  phrex_vphold(:, replica_id) = 0.0_dp
+
+#ifdef CUDA
+  call gpu_pharex_capture(phrex_theta(:, replica_id),                  &
+                          phrex_dtheta(:, replica_id),                 &
+                          phrex_vtheta(:, replica_id),                 &
+                          phrex_dphold(:, replica_id),                 &
+                          phrex_vphold(:, replica_id),                 &
+                          phrex_random_counter(replica_id),            &
+                          phrex_random(:, replica_id))
+#else
+  phrex_theta(1:ntitr, replica_id)  = ph_theta(1:ntitr)
+  phrex_dtheta(1:ntitr, replica_id) = dph_theta(1:ntitr)
+  phrex_vtheta(1:ntitr, replica_id) = vph_theta(1:ntitr)
+  phrex_dphold(1:ntitr, replica_id) = dphold(1:ntitr)
+  phrex_vphold(1:ntitr, replica_id) = vphold(1:ntitr)
+#endif
+
+  phrex_iupdate(replica_id) = iupdate
+
+  call arex_pay_phrex_compute_proton_count(phrex_theta(:, replica_id),      &
+                                           phrex_proton_count(replica_id),  &
+                                           ierr, message)
+#ifdef AREX_DEBUG
+  if (replica_id == 2 .and. slot_id == 2) then
+    write(0,'(a,i0,a,i0,a,f10.4,a,f10.4,a,f10.4)') &
+       'AREX DBG PHREX CAPTURE worker_state replica ', replica_id, &
+       ' slot ', slot_id, &
+       ' theta1 ', phrex_theta(1, replica_id), &
+       ' lambda1 ', sin(phrex_theta(1, replica_id))**2, &
+       ' proton_count ', phrex_proton_count(replica_id)
+    call flush(0)
+  end if
+#endif
+
+  if (ierr /= ARM_OK) return
+
+  phrex_replica_valid(replica_id) = .true.
+end subroutine arex_pay_phrex_capture_from_worker
