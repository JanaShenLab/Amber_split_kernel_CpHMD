+  end if
+end subroutine arex_rst_apply_payload_checkpoint_mapped
+
+subroutine arex_rst_apply_migration_state(ckpt, mgr, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: old_replica
+  integer :: restart_slot
+  integer :: next_uid
+  integer :: arm_ierr
+  integer :: alloc_stat
+  integer, allocatable :: source_old_slot(:)
+  integer, allocatable :: source_old_replica(:)
+  integer, allocatable :: source_restart_slot(:)
+  integer, allocatable :: old_replica_uids(:)
+  logical, allocatable :: retained(:)
+  character(len=256) :: arm_message
+
+  call arex_rst_validate_checkpoint_compatibility(ckpt, mgr, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  if (arex_rst_checkpoint_ladder_matches_current(ckpt)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_apply_migration_state: ladder is unchanged')
+    return
+  end if
+
+  allocate(source_old_slot(mgr%nslots), source_old_replica(mgr%nreplicas), &
+           source_restart_slot(mgr%nslots), retained(mgr%nreplicas), &
+           old_replica_uids(ckpt%nreplicas), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_apply_migration_state: migration mapping allocation failed')
+    goto 900
+  end if
+
+  call arex_rst_build_migration_map(ckpt, source_old_slot, source_old_replica, &
+                                    source_restart_slot, retained, ierr, message)
+  if (ierr /= AREX_RST_OK) goto 900
+
+  do i = 1, ckpt%nreplicas
+    old_replica_uids(i) = ckpt%replicas(i)%replica_uid
+  end do
+
+  mgr%epoch = 1
+  mgr%current_parity = ARM_PARITY_EVEN
+  mgr%history_generation = ckpt%history_generation + 1
+  do i = 1, mgr%nslots
+    mgr%slot_owner(i) = i
+  end do
+  mgr%slot_restart_owner(:) = 0
+  mgr%slot_restart_replica_segments(:) = 0
+
+  next_uid = ckpt%next_replica_uid
+  do i = 1, mgr%nreplicas
+    old_replica = source_old_replica(i)
+    restart_slot = source_restart_slot(i)
+
+    mgr%replicas(i)%replica_id = i
+    mgr%replicas(i)%slot_id = i
+    mgr%replicas(i)%status = ARM_REPLICA_IDLE
+    mgr%replicas(i)%assigned_worker_id = 0
+    mgr%replicas(i)%segments_completed = 0
+    mgr%replicas(i)%completed_epoch = 0
+    mgr%replicas(i)%exchange_resolved_epoch = 0
+
+    if (retained(i)) then
+      mgr%replicas(i)%replica_uid = ckpt%replicas(old_replica)%replica_uid
+      mgr%replicas(i)%parent_uid = ckpt%replicas(old_replica)%parent_uid
+    else
+      mgr%replicas(i)%replica_uid = next_uid
+      mgr%replicas(i)%parent_uid = ckpt%replicas(old_replica)%replica_uid
+      next_uid = next_uid + 1
+    end if
+
+    call arex_rst_seed_common_snapshot_from_slot_restart(ckpt, mgr, restart_slot, &
+         ckpt%slot_ladder(restart_slot), i, ckpt%slot_output(restart_slot)%restart_time_ps, &
+         ierr, message)
+    if (ierr /= AREX_RST_OK) goto 900
+  end do
+  mgr%next_replica_uid = next_uid
+
+  call arex_rst_apply_migration_output_state(ckpt, mgr, source_old_slot, &
+                                             source_restart_slot, retained, ierr, message)
+  if (ierr /= AREX_RST_OK) goto 900
+
+  if (ckpt%have_payload_checkpoint) then
+    call arex_rst_apply_payload_checkpoint_mapped(ckpt, source_old_replica, ierr, message)
+    if (ierr /= AREX_RST_OK) goto 900
+  else
+    do i = 1, mgr%nreplicas
+      restart_slot = source_restart_slot(i)
+      call arex_rst_seed_payload_from_slot_restart(ckpt, restart_slot, &
+           ckpt%slot_ladder(restart_slot), i, ckpt%payload_type, ierr, message)
+      if (ierr /= AREX_RST_OK) goto 900
+    end do
+  end if
+
+  do i = 1, mgr%nworkers
+    mgr%workers(i)%status = ARM_WORKER_IDLE
+    mgr%workers(i)%active_replica_id = 0
+    mgr%workers(i)%active_slot_id = 0
+  end do
+
+  arm_ierr = ARM_OK
+  arm_message = ''
+  call arm_write_migration_history(mgr, ckpt%history_generation, ckpt%epoch, &
+       old_replica_uids, ckpt%slot_ladder, arex_ladder(1:mgr%nslots), &
+       source_old_slot, source_old_replica, retained, arm_ierr, arm_message)
+  if (arm_ierr /= ARM_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(arm_message))
+    goto 900
+  end if
+
+  call random_seed(put=ckpt%scheduler_rng)
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+900 continue
+  if (allocated(source_old_slot)) deallocate(source_old_slot)
+  if (allocated(source_old_replica)) deallocate(source_old_replica)
+  if (allocated(source_restart_slot)) deallocate(source_restart_slot)
+  if (allocated(retained)) deallocate(retained)
+  if (allocated(old_replica_uids)) deallocate(old_replica_uids)
+end subroutine arex_rst_apply_migration_state
+
+subroutine arex_rst_restore_from_checkpoint(checkpoint_name, mgr, ierr, message)
+  character(len=*), intent(in) :: checkpoint_name
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_rst_checkpoint_t) :: ckpt
+  integer :: slot_id
+  integer :: replica_id
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  call arex_rst_read_checkpoint(checkpoint_name, ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  call arex_rst_validate_checkpoint_restart_inventory(ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) then
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  call arex_rst_validate_checkpoint_compatibility(ckpt, mgr, ierr, message)
+  if (ierr /= AREX_RST_OK) then
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  if (.not. arex_rst_checkpoint_ladder_matches_current(ckpt)) then
+    call arex_rst_apply_migration_state(ckpt, mgr, ierr, message)
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  call arex_rst_apply_logical_state(ckpt, mgr, ierr, message)
+  if (ierr /= AREX_RST_OK) then
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  call arex_rst_apply_output_state(ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) then
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  do slot_id = 1, ckpt%nslots
+    ! The slot restart contains the walker that last completed MD in that slot,
+    ! which can differ from the post-exchange slot_owner mapping.
+    replica_id = ckpt%slot_output(slot_id)%restart_replica_id
+
+    call arex_rst_seed_common_snapshot_from_slot_restart(ckpt, mgr, slot_id, &
+      ckpt%slot_ladder(slot_id), replica_id, ckpt%slot_output(slot_id)%restart_time_ps, &
+      ierr, message)
+    if (ierr /= AREX_RST_OK) then
+      call arex_rst_release_checkpoint(ckpt)
+      return
+    end if
+
+    if (.not. ckpt%have_payload_checkpoint) then
+      call arex_rst_seed_payload_from_slot_restart(ckpt, slot_id, ckpt%slot_ladder(slot_id), &
+           replica_id, ckpt%payload_type, ierr, message)
+      if (ierr /= AREX_RST_OK) then
+        call arex_rst_release_checkpoint(ckpt)
+        return
+      end if
+    end if
+  end do
+
+  call arex_rst_apply_payload_checkpoint(ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) then
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  ! Resume the scheduler exchange stream at the exact checkpointed position.
+  call random_seed(put=ckpt%scheduler_rng)
+
+  call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_rst_restore_from_checkpoint
+
+end module arex_rst_mod
