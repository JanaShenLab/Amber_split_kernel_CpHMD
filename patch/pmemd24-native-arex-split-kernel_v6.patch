+static __device__ __forceinline__
+kPMEPHMDAtomState kPMEPHMDLoadAtomState(const kPMEPHMDDirectConst& sim,
+                                        const unsigned int atom,
+                                        const bool valid)
+{
+  kPMEPHMDAtomState s;
+
+  s.grp = -1;
+  s.psp_grp = 0;
+  s.index = atom;
+
+  s.qphmd = (PMEFloat)0.0;
+  s.qd = (PMEFloat)0.0;
+  s.qxd = (PMEFloat)0.0;
+
+  s.xlambda = (PMEFloat)1.0;
+  s.fact = (PMEFloat)1.0;
+  s.dx = (PMEFloat)0.0;
+  s.lambda = (PMEFloat)0.0;
+
+  s.titr = false;
+  s.taut = false;
+
+  if (!valid) {
+    return s;
+  }
+
+  s.grp = sim.pImageGrplist[atom] - 1;
+  s.qphmd = sim.pImageCharge_phmd[atom];
+
+  if (s.grp >= 0) {
+    const PMEFloat2 pqstate1 = sim.pImageQstate1[atom];
+    const PMEFloat2 pqstate2 = sim.pImageQstate2[atom];
+
+    s.psp_grp = sim.psp_grp[s.grp];
+
+    const PMEFloat2 vstate1 = sim.pvstate1[sim.pImageIndexPHMD[atom]];
+    PMEFloat radh = vstate1.x;
+
+    PMEFloat lambda = sin(sim.pph_theta[s.grp]);
+    lambda *= lambda;
+
+    s.lambda = lambda;
+    s.fact = (PMEFloat)1.0 - lambda;
+    s.xlambda = (PMEFloat)1.0;
+
+    PMEFloat x2 = (PMEFloat)1.0;
+
+    if (s.psp_grp > 0) {
+      s.taut = true;
+
+      x2 = sin(sim.pph_theta[s.grp + 1]);
+      x2 *= x2;
+
+      radh += vstate1.y;
+
+      PMEFloat ihtaut = (PMEFloat)0.0;
+      if (vstate1.x > (PMEFloat)0.0) {
+        ihtaut = (PMEFloat)1.0;
+        s.xlambda = x2;
+      }
+      else if (vstate1.y > (PMEFloat)0.0) {
+        ihtaut = (PMEFloat)-1.0;
+        s.xlambda = (PMEFloat)1.0 - x2;
+      }
+
+      if (s.psp_grp == 1) {
+        s.fact = (PMEFloat)1.0 - lambda * s.xlambda;
+        s.dx = -ihtaut * lambda;
+      }
+      else if (s.psp_grp == 3) {
+        s.fact = ((PMEFloat)1.0 - lambda) * s.xlambda;
+        s.dx = ihtaut * ((PMEFloat)1.0 - lambda);
+      }
+
+      const PMEFloat qunprot = lambda * (pqstate2.x - pqstate2.y);
+      const PMEFloat qprot   = ((PMEFloat)1.0 - lambda) * (pqstate1.x - pqstate1.y);
+      s.qxd = qunprot + qprot;
+    }
+
+    s.titr = (radh > (PMEFloat)0.0);
+
+    const PMEFloat qunprot = x2 * pqstate2.x + ((PMEFloat)1.0 - x2) * pqstate2.y;
+    const PMEFloat qprot   = x2 * pqstate1.x + ((PMEFloat)1.0 - x2) * pqstate1.y;
+    s.qd = qunprot - qprot;
+  }
+
+  return s;
+}
+
+static __device__ __forceinline__
+kPMEPHMDAtomState kPMEPHMDShuffleAtomState(const kPMEPHMDAtomState& s,
+                                           const int lane)
+{
+  kPMEPHMDAtomState out;
+
+  out.grp      = __SHFL(WARP_MASK, s.grp, lane);
+  out.psp_grp  = __SHFL(WARP_MASK, s.psp_grp, lane);
+  out.index    = __SHFL(WARP_MASK, s.index, lane);
+
+  out.qphmd    = __SHFL(WARP_MASK, s.qphmd, lane);
+  out.qd       = __SHFL(WARP_MASK, s.qd, lane);
+  out.qxd      = __SHFL(WARP_MASK, s.qxd, lane);
+
+  out.xlambda  = __SHFL(WARP_MASK, s.xlambda, lane);
+  out.fact     = __SHFL(WARP_MASK, s.fact, lane);
+  out.dx       = __SHFL(WARP_MASK, s.dx, lane);
+  out.lambda   = __SHFL(WARP_MASK, s.lambda, lane);
+
+  const int titr = __SHFL(WARP_MASK, (int)s.titr, lane);
+  const int taut = __SHFL(WARP_MASK, (int)s.taut, lane);
+
+  out.titr = (titr != 0);
+  out.taut = (taut != 0);
+
+  return out;
+}
+
+static __device__ __forceinline__
+void kPMEPHMDPairCorrection(const kPMEPHMDAtomState& si,
+                            const kPMEPHMDAtomState& sj,
+                            const bool ljNotExcluded,
+                            const PMEFloat de,
+                            const PMEFloat ljdf,
+                            const PMEFloat coulScale,
+                            PMEFloat& dudli,
+                            PMEFloat& dudliplus,
+                            PMEFloat& dudlj,
+                            PMEFloat& dudljplus,
+                            PMEFloat& deltaDf,
+                            PMEFloat& deltaEvdw)
+{
+  dudlj = (PMEFloat)0.0;
+  dudljplus = (PMEFloat)0.0;
+  deltaDf = (PMEFloat)0.0;
+  deltaEvdw = (PMEFloat)0.0;
+
+  PMEFloat factphmd = (PMEFloat)1.0;
+
+  if (ljNotExcluded) {
+    if (si.titr && sj.titr) {
+      if (si.grp != sj.grp) {
+        factphmd = si.fact * sj.fact;
+
+        dudli -= si.xlambda * sj.fact * de;
+        dudlj -= sj.xlambda * si.fact * de;
+
+        if (si.taut) {
+          dudliplus += si.dx * sj.fact * de;
+        }
+        if (sj.taut) {
+          dudljplus += sj.dx * si.fact * de;
+        }
+      }
+      else if (si.psp_grp == 1) {
+        factphmd = (PMEFloat)1.0 - si.lambda;
+        dudli -= de;
+      }
+    }
+    else if (si.titr) {
+      factphmd = si.fact;
+      dudli -= si.xlambda * de;
+
+      if (si.taut) {
+        dudliplus += si.dx * de;
+      }
+    }
+    else if (sj.titr) {
+      factphmd = sj.fact;
+      dudlj -= sj.xlambda * de;
+
+      if (sj.taut) {
+        dudljplus += sj.dx * de;
+      }
+    }
+
+    const PMEFloat factDelta = factphmd - (PMEFloat)1.0;
+    deltaDf = factDelta * ljdf;
+    deltaEvdw = factDelta * de;
+  }
+
+  if (si.grp >= 0) {
+    dudli += sj.qphmd * si.qd * coulScale;
+    if (si.psp_grp > 0) {
+      dudliplus += sj.qphmd * si.qxd * coulScale;
+    }
+  }
+
+  if (sj.grp >= 0) {
+    dudlj += si.qphmd * sj.qd * coulScale;
+    if (sj.psp_grp > 0) {
+      dudljplus += si.qphmd * sj.qxd * coulScale;
+    }
+  }
+}
+
+template <bool DoVirial, bool DoFswitch, bool DoEnergy, bool IsOrthog>
+__global__ void
+kPMEPHMDDirectCorrections16_kernel(kPMEPHMDDirectConst sim)
+{
+  const unsigned int tgx = threadIdx.x & (GRID - 1);
+  const unsigned int warp = threadIdx.x / GRID;
+  const unsigned int warpsPerBlock = blockDim.x / GRID;
+
+  const unsigned int iLane = tgx & sim.NLAtomsPerWarpBitsMask;
+  const unsigned int jgroup = tgx >> sim.NLAtomsPerWarpBits;
+  const unsigned int joffset = tgx & ~sim.NLAtomsPerWarpBitsMask;
+
+  const unsigned int totalInteractions =
+    PME_PHMD_ORTHO16_ATOMS_PER_WARP / 2u * (PME_PHMD_ORTHO16_ATOMS_PER_WARP - 1u);
+  const unsigned int iftlim = (totalInteractions + GRID - 1u) / GRID;
+
+  const PMEFloat delta = (PMEFloat)1.0e-5;
+  const PMEFloat sixth = (PMEFloat)0.16666666666667;
+  const PMEFloat twelvth = (PMEFloat)0.083333333333333;
+
+  unsigned int listPos = blockIdx.x * warpsPerBlock + warp;
+  const unsigned int nentries = *(sim.pNLEntryPHMDCount);
+  const unsigned int nlStride = gridDim.x * warpsPerBlock;
+
+  while (listPos < nentries) {
+#if PME_PHMD_DIRECT_DEBUG_MAX_NLPOS
+    if (listPos >= PME_PHMD_DIRECT_DEBUG_MAX_NLPOS) {
+      break;
+    }
+#endif
+
+    const unsigned int nlpos = sim.pNLEntryPHMDList[listPos];
+    const unsigned int entryMask = sim.pNLEntryPHMDMask[nlpos];
+    const unsigned int yPHMDMask = sim.pNLEntryPHMDYAtomMask[nlpos];
+    const bool entryYHasPHMD = (yPHMDMask != 0u);
+    (void)entryMask;
+
+    const bool doEntry = true;
+
+    if (doEntry) {
+      NLEntry entry = sim.pNLEntry[nlpos];
+
+      const bool bHomeCell = (entry.NL.ymax & NLENTRY_HOME_CELL_MASK) != 0u;
+      entry.NL.ymax >>= NLENTRY_YMAX_SHIFT;
+
+      unsigned int offset = entry.NL.offset;
+
+      const unsigned int yIndex = entry.NL.ypos + iLane;
+      const bool yValid = (iLane < PME_PHMD_ORTHO16_ATOMS_PER_WARP) &&
+                          (yIndex < entry.NL.ymax);
+
+      PMEFloat xi, yi, zi, qi;
+      unsigned int LJIDiRaw;
+
+      kPMEPHMDLoadAtomBasics(sim, yIndex, yValid, xi, yi, zi, qi, LJIDiRaw);
+      kPMEPHMDTransformYAtom<DoVirial, IsOrthog>(xi, yi, zi, sim);
+      const kPMEPHMDAtomState si = kPMEPHMDLoadAtomState(sim, yIndex, yValid);
+
+      const bool yLanePHMD =
+        yValid && ((yPHMDMask & (1u << iLane)) != 0u);
+
+      PMEFloat dudli = (PMEFloat)0.0;
+      PMEFloat dudliplus = (PMEFloat)0.0;
+
+      PMEFloat TLx_i = (PMEFloat)0.0;
+      PMEFloat TLy_i = (PMEFloat)0.0;
+      PMEFloat TLz_i = (PMEFloat)0.0;
+
+      // Rounding-aware force validation for C:
+      // old raw delta = round(full old tile) - round(full normal tile)
+      PMEFloat baseTLx_home = (PMEFloat)0.0;
+      PMEFloat baseTLy_home = (PMEFloat)0.0;
+      PMEFloat baseTLz_home = (PMEFloat)0.0;
+      PMEFloat oldTLx_home  = (PMEFloat)0.0;
+      PMEFloat oldTLy_home  = (PMEFloat)0.0;
+      PMEFloat oldTLz_home  = (PMEFloat)0.0;
+
+      PMEFloat TLvir_11 = (PMEFloat)0.0;
+      PMEFloat TLvir_22 = (PMEFloat)0.0;
+      PMEFloat TLvir_33 = (PMEFloat)0.0;
+
+      PMEFloat TLevdw = (PMEFloat)0.0;
+
+      // -----------------------------------------------------------------------
+      // Home-cell first tile.
+      //
+      // Mirrors the old triangular-tile structure.  This path uses the old
+      // PHMD Coulomb derivative form:
+      //
+      //   swtch * rinv * fnrange
+      // -----------------------------------------------------------------------
+      if (bHomeCell) { if (PME_PHMD_DIRECT_DO_HOME_TILE) {
+        unsigned int exclusion = sim.pNLAtomList[offset + iLane];
+        offset += sim.NLAtomsPerWarp;
+
+        if (PME_PHMD_ORTHO16_ATOMS_PER_WARP < GRID) {
+          exclusion >>= iftlim * jgroup;
+        }
+
+        const unsigned int LJIDjRaw = LJIDiRaw;
+        const unsigned int LJIDi = LJIDiRaw * sim.LJTypes;
+
+        int j = ((tgx + iftlim * jgroup + 1) & sim.NLAtomsPerWarpBitsMask) | joffset;
+        int jrec = ((PME_PHMD_ORTHO16_ATOMS_PER_WARP + tgx -
+                    (iftlim * jgroup + 1)) & sim.NLAtomsPerWarpBitsMask) | joffset;
+
+#pragma unroll 2
+        for (int ift = 0; ift < (int)iftlim; ift++) {
+           const PMEFloat xj = __SHFL(WARP_MASK, xi, j);
+           const PMEFloat yj = __SHFL(WARP_MASK, yi, j);
+           const PMEFloat zj = __SHFL(WARP_MASK, zi, j);
+           const PMEFloat qjRound = __SHFL(WARP_MASK, qi, j);
+
+           const unsigned int LJIDj = __SHFL(WARP_MASK, LJIDjRaw, j);
+            const kPMEPHMDAtomState sj = kPMEPHMDShuffleAtomState(si, j);
+
+
+            const unsigned int jYLane =
+              ((unsigned int)j) & sim.NLAtomsPerWarpBitsMask;
+
+#if PME_PHMD_DIRECT_PAIR_SKIP
+            const bool pairPHMDRelevant =
+              yLanePHMD || ((yPHMDMask & (1u << jYLane)) != 0u);
+#else
+            const bool pairPHMDRelevant = true;
+#endif
+
+            PMEFloat dfdx = (PMEFloat)0.0;
+            PMEFloat dfdy = (PMEFloat)0.0;
+            PMEFloat dfdz = (PMEFloat)0.0;
+
+            if (pairPHMDRelevant) {
+              const PMEFloat xij = xi - xj;
+              const PMEFloat yij = yi - yj;
+              const PMEFloat zij = zi - zj;
+              const PMEFloat r2 = xij * xij + yij * yij + zij * zij;
+
+              const bool inrange = ((r2 < sim.cut2) && (r2 > delta));
+              const bool activeInteraction = inrange &&
+                ((unsigned int)(ift * GRID + tgx) < totalInteractions);
+
+              PMEFloat deltaDf = (PMEFloat)0.0;
+              PMEFloat deltaEvdw = (PMEFloat)0.0;
+              PMEFloat baseDfRound = (PMEFloat)0.0;
+              PMEFloat oldDfRound  = (PMEFloat)0.0;
+
+              if (inrange) {
+                const unsigned int ljIndex = LJIDi + LJIDj;
+                PMEFloat r2inv;
+                PMEFloat r;
+                PMEFloat rinv;
+
+                kPMEPHMDComputeDistanceTerms<DoFswitch, DoEnergy>(r2,
+                                                        r2inv,
+                                                        r,
+                                                        rinv);
+
+                const PMEFloat2 term = sim.pLJTerm[ljIndex];
+                const PMEFloat r6inv = r2inv * r2inv * r2inv;
+
+#ifdef use_DPFP
+                PMEFloat swtch = erfc(sim.ew_coeffSP * r);
+#else
+                //PMEFloat swtch = fasterfc(r);
+                PMEFloat swtch = kPMEPHMDErfcSwitch(sim, r);
+#endif
+
+                const bool excluded = (exclusion & 0x1u) != 0u;
+                if (excluded) {
+                  swtch -= (PMEFloat)1.0;
+                }
+
+                const PMEFloat fnrange = activeInteraction ? (PMEFloat)1.0
+                                                           : (PMEFloat)0.0;
+
+                PMEFloat de = (PMEFloat)0.0;
+                PMEFloat ljdf = (PMEFloat)0.0;
+
+                if (!excluded) {
+                  kPMEPHMDComputeLJCorrectionTerms<DoFswitch,DoEnergy>(sim,
+                                                              term,
+                                                              r2,
+                                                              r2inv,
+                                                              rinv,
+                                                              r6inv,
+                                                              fnrange,
+                                                              sixth,
+                                                              twelvth,
+                                                              de,
+                                                              ljdf);
+                }
+
+                PMEFloat dudlj;
+                PMEFloat dudljplus;
+
+                  kPMEPHMDPairCorrection(si,
+                                          sj,
+                                          !excluded,
+                                          de,
+                                          ljdf,
+                                          swtch * rinv * fnrange,
+                                          dudli,
+                                          dudliplus,
+                                          dudlj,
+                                          dudljplus,
+                                          deltaDf,
+                                          deltaEvdw);
+
+                if (!activeInteraction) {
+                  deltaDf = (PMEFloat)0.0;
+                  deltaEvdw = (PMEFloat)0.0;
+                }
+
+                if (PME_PHMD_ROUNDING_AWARE_FORCE &&
+                    DoEnergy && !DoVirial && !DoFswitch) {
+                  const PMEFloat qiqj = qi * qjRound;
+                  const PMEFloat d_swtch_dx = kPMEPHMDDSwitchDx(sim, r2);
+
+                  baseDfRound = kPMEPHMDBaseForceDf<true, false>(
+                      qiqj,
+                      excluded ? (PMEFloat)0.0 : ljdf,
+                      swtch,
+                      rinv,
+                      r2inv,
+                      d_swtch_dx);
+
+                  if (!activeInteraction) {
+                    baseDfRound = (PMEFloat)0.0;
+                  }
+
+                  oldDfRound = baseDfRound + deltaDf;
+                }
+
+#if PME_PHMD_FORCE_PAIR_TARGET_WATCH
+                  if (DoEnergy && !DoVirial && !DoFswitch &&
+                      (kPMEPHMDWatchForceTargetAtom(si.index) ||
+                       kPMEPHMDWatchForceTargetAtom(sj.index))) {
+                    const unsigned int slot =
+                      atomicAdd(&kPMEPHMDForcePairTargetWatchCounter, 1u);
+
+                    if (slot < PME_PHMD_FORCE_PAIR_TARGET_WATCH_LIMIT) {
+                      printf("PME_PHMD_FORCE_PAIR_TARGET_WATCH tile=HOME nlpos=%u tgx=%u ift=%d "
+                             "si=%u siGrp=%d siTitr=%d siFact=% .9e "
+                             "sj=%u sjGrp=%d sjTitr=%d sjFact=% .9e "
+                             "pairPHMDRelevant=%d inrange=%d active=%d excluded=%d "
+                             "r2=% .9e ljdf=% .9e de=% .9e deltaDf=% .9e deltaEvdw=% .9e "
+                             "xij=% .9e yij=% .9e zij=% .9e "
+                             "dfdx=% .9e dfdy=% .9e dfdz=% .9e "
+                             "dudli=% .9e dudlj=% .9e\n",
+                             nlpos,
+                             tgx,
+                             ift,
+                             si.index,
+                             si.grp,
+                             si.titr ? 1 : 0,
+                             (double)si.fact,
+                             sj.index,
+                             sj.grp,
+                             sj.titr ? 1 : 0,
+                             (double)sj.fact,
+                             pairPHMDRelevant ? 1 : 0,
+                             inrange ? 1 : 0,
+                             activeInteraction ? 1 : 0,
+                             excluded ? 1 : 0,
+                             (double)r2,
+                             (double)ljdf,
+                             (double)de,
+                             (double)deltaDf,
+                             (double)deltaEvdw,
+                             (double)xij,
+                             (double)yij,
+                             (double)zij,
+                             (double)(deltaDf * xij),
+                             (double)(deltaDf * yij),
+                             (double)(deltaDf * zij),
+                             (double)dudli,
+                             (double)dudlj);
+                    }
+                  }
+#endif
+
+                  if (DoEnergy) {
+                    TLevdw += deltaEvdw;
+                  }
+
+#if PME_PHMD_DIRECT_DO_DUDL_ATOMICS
+                if (sj.grp >= 0) {
+#if PME_PHMD_WATCH_INDEX >= 0
+                  kPMEPHMDWatchDudl(4,
+                                    nlpos,
+                                    sj.index,
+                                    sj.grp,
+                                    sj.psp_grp,
+                                    dudlj,
+                                    dudljplus);
+#endif
+
+                  kPMEPHMDAtomicAddDudl(&sim.pdph_accumulator[sj.index], dudlj);
+                  kPMEPHMDAtomicAddDudl(&sim.pdph_plus_accumulator[sj.index], dudljplus);
+                }
+#endif
+              }
+
+           if (PME_PHMD_ROUNDING_AWARE_FORCE &&
+               DoEnergy && !DoVirial && !DoFswitch) {
+             const PMEFloat baseDfdx = baseDfRound * xij;
+            const PMEFloat baseDfdy = baseDfRound * yij;
+            const PMEFloat baseDfdz = baseDfRound * zij;
+
+            const PMEFloat oldDfdx = oldDfRound * xij;
+            const PMEFloat oldDfdy = oldDfRound * yij;
+            const PMEFloat oldDfdz = oldDfRound * zij;
+
+            baseTLx_home += baseDfdx;
+            baseTLy_home += baseDfdy;
+            baseTLz_home += baseDfdz;
+            baseTLx_home -= __SHFL(WARP_MASK, baseDfdx, jrec);
+            baseTLy_home -= __SHFL(WARP_MASK, baseDfdy, jrec);
+            baseTLz_home -= __SHFL(WARP_MASK, baseDfdz, jrec);
+
+            oldTLx_home += oldDfdx;
+            oldTLy_home += oldDfdy;
+            oldTLz_home += oldDfdz;
+            oldTLx_home -= __SHFL(WARP_MASK, oldDfdx, jrec);
+            oldTLy_home -= __SHFL(WARP_MASK, oldDfdy, jrec);
+            oldTLz_home -= __SHFL(WARP_MASK, oldDfdz, jrec);
+          }
+
+          dfdx = deltaDf * xij;
+          dfdy = deltaDf * yij;
+          dfdz = deltaDf * zij;
+
+          if (DoVirial) {
+                TLvir_11 -= xij * dfdx;
+                TLvir_22 -= yij * dfdy;
+                TLvir_33 -= zij * dfdz;
+              }
+            }
+
+            TLx_i += dfdx;
+            TLy_i += dfdy;
+            TLz_i += dfdz;
+
+            TLx_i -= __SHFL(WARP_MASK, dfdx, jrec);
+            TLy_i -= __SHFL(WARP_MASK, dfdy, jrec);
+            TLz_i -= __SHFL(WARP_MASK, dfdz, jrec);
+          exclusion >>= 1;
+          j = ((j + 1) & sim.NLAtomsPerWarpBitsMask) | joffset;
+
+          jrec = ((jrec + PME_PHMD_ORTHO16_ATOMS_PER_WARP - 1) &
+                  sim.NLAtomsPerWarpBitsMask) | joffset;
+        }
+
+#if PME_PHMD_DIRECT_DO_FORCE_ATOMICS && PME_PHMD_ROUNDING_AWARE_FORCE
+  if (DoEnergy && !DoVirial && !DoFswitch) {
+    const int phmdRoundPartnerLane =
+      (tgx < PME_PHMD_ORTHO16_ATOMS_PER_WARP) ?
+      (tgx + PME_PHMD_ORTHO16_ATOMS_PER_WARP) :
+      (tgx - PME_PHMD_ORTHO16_ATOMS_PER_WARP);
+
+    const PMEFloat baseRedX =
+      baseTLx_home + __SHFL(WARP_MASK, baseTLx_home, phmdRoundPartnerLane);
+    const PMEFloat baseRedY =
+      baseTLy_home + __SHFL(WARP_MASK, baseTLy_home, phmdRoundPartnerLane);
+    const PMEFloat baseRedZ =
+      baseTLz_home + __SHFL(WARP_MASK, baseTLz_home, phmdRoundPartnerLane);
+
+    const PMEFloat oldRedX =
+      oldTLx_home + __SHFL(WARP_MASK, oldTLx_home, phmdRoundPartnerLane);
+    const PMEFloat oldRedY =
+      oldTLy_home + __SHFL(WARP_MASK, oldTLy_home, phmdRoundPartnerLane);
+    const PMEFloat oldRedZ =
+      oldTLz_home + __SHFL(WARP_MASK, oldTLz_home, phmdRoundPartnerLane);
+
+    if ((tgx < PME_PHMD_ORTHO16_ATOMS_PER_WARP) && yValid) {
+      kPMEPHMDAtomicAddForceRaw(
+          &sim.pNBForceXAccumulator[yIndex],
+          kPMEPHMDForceRoundingDelta(oldRedX, baseRedX));
+      kPMEPHMDAtomicAddForceRaw(
+          &sim.pNBForceYAccumulator[yIndex],
+          kPMEPHMDForceRoundingDelta(oldRedY, baseRedY));
+      kPMEPHMDAtomicAddForceRaw(
+          &sim.pNBForceZAccumulator[yIndex],
+          kPMEPHMDForceRoundingDelta(oldRedZ, baseRedZ));
+    }
+  }
+#endif
+      }
+        else {
+                offset += sim.NLAtomsPerWarp;
+        }
+      }
+
+      // -----------------------------------------------------------------------
+      // Remaining x tiles.
+      //
+      // This first validation implementation favors clarity over speed: each
+      // y lane loops over the x swath directly.  This will not perfectly match
+      // old force rounding order, but it should validate the PHMD math.
+      //
+      // This path uses the old non-fswitch PHMD Coulomb derivative form:
+      //
+      //   fnrange * swtch
+      // -----------------------------------------------------------------------
+if (PME_PHMD_DIRECT_DO_X_TILE) {
+  unsigned int tx = 0u;
+
+  const unsigned int LJIDi = LJIDiRaw * sim.LJTypes;
+
+  while (tx < entry.NL.xatoms) {
+    // -----------------------------------------------------------------------
+    // Mirror kNLCPNE.h x-tile traversal:
+    //
+    //   each lane owns one x atom record
+    //   each lane owns one exclusion mask
+    //   lanes rotate through the x atoms using j / jrec shuffles
+    //
+    // This intentionally replaces the earlier simplified y-lane serial loop.
+    // -----------------------------------------------------------------------
+
+    const unsigned int swathOffset = offset;
+    const unsigned int xPHMDMask = sim.pNLAtomListPHMDMask[swathOffset];
+
+    if (!entryYHasPHMD && (xPHMDMask == 0u)) {
+      offset += GRID;
+      offset += sim.NLAtomsPerWarp * sizeof(PMEMask) / sizeof(unsigned int);
+      tx += GRID;
+      continue;
+    }
+
+    const unsigned int shID = sim.pNLAtomList[offset + tgx];
+    offset += GRID;
+
+    PMEMask fullExclusion =
+      ((PMEMask*)&sim.pNLAtomList[offset])[tgx & sim.NLAtomsPerWarpBitsMask];
+
+    offset += sim.NLAtomsPerWarp * sizeof(PMEMask) / sizeof(unsigned int);
+
+    if (PME_PHMD_ORTHO16_ATOMS_PER_WARP < GRID) {
+      fullExclusion >>= joffset;
+    }
+
+    unsigned int exclusion =
+      ((unsigned int)fullExclusion) & sim.NLAtomsPerWarpMask;
+
+    PMEFloat shFx = (PMEFloat)0.0;
+    PMEFloat shFy = (PMEFloat)0.0;
+    PMEFloat shFz = (PMEFloat)0.0;
+
+    PMEFloat baseShFx = (PMEFloat)0.0;
+    PMEFloat baseShFy = (PMEFloat)0.0;
+    PMEFloat baseShFz = (PMEFloat)0.0;
+    PMEFloat oldShFx  = (PMEFloat)0.0;
