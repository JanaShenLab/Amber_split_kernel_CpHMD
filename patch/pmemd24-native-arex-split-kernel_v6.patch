+  std::printf("  home-cell masked:       %llu\n", homeMasked);
+  std::printf("  home-cell with y PHMD:  %llu\n",
+              hCounts[PME_PHMD_DIAG_HOME_Y_ENTRIES]);
+  std::printf("  home-cell masked no y:  %llu\n", homeMaskedNoY);
+  std::printf("  home-tile skip opportunity among masked home entries: %.6f\n",
+              homeSkipFraction);
+
+  std::printf("PME-PHMD atom-density diagnostics over masked entries:\n");
+  std::printf("  masked y atoms:         %llu\n",
+              hCounts[PME_PHMD_DIAG_MASKED_Y_ATOMS]);
+  std::printf("  masked y PHMD atoms:    %llu\n",
