+__global__ void
+kPMEPHMDCompareConsumedAccumulatorSlots_kernel(
+  const PMEAccumulator* __restrict__ referenceDph,
+  const PMEAccumulator* __restrict__ referenceDphPlus,
+  const PMEAccumulator* __restrict__ testDph,
+  const PMEAccumulator* __restrict__ testDphPlus,
+  const int2* __restrict__ presbounds,
+  const int* __restrict__ psp_grp,
+  const unsigned int* __restrict__ pImageAtomLookup,
+  unsigned int thetaCount,
+  int useNeighborList,
+  unsigned long long tolerance,
+  unsigned long long* __restrict__ result)
+{
+  // result[0] = max absolute fixed-point difference
+  // result[1] = count above tolerance
+  // result[2] = count of consumed accumulator reads compared
+
+  for (unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+       pos < thetaCount;
+       pos += blockDim.x * gridDim.x) {
+
+    const int restype = psp_grp[pos];
+    const bool usePlus = !(restype == 0 || restype == 1 || restype == 3);
+
+    const int respos = usePlus ? static_cast<int>(pos) - 1
+                               : static_cast<int>(pos);
+
+    if (respos < 0) {
+      continue;
+    }
+
+    const int lowerbound = presbounds[respos].x - 1;
+    const int upperbound = presbounds[respos].y - 1;
+
+    for (int atmX = lowerbound; atmX <= upperbound; atmX++) {
+      const unsigned int accIndex = useNeighborList ?
+                                    pImageAtomLookup[atmX] :
+                                    static_cast<unsigned int>(atmX);
+
+      const PMEAccumulator reference =
+        usePlus ? referenceDphPlus[accIndex] : referenceDph[accIndex];
+
+      const PMEAccumulator test =
+        usePlus ? testDphPlus[accIndex] : testDph[accIndex];
+
+      const unsigned long long refRaw =
+        static_cast<unsigned long long>(reference);
+      const unsigned long long testRaw =
+        static_cast<unsigned long long>(test);
+
+      const unsigned long long adiff =
+        kPMEPHMDAbsAccumulatorDiff(reference, test);
+
+      atomicMax(&result[0], adiff);
+      atomicAdd(&result[2], 1ull);
+
+      if (adiff > tolerance) {
+        const unsigned long long slot = atomicAdd(&result[1], 1ull);
+
+        if (slot < 16ull) {
+          union {
+            unsigned long long u;
+            long long s;
+          } refConv, testConv;
+
+          refConv.u = refRaw;
+          testConv.u = testRaw;
+
+          printf("PME-PHMD consumed-accumulator mismatch sample: "
+                 "theta=%u restype=%d usePlus=%d atmX=%d accIndex=%u "
+                 "refRaw=%llu testRaw=%llu refSigned=%lld testSigned=%lld "
+                 "adiff=%llu\n",
+                 pos,
+                 restype,
+                 usePlus ? 1 : 0,
+                 atmX,
+                 accIndex,
+                 refRaw,
+                 testRaw,
+                 refConv.s,
+                 testConv.s,
+                 adiff);
+        }
+      }
+    }
+  }
+}
