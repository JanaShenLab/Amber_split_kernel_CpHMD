+__global__ void
+kPMEPHMDCompareUnsignedLongLongBuffers_kernel(
+  const unsigned long long int* __restrict__ reference,
+  const unsigned long long int* __restrict__ test,
+  unsigned int count,
+  unsigned long long tolerance,
+  unsigned long long* __restrict__ result,
+  int compareId)
+{
+  // result[0] = max absolute difference
+  // result[1] = count above tolerance
+  for (unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+       pos < count;
+       pos += blockDim.x * gridDim.x) {
+
+    const unsigned long long refRaw = reference[pos];
+    const unsigned long long testRaw = test[pos];
+    const unsigned long long adiff = kPMEPHMDAbsULLDiff(refRaw, testRaw);
+
+    atomicMax(&result[0], adiff);
+
+    if (adiff > tolerance) {
+      const unsigned long long slot = atomicAdd(&result[1], 1ull);
+
+      if (slot < 16ull) {
+        union {
+          unsigned long long u;
+          long long s;
+        } refConv, testConv;
+
+        refConv.u = refRaw;
+        testConv.u = testRaw;
+
+        printf("PME-PHMD unsigned-long-long compare mismatch sample: "
+               "compareId=%d pos=%u refRaw=%llu testRaw=%llu "
+               "refSigned=%lld testSigned=%lld adiff=%llu\n",
+               compareId,
+               pos,
+               refRaw,
+               testRaw,
+               refConv.s,
+               testConv.s,
+               adiff);
+      }
+    }
+  }
+}
