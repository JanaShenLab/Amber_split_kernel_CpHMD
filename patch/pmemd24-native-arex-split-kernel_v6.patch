+__global__ void
+kPMEPHMDCompareForceAccumulatorDeltasDecoded_kernel(
+    const PMEAccumulator* __restrict__ referenceFinal,
+    const PMEAccumulator* __restrict__ referenceBase,
+    const PMEAccumulator* __restrict__ testFinal,
+    const PMEAccumulator* __restrict__ testBase,
+    const int* __restrict__ pImageGrplist,
+    const int* __restrict__ pImageIndexPHMD,
+    unsigned int count,
+    unsigned int paddedNumberOfAtoms,
+    unsigned long long tolerance,
+    unsigned long long* __restrict__ result,
+    int compareId)
+{
+  for (unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+       pos < count;
+       pos += blockDim.x * gridDim.x) {
+
+    const unsigned long long refFinalRaw =
+      static_cast<unsigned long long>(referenceFinal[pos]);
+    const unsigned long long refBaseRaw =
+      static_cast<unsigned long long>(referenceBase[pos]);
+    const unsigned long long testFinalRaw =
+      static_cast<unsigned long long>(testFinal[pos]);
+    const unsigned long long testBaseRaw =
+      static_cast<unsigned long long>(testBase[pos]);
+
+    const unsigned long long refDeltaRaw = refFinalRaw - refBaseRaw;
+    const unsigned long long testDeltaRaw = testFinalRaw - testBaseRaw;
+    const unsigned long long diffRaw = testDeltaRaw - refDeltaRaw;
+
+    unsigned long long adiff;
+    if (diffRaw & 0x8000000000000000ull) {
+      adiff = (~diffRaw) + 1ull;
+    }
+    else {
+      adiff = diffRaw;
+    }
+
+    atomicMax(&result[0], adiff);
+
+    if (adiff > tolerance) {
+      const unsigned long long slot = atomicAdd(&result[1], 1ull);
+
+      if (slot < 32ull) {
+        unsigned int component = 0u;
+        unsigned int atom = pos;
+
+        if (pos >= 2u * paddedNumberOfAtoms) {
+          component = 2u;
+          atom = pos - 2u * paddedNumberOfAtoms;
+        }
+        else if (pos >= paddedNumberOfAtoms) {
+          component = 1u;
+          atom = pos - paddedNumberOfAtoms;
+        }
+
+        int grpRaw = -9999;
+        int grp = -9999;
+        int imageIndexPHMD = -1;
+
+        if (atom < paddedNumberOfAtoms && pImageGrplist != nullptr) {
+          grpRaw = pImageGrplist[atom];
+          grp = grpRaw - 1;
+
+          if (grp >= 0 && pImageIndexPHMD != nullptr) {
+            imageIndexPHMD = pImageIndexPHMD[atom];
+          }
+        }
+
+        union { unsigned long long u; long long s; } refDelta, testDelta;
+        refDelta.u = refDeltaRaw;
+        testDelta.u = testDeltaRaw;
+
+        printf("PME-PHMD force-delta decoded mismatch sample: "
+               "compareId=%d pos=%u comp=%u atom=%u grpRaw=%d grp=%d imageIndexPHMD=%d "
+               "refDeltaRaw=%llu testDeltaRaw=%llu "
+               "refDeltaSigned=%lld testDeltaSigned=%lld adiff=%llu\n",
+               compareId,
+               pos,
+               component,
+               atom,
+               grpRaw,
+               grp,
+               imageIndexPHMD,
+               refDeltaRaw,
+               testDeltaRaw,
+               refDelta.s,
+               testDelta.s,
+               adiff);
+      }
+    }
+  }
+}
