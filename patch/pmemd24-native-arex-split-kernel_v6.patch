+template <bool DoVirial, bool IsOrthog>
+static __device__ __forceinline__
+void kPMEPHMDApplyCellOffsetAndTransform(PMEFloat& x,
+                                          PMEFloat& y,
+                                          PMEFloat& z,
+                                          const int cell,
+                                          const kPMEPHMDDirectConst& sim)
+{
+  if (IsOrthog) {
+    if (DoVirial) {
+      const PMEFloat* ucellf = sim.pNTPData->ucellf;
+      x += ucellf[0] * sim.cellOffset[cell][0];
+      y += ucellf[4] * sim.cellOffset[cell][1];
+      z += ucellf[8] * sim.cellOffset[cell][2];
+    }
+    else {
+      x += sim.cellOffset[cell][0];
+      y += sim.cellOffset[cell][1];
+      z += sim.cellOffset[cell][2];
+    }
+  }
+  else {
+    x += sim.cellOffset[cell][0];
+    y += sim.cellOffset[cell][1];
+    z += sim.cellOffset[cell][2];
+
+    const PMEFloat ox = x;
+    const PMEFloat oy = y;
+    const PMEFloat oz = z;
+
+    if (DoVirial) {
+      const PMEFloat* ucellf = sim.pNTPData->ucellf;
+      x = ucellf[0] * ox + ucellf[1] * oy + ucellf[2] * oz;
+      y =                 ucellf[4] * oy + ucellf[5] * oz;
+      z =                                 ucellf[8] * oz;
+    }
+    else {
+      x = sim.ucellf[0] * ox + sim.ucellf[1] * oy + sim.ucellf[2] * oz;
+      y =                   sim.ucellf[4] * oy + sim.ucellf[5] * oz;
+      z =                                       sim.ucellf[8] * oz;
+    }
+  }
+}
