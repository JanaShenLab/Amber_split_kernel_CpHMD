+subroutine arex_pay_phrex_apply_slot_retarget(slot_id, ierr, message)
+#ifdef CUDA
+  interface
+    subroutine gpu_upload_charges_pme_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_pme_cph
+
+    subroutine gpu_upload_charges_gb_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_gb_cph
+  end interface
+#endif
+
+  integer, intent(in) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_apply_slot_retarget: payload not initialized')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_apply_slot_retarget: invalid slot_id')
+    return
+  end if
+
+  solvph = phrex_slot_ladder(slot_id)
+  call reset_park()
+
+  call arex_pay_phrex_refresh_live_charges(ierr, message)
+  if (ierr /= ARM_OK) return
+
+#ifdef CUDA
+  if (iphmd == 3) then
+    call gpu_upload_charges_pme_cph(atm_qterm)
+  else
+    call gpu_upload_charges_gb_cph(atm_qterm)
+  end if
+#endif
+end subroutine arex_pay_phrex_apply_slot_retarget
+
+subroutine arex_pay_phrex_sync_assigned_replica(replica_id, slot_id, sync_mode, &
+                                                ierr, message)
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_capture(ph_theta_out, dph_theta_out, vtheta_out, &
+                                  dphold_out, vphold_out, random_counter_out, &
+                                  random_out)
+      import dp
+      real(dp), intent(out) :: ph_theta_out(*)
+      real(dp), intent(out) :: dph_theta_out(*)
+      real(dp), intent(out) :: vtheta_out(*)
+      real(dp), intent(out) :: dphold_out(*)
+      real(dp), intent(out) :: vphold_out(*)
+      integer, intent(out) :: random_counter_out
+      real(dp), intent(out) :: random_out(*)
+    end subroutine gpu_pharex_capture
+
+    subroutine gpu_pharex_restore(ph_theta_in, dph_theta_in, vph_theta_in, &
+                                  dphold_in, vphold_in, charge_phmd_in,    &
+                                  random_counter_in, random_in)
+      import dp
+      real(dp), intent(in) :: ph_theta_in(*)
+      real(dp), intent(in) :: dph_theta_in(*)
+      real(dp), intent(in) :: vph_theta_in(*)
+      real(dp), intent(in) :: dphold_in(*)
+      real(dp), intent(in) :: vphold_in(*)
+      real(dp), intent(in) :: charge_phmd_in(*)
+      integer, intent(in) :: random_counter_in
+      real(dp), intent(in) :: random_in(*)
+    end subroutine gpu_pharex_restore
+  end interface
+#endif
+
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: sync_mode
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: valid_i
+  integer :: iupdate_buf
+  integer :: root_ierr
+  character(len=256) :: root_message
+
+  real(dp), allocatable :: theta_buf(:)
+  real(dp), allocatable :: dtheta_buf(:)
+  real(dp), allocatable :: vtheta_buf(:)
+  real(dp), allocatable :: dphold_buf(:)
+  real(dp), allocatable :: vphold_buf(:)
+
+#ifdef CUDA
+  integer :: random_counter_buf
+  real(dp), allocatable :: random_buf(:)
+#endif
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+#ifndef MPI
+  call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arex_pay_phrex_sync_assigned_replica: requires MPI')
+  return
+#else
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_sync_assigned_replica: payload not initialized')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_sync_assigned_replica: invalid replica_id')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_sync_assigned_replica: invalid slot_id')
+    return
+  end if
+
+  select case (sync_mode)
+  case (AREX_PHREX_SYNC_NOOP)
+    if (arex_emulate_restart == 1) then
+      call arex_pay_phrex_emulate_restart_boundary(replica_id, slot_id, ierr, message)
+    end if
+    return
+
+  case (AREX_PHREX_SYNC_SLOT_ONLY)
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0,a,l1,a,i0,a,i0)') &
+           'AREX DBG PHREX SLOT_ONLY begin: replica ', replica_id, &
+           ', slot ', slot_id, ', charge_phmd_alloc=', allocated(charge_phmd), &
+           ', natom=', natom, ', ntitr=', ntitr
+      call flush(0)
+    end if
+#endif
+#endif
+
+    if (arex_emulate_restart == 1) then
+#ifdef CUDA
+      ! Capture current resident device theta/vtheta before discarding
+      ! restart-nonpersistent PHMD history.
+      allocate(theta_buf(phrex_ntheta),   &
+               dtheta_buf(phrex_ntheta),  &
+               vtheta_buf(phrex_ntheta),  &
+               dphold_buf(phrex_ntheta),  &
+               vphold_buf(phrex_ntheta))
+      allocate(random_buf(phrex_random_buffer_size))
+
+      theta_buf(:)  = 0.0_dp
+      dtheta_buf(:) = 0.0_dp
+      vtheta_buf(:) = 0.0_dp
+      dphold_buf(:) = 0.0_dp
+      vphold_buf(:) = 0.0_dp
+      random_counter_buf = 0
+      random_buf(:) = 0.0_dp
+
+      call gpu_pharex_capture(theta_buf, dtheta_buf, vtheta_buf, &
+                              dphold_buf, vphold_buf, &
+                              random_counter_buf, random_buf)
+
+      phrex_theta(:, replica_id)  = 0.0_dp
+      phrex_vtheta(:, replica_id) = 0.0_dp
+      phrex_theta(1:ntitr, replica_id)  = theta_buf(1:ntitr)
+      phrex_vtheta(1:ntitr, replica_id) = vtheta_buf(1:ntitr)
+      phrex_replica_valid(replica_id) = .true.
+
+      deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+      deallocate(random_buf)
+#else
+      phrex_theta(:, replica_id)  = 0.0_dp
+      phrex_vtheta(:, replica_id) = 0.0_dp
+      phrex_theta(1:ntitr, replica_id)  = ph_theta(1:ntitr)
+      phrex_vtheta(1:ntitr, replica_id) = vph_theta(1:ntitr)
+      phrex_replica_valid(replica_id) = .true.
+#endif
+
+      call arex_pay_phrex_emulate_restart_boundary(replica_id, slot_id, ierr, message)
+
+#ifdef AREX_DEBUG
+#ifdef MPI
+      if (ierr /= ARM_OK .and. mytaskid == 0) then
+        write(0,'(a,a)') 'AREX DBG PHREX SLOT_ONLY emulate restart error: ', &
+             trim(message)
+        call flush(0)
+      end if
+#endif
+#endif
+      return
+    end if
+
+#ifdef CUDA
+    ! In CUDA mode, the current PHREX theta state lives on the device after a
+    ! segment.  SLOT_ONLY keeps the same replica on the same worker but changes
+    ! the slot pH, so refresh_live_charges() must see the current device theta,
+    ! not stale host ph_theta.
+    allocate(theta_buf(phrex_ntheta),   &
+             dtheta_buf(phrex_ntheta),  &
+             vtheta_buf(phrex_ntheta),  &
+             dphold_buf(phrex_ntheta),  &
+             vphold_buf(phrex_ntheta))
+    allocate(random_buf(phrex_random_buffer_size))
+
+    theta_buf(:)  = 0.0_dp
+    dtheta_buf(:) = 0.0_dp
+    vtheta_buf(:) = 0.0_dp
+    dphold_buf(:) = 0.0_dp
+    vphold_buf(:) = 0.0_dp
+    random_counter_buf = 0
+    random_buf(:) = 0.0_dp
+
+    call gpu_pharex_capture(theta_buf, dtheta_buf, vtheta_buf, &
+                            dphold_buf, vphold_buf, &
+                            random_counter_buf, random_buf)
+
+    ph_theta(:)  = 0.0_dp
+    dph_theta(:) = 0.0_dp
+    vph_theta(:) = 0.0_dp
+    dphold(:)    = 0.0_dp
+    vphold(:)    = 0.0_dp
+
+    ph_theta(1:ntitr)  = theta_buf(1:ntitr)
+    dph_theta(1:ntitr) = dtheta_buf(1:ntitr)
+    vph_theta(1:ntitr) = vtheta_buf(1:ntitr)
+    dphold(1:ntitr)    = dphold_buf(1:ntitr)
+    vphold(1:ntitr)    = vphold_buf(1:ntitr)
+
+    deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+    deallocate(random_buf)
+
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0,a,f8.4,a,f8.4)') &
+           'AREX DBG PHREX SLOT_ONLY captured live CUDA theta: replica ', &
+           replica_id, ', slot ', slot_id, &
+           ', theta1=', ph_theta(1), ', lambda1=', sin(ph_theta(1))**2
+      call flush(0)
+    end if
+#endif
+#endif
+#endif
+
+    call arex_pay_phrex_apply_slot_retarget(slot_id, ierr, message)
+
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (ierr /= ARM_OK .and. mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG PHREX SLOT_ONLY error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+#endif
+    return
+
+  case default
+    continue
+  end select
+#ifdef AREX_DEBUG
+#ifdef MPI
+  if (mytaskid == 0) then
+    write(0,'(a,i0,a,i0,a,i0,a,l1,a,i0,a,i0)') &
+         'AREX DBG PHREX FULL begin: replica ', replica_id, &
+         ', slot ', slot_id, ', sync=', sync_mode, &
+         ', valid=', phrex_replica_valid(replica_id), &
+         ', natom=', natom, ', ntitr=', ntitr
+    call flush(0)
+  end if
+#endif
+#endif
+  allocate(theta_buf(phrex_ntheta),   &
+           dtheta_buf(phrex_ntheta),  &
+           vtheta_buf(phrex_ntheta),  &
+           dphold_buf(phrex_ntheta),  &
+           vphold_buf(phrex_ntheta))
+
+#ifdef CUDA
+  allocate(random_buf(phrex_random_buffer_size))
+#endif
+
+  theta_buf(:)  = 0.0_dp
+  dtheta_buf(:) = 0.0_dp
+  vtheta_buf(:) = 0.0_dp
+  dphold_buf(:) = 0.0_dp
+  vphold_buf(:) = 0.0_dp
+  iupdate_buf   = 0
+  valid_i       = 0
+  root_ierr     = ARM_OK
+  root_message  = ''
+
+#ifdef CUDA
+  random_counter_buf = 0
+  random_buf(:) = 0.0_dp
+#endif
+
+  if (mytaskid == 0) then
+    if (phrex_replica_valid(replica_id)) then
+      valid_i = 1
+      theta_buf(:)  = phrex_theta(:, replica_id)
+      dtheta_buf(:) = phrex_dtheta(:, replica_id)
+      vtheta_buf(:) = phrex_vtheta(:, replica_id)
+      dphold_buf(:) = phrex_dphold(:, replica_id)
+      vphold_buf(:) = phrex_vphold(:, replica_id)
+      iupdate_buf   = phrex_iupdate(replica_id)
+#ifdef CUDA
+      random_counter_buf = phrex_random_counter(replica_id)
+      random_buf(:)      = phrex_random(:, replica_id)
+#endif
+    end if
+  end if
+
+  call mpi_bcast(root_ierr, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(root_message, len(root_message), mpi_character, 0, &
+                 pmemd_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+#ifdef CUDA
+    deallocate(random_buf)
+#endif
+    return
+  end if
+
+  call mpi_bcast(valid_i, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+
+  ! Even if the authoritative PHREX state is not valid yet, the worker must
+  ! still be retargeted to the assigned slot pH before running the segment.
+  if (valid_i == 0) then
+    call arex_pay_phrex_apply_slot_retarget(slot_id, ierr, message)
+    if (ierr /= ARM_OK) then
+#ifdef AREX_DEBUG
+#ifdef MPI
+      if (mytaskid == 0) then
+        write(0,'(a,i0,a,i0,a,a)') &
+             'AREX DBG PHREX FULL invalid-state retarget failed: replica ', &
+             replica_id, ', slot ', slot_id, ', msg=', trim(message)
+        call flush(0)
+      end if
+#endif
+#endif
+      deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+#ifdef CUDA
+      deallocate(random_buf)
+#endif
+      return
+    end if
+
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0)') &
+           'AREX DBG PHREX FULL invalid-state retarget ok: replica ', &
+           replica_id, ', slot ', slot_id
+      call flush(0)
+    end if
+#endif
+#endif
+  end if
+
+  if (valid_i /= 0) then
+    call mpi_bcast(theta_buf, phrex_ntheta, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(dtheta_buf, phrex_ntheta, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(vtheta_buf, phrex_ntheta, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(dphold_buf, phrex_ntheta, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(vphold_buf, phrex_ntheta, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(iupdate_buf, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+#ifdef CUDA
+    call mpi_bcast(random_counter_buf, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+    call mpi_bcast(random_buf, phrex_random_buffer_size, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+#endif
+
+    if (arex_emulate_restart == 1) then
+      dtheta_buf(:) = 0.0_dp
+      dphold_buf(:) = 0.0_dp
+      vphold_buf(:) = vtheta_buf(:)
+      iupdate_buf   = 0
+      qsetlam       = .false.
+      phkin         = 0.0_dp
+#ifdef CUDA
+      random_counter_buf = 0
+      random_buf(:) = 0.0_dp
+#endif
+    end if
+
+    ph_theta(:)  = 0.0_dp
+    dph_theta(:) = 0.0_dp
+    vph_theta(:) = 0.0_dp
+    dphold(:)    = 0.0_dp
+    vphold(:)    = 0.0_dp
+
+    ph_theta(1:ntitr)  = theta_buf(1:ntitr)
+    dph_theta(1:ntitr) = dtheta_buf(1:ntitr)
+    vph_theta(1:ntitr) = vtheta_buf(1:ntitr)
+    dphold(1:ntitr)    = dphold_buf(1:ntitr)
+    vphold(1:ntitr)    = vphold_buf(1:ntitr)
+    iupdate            = iupdate_buf
+
+    call arex_pay_phrex_apply_slot_retarget(slot_id, ierr, message)
+    if (ierr /= ARM_OK) then
+#ifdef AREX_DEBUG
+#ifdef MPI
+      if (mytaskid == 0) then
+        write(0,'(a,i0,a,i0,a,a)') &
+             'AREX DBG PHREX FULL retarget failed: replica ', replica_id, &
+             ', slot ', slot_id, ', msg=', trim(message)
+        call flush(0)
+      end if
+#endif
+#endif
+      deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+#ifdef CUDA
+      deallocate(random_buf)
+#endif
+      return
+    end if
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0)') &
+           'AREX DBG PHREX FULL retarget ok: replica ', replica_id, &
+           ', slot ', slot_id
+      call flush(0)
+    end if
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0,a)') &
+           'AREX DBG PHREX FULL before gpu_pharex_restore: replica ', replica_id, &
+           ', slot ', slot_id, ', entering CUDA restore'
+      call flush(0)
+    end if
+!   if (mytaskid == 0) then
+!     write(0,'(a,i0,a,i0,a,f12.6,a,f12.6,a,f12.6,a,f12.6,a,f12.6)') &
+!          'AREX DBG PHREX FULL zero-history diagnostic BEFORE: replica ', replica_id, &
+!          ', slot ', slot_id, &
+!          ', theta1 ', theta_buf(1), &
+!          ', lambda1 ', sin(theta_buf(1))**2, &
+!          ', dtheta1 ', dtheta_buf(1), &
+!          ', vtheta1 ', vtheta_buf(1), &
+!          ', dphold1 ', dphold_buf(1)
+!     call flush(0)
+!   end if
+!   !
+!   ! AREX/PHREX DIAGNOSTIC ONLY:
+!   ! Preserve restored theta/lambda but remove PHMD continuation momentum/history
+!   ! before FULL CUDA restore.  If this prevents the production-start lambda
+!   ! kick, the bug is in restored PHMD history/momentum, not pH/park/files.
+!   !
+!   dtheta_buf(:) = 0.0_dp
+!   vtheta_buf(:) = 0.0_dp
+!   dphold_buf(:) = 0.0_dp
+!   vphold_buf(:) = 0.0_dp
+!
+!     if (mytaskid == 0) then
+!       write(0,'(a,i0,a,i0,a,f12.6,a,f12.6,a,f12.6,a,f12.6,a,f12.6)') &
+!            'AREX DBG PHREX FULL zero-history diagnostic AFTER: replica ', replica_id, &
+!            ', slot ', slot_id, &
+!            ', theta1 ', theta_buf(1), &
+!            ', lambda1 ', sin(theta_buf(1))**2, &
+!            ', dtheta1 ', dtheta_buf(1), &
+!            ', vtheta1 ', vtheta_buf(1), &
+!            ', dphold1 ', dphold_buf(1)
+!       call flush(0)
+!     end if
+#endif
+#endif
+#ifdef CUDA
+    call gpu_pharex_restore(theta_buf, dtheta_buf, vtheta_buf, &
+                            dphold_buf, vphold_buf, charge_phmd, &
+                            random_counter_buf, random_buf)
+#endif
+#ifdef AREX_DEBUG
+#ifdef MPI
+      if (mytaskid == 0) then
+        write(0,'(a,i0,a,i0)') &
+             'AREX DBG PHREX FULL after gpu_pharex_restore: replica ', replica_id, &
+             ', slot ', slot_id
+        call flush(0)
+      end if
+#endif
+#endif
+
+  !
+  ! AREX/PHREX: after FULL CUDA restore, mirror the restored PHMD
+  ! payload back into the live host PHMD arrays before rebuilding
+  ! host/live charges.  refresh_live_charges() reads ph_theta(), not
+  ! theta_buf().
+  !
+  ph_theta(1:ntitr)  = theta_buf(1:ntitr)
+  dph_theta(1:ntitr) = dtheta_buf(1:ntitr)
+  vph_theta(1:ntitr) = vtheta_buf(1:ntitr)
+
+  call arex_pay_phrex_refresh_live_charges(ierr, message)
+  if (ierr /= ARM_OK) return
+
+#ifdef CUDA
+  if (iphmd == 3) then
+    call gpu_upload_charges_pme_cph(atm_qterm)
+  else
+    call gpu_upload_charges_gb_cph(atm_qterm)
+  end if
+#endif
+
+#ifdef AREX_DEBUG
+#ifdef MPI
+  if (mytaskid == 0) then
+    write(0,'(a,i0,a,i0,a,f12.6,a,f12.6)') &
+         'AREX DBG PHREX FULL after host theta sync + refresh/upload live charges: replica ', &
+         replica_id, ', slot ', slot_id, &
+         ', theta1 ', ph_theta(1), &
+         ', lambda1 ', sin(ph_theta(1))**2
+    call flush(0)
+  end if
+#endif
+#endif
+  end if
+
+  deallocate(theta_buf, dtheta_buf, vtheta_buf, dphold_buf, vphold_buf)
+#ifdef CUDA
+  deallocate(random_buf)
+#endif
+#endif
+end subroutine arex_pay_phrex_sync_assigned_replica
+
+subroutine arex_pay_phrex_refresh_live_charges(ierr, message)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i, j
+  real(dp) :: x1, x2, qprot, qunprot
+  character(len=256) :: debug_message
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. allocated(charge_phmd)) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_refresh_live_charges: charge_phmd is not allocated')
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG refresh_live_charges error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+#endif
+    return
+  end if
+
+  if (natom <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_refresh_live_charges: natom must be > 0')
+#ifdef AREX_DEBUG
+#ifdef MPI
+    if (mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG refresh_live_charges error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+#endif
+    return
+  end if
+
+  do i = 1, natom
+    j = grplist(i)
+    if (j /= 0) then
+      if (j < 1 .or. j > ntitr) then
+        write(debug_message,'(a,i0,a,i0,a,i0)') &
+             'arex_pay_phrex_refresh_live_charges: grplist index out of range at atom ', &
+             i, ', j=', j, ', ntitr=', ntitr
+        call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, trim(debug_message))
+#ifdef AREX_DEBUG
+#ifdef MPI
+        if (mytaskid == 0) then
+          write(0,'(a,a)') 'AREX DBG refresh_live_charges error: ', trim(debug_message)
+          call flush(0)
+        end if
+#endif
+#endif
+        return
+      end if
+
+      x1 = sin(ph_theta(j))**2
+      if (sp_grp(j) <= 0) then
+        x2 = 1.0_dp
+      else
+        if (j + 1 > ntitr) then
+          write(debug_message,'(a,i0,a,i0,a,i0)') &
+               'arex_pay_phrex_refresh_live_charges: paired grplist index out of range at atom ', &
+               i, ', j+1=', j+1, ', ntitr=', ntitr
+          call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, trim(debug_message))
+#ifdef AREX_DEBUG
+#ifdef MPI
+          if (mytaskid == 0) then
+            write(0,'(a,a)') 'AREX DBG refresh_live_charges error: ', trim(debug_message)
+            call flush(0)
+          end if
+#endif
+#endif
+          return
+        end if
+        x2 = sin(ph_theta(j+1))**2
+      end if
+
+      qprot   = x2*qstate1(1,i)    + (1.0_dp-x2)*qstate1(2,i)
+      qunprot = x2*qstate2(1,i)    + (1.0_dp-x2)*qstate2(2,i)
+      charge_phmd(i) = (1.0_dp-x1)*qprot + x1*qunprot
+
+      qprot   = x2*qstate1_md(1,i) + (1.0_dp-x2)*qstate1_md(2,i)
+      qunprot = x2*qstate2_md(1,i) + (1.0_dp-x2)*qstate2_md(2,i)
+      atm_qterm(i) = (1.0_dp-x1)*qprot + x1*qunprot
+    end if
+
+    j = linkgrplist(i)
+    if (j /= 0) then
+      if (j < 1 .or. j > ntitr) then
+        write(debug_message,'(a,i0,a,i0,a,i0)') &
+             'arex_pay_phrex_refresh_live_charges: linkgrplist index out of range at atom ', &
+             i, ', j=', j, ', ntitr=', ntitr
+        call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, trim(debug_message))
+#ifdef AREX_DEBUG
+#ifdef MPI
+        if (mytaskid == 0) then
+          write(0,'(a,a)') 'AREX DBG refresh_live_charges error: ', trim(debug_message)
+          call flush(0)
+        end if
+#endif
+#endif
+        return
+      end if
+
+      x1 = sin(ph_theta(j))**2
+      charge_phmd(i) = x1*qstate1(1,i)    + (1.0_dp-x1)*qstate2(1,i)
+      atm_qterm(i)   = x1*qstate1_md(1,i) + (1.0_dp-x1)*qstate2_md(1,i)
+    end if
+  end do
+end subroutine arex_pay_phrex_refresh_live_charges
