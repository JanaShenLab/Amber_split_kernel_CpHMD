+        form='FORMATTED')
+   write(phmd_unit, nml=phmdrestrt)
+   close(phmd_unit)
+
+   if (phmd_output_open) then
+      ! Restart writing uses file units; force output rebinding afterward.
+      close(phmdout_unit)
+      phmd_output_open = .false.
+      phmd_output_slot = 0
+   end if
+
