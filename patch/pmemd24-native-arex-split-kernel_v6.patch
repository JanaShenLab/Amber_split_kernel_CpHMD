+__device__ __forceinline__ PMEDouble2
+kUpdateOnePHMDNLChargeAndGetSum(const int atom)
+{
+  PMEDouble2 result;
+  result.x = 0.0;
+  result.y = 0.0;
+
+  const int h = cSim.pgrplist[atom] - 1;
+  const int k = cSim.plinkgrplist[atom] - 1;
+
+  PMEFloat charge = (PMEFloat)0.0;
+
+  if (h >= 0) {
+    PMEFloat x1 = sin(cSim.pph_theta[h]);
+    PMEFloat x2 = (PMEFloat)1.0;
+
+    if (cSim.psp_grp[h] > 0) {
+      x2 = sin(cSim.pph_theta[h + 1]);
+      x2 *= x2;
+    }
+
+    x1 *= x1;
+
+    const PMEFloat qprot =
+      x2 * cSim.pqstate1[atom].x + ((PMEFloat)1.0 - x2) * cSim.pqstate1[atom].y;
+    const PMEFloat qunprot =
+      x2 * cSim.pqstate2[atom].x + ((PMEFloat)1.0 - x2) * cSim.pqstate2[atom].y;
+
+    charge = ((PMEFloat)1.0 - x1) * qprot + x1 * qunprot;
+  }
+  else if (k >= 0) {
+    PMEFloat x1 = sin(cSim.pph_theta[k]);
+    x1 *= x1;
+
+    charge =
+      x1 * cSim.pqstate1[atom].x + ((PMEFloat)1.0 - x1) * cSim.pqstate2[atom].x;
+  }
+  else {
+    // This should not happen for atoms in pPHMDChargeAtoms, but keep a safe fallback.
+    const int atmx = cSim.pImageAtomLookup[atom];
+    charge = cSim.pAtomChargeSP[atmx];
+  }
+
+  const int atmx = cSim.pImageAtomLookup[atom];
+
+  cSim.pcharge_phmd[atom] = charge;
+  cSim.pImageCharge_phmd[atmx] = charge;
+  cSim.pAtomChargeSPLJID[atmx].x = charge;
+  cSim.pAtomCharge[atmx] = charge;
+  cSim.pAtomChargeSP[atmx] = charge;
+  cSim.pImageCharge[atmx] = charge;
+
+  const PMEDouble q = (PMEDouble)charge;
+  result.x = q;
+  result.y = q * q;
+
+  return result;
+}
