+    gpu->sim.presbounds,
+    gpu->sim.psp_grp,
+    gpu->sim.pImageAtomLookup,
+    thetaCount,
+    useNeighborList
+  );
+
+  LAUNCHERROR("kPMEPHMDReduceThetaFromAccumulators_kernel reference launch");
+
+  status = cudaDeviceSynchronize();
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareReducedTheta: reference reduction failed for %s: %s\n",
+                 label,
+                 cudaGetErrorString(status));
+    cudaFree(dThetaReference);
+    cudaFree(dThetaTest);
+    std::free(hThetaReference);
+    std::free(hThetaTest);
+    std::abort();
+  }
+
+  kPMEPHMDReduceThetaFromAccumulators_kernel<<<blocks, threads>>>(
+    testDph,
+    testDphPlus,
+    dThetaTest,
+    gpu->sim.presbounds,
+    gpu->sim.psp_grp,
+    gpu->sim.pImageAtomLookup,
+    thetaCount,
+    useNeighborList
+  );
+
+  LAUNCHERROR("kPMEPHMDReduceThetaFromAccumulators_kernel test launch");
+
+  status = cudaDeviceSynchronize();
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareReducedTheta: test reduction failed for %s: %s\n",
+                 label,
+                 cudaGetErrorString(status));
+    cudaFree(dThetaReference);
+    cudaFree(dThetaTest);
+    std::free(hThetaReference);
+    std::free(hThetaTest);
+    std::abort();
+  }
+
+  status = cudaMemcpy(hThetaReference,
+                      dThetaReference,
+                      thetaBytes,
+                      cudaMemcpyDeviceToHost);
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareReducedTheta: cudaMemcpy reference failed for %s: %s\n",
+                 label,
+                 cudaGetErrorString(status));
+    cudaFree(dThetaReference);
+    cudaFree(dThetaTest);
+    std::free(hThetaReference);
+    std::free(hThetaTest);
+    std::abort();
+  }
+
+  status = cudaMemcpy(hThetaTest,
+                      dThetaTest,
+                      thetaBytes,
+                      cudaMemcpyDeviceToHost);
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareReducedTheta: cudaMemcpy test failed for %s: %s\n",
+                 label,
+                 cudaGetErrorString(status));
+    cudaFree(dThetaReference);
+    cudaFree(dThetaTest);
+    std::free(hThetaReference);
+    std::free(hThetaTest);
+    std::abort();
+  }
+
+  double maxAbsDiff = 0.0;
+  unsigned long long countAboveTolerance = 0ull;
+  unsigned int samplesPrinted = 0u;
+
+  for (unsigned int pos = 0; pos < thetaCount; pos++) {
+    const double ref = static_cast<double>(hThetaReference[pos]);
+    const double tst = static_cast<double>(hThetaTest[pos]);
+    const double adiff = std::fabs(tst - ref);
+
+    if (adiff > maxAbsDiff) {
+      maxAbsDiff = adiff;
+    }
+
+    if (adiff > tolerance) {
+      countAboveTolerance++;
+
+      if (samplesPrinted < 16u) {
+        std::printf("PME-PHMD reduced-theta mismatch sample: "
+                    "pos=%u ref=% .9e test=% .9e adiff=% .9e\n",
+                    pos,
+                    ref,
+                    tst,
+                    adiff);
+        samplesPrinted++;
+      }
+    }
+  }
+
+  std::printf("PME-PHMD direct compare: %s\n", label);
+  std::printf("  count:                 %u\n", thetaCount);
+  std::printf("  tolerance:             %.9e theta units\n", tolerance);
+  std::printf("  max abs difference:    %.9e theta units\n", maxAbsDiff);
+  std::printf("  count above tolerance: %llu\n", countAboveTolerance);
+  std::fflush(stdout);
+
+  cudaFree(dThetaReference);
+  cudaFree(dThetaTest);
+  std::free(hThetaReference);
+  std::free(hThetaTest);
+}
