+                   (long long)kPMEPHMDForceFloatToAccumulator(shFy),
+                   (long long)kPMEPHMDForceFloatToAccumulator(shFz));
+          }
+        }
+#endif
+if (PME_PHMD_ROUNDING_AWARE_FORCE &&
+    DoEnergy && !DoVirial && !DoFswitch) {
+  kPMEPHMDAtomicAddForceRaw(
+      &sim.pNBForceXAccumulator[shIndex],
+      kPMEPHMDForceRoundingDelta(oldShFx, baseShFx));
+  kPMEPHMDAtomicAddForceRaw(
+      &sim.pNBForceYAccumulator[shIndex],
+      kPMEPHMDForceRoundingDelta(oldShFy, baseShFy));
+  kPMEPHMDAtomicAddForceRaw(
+      &sim.pNBForceZAccumulator[shIndex],
+      kPMEPHMDForceRoundingDelta(oldShFz, baseShFz));
+}
+else {
+  kPMEPHMDAtomicAddForce(&sim.pNBForceXAccumulator[shIndex], shFx);
+  kPMEPHMDAtomicAddForce(&sim.pNBForceYAccumulator[shIndex], shFy);
+  kPMEPHMDAtomicAddForce(&sim.pNBForceZAccumulator[shIndex], shFz);
+}
+
+
+
+      }
+#endif
+    tx += GRID;
+  }
+}
+#if PME_PHMD_DIRECT_DO_FORCE_ATOMICS
+const PMEFloat redTLx =
+  TLx_i + __SHFL(WARP_MASK, TLx_i, tgx + PME_PHMD_ORTHO16_ATOMS_PER_WARP);
+const PMEFloat redTLy =
+  TLy_i + __SHFL(WARP_MASK, TLy_i, tgx + PME_PHMD_ORTHO16_ATOMS_PER_WARP);
+const PMEFloat redTLz =
+  TLz_i + __SHFL(WARP_MASK, TLz_i, tgx + PME_PHMD_ORTHO16_ATOMS_PER_WARP);
+
+if ((tgx < PME_PHMD_ORTHO16_ATOMS_PER_WARP) && yValid) {
+#if PME_PHMD_FORCE_TARGET_WATCH
+  if (DoEnergy && !DoVirial && !DoFswitch &&
+      kPMEPHMDWatchForceTargetAtom(yIndex)) {
+    const unsigned int slot =
+      atomicAdd(&kPMEPHMDForceTargetWatchCounter, 1u);
+
+    if (slot < PME_PHMD_FORCE_TARGET_WATCH_LIMIT) {
+      printf("PME_PHMD_FORCE_TARGET_WATCH side=Y nlpos=%u tgx=%u "
+             "yIndex=%u yGrp=%d entryYHasPHMD=%d yPHMDMask=0x%08x "
+             "redTLx=% .9e redTLy=% .9e redTLz=% .9e "
+             "accX=%lld accY=%lld accZ=%lld\n",
+             nlpos,
+             tgx,
+             yIndex,
+             si.grp,
+             entryYHasPHMD ? 1 : 0,
+             yPHMDMask,
+             (double)redTLx,
+             (double)redTLy,
+             (double)redTLz,
+             (long long)kPMEPHMDForceFloatToAccumulator(redTLx),
+             (long long)kPMEPHMDForceFloatToAccumulator(redTLy),
+             (long long)kPMEPHMDForceFloatToAccumulator(redTLz));
+    }
+  }
+#endif
+if (!(PME_PHMD_ROUNDING_AWARE_FORCE &&
+      DoEnergy && !DoVirial && !DoFswitch)) {
+  kPMEPHMDAtomicAddForce(&sim.pNBForceXAccumulator[yIndex], redTLx);
+  kPMEPHMDAtomicAddForce(&sim.pNBForceYAccumulator[yIndex], redTLy);
+  kPMEPHMDAtomicAddForce(&sim.pNBForceZAccumulator[yIndex], redTLz);
+}
+}
+#endif
+#if PME_PHMD_DIRECT_DO_DUDL_ATOMICS
+if (si.grp >= 0) {
+#if PME_PHMD_WATCH_INDEX >= 0
+  kPMEPHMDWatchDudl(3,
+                    nlpos,
+                    si.index,
+                    si.grp,
+                    si.psp_grp,
+                    dudli,
+                    dudliplus);
+#endif
+
+  kPMEPHMDAtomicAddDudl(&sim.pdph_accumulator[si.index], dudli);
+  kPMEPHMDAtomicAddDudl(&sim.pdph_plus_accumulator[si.index], dudliplus);
+}
+#endif
+      if (DoEnergy || DoVirial) {
+        long long int evdw = 0;
+        long long int vir_11 = 0;
+        long long int vir_22 = 0;
+        long long int vir_33 = 0;
+
+#ifdef use_SPFP
+        if (DoEnergy) {
+          evdw = fast_llrintf(TLevdw * ENERGYSCALEF);
+        }
+        if (DoVirial) {
+          vir_11 = fast_llrintf(TLvir_11 * FORCESCALEF);
+          vir_22 = fast_llrintf(TLvir_22 * FORCESCALEF);
+          vir_33 = fast_llrintf(TLvir_33 * FORCESCALEF);
+        }
+#else
+        if (DoEnergy) {
+          evdw = llrint(TLevdw * ENERGYSCALE);
+        }
+        if (DoVirial) {
+          vir_11 = llrint(TLvir_11 * FORCESCALE);
+          vir_22 = llrint(TLvir_22 * FORCESCALE);
+          vir_33 = llrint(TLvir_33 * FORCESCALE);
+        }
+#endif
+
+        for (unsigned int rlev = GRID >> 1; rlev > 0u; rlev >>= 1) {
+          if (DoEnergy) {
+            evdw += __SHFL(WARP_MASK, evdw, tgx + rlev);
+          }
+          if (DoVirial) {
+            vir_11 += __SHFL(WARP_MASK, vir_11, tgx + rlev);
+            vir_22 += __SHFL(WARP_MASK, vir_22, tgx + rlev);
+            vir_33 += __SHFL(WARP_MASK, vir_33, tgx + rlev);
+          }
+        }
+
+        if (tgx == 0u) {
+          if (DoEnergy) {
+            atomicAdd(sim.pEVDW, kPMEPHMDLLToULL(evdw));
+          }
+          if (DoVirial) {
+            atomicAdd(sim.pVirial_11, kPMEPHMDLLToULL(vir_11));
+            atomicAdd(sim.pVirial_22, kPMEPHMDLLToULL(vir_22));
+            atomicAdd(sim.pVirial_33, kPMEPHMDLLToULL(vir_33));
+          }
+        }
+      }
+    }
+
+    listPos += nlStride;
+  }
+}
+
+template <bool DoVirial, bool DoFswitch, bool DoEnergy>
+static void kPMEPHMDLaunchDirectCorrections16(gpuContext gpu,
+                                               const kPMEPHMDDirectConst& dSim,
+                                               const unsigned int blocks,
+                                               const unsigned int threads,
+                                               const char* launchLabel)
+{
+  if (gpu->sim.is_orthog) {
+    kPMEPHMDDirectCorrections16_kernel<DoVirial, DoFswitch, DoEnergy, true>
+      <<<blocks, threads>>>(dSim);
+  }
+  else {
+    kPMEPHMDDirectCorrections16_kernel<DoVirial, DoFswitch, DoEnergy, false>
+      <<<blocks, threads>>>(dSim);
+  }
+
+  LAUNCHERROR(launchLabel);
+}
+
+static void
+kPMEPHMDDirectCorrectionsImpl(gpuContext gpu,
+                              const bool doVirial,
+                              const bool doFswitch,
+                              const bool doEnergy)
+{
+  if (gpu == nullptr) {
+    return;
+  }
+
+  if (gpu->iphmd != 3) {
+    return;
+  }
+
+  if (gpu->sim.pNLEntryPHMDMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNLEntryPHMDMask is null. "
+                 "Build/allocate the PHMD NLEntry mask before launching the "
+                 "direct correction pass.\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDYAtomMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNLEntryPHMDYAtomMask is null. "
+                 "Build/allocate the PHMD y-atom mask before launching the "
+                 "direct correction pass.\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDList == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNLEntryPHMDList is null. "
+                 "Did you add and allocate pbNLEntryPHMDList?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDCount == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNLEntryPHMDCount is null. "
+                 "Did you add and allocate pbNLEntryPHMDCount?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLAtomListPHMDMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNLAtomListPHMDMask is null. "
+                 "Build/allocate the PHMD x-swath mask before launching the "
+                 "direct correction pass.\n");
+    std::abort();
+  }
+
+  if (gpu->sim.NLAtomsPerWarp != PME_PHMD_ORTHO16_ATOMS_PER_WARP) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: this validation kernel only "
+                 "supports NLAtomsPerWarp == 16.  Current NLAtomsPerWarp = %u\n",
+                 gpu->sim.NLAtomsPerWarp);
+    std::abort();
+  }
+
+  if (doVirial && gpu->sim.pNTPData == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pNTPData is null for virial correction path.\n");
+    std::abort();
+  }
+
+  if (doFswitch && gpu->sim.fswitch < 0) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: fswitch correction requested, "
+                 "but gpu->sim.fswitch is negative.\n");
+    std::abort();
+  }
+
+  if (doEnergy && gpu->sim.pEVDW == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: pEVDW is null for energy correction path.\n");
+    std::abort();
+  }
+
+  const unsigned int threads = PME_PHMD_DIRECT_THREADS_PER_BLOCK;
+  const unsigned int blocks =
+    kPMEPHMDChooseBlocks(static_cast<unsigned int>(gpu->sim.NLMaxEntries),
+                         threads);
+  kPMEPHMDDirectConst dSim;
+
+  dSim.pNLEntry = gpu->sim.pNLEntry;
+  dSim.pNLEntries = gpu->sim.pNLEntries;
+  dSim.pNLEntryPHMDMask      = gpu->sim.pNLEntryPHMDMask;
+  dSim.pNLEntryPHMDYAtomMask = gpu->sim.pNLEntryPHMDYAtomMask;
+  dSim.pNLEntryPHMDList      = gpu->sim.pNLEntryPHMDList;
+  dSim.pNLEntryPHMDCount     = gpu->sim.pNLEntryPHMDCount;
+  dSim.pNLAtomList           = gpu->sim.pNLAtomList;
+  dSim.pNLAtomListPHMDMask   = gpu->sim.pNLAtomListPHMDMask;
+
+  dSim.pAtomXYSP = gpu->sim.pAtomXYSP;
+  dSim.pAtomZSP = gpu->sim.pAtomZSP;
+  dSim.pAtomChargeSPLJID = gpu->sim.pAtomChargeSPLJID;
+  dSim.pLJTerm = gpu->sim.pLJTerm;
+
+  dSim.pImageGrplist = gpu->sim.pImageGrplist;
+  dSim.pImageCharge_phmd = gpu->sim.pImageCharge_phmd;
+  dSim.pImageQstate1 = gpu->sim.pImageQstate1;
+  dSim.pImageQstate2 = gpu->sim.pImageQstate2;
+  dSim.pImageIndexPHMD = gpu->sim.pImageIndexPHMD;
+
+  dSim.psp_grp = gpu->sim.psp_grp;
+  dSim.pvstate1 = gpu->sim.pvstate1;
+  dSim.pph_theta = gpu->sim.pph_theta;
+
+  dSim.pdph_accumulator = gpu->sim.pdph_accumulator;
+  dSim.pdph_plus_accumulator = gpu->sim.pdph_plus_accumulator;
+
+  dSim.pNBForceXAccumulator = gpu->sim.pNBForceXAccumulator;
+  dSim.pNBForceYAccumulator = gpu->sim.pNBForceYAccumulator;
+  dSim.pNBForceZAccumulator = gpu->sim.pNBForceZAccumulator;
+
+  dSim.pVirial_11 = gpu->sim.pVirial_11;
+  dSim.pVirial_22 = gpu->sim.pVirial_22;
+  dSim.pVirial_33 = gpu->sim.pVirial_33;
+
+  dSim.pEVDW = gpu->sim.pEVDW;
+
+  dSim.pNTPData = gpu->sim.pNTPData;
+
+  dSim.ucellf[0] = gpu->sim.ucellf[0][0];
+  dSim.ucellf[1] = gpu->sim.ucellf[0][1];
+  dSim.ucellf[2] = gpu->sim.ucellf[0][2];
+
+  dSim.ucellf[3] = gpu->sim.ucellf[1][0];
+  dSim.ucellf[4] = gpu->sim.ucellf[1][1];
+  dSim.ucellf[5] = gpu->sim.ucellf[1][2];
+
+  dSim.ucellf[6] = gpu->sim.ucellf[2][0];
+  dSim.ucellf[7] = gpu->sim.ucellf[2][1];
+  dSim.ucellf[8] = gpu->sim.ucellf[2][2];
+
+  dSim.NLAtomsPerWarp = gpu->sim.NLAtomsPerWarp;
+  dSim.NLAtomsPerWarpBits = gpu->sim.NLAtomsPerWarpBits;
+  dSim.NLAtomsPerWarpBitsMask = gpu->sim.NLAtomsPerWarpBitsMask;
+  dSim.NLAtomsPerWarpMask = gpu->sim.NLAtomsPerWarpMask;
+  dSim.LJTypes = gpu->sim.LJTypes;
+
+  dSim.cut2 = gpu->sim.cut2;
+  dSim.ew_coeffSP = gpu->sim.ew_coeffSP;
+  dSim.ew_coeff2 = gpu->sim.ew_coeff2;
+  dSim.negTwoEw_coeffRsqrtPI = gpu->sim.negTwoEw_coeffRsqrtPI;
+
+  dSim.fswitch2 = gpu->sim.fswitch2;
+  dSim.cut3inv = gpu->sim.cut3inv;
+  dSim.cut6inv = gpu->sim.cut6inv;
+  dSim.invfswitch6cut6 = gpu->sim.invfswitch6cut6;
+  dSim.invfswitch3cut3 = gpu->sim.invfswitch3cut3;
+  dSim.cut6invcut6minfswitch6 = gpu->sim.cut6invcut6minfswitch6;
+  dSim.cut3invcut3minfswitch3 = gpu->sim.cut3invcut3minfswitch3;
+
+  const double ewcoeff = static_cast<double>(gpu->sim.ew_coeffSP);
+
+  dSim.erfcCoeffs.c0 = static_cast<PMEFloat>(-1.6488499458192755E-006 * pow(ewcoeff, 10.0));
+  dSim.erfcCoeffs.c1 = static_cast<PMEFloat>( 2.9524665006554534E-005 * pow(ewcoeff,  9.0));
+  dSim.erfcCoeffs.c2 = static_cast<PMEFloat>(-2.3341951153749626E-004 * pow(ewcoeff,  8.0));
+  dSim.erfcCoeffs.c3 = static_cast<PMEFloat>( 1.0424943374047289E-003 * pow(ewcoeff,  7.0));
+  dSim.erfcCoeffs.c4 = static_cast<PMEFloat>(-2.5501426008983853E-003 * pow(ewcoeff,  6.0));
+  dSim.erfcCoeffs.c5 = static_cast<PMEFloat>( 3.1979939710877236E-004 * pow(ewcoeff,  5.0));
+  dSim.erfcCoeffs.c6 = static_cast<PMEFloat>( 2.7605379075746249E-002 * pow(ewcoeff,  4.0));
+  dSim.erfcCoeffs.c7 = static_cast<PMEFloat>(-1.4827402067461906E-001 * pow(ewcoeff,  3.0));
+  dSim.erfcCoeffs.c8 = static_cast<PMEFloat>(-9.1844764013203406E-001 * ewcoeff * ewcoeff);
+  dSim.erfcCoeffs.c9 = static_cast<PMEFloat>(-1.6279070384382459E+000 * ewcoeff);
+
+  for (unsigned int c = 0; c < PME_PHMD_CELL_OFFSET_COUNT; c++) {
+    dSim.cellOffset[c][0] = gpu->sim.cellOffset[c][0];
+    dSim.cellOffset[c][1] = gpu->sim.cellOffset[c][1];
+    dSim.cellOffset[c][2] = gpu->sim.cellOffset[c][2];
+  }
+
+#if PME_PHMD_FORCE_WRITEBACK_DIAG
+  {
+    const unsigned int zero = 0u;
+    cudaError_t forceDiagStatus =
+      cudaMemcpyToSymbol(kPMEPHMDForceWritebackDiagCounter,
+                         &zero,
+                         sizeof(unsigned int),
+                         0,
+                         cudaMemcpyHostToDevice);
+    if (forceDiagStatus != cudaSuccess) {
+      std::fprintf(stderr,
+                   "kPMEPHMDDirectCorrections: failed to reset force writeback diag counter: %s\n",
+                   cudaGetErrorString(forceDiagStatus));
+      std::abort();
+    }
+  }
+#endif
+
+  #if PME_PHMD_WATCH_INDEX >= 0
+{
+  const unsigned int zero = 0u;
+  cudaError_t watchStatus =
+    cudaMemcpyToSymbol(kPMEPHMDWatchCounter,
+                       &zero,
+                       sizeof(unsigned int),
+                       0,
+                       cudaMemcpyHostToDevice);
+  if (watchStatus != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDDirectCorrections: failed to reset watch counter: %s\n",
+                 cudaGetErrorString(watchStatus));
+    std::abort();
+  }
+}
+#endif
+#if PME_PHMD_FORCE_TARGET_WATCH
+  {
+    const unsigned int zero = 0u;
+    cudaError_t targetWatchStatus =
+      cudaMemcpyToSymbol(kPMEPHMDForceTargetWatchCounter,
+                         &zero,
+                         sizeof(unsigned int),
+                         0,
+                         cudaMemcpyHostToDevice);
+    if (targetWatchStatus != cudaSuccess) {
+      std::fprintf(stderr,
+                   "kPMEPHMDDirectCorrections: failed to reset force target watch counter: %s\n",
+                   cudaGetErrorString(targetWatchStatus));
+      std::abort();
+    }
+  }
+#endif
+#if PME_PHMD_FORCE_PAIR_TARGET_WATCH
+  {
+    const unsigned int zero = 0u;
+    cudaError_t pairWatchStatus =
+      cudaMemcpyToSymbol(kPMEPHMDForcePairTargetWatchCounter,
+                         &zero,
+                         sizeof(unsigned int),
+                         0,
+                         cudaMemcpyHostToDevice);
+    if (pairWatchStatus != cudaSuccess) {
+      std::fprintf(stderr,
+                   "kPMEPHMDDirectCorrections: failed to reset force pair target watch counter: %s\n",
+                   cudaGetErrorString(pairWatchStatus));
+      std::abort();
+    }
+  }
+#endif
+  if (doVirial) {
+    if (doFswitch) {
+      if (doEnergy) {
+        kPMEPHMDLaunchDirectCorrections16<true, true, true>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16VirialFswitchEnergy_kernel launch");
+      }
+      else {
+        kPMEPHMDLaunchDirectCorrections16<true, true, false>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16VirialFswitch_kernel launch");
+      }
+    }
+    else {
+      if (doEnergy) {
+        kPMEPHMDLaunchDirectCorrections16<true, false, true>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16VirialEnergy_kernel launch");
+      }
+      else {
+        kPMEPHMDLaunchDirectCorrections16<true, false, false>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16Virial_kernel launch");
+      }
+    }
+  }
+  else {
+    if (doFswitch) {
+      if (doEnergy) {
+        kPMEPHMDLaunchDirectCorrections16<false, true, true>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16FswitchEnergy_kernel launch");
+      }
+      else {
+        kPMEPHMDLaunchDirectCorrections16<false, true, false>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16Fswitch_kernel launch");
+      }
+    }
+    else {
+      if (doEnergy) {
+        kPMEPHMDLaunchDirectCorrections16<false, false, true>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16Energy_kernel launch");
+      }
+      else {
+        kPMEPHMDLaunchDirectCorrections16<false, false, false>
+          (gpu, dSim, blocks, threads,
+           "kPMEPHMDDirectCorrections16_kernel launch");
+      }
+    }
+  }
+}
+
+extern "C" void
+kPMEPHMDDirectCorrections(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, false, false, false);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsVirial(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, true, false, false);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsFswitch(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, false, true, false);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsVirialFswitch(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, true, true, false);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsEnergy(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, false, false, true);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsVirialEnergy(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, true, false, true);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsFswitchEnergy(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, false, true, true);
+}
+
+extern "C" void
+kPMEPHMDDirectCorrectionsVirialFswitchEnergy(gpuContext gpu)
+{
+  kPMEPHMDDirectCorrectionsImpl(gpu, true, true, true);
+}
diff --git a/src/pmemd/src/cuda/kPME_PHMD.h b/src/pmemd/src/cuda/kPME_PHMD.h
new file mode 100644
index 0000000..914c76f
--- /dev/null
+++ b/src/pmemd/src/cuda/kPME_PHMD.h
@@ -0,0 +1,201 @@
+#ifndef KPME_PHMD_H
+#define KPME_PHMD_H
+
+#include "base_gpuContext.h"
+
+//tmp for debug
+//#define PME_PHMD_COMPARE_DIRECT
+
+// -----------------------------------------------------------------------------
+// PHMD-specific PME helper interface, written by Guy W. Dayhoff II.
+//
+// This header is intentionally small.  The implementation should live in
+// kPME_PHMD.cu so that PHMD-PME rework remains isolated from the existing PME
+// kernels as much as possible.
+//
+// Design goal:
+//   - iphmd != 3: no PHMD mask build, no PHMD correction kernel, standard PME
+//                 runtime path unchanged.
+//   - iphmd == 3: use normal PME direct-space force kernel, then apply PHMD
+//                 direct-space corrections over masked neighbor-list entries.
+// -----------------------------------------------------------------------------
+
+// Neighbor-list PHMD relevance mask bits.
+//
+// These are stored in cSim.pNLEntryPHMDMask[nlEntryIndex].
+//
+//   0: no PHMD-relevant atoms in this NLEntry
+//   1: y side contains at least one PHMD-relevant atom
+//   2: x side contains at least one PHMD-relevant atom
+//   3: both y and x sides contain PHMD-relevant atoms
+//
+// Direct-space PHMD relevance is based on:
+//   cSim.pImageGrplist[imageAtomIndex] > 0
+//
+enum {
+  PME_PHMD_NL_Y_HAS_PHMD = 1u,
+  PME_PHMD_NL_X_HAS_PHMD = 2u
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Build pNLEntryPHMDMask from the already-built standard PME neighbor list.
+//
+// Intended call site:
+//   after neighbor-list construction/remap is complete,
+//   only when gpu->iphmd == 3.
+//
+// This should not modify the standard neighbor list.  It only reads:
+//   cSim.pNLEntry
+//   cSim.pNLAtomList
