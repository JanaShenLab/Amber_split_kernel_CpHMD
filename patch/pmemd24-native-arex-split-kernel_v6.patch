+subroutine phmd_bind_output_context(ierr, message)
+   use file_io_dat_mod, only : phmdout_unit, phmdout_name, owrite
+   use file_io_mod,     only : amopen
+   use arex_io_mod,     only : arex_io_is_enabled, arex_io_get_active_slot, &
+                               arex_io_get_active_phmd_output_initialized, &
+                               arex_io_set_active_phmd_output_initialized
+   implicit none
+
+   integer, intent(out) :: ierr
+   character(len=*), intent(out) :: message
+
+   logical :: initialized
+   logical :: exists
+   integer :: slot_id
+   integer :: io_ierr
+   character(len=256) :: io_message
+   character(len=256) :: output_name
+   character(len=32) fmt00
+   character(len=20) fmt120
+   integer :: i
+
+   ierr = 0
+   message = ''
+
+   if (.not. arex_io_is_enabled()) then
+      if (.not. phmd_output_open) then
+         call phmd_output_filename(phmdout_name, output_name)
+         ! Normal PHMD: reopen the existing output file after restart writes.
+         inquire(file=trim(output_name), exist=exists)
+         if (lambda_binary_output) then
+            if (exists) then
+               call phmd_open_lmb(output_name, 'append')
+            else
+               call phmd_open_lmb(output_name, 'new')
+            end if
+         else
+            if (exists) then
+               open(unit=phmdout_unit, file=trim(phmdout_name), status='OLD', &
+                    position='APPEND', form='FORMATTED')
+            else
+               call amopen(phmdout_unit, phmdout_name, owrite, 'F', 'W')
+            end if
+         end if
+         phmd_output_open = .true.
+         phmd_output_slot = 0
+      end if
+      return
+   end if
+
+   call arex_io_get_active_slot(slot_id)
+   if (slot_id <= 0) then
+      ierr = 1
+      message = 'phmd_bind_output_context: no active AREX slot is bound'
+      return
+   end if
+
+   if (phmd_output_open .and. phmd_output_slot == slot_id) return
+
+   ! The filename is resolved only when the output file changes.
+   call phmd_output_filename(phmdout_name, output_name)
+
+   if (phmd_output_open) then
+      ! AREX: close the old slot file before switching to another slot.
+      close(phmdout_unit)
+      phmd_output_open = .false.
+      phmd_output_slot = 0
+   end if
+
+   io_ierr = 0
+   io_message = ''
+   call arex_io_get_active_phmd_output_initialized(initialized, io_ierr, io_message)
+   if (io_ierr .ne. 0) then
+      ierr = io_ierr
+      message = trim(io_message)
+      return
+   end if
+
+   if (.not. initialized) then
+      ! AREX: first write for this slot starts a fresh slot-owned file.
+      if (lambda_binary_output) then
+         call phmd_open_lmb(output_name, 'replace')
+      else
+         open(unit=phmdout_unit, file=trim(phmdout_name), status='REPLACE', &
+              form='FORMATTED')
+      end if
+      phmd_output_open = .true.
+      phmd_output_slot = slot_id
+
+      ! AREX: each slot file needs its own PHMD header.
+      if ((.not. lambda_binary_output) .and. &
+          (prlam .or. prderiv .or. prke .and. prnlev .ge. 0)) then
+         write(fmt00,'("(a,",i4,"(1x,i10))")') ntitr
+         write(fmt120,'("(a, ",i4,"(f8.3))")') ntitr
+         write(phmdout_unit,fmt00) '# ititr ',(i,i=1,ntitr)
+         write(phmdout_unit,fmt00) '#  ires ',(titrres(i),i=1,ntitr)
+         write(phmdout_unit,fmt00) '# itauto',(sp_grp(i),i=1,ntitr)
+         write(phmdout_unit,fmt120) '# ParK',(park(i),i=1,ntitr)
+      end if
+
+      call arex_io_set_active_phmd_output_initialized(.true., io_ierr, io_message)
+      if (io_ierr .ne. 0) then
+         ierr = io_ierr
+         message = trim(io_message)
+         return
+      end if
+   else
+      ! AREX: a slot already started writing, so append to its file.
+      inquire(file=trim(output_name), exist=exists)
+      if (.not. exists) then
+         ierr = 1
+         message = 'phmd_bind_output_context: expected slot PHMD output file is missing'
+         return
+      end if
+
+      if (lambda_binary_output) then
+         call phmd_open_lmb(output_name, 'append')
+      else
+         open(unit=phmdout_unit, file=trim(phmdout_name), status='OLD', &
+              position='APPEND', form='FORMATTED')
+      end if
+      phmd_output_open = .true.
+      phmd_output_slot = slot_id
+   end if
+end subroutine phmd_bind_output_context
