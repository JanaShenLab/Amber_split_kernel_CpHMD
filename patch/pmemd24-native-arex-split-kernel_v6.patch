+  subroutine arex_pay_phrex_import_checkpoint_state_mapped(source_replica,       &
+                                                           replica_valid_in,     &
+                                                           theta_in, dtheta_in,  &
+                                                           vtheta_in, dphold_in, &
+                                                           vphold_in, proton_count_in, &
+                                                           iupdate_in,           &
+#ifdef CUDA
+                                                           random_counter_in,    &
+                                                           random_in,            &
+#endif
+                                                           ierr, message)
+    integer, intent(in) :: source_replica(:)
+    logical, intent(in) :: replica_valid_in(:)
+    real(dp), intent(in) :: theta_in(:,:)
+    real(dp), intent(in) :: dtheta_in(:,:)
+    real(dp), intent(in) :: vtheta_in(:,:)
+    real(dp), intent(in) :: dphold_in(:,:)
+    real(dp), intent(in) :: vphold_in(:,:)
+    real(dp), intent(in) :: proton_count_in(:)
+    integer, intent(in) :: iupdate_in(:)
+#ifdef CUDA
+    integer, intent(in) :: random_counter_in(:)
+    real(dp), intent(in) :: random_in(:,:)
+#endif
+    integer, intent(out) :: ierr
+    character(len=*), intent(out) :: message
+
+    integer :: i
+    integer :: src
+    integer :: nold
+
+    if (.not. phrex_initialized) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_import_checkpoint_state_mapped: payload not initialized')
+      return
+    end if
+
+    if (size(source_replica) /= phrex_nreplicas) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_import_checkpoint_state_mapped: mapping size mismatch')
+      return
+    end if
+
+    nold = size(replica_valid_in)
+    if (nold <= 0 .or. size(proton_count_in) /= nold .or. size(iupdate_in) /= nold) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_import_checkpoint_state_mapped: old replica-sized input mismatch')
+      return
+    end if
+
+    if (size(theta_in,1) /= phrex_ntheta .or. size(theta_in,2) /= nold .or. &
+        size(dtheta_in,1) /= phrex_ntheta .or. size(dtheta_in,2) /= nold .or. &
+        size(vtheta_in,1) /= phrex_ntheta .or. size(vtheta_in,2) /= nold .or. &
+        size(dphold_in,1) /= phrex_ntheta .or. size(dphold_in,2) /= nold .or. &
+        size(vphold_in,1) /= phrex_ntheta .or. size(vphold_in,2) /= nold) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_import_checkpoint_state_mapped: theta-sized input mismatch')
+      return
+    end if
+
+#ifdef CUDA
+    if (size(random_counter_in) /= nold .or. &
+        size(random_in,1) /= phrex_random_buffer_size .or. size(random_in,2) /= nold) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_import_checkpoint_state_mapped: random-state input mismatch')
+      return
+    end if
+#endif
+
+    do i = 1, phrex_nreplicas
+      src = source_replica(i)
+      if (src < 1 .or. src > nold) then
+        call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+          'arex_pay_phrex_import_checkpoint_state_mapped: invalid source replica')
+        return
+      end if
+
+      phrex_replica_valid(i) = replica_valid_in(src)
+      phrex_theta(:,i)       = theta_in(:,src)
+      phrex_dtheta(:,i)      = dtheta_in(:,src)
+      phrex_vtheta(:,i)      = vtheta_in(:,src)
+      phrex_dphold(:,i)      = dphold_in(:,src)
+      phrex_vphold(:,i)      = vphold_in(:,src)
+      phrex_proton_count(i)  = proton_count_in(src)
+      phrex_iupdate(i)       = iupdate_in(src)
+#ifdef CUDA
+      phrex_random_counter(i) = random_counter_in(src)
+      phrex_random(:,i)       = random_in(:,src)
+#endif
+    end do
+
+    call arex_pay_set_status(ierr, message, ARM_OK, '')
+  end subroutine arex_pay_phrex_import_checkpoint_state_mapped
+
+  subroutine arex_pay_phrex_seed_replica_from_restart(replica_id, theta_in, vtheta_in, ierr, message)
+    integer, intent(in) :: replica_id
+    real(dp), intent(in) :: theta_in(:)
+    real(dp), intent(in) :: vtheta_in(:)
+    integer, intent(out) :: ierr
+    character(len=*), intent(out) :: message
+
+    if (.not. phrex_initialized) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_seed_replica_from_restart: payload not initialized')
+      return
+    end if
+
+    if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_seed_replica_from_restart: invalid replica_id')
+      return
+    end if
+
+    if (size(theta_in) /= phrex_ntheta .or. size(vtheta_in) /= phrex_ntheta) then
+      call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arex_pay_phrex_seed_replica_from_restart: theta-size input mismatch')
+      return
+    end if
+
+    phrex_theta(:, replica_id)  = theta_in(:)
+    phrex_vtheta(:, replica_id) = vtheta_in(:)
+
+    ! These fields are not present in the legacy PHMD restart file. Seed them to
+    ! a neutral state here; a subsequent AREX checkpoint import may overwrite
+    ! them with richer continuation state.
+    phrex_dtheta(:, replica_id) = 0.0_dp
+    phrex_dphold(:, replica_id) = 0.0_dp
+    phrex_vphold(:, replica_id) = 0.0_dp
+    phrex_iupdate(replica_id)   = 0
+#ifdef CUDA
+    phrex_random_counter(replica_id) = 0
+    phrex_random(:, replica_id)      = 0.0_dp
+#endif
+
+    call arex_pay_phrex_compute_proton_count(phrex_theta(:, replica_id),      &
+                                             phrex_proton_count(replica_id),  &
+                                             ierr, message)
+    if (ierr /= ARM_OK) return
+
+    phrex_replica_valid(replica_id) = .true.
+    call arex_pay_set_status(ierr, message, ARM_OK, '')
+  end subroutine arex_pay_phrex_seed_replica_from_restart
+
+subroutine arex_pay_phrex_emulate_restart_boundary(replica_id, slot_id, ierr, message)
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_restore(ph_theta_in, dph_theta_in, vph_theta_in, &
+                                  dphold_in, vphold_in, charge_phmd_in,    &
+                                  random_counter_in, random_in)
+      import dp
+      real(dp), intent(in) :: ph_theta_in(*)
+      real(dp), intent(in) :: dph_theta_in(*)
+      real(dp), intent(in) :: vph_theta_in(*)
+      real(dp), intent(in) :: dphold_in(*)
+      real(dp), intent(in) :: vphold_in(*)
+      real(dp), intent(in) :: charge_phmd_in(*)
+      integer, intent(in) :: random_counter_in
+      real(dp), intent(in) :: random_in(*)
+    end subroutine gpu_pharex_restore
+
+    subroutine gpu_upload_charges_pme_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_pme_cph
+
+    subroutine gpu_upload_charges_gb_cph(charge)
+      import dp
+      real(dp), intent(in) :: charge(*)
+    end subroutine gpu_upload_charges_gb_cph
+  end interface
+#endif
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_emulate_restart_boundary: payload not initialized')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_emulate_restart_boundary: invalid replica_id')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_emulate_restart_boundary: invalid slot_id')
+    return
+  end if
+
+  if (ntitr /= phrex_ntitr) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_emulate_restart_boundary: ntitr changed after initialization')
+    return
+  end if
+
+  if (.not. phrex_replica_valid(replica_id)) then
+    call arex_pay_set_status(ierr, message, ARM_OK, '')
+    return
+  end if
+
+  ! Emulate what survives a true command-line restart from PHMD restart:
+  ! keep theta/vtheta, discard transient PHMD history.
+  ph_theta(:)  = 0.0_dp
+  dph_theta(:) = 0.0_dp
+  vph_theta(:) = 0.0_dp
+  dphold(:)    = 0.0_dp
+  vphold(:)    = 0.0_dp
+
+  ph_theta(1:ntitr)  = phrex_theta(1:ntitr, replica_id)
+  vph_theta(1:ntitr) = phrex_vtheta(1:ntitr, replica_id)
+  vphold(1:ntitr)    = vph_theta(1:ntitr)
+
+  iupdate = 0
+  qsetlam = .false.
+  phkin   = 0.0_dp
+
+  ! Keep the worker-local replica store consistent with the emulated
+  ! restart state. This prevents a later pack/capture from seeing stale
+  ! transient history before the next segment evolves it.
+  phrex_dtheta(:, replica_id) = 0.0_dp
+  phrex_dphold(:, replica_id) = 0.0_dp
+  phrex_vphold(:, replica_id) = 0.0_dp
+
+  phrex_vphold(1:ntitr, replica_id) = phrex_vtheta(1:ntitr, replica_id)
+  phrex_iupdate(replica_id) = 0
+
+#ifdef CUDA
+  if (phrex_random_buffer_size > 0) then
+    phrex_random_counter(replica_id) = 0
+    phrex_random(:, replica_id) = 0.0_dp
+  end if
+#endif
+
+  ! Slot condition remains slot-owned.
+  solvph = phrex_slot_ladder(slot_id)
+  call reset_park()
+
+  call arex_pay_phrex_refresh_live_charges(ierr, message)
+  if (ierr /= ARM_OK) return
+
+#ifdef CUDA
+  call gpu_pharex_restore(phrex_theta(:, replica_id),                  &
+                          phrex_dtheta(:, replica_id),                 &
+                          phrex_vtheta(:, replica_id),                 &
+                          phrex_dphold(:, replica_id),                 &
+                          phrex_vphold(:, replica_id),                 &
+                          charge_phmd,                                 &
+                          phrex_random_counter(replica_id),            &
+                          phrex_random(:, replica_id))
+
+  if (iphmd == 3) then
+    call gpu_upload_charges_pme_cph(atm_qterm)
+  else
+    call gpu_upload_charges_gb_cph(atm_qterm)
+  end if
+#endif
+end subroutine arex_pay_phrex_emulate_restart_boundary
+
+subroutine arex_pay_phrex_evaluate_exchange(replica_a, slot_a, replica_b, slot_b, accept, ierr, message)
+  integer, intent(in) :: replica_a
+  integer, intent(in) :: slot_a
+  integer, intent(in) :: replica_b
+  integer, intent(in) :: slot_b
+  logical, intent(out) :: accept
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  real(dp) :: proton_a, proton_b
+  real(dp) :: ph_a, ph_b
+  real(dp) :: delta
+  real(dp) :: u
+
+  accept = .false.
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_evaluate_exchange: payload not initialized')
+    return
+  end if
+
+  if (replica_a < 1 .or. replica_a > phrex_nreplicas .or. &
+      replica_b < 1 .or. replica_b > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_evaluate_exchange: invalid replica id')
+    return
+  end if
+
+  if (slot_a < 1 .or. slot_a > phrex_nslots .or. &
+      slot_b < 1 .or. slot_b > phrex_nslots) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_evaluate_exchange: invalid slot id')
+    return
+  end if
+
+  if (.not. phrex_replica_valid(replica_a) .or. &
+      .not. phrex_replica_valid(replica_b)) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_evaluate_exchange: missing captured payload state')
+    return
+  end if
+
+  proton_a = phrex_proton_count(replica_a)
+  proton_b = phrex_proton_count(replica_b)
+
+  ph_a = phrex_slot_ladder(slot_a)
+  ph_b = phrex_slot_ladder(slot_b)
+
+  delta = log(10.0_dp) * (proton_a - proton_b) * (ph_b - ph_a)
+
+  if (delta < 0.0_dp) then
+    accept = .true.
+  else
+    call random_number(u)
+    accept = exp(-delta) > u
+  end if
+end subroutine arex_pay_phrex_evaluate_exchange
+
+subroutine arex_pay_phrex_post_exchange(replica_a, old_slot_a, new_slot_a, &
+                                        replica_b, old_slot_b, new_slot_b, &
+                                        ierr, message)
+  integer, intent(in) :: replica_a
+  integer, intent(in) :: old_slot_a
+  integer, intent(in) :: new_slot_a
+  integer, intent(in) :: replica_b
+  integer, intent(in) :: old_slot_b
+  integer, intent(in) :: new_slot_b
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  logical :: accepted
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. phrex_initialized) return
+
+  if (old_slot_a < 1 .or. old_slot_a > phrex_nslots .or. &
+      new_slot_a < 1 .or. new_slot_a > phrex_nslots .or. &
+      old_slot_b < 1 .or. old_slot_b > phrex_nslots .or. &
+      new_slot_b < 1 .or. new_slot_b > phrex_nslots) then
+
+    write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,i0)') &
+         'AREX PHREX EXCHANGE: invalid slot ids: replica ', replica_a, &
+         ' old_slot ', old_slot_a, ' new_slot ', new_slot_a, &
+         '; replica ', replica_b, ' old_slot ', old_slot_b, &
+         ' new_slot ', new_slot_b
+    call flush(0)
+    return
+  end if
+
+  accepted = (old_slot_a /= new_slot_a) .or. (old_slot_b /= new_slot_b)
+
+
+#ifdef AREX_DEBUG
+  if (accepted) then
+    write(0,'(a,i0,a,i0,a,f7.3,a,i0,a,f7.3,a,i0,a,i0,a,f7.3,a,i0,a,f7.3)') &
+         'AREX PHREX ACCEPTED_SWAP: replica ', replica_a, &
+         ' slot ', old_slot_a, ' pH ', phrex_slot_ladder(old_slot_a), &
+         ' -> slot ', new_slot_a, ' pH ', phrex_slot_ladder(new_slot_a), &
+         '; replica ', replica_b, &
+         ' slot ', old_slot_b, ' pH ', phrex_slot_ladder(old_slot_b), &
+         ' -> slot ', new_slot_b, ' pH ', phrex_slot_ladder(new_slot_b)
+  else
+    write(0,'(a,i0,a,i0,a,f7.3,a,i0,a,i0,a,f7.3)') &
+         'AREX PHREX REJECTED_EXCHANGE: replica ', replica_a, &
+         ' remains slot ', old_slot_a, ' pH ', phrex_slot_ladder(old_slot_a), &
+         '; replica ', replica_b, &
+         ' remains slot ', old_slot_b, ' pH ', phrex_slot_ladder(old_slot_b)
+  end if
+  call flush(0)
+#endif
+end subroutine arex_pay_phrex_post_exchange
+
