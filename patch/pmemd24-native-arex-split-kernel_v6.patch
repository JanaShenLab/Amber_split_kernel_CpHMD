+!*******************************************************************************
+! Return whether the active slot hits a given output frequency after a local
+! step offset within the currently running segment.
+!
+! This helper exists specifically for AREX slot-owned output cadence. The
+! archive schedule must be keyed to slot logical time, not worker wall time.
+! For non-AREX or invalid state, return .false. and let the caller use the
+! normal non-AREX cadence path unchanged.
+!*******************************************************************************
+logical function arex_io_active_slot_hits_freq(step_offset, freq)
+  integer, intent(in) :: step_offset
+  integer, intent(in) :: freq
+
+  arex_io_active_slot_hits_freq = .false.
+
+  if (.not. arex_io_initialized) return
+  if (.not. arex_io_enabled_flag) return
+  if (freq <= 0) return
+
+  ! A slot-owned archive event must occur after at least one local MD step
+  ! within the current segment. Prevent spurious AREX writes at segment entry
+  ! when runmd_one_segment resets nstep = 0.
+  if (step_offset <= 0) return
+
+  if (arex_io_active_slot < 1 .or. arex_io_active_slot > arex_io_nslots) return
+
+  arex_io_active_slot_hits_freq = &
+       mod(slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps + step_offset, freq) == 0
+
+end function arex_io_active_slot_hits_freq
+
+!*******************************************************************************
+! Return the active slot-owned logical MD time in ps for a write occurring
+! step_offset steps into the currently running segment.
+!
+! For non-AREX or invalid state, fall back to the live PMEMD time t so callers
+! can safely use this helper without adding a separate non-AREX branch.
+!*******************************************************************************
+double precision function arex_io_active_slot_time(step_offset)
+  integer, intent(in) :: step_offset
+
+  arex_io_active_slot_time = t
+
+  if (.not. arex_io_initialized) return
+  if (.not. arex_io_enabled_flag) return
+  if (arex_io_active_slot < 1 .or. arex_io_active_slot > arex_io_nslots) return
+
+  arex_io_active_slot_time = &
+       slot_ctx(arex_io_active_slot)%bintraj%mdcrd_time_origin_ps + &
+       dble(slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps + step_offset) * dt
+
+end function arex_io_active_slot_time
+
+!*******************************************************************************
+! Return the active slot-owned logical MD step index for an event occurring
+! step_offset steps into the currently running segment.
+!*******************************************************************************
+integer function arex_io_active_slot_logical_step(step_offset)
+  integer, intent(in) :: step_offset
+
+  arex_io_active_slot_logical_step = step_offset
+
+  if (.not. arex_io_initialized) return
+  if (.not. arex_io_enabled_flag) return
+  if (arex_io_active_slot < 1 .or. arex_io_active_slot > arex_io_nslots) return
+
+  arex_io_active_slot_logical_step = &
+       slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps + step_offset
+
+end function arex_io_active_slot_logical_step
+
+!*******************************************************************************
+! Advance the active slot's logical trajectory time after one completed AREX
+! segment.
+!
+! This updates the slot-owned logical step counter that drives AREX trajectory
+! cadence. It must be called only after a segment completes successfully while
+! the just-finished slot is still bound as the active slot.
+!*******************************************************************************
+subroutine arex_io_advance_active_mdcrd_logical_steps(delta_steps, ierr, message)
+  integer, intent(in) :: delta_steps
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = AREX_IO_OK
+  message = ''
+
+  if (.not. arex_io_initialized) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_advance_active_mdcrd_logical_steps: module not initialized'
+    return
+  end if
+
+  if (.not. arex_io_enabled_flag) return
+
+  if (delta_steps < 0) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_advance_active_mdcrd_logical_steps: delta_steps must be >= 0'
+    return
+  end if
+
+  if (arex_io_active_slot < 1 .or. arex_io_active_slot > arex_io_nslots) then
+    ierr = AREX_IO_ERR_INVALID
+    message = 'arex_io_advance_active_mdcrd_logical_steps: no active slot is bound'
+    return
+  end if
+
+  slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps = &
+       slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps + delta_steps
+
+  slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_time_ps = &
+       slot_ctx(arex_io_active_slot)%bintraj%mdcrd_time_origin_ps + &
+       dble(slot_ctx(arex_io_active_slot)%bintraj%mdcrd_logical_steps) * dt
+
+end subroutine arex_io_advance_active_mdcrd_logical_steps
