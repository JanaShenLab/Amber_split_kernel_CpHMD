index 0000000..31c445d
--- /dev/null
+++ b/src/pmemd/src/arex_utils.F90
@@ -0,0 +1,227 @@
+!*******************************************************************************
+! Module: arex_utils_mod
+!
+! Shared AREX utility helpers.
+!
+! Scope:
+!   * shared status/message helper
+!   * small validation helpers for repeated AREX guard patterns
+!
+! Keep this module narrow. Do not put payload logic, MPI packing, checkpoint I/O,
+! or slot-output policy here.
+!*******************************************************************************
+
+module arex_utils_mod
+
+  use mdin_ctrl_dat_mod, only : arex_segment_steps, ntwx, ntwv, ntwf, dt
+
+  implicit none
+  private
+
+  public :: arex_set_status
+  public :: arex_require
+  public :: arex_validate_initialized
+  public :: arex_validate_enabled
+  public :: arex_validate_positive
+  public :: arex_validate_nonnegative
+  public :: arex_validate_index
+  public :: arex_validate_active_index
+  public :: arex_slot_progress_from_segments
+
+contains
+
+!===============================================================================
+! Shared status/message setter.
+!===============================================================================
+subroutine arex_set_status(ierr, message, code, text)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer, intent(in) :: code
+  character(len=*), intent(in) :: text
+
+  ierr = code
+  if (len(message) > 0) message = text
+end subroutine arex_set_status
+
+!===============================================================================
+! Generic requirement helper.
+! If CONDITION is false, set CODE/TEXT and return ok=.false.
+!===============================================================================
+subroutine arex_require(condition, code, text, ok, ierr, message)
+  logical, intent(in) :: condition
+  integer, intent(in) :: code
+  character(len=*), intent(in) :: text
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  if (condition) then
+    ok = .true.
+    call arex_set_status(ierr, message, 0, '')
+  else
+    ok = .false.
+    call arex_set_status(ierr, message, code, text)
+  end if
+end subroutine arex_require
+
+!===============================================================================
+! Validate module/object initialized state.
+!===============================================================================
+subroutine arex_validate_initialized(initialized, routine_name, invalid_code, &
+                                     ok, ierr, message)
+  logical, intent(in) :: initialized
+  character(len=*), intent(in) :: routine_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(initialized, invalid_code, &
+       trim(routine_name) // ': module not initialized', &
+       ok, ierr, message)
+end subroutine arex_validate_initialized
+
+!===============================================================================
+! Validate enabled state.
+!===============================================================================
+subroutine arex_validate_enabled(enabled, routine_name, feature_name, invalid_code, &
+                                 ok, ierr, message)
+  logical, intent(in) :: enabled
+  character(len=*), intent(in) :: routine_name
+  character(len=*), intent(in) :: feature_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(enabled, invalid_code, &
+       trim(routine_name) // ': ' // trim(feature_name) // ' is not enabled', &
+       ok, ierr, message)
+end subroutine arex_validate_enabled
+
+!===============================================================================
+! Validate positive integer (> 0).
+!===============================================================================
+subroutine arex_validate_positive(value, value_name, routine_name, invalid_code, &
+                                  ok, ierr, message)
+  integer, intent(in) :: value
+  character(len=*), intent(in) :: value_name
+  character(len=*), intent(in) :: routine_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(value > 0, invalid_code, &
+       trim(routine_name) // ': ' // trim(value_name) // ' must be > 0', &
+       ok, ierr, message)
+end subroutine arex_validate_positive
+
+!===============================================================================
+! Validate nonnegative integer (>= 0).
+!===============================================================================
+subroutine arex_validate_nonnegative(value, value_name, routine_name, invalid_code, &
+                                     ok, ierr, message)
+  integer, intent(in) :: value
+  character(len=*), intent(in) :: value_name
+  character(len=*), intent(in) :: routine_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(value >= 0, invalid_code, &
+       trim(routine_name) // ': ' // trim(value_name) // ' must be >= 0', &
+       ok, ierr, message)
+end subroutine arex_validate_nonnegative
+
+!===============================================================================
+! Validate generic bounded index.
+!===============================================================================
+subroutine arex_validate_index(idx, lower_bound, upper_bound, index_name, &
+                               routine_name, invalid_code, ok, ierr, message)
+  integer, intent(in) :: idx
+  integer, intent(in) :: lower_bound
+  integer, intent(in) :: upper_bound
+  character(len=*), intent(in) :: index_name
+  character(len=*), intent(in) :: routine_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(idx >= lower_bound .and. idx <= upper_bound, invalid_code, &
+       trim(routine_name) // ': invalid ' // trim(index_name), &
+       ok, ierr, message)
+end subroutine arex_validate_index
+
+!===============================================================================
+! Validate active bounded index.
+! Message is specialized for patterns like "no active slot is bound".
+!===============================================================================
+subroutine arex_validate_active_index(active_idx, lower_bound, upper_bound, &
+                                      active_name, routine_name, invalid_code, &
+                                      ok, ierr, message)
+  integer, intent(in) :: active_idx
+  integer, intent(in) :: lower_bound
+  integer, intent(in) :: upper_bound
+  character(len=*), intent(in) :: active_name
+  character(len=*), intent(in) :: routine_name
+  integer, intent(in) :: invalid_code
+  logical, intent(out) :: ok
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_require(active_idx >= lower_bound .and. active_idx <= upper_bound, &
+       invalid_code, &
+       trim(routine_name) // ': no active ' // trim(active_name) // ' is bound', &
+       ok, ierr, message)
+end subroutine arex_validate_active_index
+
+!===============================================================================
+! Derive authoritative slot-owned output progress from completed AREX segments.
+! Shared by AREX restart/checkpoint and MPI assignment sync paths.
+!===============================================================================
+subroutine arex_slot_progress_from_segments(completed_segments, time_origin_ps, &
+                                            mdcrd_frame, mdvel_frame, mdfrc_frame, &
+                                            logical_steps, logical_time_ps, &
+                                            phmd_output_initialized)
+  integer, intent(in) :: completed_segments
+  double precision, intent(in) :: time_origin_ps
+  integer, intent(out) :: mdcrd_frame
+  integer, intent(out) :: mdvel_frame
+  integer, intent(out) :: mdfrc_frame
+  integer, intent(out) :: logical_steps
+  double precision, intent(out) :: logical_time_ps
+  logical, intent(out) :: phmd_output_initialized
+
+  logical_steps = completed_segments * arex_segment_steps
+  logical_time_ps = time_origin_ps + dble(logical_steps) * dt
+
+  if (ntwx > 0) then
+    mdcrd_frame = logical_steps / ntwx + 1
+  else
+    mdcrd_frame = 1
+  end if
+
+  if (ntwv > 0) then
+    mdvel_frame = logical_steps / ntwv + 1
+  else if (ntwv < 0) then
+    mdvel_frame = mdcrd_frame
+  else
+    mdvel_frame = 1
+  end if
+
+  if (ntwf > 0) then
+    mdfrc_frame = logical_steps / ntwf + 1
+  else if (ntwf < 0) then
+    mdfrc_frame = mdcrd_frame
+  else
+    mdfrc_frame = 1
+  end if
+
+  phmd_output_initialized = (completed_segments > 0)
+
+end subroutine arex_slot_progress_from_segments
+
+end module arex_utils_mod
