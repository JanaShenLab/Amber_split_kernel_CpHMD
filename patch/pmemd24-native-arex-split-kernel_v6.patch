+!*******************************************************************************
+!
+! Module: arex_mpi_mod
+!
+! AREX = Asynchronous Replica Exchange
+!
+! Purpose
+! -------
+! This module provides the MPI coordination layer for the generic AREX
+! manager. The generic manager itself lives in arex_arm_mod and remains
+! free of PMEMD transport policy. This file is responsible for:
+!
+! 1. mapping worker groups onto the existing multipmemd communicators
+! 2. owning the authoritative manager on arex_sched_comm rank 0
+! 3. handling worker-master check-in at segment boundaries
+! 4. broadcasting local assignments inside each pmemd_comm worker group
+!
+! Current coordination model
+! --------------------------
+! - each pmemd_comm group is one AREX worker
+! - rank 0 of each pmemd_comm group is the worker-group master
+! - arex_sched_comm rank 0 owns the authoritative scheduler state
+! - non-master ranks never talk to arex_sched_comm directly
+!
+! This file does not perform MD integration and does not own payload
+! chemistry. It only coordinates assignments and campaign progress.
+!
+! Notes
+! -----
+! The current process layout does not create a dedicated standalone
+! scheduler rank. The global scheduler therefore runs on the worker-group
+! master that is arex_sched_comm rank 0. Coordination occurs at safe
+! segment boundaries only.
+!
+!*******************************************************************************
+
+  module arex_mpi_mod
+
+  use arex_arm_mod, only : dp, arm_manager_t, arm_payload_api_t, arm_md_snapshot_t, &
+                   arm_manager_init, arm_manager_finalize, &
+                   arm_set_segments_per_replica, &
+                   arm_register_payload, arm_seed_initial_snapshots, &
+                   arm_begin_epoch, arm_next_ready_replica, &
+                   arm_assign_replica_to_worker, &
+                   arm_mark_segment_complete, &
+                   arm_try_resolve_ready_exchanges, &
+                   arm_epoch_complete, arm_restart_set_ready, &
+                   arm_write_exchange_history, &
+                   arm_campaign_complete, arm_emulate_common_restart_boundary, &
+                   arm_snapshot_allocate, arm_snapshot_deallocate, &
+                   arm_capture_common_md_state, arm_restore_common_md_state, &
+                   ARM_OK, ARM_ERR_INVALID, ARM_ERR_ALLOC, &
+                   ARM_ERR_NOT_IMPLEMENTED, &
+                   ARM_REPLICA_IDLE, ARM_WORKER_IDLE
+  use arex_restraint_mod, only : arex_restraint_apply
+  use file_io_dat_mod, only : mdout, max_fn_len
+  use get_cmdline_mod, only : arexrst_specified, arexrst_name, arex_append, &
+                              arex_checkpoint_output_name
+  use arex_rst_mod, only : arex_rst_checkpoint_t, arex_rst_read_checkpoint, &
+                           arex_rst_release_checkpoint, arex_rst_write_checkpoint, &
+                           arex_rst_remove_numbered_set, arex_rst_capture_checkpoint, &
+                           arex_rst_restore_from_checkpoint, &
+                           arex_rst_get_checkpoint_warmup_state, &
+                           arex_rst_ladder_count, arex_rst_build_migration_map, &
+                           AREX_RST_OK
+  use arex_io_mod,  only : arex_io_init, arex_io_bintraj_state_t, &
+                           arex_io_get_slot_bintraj_state, &
+                           arex_io_set_slot_bintraj_state, &
+                           arex_io_get_slot_names, arex_io_set_slot_restart_initialized, &
+                           arex_io_set_slot_phmd_output_initialized
+  use mdin_ctrl_dat_mod, only : arex_warmup_segments, arex_ladder, arex_ladder_unset, &
+                                arex_segment_steps, ntwx, ntwv, ntwf, dt, t, &
+                                arex_emulate_restart, arex_restraint_npoints
+  use arex_pay_phrex_mod, only : arex_pay_phrex_build_api, &
+                               arex_pay_phrex_init_authoritative_storage, &
+                               arex_pay_phrex_seed_all_replicas, &
+                               arex_pay_phrex_sync_assigned_replica, &
+                               arex_pay_phrex_send_assigned_replica_to_worker, &
+                               arex_pay_phrex_recv_assigned_replica_from_global, &
+                               arex_pay_phrex_send_completed_replica_to_scheduler, &
+                               arex_pay_phrex_recv_completed_replica_from_worker
+#ifdef MPI
+  use parallel_dat_mod
+#endif
+
+  implicit none
+  private
+
+#ifdef MPI
+
+  integer, parameter :: arex_mpi_msg_len = 256
+
+  ! Every worker rank needs the same fixed output-part frame origin after slot
+  ! migration. This cache is loaded once from the authoritative source checkpoint.
+  integer, allocatable, save :: arex_part_start_steps(:)
+  real(dp), allocatable, save :: arex_part_time_origins(:)
+
+  integer, parameter :: AREX_MPI_REQ_ASSIGN        = 1
+  integer, parameter :: AREX_MPI_REQ_COMPLETE      = 2
+  integer, parameter :: AREX_MPI_REQ_COMPLETE_STOP = 3
+
+  integer, parameter :: AREX_MPI_SYNC_FULL      = 0
+  integer, parameter :: AREX_MPI_SYNC_SLOT_ONLY = 1
+  integer, parameter :: AREX_MPI_SYNC_NOOP      = 2
+
+  integer, parameter :: AREX_MPI_TAG_BOOT           = 8100
+  integer, parameter :: AREX_MPI_TAG_REQ            = 8101
+  integer, parameter :: AREX_MPI_TAG_RESP           = 8102
+  integer, parameter :: AREX_MPI_TAG_MSG            = 8103
+  integer, parameter :: AREX_MPI_TAG_STATE          = 8104
+  integer, parameter :: AREX_MPI_TAG_COMPLETE_STATE = 8105
+
+  ! Reporting-only cumulative AREX endpoint for mdinfo.
+  ! Zero for a fresh AREX run; set by the scheduler for --arexrst.
+  integer, save, public :: arex_mpi_mdinfo_total_steps = 0
+
+  type, public :: arex_mpi_state_t
+    logical :: initialized      = .false.
+    logical :: is_group_master  = .false.
+    logical :: is_global_master = .false.
+    logical :: have_master_comm = .false.
+
+    integer :: worker_id = 0
+    integer :: nworkers  = 0
+
+    logical :: warmup_active = .false.
+    integer :: warmup_segments_target = 0
+    integer :: warmup_segments_completed = 0
+
+    ! AREX periodic checkpoint cadence, measured in scheduler-observed
+    ! completed segments. Zero disables periodic checkpoints; a final
+    ! checkpoint is always written when the campaign completes.
+    integer :: checkpoint_frequency = 0
+    integer :: checkpoint_segments_since_write = 0
+    integer :: epoch_restart_number = 0   ! 0: none, >0: numbered, -1: final
+    integer :: last_checkpoint_number = 0
+    integer :: pending_checkpoint_number = 0
+    integer :: pending_previous_number = 0
+    type(arex_rst_checkpoint_t) :: pending_checkpoint
+    integer :: assigned_restart_number = 0
+    logical :: stop_requested = .false.
+
+    type(arm_manager_t) :: mgr
+
+    type(arm_md_snapshot_t) :: assigned_md
+    logical :: assigned_md_ready = .false.
+    integer :: assigned_replica_id = 0
+    integer :: assigned_completed_segments = 0
+    integer :: assigned_sync_mode  = AREX_MPI_SYNC_FULL
+
+    integer :: active_replica_id = 0
+    integer :: active_slot_id    = 0
+
+    logical, allocatable :: pending_request(:)
+    logical, allocatable :: response_ready(:)
+    logical, allocatable :: worker_finished(:)
+
+    logical, allocatable :: resident_valid(:)
+    integer, allocatable :: resident_replica(:)
+    integer, allocatable :: resident_slot(:)
+
+    integer, allocatable :: response_ierr(:)
+    integer, allocatable :: response_done(:)
+    integer, allocatable :: response_replica(:)
+    integer, allocatable :: response_slot(:)
+    integer, allocatable :: response_completed_segments(:)
+    integer, allocatable :: response_sync_mode(:)
+    integer, allocatable :: response_restart_number(:)
+    character(len=arex_mpi_msg_len), allocatable :: response_msg(:)
+  end type arex_mpi_state_t
+
+#else
+
+  type, public :: arex_mpi_state_t
+    logical :: initialized = .false.
+  end type arex_mpi_state_t
+
+#endif
+
+  public :: arex_mpi_init
+  public :: arex_mpi_finalize
+  public :: arex_mpi_begin_worker
+  public :: arex_mpi_complete_segment
+  public :: arex_mpi_run_scheduler
+
+contains
+
+#ifdef MPI
+
+!===============================================================================
+! Return the packed real-buffer size for one common MD snapshot.
+! Layout:
+!   crd(3*natom), vel(3*natom), last_vel(3*natom),
+!   box(3), alpha, beta, gamma, time
+!===============================================================================
+integer function arex_mpi_md_packed_size(natom)
+  integer, intent(in) :: natom
+
+  arex_mpi_md_packed_size = 9 * natom + 7
+end function arex_mpi_md_packed_size
+
+!===============================================================================
+! Pack one allocated common MD snapshot into a contiguous real buffer.
+!===============================================================================
+subroutine arex_mpi_pack_md_snapshot(snapshot, packed_md, ierr, message)
+  type(arm_md_snapshot_t), intent(in) :: snapshot
+  real(dp), intent(out) :: packed_md(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: ncart
+  integer :: idx
+  integer :: needed
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. snapshot%allocated) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_pack_md_snapshot: snapshot is not allocated'
+    return
+  end if
+
+  needed = arex_mpi_md_packed_size(snapshot%natom)
+  if (size(packed_md) /= needed) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_pack_md_snapshot: packed buffer size mismatch'
+    return
+  end if
+
+  ncart = 3 * snapshot%natom
+  idx = 1
+
+  packed_md(idx:idx+ncart-1) = reshape(snapshot%crd, (/ ncart /))
+  idx = idx + ncart
+
+  packed_md(idx:idx+ncart-1) = reshape(snapshot%vel, (/ ncart /))
+  idx = idx + ncart
+
+  packed_md(idx:idx+ncart-1) = reshape(snapshot%last_vel, (/ ncart /))
+  idx = idx + ncart
+
+  packed_md(idx:idx+2) = snapshot%box
+  idx = idx + 3
+
+  packed_md(idx) = snapshot%alpha
+  idx = idx + 1
+
+  packed_md(idx) = snapshot%beta
+  idx = idx + 1
+
+  packed_md(idx) = snapshot%gamma
+  idx = idx + 1
+
+  packed_md(idx) = snapshot%time
+end subroutine arex_mpi_pack_md_snapshot
+
+!===============================================================================
+! Unpack one contiguous real buffer into an allocated common MD snapshot.
+!===============================================================================
+subroutine arex_mpi_unpack_md_snapshot(snapshot, packed_md, ierr, message)
+  type(arm_md_snapshot_t), intent(inout) :: snapshot
+  real(dp), intent(in) :: packed_md(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: ncart
+  integer :: idx
+  integer :: needed
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. snapshot%allocated) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_unpack_md_snapshot: snapshot is not allocated'
+    return
+  end if
+
+  needed = arex_mpi_md_packed_size(snapshot%natom)
+  if (size(packed_md) /= needed) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_unpack_md_snapshot: packed buffer size mismatch'
+    return
+  end if
+
+  ncart = 3 * snapshot%natom
+  idx = 1
+
+  snapshot%crd = reshape(packed_md(idx:idx+ncart-1), shape(snapshot%crd))
+  idx = idx + ncart
+
+  snapshot%vel = reshape(packed_md(idx:idx+ncart-1), shape(snapshot%vel))
+  idx = idx + ncart
+
+  snapshot%last_vel = reshape(packed_md(idx:idx+ncart-1), shape(snapshot%last_vel))
+  idx = idx + ncart
+
+  snapshot%box = packed_md(idx:idx+2)
+  idx = idx + 3
+
+  snapshot%alpha = packed_md(idx)
+  idx = idx + 1
+
+  snapshot%beta = packed_md(idx)
+  idx = idx + 1
+
+  snapshot%gamma = packed_md(idx)
+  idx = idx + 1
+
+  snapshot%time = packed_md(idx)
+end subroutine arex_mpi_unpack_md_snapshot
+
+!===============================================================================
+! Dedicated AREX scheduler entry point.
+!
+! This routine runs only on the detached scheduler rank. It owns the
+! authoritative manager and services worker-master requests over
+! arex_sched_comm.
+!===============================================================================
+subroutine arex_mpi_run_scheduler()
+
+  type(arex_mpi_state_t) :: state
+  integer :: request(2)
+  integer :: requester_id
+  integer :: replica_id
+  integer :: status(mpi_status_size)
+  integer :: ierr
+  character(len=arex_mpi_msg_len) :: message
+  integer :: finalize_ierr
+  character(len=arex_mpi_msg_len) :: finalize_message
+
+  ierr = ARM_OK
+  message = ''
+!  write(0,*) 'AREX DBG scheduler run loop entered'
+
+  call arex_mpi_scheduler_bootstrap(state, ierr, message)
+  if (ierr /= ARM_OK) then
+    write(0,'(a)') 'AREX FATAL: scheduler bootstrap failed: ' // trim(message)
+    call mpi_abort(mpi_comm_world, 1, err_code_mpi)
+  end if
+
+  do while (.not. all(state%worker_finished))
+    call mpi_recv(request, 2, mpi_integer, mpi_any_source, AREX_MPI_TAG_REQ, &
+                  arex_sched_comm, status, err_code_mpi)
+
+    requester_id = request(2)
+
+    if (request(1) == AREX_MPI_REQ_COMPLETE .or. &
+        request(1) == AREX_MPI_REQ_COMPLETE_STOP) then
+      replica_id = state%mgr%workers(requester_id)%active_replica_id
+
+      if (replica_id < 1 .or. replica_id > state%mgr%nreplicas) then
+        ierr = ARM_ERR_INVALID
+        message = 'arex_mpi_run_scheduler: invalid active replica on COMPLETE request'
+        call arex_mpi_fail_pending_requests(state, requester_id, ierr, message)
+        call arex_mpi_flush_remote_responses(state, 0, ierr, message)
+        cycle
+      end if
+
+      call arex_mpi_recv_completed_state_from_worker(state, replica_id, &
+                                                     status(MPI_SOURCE), ierr, message)
+      if (ierr /= ARM_OK) then
+        call arex_mpi_fail_pending_requests(state, requester_id, ierr, message)
+        call arex_mpi_flush_remote_responses(state, 0, ierr, message)
+        cycle
+      end if
+
+      call arex_pay_phrex_recv_completed_replica_from_worker(replica_id, &
+           status(MPI_SOURCE), ierr, message)
+      if (ierr /= ARM_OK) then
+        call arex_mpi_fail_pending_requests(state, requester_id, ierr, message)
+        call arex_mpi_flush_remote_responses(state, 0, ierr, message)
+        cycle
+      end if
+    end if
+
+    call arex_mpi_process_request(state, request(1), requester_id, ierr, message)
+    if (ierr /= ARM_OK) then
+      call arex_mpi_fail_pending_requests(state, requester_id, ierr, message)
+    end if
+
+    call arex_mpi_flush_remote_responses(state, 0, ierr, message)
+    if (ierr /= ARM_OK) then
+      write(0,'(a)') 'AREX FATAL: scheduler response flush failed: ' // trim(message)
+      call mpi_abort(mpi_comm_world, 1, err_code_mpi)
+    end if
+  end do
+
+  finalize_message = ''
+  call arm_manager_finalize(state%mgr, finalize_ierr, finalize_message)
+
+  if (allocated(state%pending_request))   deallocate(state%pending_request)
+  if (allocated(state%response_ready))    deallocate(state%response_ready)
+  if (allocated(state%worker_finished))   deallocate(state%worker_finished)
+
+  if (allocated(state%resident_valid))    deallocate(state%resident_valid)
+  if (allocated(state%resident_replica))  deallocate(state%resident_replica)
+  if (allocated(state%resident_slot))     deallocate(state%resident_slot)
+
+  if (allocated(state%response_ierr))     deallocate(state%response_ierr)
+  if (allocated(state%response_done))     deallocate(state%response_done)
+  if (allocated(state%response_replica))  deallocate(state%response_replica)
+  if (allocated(state%response_slot))     deallocate(state%response_slot)
+  if (allocated(state%response_sync_mode)) deallocate(state%response_sync_mode)
+  if (allocated(state%response_restart_number)) deallocate(state%response_restart_number)
+  if (allocated(state%response_msg))      deallocate(state%response_msg)
+
+end subroutine arex_mpi_run_scheduler
+
+!===============================================================================
+! Seed the scheduler-side RNG from the AREX seed so exchange acceptance runs on
+! the detached scheduler are reproducible.
+!===============================================================================
+subroutine arex_mpi_seed_rng_from_integer(seed_in)
+  integer, intent(in) :: seed_in
+
+  integer, parameter :: i8 = selected_int_kind(18)
+
+  integer :: n, i, alloc_stat
+  integer, allocatable :: seed_values(:)
+
+  integer(kind=i8) :: clock_count
+  integer(kind=i8) :: clock_rate
+  integer(kind=i8) :: clock_max
+  integer(kind=i8) :: mixed
+  integer(kind=i8) :: int_huge
+  integer :: date_values(8)
+
+  ! arex_seed == 0 preserves the existing behavior:
+  ! do not explicitly seed Fortran's RNG.
+  if (seed_in == 0) return
+
+  call random_seed(size=n)
+
+  allocate(seed_values(n), stat=alloc_stat)
+  if (alloc_stat /= 0) return
+
+  int_huge = int(huge(1) - 1, kind=i8)
+
+  if (seed_in > 0) then
+    ! Reproducible deterministic seed.
+    do i = 1, n
+      mixed = int(abs(seed_in), kind=i8) + 37_i8 * int(i, kind=i8)
+      seed_values(i) = int(mod(mixed, int_huge) + 1_i8)
+    end do
+
+  else
+    ! arex_seed < 0: initialize from wall-clock/system-clock state.
+    call system_clock(count=clock_count, count_rate=clock_rate, &
+                      count_max=clock_max)
+    call date_and_time(values=date_values)
+
+    do i = 1, n
+      mixed = abs(clock_count)                                      &
+            + 104729_i8 * int(i, kind=i8)                           &
+            + 7919_i8   * abs(clock_rate)                           &
+            + 1543_i8   * abs(clock_max)                            &
+            + 37_i8     * int(date_values(8), kind=i8)              &
+            + 101_i8    * int(date_values(7), kind=i8)              &
+            + 1009_i8   * int(date_values(6), kind=i8)              &
+            + 10007_i8  * int(date_values(5), kind=i8)
+
+      seed_values(i) = int(mod(mixed, int_huge) + 1_i8)
+    end do
+  end if
+
+  call random_seed(put=seed_values)
+  deallocate(seed_values)
+end subroutine arex_mpi_seed_rng_from_integer
+
+!===============================================================================
+! Send the initial scheduler bootstrap payload from worker 1 to the detached
+! scheduler rank.
+!===============================================================================
+subroutine arex_mpi_send_bootstrap_to_scheduler(nreplicas, nsegments, natom, &
+                                                ierr, message)
+   use mdin_ctrl_dat_mod, only : arex_type, arex_ladder, arex_ladder_unset, &
+                                arex_warmup_segments, arex_seed, arex_chkfrq
+   use phmd_mod,          only : ntitr, ph_theta, dph_theta, vph_theta, &
+                                dphold, vphold, iupdate, qphmdstart, &
+                                sp_grp, local_model_pka
+  use gbl_constants_mod, only : pi
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nsegments
+  integer, intent(in) :: natom
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: bootstrap(9)
+  integer :: ladder_count
+  integer :: i
+  integer :: random_buffer_size
+  double precision, allocatable :: ladder(:)
+  type(arm_md_snapshot_t) :: bootstrap_md
+  integer :: md_valid_i
+  integer :: packed_md_size
+  integer :: md_ierr
+  character(len=arex_mpi_msg_len) :: md_message
+  real(dp), allocatable :: packed_md(:)
+
+  integer :: random_counter_boot
+  real(dp), allocatable :: random_boot(:)
+
+  real(dp), allocatable :: boot_theta(:,:)
+  real(dp), allocatable :: boot_dtheta(:,:)
+  real(dp), allocatable :: boot_vtheta(:,:)
+  real(dp), allocatable :: boot_dphold(:,:)
+  real(dp), allocatable :: boot_vphold(:,:)
+  integer :: boot_replica
+  integer :: boot_i
+  integer :: boot_ncopy
+  integer :: boot_ntheta
+  real(dp) :: boot_ph
+
+#ifdef CUDA
+  interface
+    subroutine gpu_pharex_random_buffer_size(nrandom)
+      integer, intent(out) :: nrandom
+    end subroutine gpu_pharex_random_buffer_size
+
+    subroutine gpu_pharex_capture(ph_theta_out, dph_theta_out, vph_theta_out, &
+                                  dphold_out, vphold_out, random_counter_out, &
+                                  random_out)
+      import dp
+      real(dp), intent(out) :: ph_theta_out(*)
+      real(dp), intent(out) :: dph_theta_out(*)
+      real(dp), intent(out) :: vph_theta_out(*)
+      real(dp), intent(out) :: dphold_out(*)
+      real(dp), intent(out) :: vphold_out(*)
+      integer, intent(out) :: random_counter_out
+      real(dp), intent(out) :: random_out(*)
+    end subroutine gpu_pharex_capture
+  end interface
+#endif
+
+  ierr = ARM_OK
+  message = ''
+
+  if (trim(adjustl(arex_type)) /= 'phrex') then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_send_bootstrap_to_scheduler: only arex_type=''phrex'' is supported'
+    return
+  end if
+
+  if (ntitr <= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_send_bootstrap_to_scheduler: ntitr must be > 0'
+    return
+  end if
+
+  ladder_count = 0
+  do i = 1, size(arex_ladder)
+    if (arex_ladder(i) == arex_ladder_unset) exit
+    ladder_count = ladder_count + 1
+  end do
+
+  if (ladder_count /= nreplicas) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_send_bootstrap_to_scheduler: ladder length does not match nreplicas'
+    return
+  end if
+
+  allocate(ladder(nreplicas))
+  ladder(:) = arex_ladder(1:nreplicas)
+
+  random_buffer_size = 0
+#ifdef CUDA
+  call gpu_pharex_random_buffer_size(random_buffer_size)
+#endif
+
+  random_counter_boot = 0
+  allocate(random_boot(max(1, random_buffer_size)))
+  random_boot(:) = 0.0_dp
+
+#ifdef CUDA
+  if (random_buffer_size > 0) then
+    call gpu_pharex_capture(ph_theta, dph_theta, vph_theta, &
+                            dphold, vphold, random_counter_boot, random_boot)
+  end if
+#endif
+
+  boot_ntheta = size(ph_theta)
+
+  allocate(boot_theta(boot_ntheta, nreplicas), &
+           boot_dtheta(boot_ntheta, nreplicas), &
+           boot_vtheta(boot_ntheta, nreplicas), &
+           boot_dphold(boot_ntheta, nreplicas), &
+           boot_vphold(boot_ntheta, nreplicas))
+
+  boot_theta(:,:)  = 0.0_dp
+  boot_dtheta(:,:) = 0.0_dp
+  boot_vtheta(:,:) = 0.0_dp
+  boot_dphold(:,:) = 0.0_dp
+  boot_vphold(:,:) = 0.0_dp
+
+  boot_ncopy = min(ntitr, boot_ntheta)
+
+  do boot_replica = 1, nreplicas
+    boot_theta(:, boot_replica)  = ph_theta(1:boot_ntheta)
+    boot_dtheta(:, boot_replica) = dph_theta(1:boot_ntheta)
+    boot_vtheta(:, boot_replica) = vph_theta(1:boot_ntheta)
+    boot_dphold(:, boot_replica) = dphold(1:boot_ntheta)
+    boot_vphold(:, boot_replica) = vphold(1:boot_ntheta)
+
+    if (qphmdstart) then
+      boot_ph = ladder(boot_replica)
+
+      boot_dtheta(1:boot_ncopy, boot_replica) = 0.0_dp
+      boot_dphold(1:boot_ncopy, boot_replica) = 0.0_dp
+
+      do boot_i = 1, boot_ncopy
+        select case (sp_grp(boot_i))
+        case (0, 1, 3)
+          if (boot_ph >= local_model_pka(boot_i)) then
+            boot_theta(boot_i, boot_replica) = 0.5_dp * pi
+          else
+            boot_theta(boot_i, boot_replica) = 0.0_dp
+          end if
+
+        case (2, 4)
+          boot_theta(boot_i, boot_replica) = 0.5_dp * pi
+
+        case default
+          continue
+        end select
+      end do
+    end if
+  end do
+
+  md_valid_i = 0
+  md_message = ''
+  packed_md_size = arex_mpi_md_packed_size(natom)
+  allocate(packed_md(packed_md_size))
+  packed_md(:) = 0.0_dp
+
+  call arm_snapshot_allocate(bootstrap_md, natom, md_ierr, md_message)
+  if (md_ierr == ARM_OK) then
+    call arm_capture_common_md_state(bootstrap_md, md_ierr, md_message)
+  end if
+
+  if (md_ierr == ARM_OK .and. bootstrap_md%valid) then
+    call arex_mpi_pack_md_snapshot(bootstrap_md, packed_md, md_ierr, md_message)
+    if (md_ierr == ARM_OK) md_valid_i = 1
+  end if
+
+  bootstrap(1) = nreplicas
+  bootstrap(2) = nsegments
+  bootstrap(3) = natom
+  bootstrap(4) = size(ph_theta)
+  bootstrap(5) = ntitr
+  bootstrap(6) = random_buffer_size
+  bootstrap(7) = arex_warmup_segments
+  bootstrap(8) = arex_seed
+  bootstrap(9) = arex_chkfrq
+
+! write(0,*) 'AREX DBG worker sending scheduler bootstrap', &
+!          ' nreplicas=', nreplicas, &
+!          ' nsegments=', nsegments, &
+!          ' natom=', natom, &
+!          ' ntitr=', ntitr, &
+!          ' ladder_count=', ladder_count, &
+!          ' random_buffer_size=', random_buffer_size
+
+  call mpi_send(bootstrap, 9, mpi_integer, 0, AREX_MPI_TAG_BOOT, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(ladder, nreplicas, mpi_double_precision, 0, AREX_MPI_TAG_BOOT, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(md_valid_i, 1, mpi_integer, 0, AREX_MPI_TAG_BOOT, &
+                arex_sched_comm, err_code_mpi)
+
+  if (md_valid_i /= 0) then
+    call mpi_send(packed_md, packed_md_size, mpi_double_precision, 0, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  end if
+
+  call mpi_send(boot_theta, boot_ntheta*nreplicas, mpi_double_precision, 0, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  call mpi_send(boot_dtheta, boot_ntheta*nreplicas, mpi_double_precision, 0, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  call mpi_send(boot_vtheta, boot_ntheta*nreplicas, mpi_double_precision, 0, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  call mpi_send(boot_dphold, boot_ntheta*nreplicas, mpi_double_precision, 0, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  call mpi_send(boot_vphold, boot_ntheta*nreplicas, mpi_double_precision, 0, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  call mpi_send(iupdate, 1, mpi_integer, 0, AREX_MPI_TAG_BOOT, &
+                arex_sched_comm, err_code_mpi)
+
+  if (random_buffer_size > 0) then
+    call mpi_send(random_counter_boot, 1, mpi_integer, 0, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+    call mpi_send(random_boot, random_buffer_size, mpi_double_precision, 0, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, err_code_mpi)
+  end if
+
+!  write(0,*) 'AREX DBG worker finished sending scheduler bootstrap'
+
+  if (bootstrap_md%allocated) call arm_snapshot_deallocate(bootstrap_md)
+  if (allocated(packed_md)) deallocate(packed_md)
+  if (allocated(random_boot)) deallocate(random_boot)
+  if (allocated(boot_theta)) deallocate(boot_theta)
+  if (allocated(boot_dtheta)) deallocate(boot_dtheta)
+  if (allocated(boot_vtheta)) deallocate(boot_vtheta)
+  if (allocated(boot_dphold)) deallocate(boot_dphold)
+  if (allocated(boot_vphold)) deallocate(boot_vphold)
+  deallocate(ladder)
+end subroutine arex_mpi_send_bootstrap_to_scheduler
+
+!===============================================================================
+! Receive the initial bootstrap payload and initialize the detached scheduler.
+!===============================================================================
+subroutine arex_mpi_scheduler_bootstrap(state, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arm_payload_api_t) :: payload_api
+
+  integer :: bootstrap(9)
+  integer :: status(mpi_status_size)
+  integer :: source_rank
+  integer :: nreplicas
+  integer :: nsegments
+  integer :: natom
+  integer :: ntheta
+  integer :: ntitr
+  integer :: random_buffer_size
+  integer :: warmup_segments_target
+  integer :: arex_seed_local
+  integer :: master_comm_size
+  integer :: alloc_stat
+
+  integer :: arex_io_ierr
+  integer :: ladder_count_local
+  integer :: dbg_i
+  integer :: restored_warmup_segments_target
+  integer :: restored_warmup_segments_completed
+  integer :: max_completed_segments
+  integer :: resume_segments_target
+  double precision, allocatable :: ladder(:)
+
+  character(len=arex_mpi_msg_len) :: bcast_message
+  character(len=256) :: arex_io_message
+
+  type(arm_md_snapshot_t) :: initial_md
+  integer :: initial_md_valid_i
+  integer :: packed_md_size
+  integer :: unpack_ierr
+  character(len=arex_mpi_msg_len) :: unpack_message
+  real(dp), allocatable :: packed_md(:)
+
+  real(dp), allocatable :: boot_theta(:,:)
+  real(dp), allocatable :: boot_dtheta(:,:)
+  real(dp), allocatable :: boot_vtheta(:,:)
+  real(dp), allocatable :: boot_dphold(:,:)
+  real(dp), allocatable :: boot_vphold(:,:)
+
+  integer :: boot_iupdate
+  integer :: boot_random_counter
+  real(dp), allocatable :: boot_random(:)
+
+  ierr = ARM_OK
+  message = ''
+  bcast_message = ''
+  arex_mpi_mdinfo_total_steps = 0
+
+  state%initialized = .false.
+  state%is_group_master = .false.
+  state%is_global_master = .true.
+  state%have_master_comm = arex_sched_comm .ne. mpi_comm_null
+  state%worker_id = 0
+  state%nworkers = 0
+  state%warmup_active = .false.
+  state%warmup_segments_target = 0
+  state%warmup_segments_completed = 0
+  state%checkpoint_frequency = 0
+  state%checkpoint_segments_since_write = 0
+  state%stop_requested = .false.
+  state%assigned_md_ready = .false.
+  state%assigned_replica_id = 0
+  state%assigned_completed_segments = 0
+  state%active_replica_id = 0
+  state%active_slot_id = 0
+
+  if (.not. state%have_master_comm) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: arex_sched_comm is null'
+    goto 900
+  end if
+
+  call mpi_comm_size(arex_sched_comm, master_comm_size, err_code_mpi)
+  state%nworkers = master_comm_size - 1
+
+  if (state%nworkers <= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: no AREX workers found in arex_sched_comm'
+    goto 900
+  end if
+
+  !write(0,*) 'AREX DBG scheduler waiting for bootstrap on arex_sched_comm'
+  call mpi_recv(bootstrap, 9, mpi_integer, mpi_any_source, AREX_MPI_TAG_BOOT, &
+                arex_sched_comm, status, err_code_mpi)
+  source_rank = status(MPI_SOURCE)
+
+  nreplicas              = bootstrap(1)
+  nsegments              = bootstrap(2)
+  natom                  = bootstrap(3)
+  ntheta                 = bootstrap(4)
+  ntitr                  = bootstrap(5)
+  random_buffer_size     = bootstrap(6)
+  warmup_segments_target = bootstrap(7)
+  arex_seed_local        = bootstrap(8)
+  state%checkpoint_frequency = bootstrap(9)
+
+  if (state%checkpoint_frequency < 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: arex_chkfrq must be >= 0'
+    goto 900
+  end if
+
+  allocate(ladder(nreplicas), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    ierr = ARM_ERR_ALLOC
+    message = 'arex_mpi_scheduler_bootstrap: failed to allocate ladder'
+    goto 900
+  end if
+
+  call mpi_recv(ladder, nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  allocate(boot_theta(ntheta, nreplicas), boot_dtheta(ntheta, nreplicas), &
+           boot_vtheta(ntheta, nreplicas), boot_dphold(ntheta, nreplicas), &
+           boot_vphold(ntheta, nreplicas), &
+           boot_random(max(1, random_buffer_size)), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    ierr = ARM_ERR_ALLOC
+    message = 'arex_mpi_scheduler_bootstrap: failed to allocate bootstrap PHREX state'
+    goto 900
+  end if
+
+  boot_theta(:,:) = 0.0_dp
+  boot_dtheta(:,:) = 0.0_dp
+  boot_vtheta(:,:) = 0.0_dp
+  boot_dphold(:,:) = 0.0_dp
+  boot_vphold(:,:) = 0.0_dp
+  boot_iupdate = 0
+  boot_random_counter = 0
+  boot_random(:) = 0.0_dp
+
+  initial_md_valid_i = 0
+  call mpi_recv(initial_md_valid_i, 1, mpi_integer, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+
+  call arm_snapshot_allocate(initial_md, natom, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  if (initial_md_valid_i /= 0) then
+    packed_md_size = arex_mpi_md_packed_size(natom)
+    allocate(packed_md(packed_md_size), stat=alloc_stat)
+    if (alloc_stat /= 0) then
+      ierr = ARM_ERR_ALLOC
+      message = 'arex_mpi_scheduler_bootstrap: failed to allocate bootstrap MD buffer'
+      goto 900
+    end if
+
+    call mpi_recv(packed_md, packed_md_size, mpi_double_precision, source_rank, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+
+    unpack_message = ''
+    call arex_mpi_unpack_md_snapshot(initial_md, packed_md, unpack_ierr, unpack_message)
+    if (unpack_ierr /= ARM_OK) then
+      ierr = unpack_ierr
+      message = trim(unpack_message)
+      goto 900
+    end if
+
+    initial_md%valid = .true.
+  end if
+
+  call mpi_recv(boot_theta, ntheta*nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(boot_dtheta, ntheta*nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(boot_vtheta, ntheta*nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(boot_dphold, ntheta*nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(boot_vphold, ntheta*nreplicas, mpi_double_precision, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(boot_iupdate, 1, mpi_integer, source_rank, &
+                AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+
+  if (random_buffer_size > 0) then
+    call mpi_recv(boot_random_counter, 1, mpi_integer, source_rank, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+    call mpi_recv(boot_random, random_buffer_size, mpi_double_precision, source_rank, &
+                  AREX_MPI_TAG_BOOT, arex_sched_comm, status, err_code_mpi)
+  end if
+
+  if (size(arex_ladder) < nreplicas) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: local arex_ladder storage is smaller than bootstrapped replica count'
+    goto 900
+  end if
+
+  arex_ladder(:) = arex_ladder_unset
+  arex_ladder(1:nreplicas) = ladder(:)
+
+ !write(0,*) 'AREX DBG scheduler received bootstrap', &
+ !         ' source_rank=', source_rank, &
+ !         ' nreplicas=', nreplicas, &
+ !         ' nsegments=', nsegments, &
+ !         ' natom=', natom, &
+ !         ' ntheta=', ntheta, &
+ !         ' ntitr=', ntitr, &
+ !         ' random_buffer_size=', random_buffer_size
+
+  call arm_manager_init(state%mgr, nreplicas, state%nworkers, natom, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  call arm_set_segments_per_replica(state%mgr, nsegments, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  call arex_pay_phrex_build_api(payload_api, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  call arm_register_payload(state%mgr, payload_api, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  call arex_pay_phrex_init_authoritative_storage(nreplicas, nreplicas, ntheta, ntitr, &
+                                                 ladder, random_buffer_size, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+  if (.not. arexrst_specified) then
+    call arex_pay_phrex_seed_all_replicas(boot_theta, boot_dtheta, boot_vtheta, &
+                                          boot_dphold, boot_vphold, boot_iupdate, &
+                                          boot_random_counter, boot_random, &
+                                          ierr, message)
+    if (ierr /= ARM_OK) goto 900
+  end if
+
+  call arm_begin_epoch(state%mgr, ierr, message)
+  if (ierr /= ARM_OK) goto 900
+
+  allocate(state%pending_request(state%nworkers), &
+           state%resident_valid(state%nworkers),  &
+           state%resident_replica(state%nworkers), &
+           state%resident_slot(state%nworkers),   &
+           stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    ierr = ARM_ERR_ALLOC
+    message = 'arex_mpi_scheduler_bootstrap: allocate pending/resident arrays failed'
+    goto 900
+  end if
+
+  allocate(state%response_ready(state%nworkers), &
+           state%worker_finished(state%nworkers), &
+           state%response_ierr(state%nworkers),    &
+           state%response_done(state%nworkers),    &
+           state%response_replica(state%nworkers), &
+           state%response_slot(state%nworkers),    &
+           state%response_completed_segments(state%nworkers), &
+           state%response_sync_mode(state%nworkers), &
+           state%response_restart_number(state%nworkers), &
+           state%response_msg(state%nworkers),     &
+           stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    ierr = ARM_ERR_ALLOC
+    message = 'arex_mpi_scheduler_bootstrap: allocate response arrays failed'
+    goto 900
+  end if
+
+  state%pending_request(:)    = .false.
+  state%response_ready(:)     = .false.
+  state%worker_finished(:)    = .false.
+
+  state%resident_valid(:)     = .false.
+  state%resident_replica(:)   = 0
+  state%resident_slot(:)      = 0
+
+  state%response_ierr(:)      = ARM_OK
+  state%response_done(:)      = 0
+  state%response_replica(:)   = 0
+  state%response_slot(:)      = 0
+  state%response_completed_segments(:) = 0
+  state%response_sync_mode(:) = AREX_MPI_SYNC_FULL
+  state%response_restart_number(:) = 0
+  state%response_msg(:)       = ''
+
+  ladder_count_local = arex_rst_ladder_count()
+
+ !write(0,*) 'AREX DBG scheduler local ladder check', &
+ !         ' ladder_count_local=', ladder_count_local, &
+ !         ' nreplicas=', nreplicas, &
+ !         ' size(arex_ladder)=', size(arex_ladder), &
+ !         ' arex_ladder_unset=', arex_ladder_unset
+
+  do dbg_i = 1, min(size(arex_ladder), 16)
+   !write(0,*) 'AREX DBG scheduler arex_ladder entry', &
+   !         ' i=', dbg_i, &
+   !         ' value=', arex_ladder(dbg_i)
+    if (arex_ladder(dbg_i) == arex_ladder_unset) exit
+  end do
+
+  if (ladder_count_local <= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: invalid local AREX ladder count'
+    goto 900
+  end if
+
+  if (ladder_count_local /= nreplicas) then
+   !write(0,*) 'AREX DBG scheduler ladder mismatch', &
+   !         ' ladder_count_local=', ladder_count_local, &
+   !         ' nreplicas=', nreplicas
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_scheduler_bootstrap: local ladder count mismatch; see scheduler debug log'
+    goto 900
+  end if
+
+  ! The scheduler is a dedicated MPI rank and did not read the initial
+  ! coordinate restart.  Give its slot I/O contexts the same absolute time
+  ! origin as the workers, rather than the scheduler's default t (zero).
+  ! On -arexrst, the checkpoint restores the authoritative slot origins.
+  if (.not. arexrst_specified .and. initial_md%valid) then
+    t = initial_md%time
+  end if
+
+  arex_io_ierr = 0
+  arex_io_message = ''
+  call arex_io_init(ladder_count_local, .true., arex_io_ierr, arex_io_message)
+  if (arex_io_ierr /= 0) then
+    ierr = ARM_ERR_INVALID
+    message = trim(arex_io_message)
+    goto 900
+  end if
+
+  if (arexrst_specified) then
+    !write(0,*) 'AREX DBG scheduler before restore_from_checkpoint', trim(arexrst_name)
+    call arex_rst_restore_from_checkpoint(trim(arexrst_name), state%mgr, ierr, message)
+    !write(0,*) 'AREX DBG scheduler after restore_from_checkpoint', &
+    !          ' ierr=', ierr, ' msg=', trim(message)
+    if (ierr /= AREX_RST_OK) goto 900
+
+    restored_warmup_segments_target = 0
+    restored_warmup_segments_completed = 0
+    call arex_rst_get_checkpoint_warmup_state(trim(arexrst_name), &
+         restored_warmup_segments_target, restored_warmup_segments_completed, &
+         ierr, message)
+    if (ierr /= AREX_RST_OK) goto 900
+
+    max_completed_segments = 0
+    do dbg_i = 1, state%mgr%nreplicas
+      if (state%mgr%replicas(dbg_i)%segments_completed > max_completed_segments) then
+        max_completed_segments = state%mgr%replicas(dbg_i)%segments_completed
+      end if
+    end do
+
+    ! Continuation semantics:
+    !   resume from checkpointed progress and extend by the amount requested
+    !   in the current input. Because the manager target is scalar, anchor the
+    !   new target to the most advanced restored replica.
+    resume_segments_target = max_completed_segments + nsegments
+    call arm_set_segments_per_replica(state%mgr, resume_segments_target, ierr, message)
+    if (ierr /= ARM_OK) goto 900
+
+    ! mdinfo uses the slot-logical coordinate, which includes any completed
+    ! AREX warmup segments.  This value is reporting-only; it does not affect
+    ! the scheduler target or MD execution.
+    arex_mpi_mdinfo_total_steps = &
+      (resume_segments_target + restored_warmup_segments_completed) * &
+      arex_segment_steps
+
+    ! Restart warmup policy:
+    !   - if current restart input disables warmup, continue immediately
+    !   - if current restart input enables warmup, resume only unfinished
+    !     checkpointed warmup; never restart warmup from zero
+    if (warmup_segments_target > 0 .and. &
+        restored_warmup_segments_completed < restored_warmup_segments_target) then
+      state%warmup_segments_target = restored_warmup_segments_target
+      state%warmup_segments_completed = restored_warmup_segments_completed
+      state%warmup_active = .true.
+    else
+      state%warmup_segments_target = 0
+      state%warmup_segments_completed = 0
+      state%warmup_active = .false.
+    end if
+
+  else
+    call arm_seed_initial_snapshots(state%mgr, ierr, message)
+    if (ierr /= ARM_OK) goto 900
+
+    if (.not. initial_md%valid) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_mpi_scheduler_bootstrap: initial MD snapshot is invalid'
+      goto 900
+    end if
+
+    do dbg_i = 1, state%mgr%nreplicas
+      state%mgr%replicas(dbg_i)%md%crd      = initial_md%crd
+      state%mgr%replicas(dbg_i)%md%vel      = initial_md%vel
+      state%mgr%replicas(dbg_i)%md%last_vel = initial_md%last_vel
+      state%mgr%replicas(dbg_i)%md%box      = initial_md%box
+      state%mgr%replicas(dbg_i)%md%alpha    = initial_md%alpha
+      state%mgr%replicas(dbg_i)%md%beta     = initial_md%beta
+      state%mgr%replicas(dbg_i)%md%gamma    = initial_md%gamma
+      state%mgr%replicas(dbg_i)%md%time     = initial_md%time
+      state%mgr%replicas(dbg_i)%md%valid    = .true.
+    end do
+
+    state%warmup_segments_target = warmup_segments_target
+    state%warmup_segments_completed = 0
+    state%warmup_active = state%warmup_segments_target > 0
+  end if
+
+  ! Fresh campaigns seed the scheduler exchange RNG from arex_seed. Exact
+  ! continuation restores the checkpointed intrinsic RNG state in arex_rst.
+  if (.not. arexrst_specified) then
+    call arex_mpi_seed_rng_from_integer(arex_seed_local)
+  end if
+
+  state%initialized = .true.
+
+  ! An in-place append from arex.chk.K must not reuse K's filename.
+  if (arex_append .and. arexrst_specified) then
+    dbg_i = scan(trim(arex_checkpoint_output_name), '.', back=.true.)
+    if (dbg_i > 0) then
+      read(arex_checkpoint_output_name(dbg_i+1:), *, iostat=alloc_stat) &
+        state%last_checkpoint_number
+      if (alloc_stat == 0 .and. state%last_checkpoint_number > 0) then
+        arex_checkpoint_output_name = arex_checkpoint_output_name(:dbg_i-1)
+      else
+        state%last_checkpoint_number = 0
+      end if
+    end if
+  end if
+  call arex_mpi_choose_epoch_restart(state)
+
+900 continue
+  bcast_message = ''
+  if (len_trim(message) > 0) bcast_message = message
+
+  call mpi_bcast(ierr, 1, mpi_integer, 0, arex_sched_comm, err_code_mpi)
+  call mpi_bcast(arex_mpi_mdinfo_total_steps, 1, mpi_integer, 0, &
+                 arex_sched_comm, err_code_mpi)
+  call mpi_bcast(bcast_message, arex_mpi_msg_len, mpi_character, 0, &
+                 arex_sched_comm, err_code_mpi)
+
+  if (initial_md%allocated) call arm_snapshot_deallocate(initial_md)
+  if (allocated(packed_md)) deallocate(packed_md)
+  if (allocated(boot_theta)) deallocate(boot_theta)
+  if (allocated(boot_dtheta)) deallocate(boot_dtheta)
+  if (allocated(boot_vtheta)) deallocate(boot_vtheta)
+  if (allocated(boot_dphold)) deallocate(boot_dphold)
+  if (allocated(boot_vphold)) deallocate(boot_vphold)
+  if (allocated(boot_random)) deallocate(boot_random)
+
+  if (allocated(ladder)) deallocate(ladder)
+
+  if (ierr /= ARM_OK) then
+    if (allocated(state%pending_request))  deallocate(state%pending_request)
+    if (allocated(state%response_ready))   deallocate(state%response_ready)
+    if (allocated(state%worker_finished))  deallocate(state%worker_finished)
+    if (allocated(state%response_ierr))    deallocate(state%response_ierr)
+    if (allocated(state%response_done))    deallocate(state%response_done)
+    if (allocated(state%response_replica)) deallocate(state%response_replica)
+    if (allocated(state%response_slot))   deallocate(state%response_slot)
+    if (allocated(state%response_completed_segments)) &
+      deallocate(state%response_completed_segments)
+    if (allocated(state%response_restart_number)) deallocate(state%response_restart_number)
+    if (allocated(state%response_msg))    deallocate(state%response_msg)
+  end if
+end subroutine arex_mpi_scheduler_bootstrap
+
+!===============================================================================
+! Capture and send one completed common MD snapshot from a worker-group master
+! to the detached scheduler rank.
+!===============================================================================
+subroutine arex_mpi_send_completed_state_to_scheduler(state, ierr, message)
+  use prmtop_dat_mod, only : natom
+
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arm_md_snapshot_t) :: local_md
+
+  integer :: alloc_ierr
+  integer :: root_ierr
+  integer :: pack_ierr
+  integer :: valid_i
+  integer :: packed_size
+  character(len=arex_mpi_msg_len) :: alloc_message
+  character(len=arex_mpi_msg_len) :: root_message
+  character(len=arex_mpi_msg_len) :: pack_message
+  real(dp), allocatable :: packed_md(:)
+
+  ierr = ARM_OK
+  message = ''
+  alloc_message = ''
+  root_message = ''
+  pack_message = ''
+  root_ierr = ARM_OK
+  valid_i = 0
+
+  if (.not. state%is_group_master) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_send_completed_state_to_scheduler: not on worker-group master'
+    return
+  end if
+
+  if (.not. state%have_master_comm) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_send_completed_state_to_scheduler: arex_sched_comm is null'
+    return
+  end if
+
+  call arm_snapshot_allocate(local_md, natom, alloc_ierr, alloc_message)
+  if (alloc_ierr /= ARM_OK) then
+    ierr = alloc_ierr
+    if (len(message) > 0) message = alloc_message(1:len(message))
+    return
+  end if
+
+  call arm_capture_common_md_state(local_md, root_ierr, root_message)
+
+  if (root_ierr == ARM_OK .and. local_md%valid) valid_i = 1
+
+  call mpi_send(root_ierr, 1, mpi_integer, 0, AREX_MPI_TAG_COMPLETE_STATE, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(root_message, arex_mpi_msg_len, mpi_character, 0, &
+                AREX_MPI_TAG_COMPLETE_STATE, arex_sched_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    call arm_snapshot_deallocate(local_md)
+    return
+  end if
+
+  call mpi_send(valid_i, 1, mpi_integer, 0, AREX_MPI_TAG_COMPLETE_STATE, &
+                arex_sched_comm, err_code_mpi)
+
+  if (valid_i /= 0) then
+    packed_size = arex_mpi_md_packed_size(local_md%natom)
+    allocate(packed_md(packed_size))
+
+    call arex_mpi_pack_md_snapshot(local_md, packed_md, pack_ierr, pack_message)
+    if (pack_ierr /= ARM_OK) then
+      ierr = pack_ierr
+      if (len(message) > 0) message = pack_message(1:len(message))
+      deallocate(packed_md)
+      call arm_snapshot_deallocate(local_md)
+      return
+    end if
+
+    call mpi_send(packed_md, packed_size, mpi_double_precision, 0, &
+                  AREX_MPI_TAG_COMPLETE_STATE, arex_sched_comm, err_code_mpi)
+
+    deallocate(packed_md)
+  end if
+
+  call arm_snapshot_deallocate(local_md)
+end subroutine arex_mpi_send_completed_state_to_scheduler
+
+!===============================================================================
+! Receive one completed common MD snapshot from a worker-group master onto the
+! detached scheduler rank.
+!===============================================================================
+subroutine arex_mpi_recv_completed_state_from_worker(state, replica_id, source_master_rank, &
+                                                     ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: source_master_rank
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: unpack_ierr
+  integer :: packed_size
+  integer :: status(mpi_status_size)
+  character(len=arex_mpi_msg_len) :: root_message
+  character(len=arex_mpi_msg_len) :: unpack_message
+  real(dp), allocatable :: packed_md(:)
+
+  ierr = ARM_OK
+  message = ''
+  root_ierr = ARM_OK
+  root_message = ''
+  unpack_message = ''
+
+  if (.not. state%is_global_master) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_recv_completed_state_from_worker: not on detached scheduler rank'
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > state%mgr%nreplicas) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_recv_completed_state_from_worker: invalid replica_id'
+    return
+  end if
+
+  call mpi_recv(root_ierr, 1, mpi_integer, source_master_rank, AREX_MPI_TAG_COMPLETE_STATE, &
+                arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(root_message, arex_mpi_msg_len, mpi_character, source_master_rank, &
+                AREX_MPI_TAG_COMPLETE_STATE, arex_sched_comm, status, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_recv(valid_i, 1, mpi_integer, source_master_rank, AREX_MPI_TAG_COMPLETE_STATE, &
+                arex_sched_comm, status, err_code_mpi)
+
+  state%mgr%replicas(replica_id)%md%valid = valid_i /= 0
+
+  if (valid_i /= 0) then
+    packed_size = arex_mpi_md_packed_size(state%mgr%natom)
+    allocate(packed_md(packed_size))
+
+    call mpi_recv(packed_md, packed_size, mpi_double_precision, source_master_rank, &
+                  AREX_MPI_TAG_COMPLETE_STATE, arex_sched_comm, status, err_code_mpi)
+
+    call arex_mpi_unpack_md_snapshot(state%mgr%replicas(replica_id)%md, packed_md, &
+                                     unpack_ierr, unpack_message)
+    deallocate(packed_md)
+
+    if (unpack_ierr /= ARM_OK) then
+      ierr = unpack_ierr
+      if (len(message) > 0) message = unpack_message(1:len(message))
+      return
+    end if
+
+    state%mgr%replicas(replica_id)%md%valid = .true.
+
+  end if
+end subroutine arex_mpi_recv_completed_state_from_worker
+
+!===============================================================================
+! Initialize the MPI coordination layer.
+!
+! Only worker-group masters participate in arex_sched_comm. The global
+! master owns the authoritative generic manager state.
+!===============================================================================
+subroutine arex_mpi_init(state, nreplicas, nsegments, natom, payload_api, &
+                         ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nsegments
+  integer, intent(in) :: natom
+  type(arm_payload_api_t), intent(in) :: payload_api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: alloc_stat
+  integer :: cleanup_ierr
+  integer :: global_rank
+  integer :: master_comm_size
+  character(len=arex_mpi_msg_len) :: cleanup_message
+  character(len=arex_mpi_msg_len) :: master_message
+  logical :: mgr_initialized
+
+  ierr = ARM_OK
+  message = ''
+  arex_mpi_mdinfo_total_steps = 0
+
+  if (state%initialized) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_init: state already initialized'
+    return
+  end if
+
+  state%is_group_master = mytaskid .eq. 0
+  state%have_master_comm = arex_sched_comm .ne. mpi_comm_null
+
+  state%is_global_master = .false.
+  state%worker_id = 0
+  state%nworkers = 0
+  state%active_replica_id = 0
+  state%active_slot_id = 0
+
+  state%warmup_active = .false.
+  state%warmup_segments_target = 0
+  state%warmup_segments_completed = 0
+  state%stop_requested = .false.
+
+  if (state%is_group_master) then
+    if (state%have_master_comm) then
+      call mpi_comm_rank(arex_sched_comm, global_rank, err_code_mpi)
+      call mpi_comm_size(arex_sched_comm, master_comm_size, err_code_mpi)
+
+      if (global_rank == 0) then
+        ierr = ARM_ERR_INVALID
+        message = 'arex_mpi_init: detached scheduler rank must not call worker initialization'
+      else
+        state%worker_id = global_rank
+        state%nworkers = master_comm_size - 1
+      end if
+
+      state%is_global_master = .false.
+    else
+      state%worker_id = 1
+      state%nworkers = 1
+      state%is_global_master = .false.
+    end if
+  end if
+
+  call mpi_bcast(state%worker_id, 1, mpi_integer, 0, pmemd_comm, &
+                 err_code_mpi)
+  call mpi_bcast(state%nworkers, 1, mpi_integer, 0, pmemd_comm, &
+                 err_code_mpi)
+
+  mgr_initialized = .false.
+
+  if (state%is_global_master) then
+    call arm_manager_init(state%mgr, nreplicas, state%nworkers, natom, &
+                          ierr, message)
+    if (ierr == ARM_OK) mgr_initialized = .true.
+
+    if (ierr == ARM_OK) then
+      call arm_set_segments_per_replica(state%mgr, nsegments, ierr, &
+                                        message)
+    end if
+
+    if (ierr == ARM_OK) then
+      call arm_register_payload(state%mgr, payload_api, ierr, message)
+    end if
+
+    if (ierr == ARM_OK) then
+      call arm_begin_epoch(state%mgr, ierr, message)
+    end if
+
+    if (ierr == ARM_OK) then
+      call arm_seed_initial_snapshots(state%mgr, ierr, message)
+    end if
+
+    if (ierr == ARM_OK) then
+      state%warmup_segments_target = arex_warmup_segments
+      state%warmup_segments_completed = 0
+      state%warmup_active = state%warmup_segments_target > 0
+
+#ifdef AREX_DEBUG
+      if (state%warmup_active) then
+        write(mdout,'(a,i0,a)') ' AREX> warmup enabled for ', &
+             state%warmup_segments_target, ' segment(s) per replica before exchanges.'
+      end if
+#endif
+    end if
+
+    if (ierr == ARM_OK) then
+      allocate(state%pending_request(state%nworkers), stat=alloc_stat)
+      if (alloc_stat /= 0) then
+        ierr = ARM_ERR_INVALID
+        message = 'arex_mpi_init: allocate pending_request failed'
+      end if
+    end if
+
+    if (ierr == ARM_OK) then
+      allocate(state%response_ready(state%nworkers), &
+               state%response_ierr(state%nworkers), &
+               state%response_done(state%nworkers), &
+               state%response_replica(state%nworkers), &
+               state%response_slot(state%nworkers), &
+               state%response_msg(state%nworkers), &
+               stat=alloc_stat)
+      if (alloc_stat /= 0) then
+        ierr = ARM_ERR_INVALID
+        message = 'arex_mpi_init: allocate response arrays failed'
+      end if
+    end if
+
+    if (ierr == ARM_OK) then
+      state%pending_request(:) = .false.
+      state%response_ready(:) = .false.
+      state%response_ierr(:) = ARM_OK
+      state%response_done(:) = 0
+      state%response_replica(:) = 0
+      state%response_slot(:) = 0
+      state%response_msg(:) = ''
+    else
+      if (allocated(state%pending_request)) deallocate(state%pending_request)
+      if (allocated(state%response_ready))  deallocate(state%response_ready)
+      if (allocated(state%response_ierr))   deallocate(state%response_ierr)
+      if (allocated(state%response_done))   deallocate(state%response_done)
+      if (allocated(state%response_replica)) deallocate(state%response_replica)
+      if (allocated(state%response_slot))   deallocate(state%response_slot)
+      if (allocated(state%response_msg))    deallocate(state%response_msg)
+
+      if (mgr_initialized) then
+        cleanup_message = ''
+        call arm_manager_finalize(state%mgr, cleanup_ierr, cleanup_message)
+      end if
+    end if
+  end if
+
+  master_message = ''
+
+  if (state%is_group_master .and. state%have_master_comm) then
+    if (state%worker_id == 1) then
+      call arex_mpi_send_bootstrap_to_scheduler(nreplicas, nsegments, natom, &
+                                                ierr, message)
+    end if
+
+    call mpi_bcast(ierr, 1, mpi_integer, 0, arex_sched_comm, &
+                   err_code_mpi)
+    call mpi_bcast(arex_mpi_mdinfo_total_steps, 1, mpi_integer, 0, &
+                   arex_sched_comm, err_code_mpi)
+    call mpi_bcast(master_message, arex_mpi_msg_len, mpi_character, 0, &
+                   arex_sched_comm, err_code_mpi)
+
+    if (len(message) > 0) message = master_message(1:len(message))
+  end if
+
+  if (state%is_group_master) then
+    master_message = ''
+    if (len_trim(message) > 0) master_message = message
+  end if
+
+  call mpi_bcast(ierr, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(arex_mpi_mdinfo_total_steps, 1, mpi_integer, 0, &
+                 pmemd_comm, err_code_mpi)
+  call mpi_bcast(master_message, arex_mpi_msg_len, mpi_character, 0, &
+                 pmemd_comm, err_code_mpi)
+
+  if (len(message) > 0) message = master_message(1:len(message))
+
+  if (ierr == ARM_OK) state%initialized = .true.
+end subroutine arex_mpi_init
+
+!===============================================================================
+! Finalize the MPI coordination layer.
+!===============================================================================
+subroutine arex_mpi_finalize(state, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: mgr_ierr
+  character(len=arex_mpi_msg_len) :: mgr_message
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%initialized) then
+    ierr = ARM_OK
+    return
+  end if
+
+  mgr_ierr = ARM_OK
+  mgr_message = ''
+
+  if (state%is_global_master) then
+    call arm_manager_finalize(state%mgr, mgr_ierr, mgr_message)
+
+    if (allocated(state%pending_request)) deallocate(state%pending_request)
+    if (allocated(state%response_ready))  deallocate(state%response_ready)
+    if (allocated(state%worker_finished)) deallocate(state%worker_finished)
+    if (allocated(state%response_ierr))   deallocate(state%response_ierr)
+    if (allocated(state%response_done))   deallocate(state%response_done)
+    if (allocated(state%response_replica)) &
+      deallocate(state%response_replica)
+    if (allocated(state%response_slot))   deallocate(state%response_slot)
+    if (allocated(state%response_msg))    deallocate(state%response_msg)
+    if (allocated(state%resident_valid))     deallocate(state%resident_valid)
+    if (allocated(state%resident_replica))   deallocate(state%resident_replica)
+    if (allocated(state%resident_slot))      deallocate(state%resident_slot)
+    if (allocated(state%response_sync_mode)) deallocate(state%response_sync_mode)
+  end if
+
+  if (state%assigned_md%allocated) then
+    call arm_snapshot_deallocate(state%assigned_md)
+  end if
+
+  state%assigned_sync_mode = AREX_MPI_SYNC_FULL
+  state%assigned_md_ready = .false.
+  state%assigned_replica_id = 0
+  state%assigned_completed_segments = 0
+  state%active_replica_id = 0
+  state%active_slot_id = 0
+  state%initialized = .false.
+  state%is_group_master = .false.
+  state%is_global_master = .false.
+  state%have_master_comm = .false.
+  state%worker_id = 0
+  state%nworkers = 0
+  state%stop_requested = .false.
+  state%assigned_md_ready = .false.
+  state%assigned_replica_id = 0
+  state%assigned_completed_segments = 0
+
+  state%warmup_active = .false.
+  state%warmup_segments_target = 0
+  state%warmup_segments_completed = 0
+
+  ierr = mgr_ierr
+  if (len(message) > 0) message = mgr_message(1:len(message))
+end subroutine arex_mpi_finalize
+
+!===============================================================================
+! Apply the restraint schedule for the newly assigned slot and make any error
+! status consistent across the worker's pmemd_comm ranks.
+!===============================================================================
+subroutine arex_mpi_apply_assigned_restraint(state, ierr, message)
+
+  type(arex_mpi_state_t), intent(in) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: local_ierr
+  integer :: group_ierr
+  character(len=arex_mpi_msg_len) :: local_message
+
+  ierr = ARM_OK
+  message = ''
+
+  ! Avoid an additional collective at every assignment when the feature is
+  ! disabled.
+  if (arex_restraint_npoints <= 0) return
+
+  local_ierr = ARM_OK
+  local_message = ''
+
+  call arex_restraint_apply(state%assigned_completed_segments, &
+                            local_ierr, local_message)
+
+  call mpi_allreduce(local_ierr, group_ierr, 1, mpi_integer, mpi_max, &
+                     pmemd_comm, err_code_mpi)
+
+  ierr = group_ierr
+
+  if (group_ierr == ARM_OK) return
+
+  if (local_ierr /= ARM_OK) then
+    message = trim(local_message)
+  else
+    message = 'arex_mpi_apply_assigned_restraint: failure on another worker-group rank'
+  end if
+
+end subroutine arex_mpi_apply_assigned_restraint
+
+!===============================================================================
+! Request the initial assignment for this worker.
+!
+! All ranks in pmemd_comm call this routine. Only the worker-group master
+! communicates across arex_sched_comm. The assignment is then broadcast
+! inside the local pmemd_comm group.
+!===============================================================================
+subroutine arex_mpi_begin_worker(state, campaign_done, replica_id, slot_id, &
+                                 ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  logical, intent(out) :: campaign_done
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: done_i
+  integer :: completed_segments_i
+
+  campaign_done = .false.
+  replica_id = 0
+  slot_id = 0
+  ierr = ARM_OK
+  message = ''
+
+  completed_segments_i = 0
+  state%assigned_sync_mode = AREX_MPI_SYNC_FULL
+  state%assigned_completed_segments = 0
+
+  if (.not. state%initialized) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_begin_worker: state not initialized'
+  else if (state%is_group_master) then
+    if (state%is_global_master) then
+      call arex_mpi_service_local_request(state, AREX_MPI_REQ_ASSIGN, &
+                                          done_i, replica_id, slot_id, &
+                                          ierr, message)
+      if (ierr == ARM_OK .and. done_i == 0 .and. &
+          replica_id > 0 .and. slot_id > 0) then
+        completed_segments_i = state%mgr%slot_segments_completed(slot_id)
+      end if
+    else
+      call arex_mpi_send_request_and_wait(state, AREX_MPI_REQ_ASSIGN, &
+                                          done_i, replica_id, slot_id, &
+                                          ierr, message)
+      completed_segments_i = state%assigned_completed_segments
+    end if
+    state%assigned_completed_segments = completed_segments_i
+    campaign_done = done_i /= 0
+  end if
+  call mpi_bcast(ierr, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(state%assigned_sync_mode, 1, mpi_integer, 0, pmemd_comm, &
+                 err_code_mpi)
+  call mpi_bcast(state%assigned_restart_number, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(replica_id, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(slot_id, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(state%assigned_completed_segments, 1, mpi_integer, 0, &
+                 pmemd_comm, err_code_mpi)
+  call arex_mpi_sync_assigned_slot_bintraj_metadata(state, campaign_done, replica_id, &
+                                                    slot_id, state%assigned_completed_segments, &
+                                                    ierr, message)
+
+ !  if (state%is_group_master) then
+ !  write(0,'(a,i0,a,i0,a,i0,a,i0,a,l1,a,i0,a,a)') &
+ !       'AREX DBG begin_worker after first metadata: worker=', state%worker_id, &
+ !       ' replica=', replica_id, &
+ !       ' slot=', slot_id, &
+ !       ' completed=', state%assigned_completed_segments, &
+ !       ' campaign_done=', campaign_done, &
+ !       ' ierr=', ierr, &
+ !       ' msg=', trim(message)
+ !  call flush(0)
+ !end if
+  call mpi_bcast(campaign_done, 1, mpi_logical, 0, pmemd_comm, &
+                 err_code_mpi)
+  if (len(message) > 0) then
+    call mpi_bcast(message, len(message), mpi_character, 0, pmemd_comm, &
+                   err_code_mpi)
+  end if
+
+ !write(0,*) 'AREX MPI DBG worker after begin_worker', &
+ !         ' local_worker_id=', state%worker_id, &
+ !         ' mytaskid=', mytaskid, &
+ !         ' replica=', replica_id, &
+ !         ' slot=', slot_id, &
+ !         ' sync_mode=', state%assigned_sync_mode, &
+ !         ' campaign_done=', campaign_done, &
+ !         ' ierr=', ierr
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    call arex_mpi_sync_assigned_state(state, replica_id, slot_id, ierr, message)
+    if (ierr == ARM_OK) then
+      call arex_mpi_apply_assigned_restraint(state, ierr, message)
+    end if
+   !    if (state%is_group_master) then
+   !  write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,a)') &
+   !       'AREX DBG begin_worker after sync_state: worker=', state%worker_id, &
+   !       ' replica=', replica_id, &
+   !       ' slot=', slot_id, &
+   !       ' sync=', state%assigned_sync_mode, &
+   !       ' ierr=', ierr, &
+   !       ' msg=', trim(message)
+   !  call flush(0)
+   !end if
+  end if
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    call arex_mpi_sync_assigned_slot_bintraj_metadata(state, campaign_done, replica_id, &
+                                                      slot_id, state%assigned_completed_segments, &
+                                                      ierr, message)
+   !    if (state%is_group_master) then
+   !  write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,a)') &
+   !       'AREX DBG begin_worker after second metadata: worker=', state%worker_id, &
+   !       ' replica=', replica_id, &
+   !       ' slot=', slot_id, &
+   !       ' completed=', state%assigned_completed_segments, &
+   !       ' ierr=', ierr, &
+   !       ' msg=', trim(message)
+   !  call flush(0)
+   !end if
+  end if
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    state%active_replica_id = replica_id
+    state%active_slot_id    = slot_id
+  else
+    state%active_replica_id = 0
+    state%active_slot_id    = 0
+  end if
+
+end subroutine arex_mpi_begin_worker
+
+!===============================================================================
+! Synchronize authoritative slot-owned trajectory metadata for the newly
+! assigned slot. This prevents workers from maintaining private per-slot
+! logical step counters when a slot migrates between workers.
+!
+! Only portable metadata is synchronized here:
+!   - logical slot steps
+!   - next frame indices
+!   - local-handle validity/initialization policy
+!
+! Process-local NetCDF handles (ncid / var ids) are NOT authoritative and must
+! be reopened locally when a slot migrates to a different worker.
+!===============================================================================
+! Read the source checkpoint once per worker MPI rank.  Slots may move
+! between workers, but every worker must calculate frame indices relative to
+! the same per-slot part-start step rather than its first assignment.
+subroutine arex_mpi_cache_part_origins(ierr, message)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  type(arex_rst_checkpoint_t) :: ckpt
+  integer :: i, nslots
+  integer, allocatable :: source_old_slot(:), source_old_replica(:), source_restart_slot(:)
+  logical, allocatable :: retained(:)
+  logical :: migrating
+
+  ierr = ARM_OK
+  message = ''
+  if (.not. arexrst_specified) return
+  if (allocated(arex_part_start_steps)) return
+
+  call arex_rst_read_checkpoint(trim(arexrst_name), ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  nslots = ckpt%nslots
+  migrating = .false.
+  if (.not. arex_append) then
+    nslots = arex_rst_ladder_count()
+    migrating = (nslots /= ckpt%nslots)
+    if (.not. migrating) &
+      migrating = any(abs(arex_ladder(1:nslots) - ckpt%slot_ladder(:)) > 1.0e-12_dp)
+  end if
+
+  if (migrating) then
+    ! Use the scheduler's existing migration mapping for the new slot origins.
+    allocate(source_old_slot(nslots), source_old_replica(nslots), &
+             source_restart_slot(nslots), retained(nslots))
+    call arex_rst_build_migration_map(ckpt, source_old_slot, source_old_replica, &
+                                      source_restart_slot, retained, ierr, message)
+    if (ierr /= AREX_RST_OK) then
+      call arex_rst_release_checkpoint(ckpt)
+      return
+    end if
+  end if
+
+  allocate(arex_part_start_steps(nslots), arex_part_time_origins(nslots))
+  do i = 1, nslots
+    if (migrating) then
+      ! Fresh output part: step zero and the mapped replica's restart time.
+      arex_part_start_steps(i) = 0
+      arex_part_time_origins(i) = ckpt%slot_output(source_restart_slot(i))%restart_time_ps
+    else
+      arex_part_time_origins(i) = ckpt%slot_output(i)%mdcrd_time_origin_ps
+      if (arex_append) then
+        arex_part_start_steps(i) = ckpt%slot_output(i)%part_start_step
+      else
+        arex_part_start_steps(i) = ckpt%slot_output(i)%mdcrd_logical_steps
+      end if
+    end if
+  end do
+  call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_mpi_cache_part_origins
+
+subroutine arex_mpi_sync_assigned_slot_bintraj_metadata(state, campaign_done, replica_id, &
+                                                        slot_id, completed_segments, ierr, message)
+
+#ifdef BINTRAJ
+  use AmberNetcdf_mod, only : NC_close
+#endif
+  type(arex_mpi_state_t), intent(inout) :: state
+  logical, intent(in) :: campaign_done
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: completed_segments
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_io_bintraj_state_t) :: slot_state
+  logical :: initialized, restart_exists, lambda_exists
+  integer :: logical_steps, part_start
+  character(len=max_fn_len) :: mdcrd_path, mdvel_path, mdfrc_path, restart_path
+  character(len=max_fn_len) :: lambda_path, phmdrestart_path
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%initialized) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_sync_assigned_slot_bintraj_metadata: state not initialized'
+    return
+  end if
+
+  if (campaign_done .or. replica_id <= 0 .or. slot_id <= 0) return
+
+  call arex_io_get_slot_bintraj_state(slot_id, slot_state, initialized, ierr, message)
+  if (ierr /= 0) return
+  call arex_mpi_cache_part_origins(ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  if (arexrst_specified) then
+    if (slot_id > size(arex_part_start_steps)) then
+      ierr = ARM_ERR_INVALID
+      message = 'AREX: worker assigned slot outside source checkpoint dimensions'
+      return
+    end if
+    slot_state%part_start_step = arex_part_start_steps(slot_id)
+    slot_state%mdcrd_time_origin_ps = arex_part_time_origins(slot_id)
+  end if
+  part_start = slot_state%part_start_step
+
+  logical_steps = completed_segments * arex_segment_steps
+
+  ! Preserve warmup logical time when completed_segments rewinds to zero
+  ! at the warmup-to-production boundary.
+  if (slot_state%mdcrd_logical_steps > logical_steps) then
+    logical_steps = slot_state%mdcrd_logical_steps
+  end if
+
+  ! Authoritative slot-owned progress.
+  slot_state%mdcrd_logical_steps = logical_steps
+  slot_state%mdcrd_logical_time_ps = slot_state%mdcrd_time_origin_ps + dble(logical_steps) * dt
+
+  if (logical_steps < part_start) then
+    ierr = ARM_ERR_INVALID
+    message = 'AREX: slot step count precedes continuation part start'
+    return
+  end if
+  if (ntwx > 0) slot_state%mdcrd_frame = logical_steps / ntwx - part_start / ntwx + 1
+  if (ntwv > 0) slot_state%mdvel_frame = logical_steps / ntwv - part_start / ntwv + 1
+  if (ntwf > 0) slot_state%mdfrc_frame = logical_steps / ntwf - part_start / ntwf + 1
+
+  ! Process-local NetCDF handles must not survive slot migration.
+  !
+  ! In addition, if the authoritative completed-segment count rewinds to zero
+  ! (startup / warmup-to-production boundary), we must force the slot-owned
+  ! files to be recreated from frame 1 even when the scheduler reports a NOOP
+  ! reuse on the same worker. Otherwise stale pre-reset files remain attached to
+  ! rewound slot metadata.
+  if (completed_segments == 0 .or. &
+      state%assigned_sync_mode /= AREX_MPI_SYNC_NOOP) then
+
+#ifdef BINTRAJ
+    ! Process-local NetCDF handles must be closed before we invalidate and
+    ! overwrite the saved slot state. Otherwise slot migration leaks file
+    ! descriptors until the process hits the OS open-file limit.
+    if (slot_state%mdcrd_ncid .ne. -1) call NC_close(slot_state%mdcrd_ncid)
+
+    if (slot_state%mdvel_ncid .ne. -1 .and. &
+        slot_state%mdvel_ncid .ne. slot_state%mdcrd_ncid) then
+      call NC_close(slot_state%mdvel_ncid)
+    end if
+
+    if (slot_state%mdfrc_ncid .ne. -1 .and. &
+        slot_state%mdfrc_ncid .ne. slot_state%mdcrd_ncid .and. &
+        slot_state%mdfrc_ncid .ne. slot_state%mdvel_ncid) then
+      call NC_close(slot_state%mdfrc_ncid)
+    end if
+#endif
+
+    initialized = .false.
+    slot_state%valid = .false.
+
+    slot_state%mdcrd_ncid         = -1
+    slot_state%coord_var_id       = -1
+    slot_state%cell_length_var_id = -1
+    slot_state%cell_angle_var_id  = -1
+    slot_state%mdcrd_time_var_id  = -1
+    slot_state%mdcrd_veloc_var_id = -1
+    slot_state%mdcrd_frc_var_id   = -1
+
+    slot_state%remd_indices_var_id = -1
+    slot_state%remd_values_var_id  = -1
+    slot_state%remd_types_var_id   = -1
+    slot_state%repidx_var_id       = -1
+    slot_state%crdidx_var_id       = -1
+    slot_state%frame_dim_id        = -1
+
+    slot_state%mdvel_ncid         = -1
+    slot_state%mdvel_time_var_id  = -1
+    slot_state%mdvel_veloc_var_id = -1
+
+    slot_state%mdfrc_ncid         = -1
+    slot_state%mdfrc_time_var_id  = -1
+    slot_state%mdfrc_frc_var_id   = -1
+  end if
+
+  call arex_io_set_slot_bintraj_state(slot_id, slot_state, initialized, ierr, message)
+  if (ierr /= 0) return
+
+  ! Determine local file lifecycle from actual output-part files, never from
+  ! cumulative campaign steps. A continuation may start millions of steps in,
+  ! yet not have written its first local trajectory/restart/lambda record.
+  call arex_io_get_slot_names(slot_id, mdcrd_path, mdvel_path, mdfrc_path, &
+       restart_path, lambda_path, phmdrestart_path, ierr, message)
+  if (ierr /= 0) return
+  if (.not. arexrst_specified .and. completed_segments == 0) then
+    ! A fresh campaign intentionally recreates its output, even if the user
+    ! copied old files into the working directory with -O.
+    restart_exists = .false.
+    lambda_exists = .false.
+  else
+    inquire(file=trim(restart_path), exist=restart_exists)
+    inquire(file=trim(lambda_path), exist=lambda_exists)
+  end if
+  call arex_io_set_slot_restart_initialized(slot_id, restart_exists, ierr, message)
+  if (ierr /= 0) return
+  call arex_io_set_slot_phmd_output_initialized(slot_id, lambda_exists, ierr, message)
+  if (ierr /= 0) return
+end subroutine arex_mpi_sync_assigned_slot_bintraj_metadata
+
+!===============================================================================
+! Report completion of one segment and obtain the next assignment.
+!
+! All ranks in pmemd_comm call this routine. Only the worker-group master
+! talks to the global scheduler. The returned assignment is broadcast
+! inside the worker group.
+!===============================================================================
+subroutine arex_mpi_complete_segment(state, campaign_done, replica_id, &
+                                     slot_id, ierr, message, stop_after_segment)
+  type(arex_mpi_state_t), intent(inout) :: state
+  logical, intent(out) :: campaign_done
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  logical, intent(in), optional :: stop_after_segment
+
+  integer :: done_i
+  integer :: completed_segments_i
+  integer :: request_kind
+
+  campaign_done = .false.
+  replica_id = 0
+  slot_id = 0
+  ierr = ARM_OK
+  message = ''
+  completed_segments_i = 0
+  state%assigned_completed_segments = 0
+
+  state%assigned_sync_mode = AREX_MPI_SYNC_FULL
+  state%assigned_restart_number = 0
+  request_kind = AREX_MPI_REQ_COMPLETE
+  if (present(stop_after_segment)) then
+    if (stop_after_segment) request_kind = AREX_MPI_REQ_COMPLETE_STOP
+  end if
+
+  if (.not. state%initialized) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_complete_segment: state not initialized'
+  else if (state%is_group_master) then
+    if (state%is_global_master) then
+      call arex_mpi_service_local_request(state, &
+                                          request_kind, &
+                                          done_i, replica_id, slot_id, &
+                                          ierr, message)
+      completed_segments_i = state%assigned_completed_segments
+    else
+      call arex_mpi_send_request_and_wait(state, &
+                                          request_kind, &
+                                          done_i, replica_id, slot_id, &
+                                          ierr, message)
+      completed_segments_i = state%assigned_completed_segments
+    end if
+    state%assigned_completed_segments = completed_segments_i
+    campaign_done = done_i /= 0
+  end if
+  call mpi_bcast(ierr, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(state%assigned_sync_mode, 1, mpi_integer, 0, pmemd_comm, &
+                 err_code_mpi)
+  call mpi_bcast(state%assigned_restart_number, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(replica_id, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(slot_id, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(state%assigned_completed_segments, 1, mpi_integer, 0, &
+                 pmemd_comm, err_code_mpi)
+  call mpi_bcast(campaign_done, 1, mpi_logical, 0, pmemd_comm, &
+                 err_code_mpi)
+  if (len(message) > 0) then
+    call mpi_bcast(message, len(message), mpi_character, 0, pmemd_comm, &
+                   err_code_mpi)
+  end if
+
+ !write(0,*) 'AREX MPI DBG worker after complete_segment', &
+ !           ' local_worker_id=', state%worker_id, &
+ !           ' mytaskid=', mytaskid, &
+ !           ' next_replica=', replica_id, &
+ !           ' next_slot=', slot_id, &
+ !           ' sync_mode=', state%assigned_sync_mode, &
+ !           ' campaign_done=', campaign_done, &
+ !           ' ierr=', ierr
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    call arex_mpi_sync_assigned_state(state, replica_id, slot_id, ierr, message)
+    if (ierr == ARM_OK) then
+      call arex_mpi_apply_assigned_restraint(state, ierr, message)
+    end if
+   !    if (state%is_group_master) then
+   !  write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,a)') &
+   !       'AREX DBG complete_segment after sync_state: worker=', state%worker_id, &
+   !       ' replica=', replica_id, &
+   !       ' slot=', slot_id, &
+   !       ' sync=', state%assigned_sync_mode, &
+   !       ' ierr=', ierr, &
+   !       ' msg=', trim(message)
+   !  call flush(0)
+   !end if
+  end if
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    call arex_mpi_sync_assigned_slot_bintraj_metadata(state, campaign_done, replica_id, &
+                                                      slot_id, state%assigned_completed_segments, &
+                                                      ierr, message)
+   !if (state%is_group_master) then
+   !  write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,a)') &
+   !       'AREX DBG complete_segment after metadata: worker=', state%worker_id, &
+   !       ' replica=', replica_id, &
+   !       ' slot=', slot_id, &
+   !       ' completed=', state%assigned_completed_segments, &
+   !       ' ierr=', ierr, &
+   !       ' msg=', trim(message)
+   !  call flush(0)
+   !end if
+  end if
+
+  if (ierr == ARM_OK .and. .not. campaign_done .and. &
+      replica_id > 0 .and. slot_id > 0) then
+    state%active_replica_id = replica_id
+    state%active_slot_id    = slot_id
+  else
+    state%active_replica_id = 0
+    state%active_slot_id    = 0
+  end if
+
+#ifdef AREX_DEBUG
+  if (state%worker_id == 1 .and. mytaskid == 0) then
+    write(0,'(a,i0,a,i0,a,i0,a,l1,a,i0)') &
+         'AREX DBG W1 complete_segment return: replica=', state%active_replica_id, &
+         ', slot=', state%active_slot_id, &
+         ', ierr=', ierr, &
+         ', campaign_done=', campaign_done, &
+         ', sync=', state%assigned_sync_mode
+    call flush(0)
+  end if
+#endif
+end subroutine arex_mpi_complete_segment
+
+!===============================================================================
+! Send one worker-master request to the global scheduler and wait for the
+! response.
+!===============================================================================
+subroutine arex_mpi_send_request_and_wait(state, request_kind, done_i, &
+                                          replica_id, slot_id, ierr, &
+                                          message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: request_kind
+  integer, intent(out) :: done_i
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: request(2)
+  integer :: response(7)
+  integer :: status(mpi_status_size)
+  character(len=arex_mpi_msg_len) :: response_msg
+
+  ierr = ARM_OK
+  message = ''
+  done_i = 0
+  replica_id = 0
+  slot_id = 0
+  state%assigned_completed_segments = 0
+  state%assigned_sync_mode = AREX_MPI_SYNC_FULL
+
+  request(1) = request_kind
+  request(2) = state%worker_id
+
+  call mpi_send(request, 2, mpi_integer, 0, AREX_MPI_TAG_REQ, &
+                arex_sched_comm, err_code_mpi)
+
+  if (request_kind == AREX_MPI_REQ_COMPLETE .or. &
+      request_kind == AREX_MPI_REQ_COMPLETE_STOP) then
+    if (state%active_replica_id <= 0 .or. state%active_slot_id <= 0) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_mpi_send_request_and_wait: no active assignment to complete'
+      return
+    end if
+
+    call arex_mpi_send_completed_state_to_scheduler(state, ierr, message)
+    if (ierr /= ARM_OK) return
+
+    call arex_pay_phrex_send_completed_replica_to_scheduler(state%active_replica_id, &
+         state%active_slot_id, state%worker_id, 0, ierr, message)
+    if (ierr /= ARM_OK) return
+  end if
+
+  call mpi_recv(response, 7, mpi_integer, 0, AREX_MPI_TAG_RESP, &
+                arex_sched_comm, status, err_code_mpi)
+
+  call mpi_recv(response_msg, arex_mpi_msg_len, mpi_character, 0, &
+                AREX_MPI_TAG_MSG, arex_sched_comm, status, &
+                err_code_mpi)
+
+  ierr = response(1)
+  done_i = response(2)
+  replica_id = response(3)
+  slot_id = response(4)
+  state%assigned_completed_segments = response(5)
+  state%assigned_sync_mode = response(6)
+  state%assigned_restart_number = response(7)
+
+#ifdef AREX_DEBUG
+  if (state%worker_id == 1 .and. ierr == ARM_OK) then
+    write(0,'(a,i0,a,i0,a,i0,a,i0,a,i0)') &
+         'AREX DBG W1 response: req=', request_kind, &
+         ', sync=', state%assigned_sync_mode, &
+         ', replica=', replica_id, &
+         ', slot=', slot_id, &
+         ', completed=', state%assigned_completed_segments
+    call flush(0)
+  end if
+#endif
+
+  if (len(message) > 0) message = response_msg(1:len(message))
+
+  if (ierr == ARM_OK .and. done_i == 0 .and. replica_id > 0 .and. slot_id > 0) then
+    if (state%assigned_sync_mode == AREX_MPI_SYNC_FULL) then
+      call arex_mpi_recv_assigned_state_from_global(state, replica_id, ierr, message)
+      if (ierr /= ARM_OK) return
+
+      call arex_pay_phrex_recv_assigned_replica_from_global(replica_id, ierr, message)
+      if (ierr /= ARM_OK) return
+    end if
+  end if
+end subroutine arex_mpi_send_request_and_wait
+
+!===============================================================================
+! Receive the assigned common MD snapshot from the global master onto a remote
+! worker-group master and stage it locally for the later pmemd_comm fanout.
+!===============================================================================
+subroutine arex_mpi_recv_assigned_state_from_global(state, replica_id, ierr, &
+                                                    message)
+  use prmtop_dat_mod, only : natom
+
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: replica_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: alloc_ierr
+  integer :: unpack_ierr
+  integer :: packed_size
+  character(len=arex_mpi_msg_len) :: root_message
+  character(len=arex_mpi_msg_len) :: alloc_message
+  character(len=arex_mpi_msg_len) :: unpack_message
+  integer :: status(mpi_status_size)
+  real(dp), allocatable :: packed_md(:)
+
+  ierr = ARM_OK
+  message = ''
+  root_ierr = ARM_OK
+  root_message = ''
+  unpack_message = ''
+
+  if (state%is_global_master) return
+
+  if (.not. state%is_group_master) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_recv_assigned_state_from_global: not on worker-group master'
+    return
+  end if
+
+  if (.not. state%have_master_comm) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_recv_assigned_state_from_global: arex_sched_comm is null'
+    return
+  end if
+
+  if (.not. state%assigned_md%allocated) then
+    alloc_message = ''
+    call arm_snapshot_allocate(state%assigned_md, natom, alloc_ierr, alloc_message)
+    if (alloc_ierr /= ARM_OK) then
+      ierr = alloc_ierr
+      if (len(message) > 0) message = alloc_message(1:len(message))
+      return
+    end if
+  end if
+
+  call mpi_recv(root_ierr, 1, mpi_integer, 0, AREX_MPI_TAG_STATE, &
+                arex_sched_comm, status, err_code_mpi)
+  call mpi_recv(root_message, arex_mpi_msg_len, mpi_character, 0, &
+                AREX_MPI_TAG_STATE, arex_sched_comm, status, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_recv(valid_i, 1, mpi_integer, 0, AREX_MPI_TAG_STATE, &
+                arex_sched_comm, status, err_code_mpi)
+
+  state%assigned_md%valid = valid_i /= 0
+
+  if (valid_i /= 0) then
+    packed_size = arex_mpi_md_packed_size(state%assigned_md%natom)
+    allocate(packed_md(packed_size))
+
+    call mpi_recv(packed_md, packed_size, mpi_double_precision, 0, &
+                  AREX_MPI_TAG_STATE, arex_sched_comm, status, err_code_mpi)
+
+    call arex_mpi_unpack_md_snapshot(state%assigned_md, packed_md, &
+                                     unpack_ierr, unpack_message)
+    deallocate(packed_md)
+
+    if (unpack_ierr /= ARM_OK) then
+      ierr = unpack_ierr
+      if (len(message) > 0) message = unpack_message(1:len(message))
+      return
+    end if
+
+    state%assigned_md%valid = .true.
+  end if
+
+  state%assigned_md_ready = .true.
+  state%assigned_replica_id = replica_id
+
+end subroutine arex_mpi_recv_assigned_state_from_global
+
+!===============================================================================
+! Send the assigned common MD snapshot from the global master to one remote
+! worker-group master across arex_sched_comm.
+!===============================================================================
+subroutine arex_mpi_send_assigned_state_to_worker(state, worker_id, replica_id, &
+                                                  ierr, message)
+  type(arex_mpi_state_t), intent(in) :: state
+  integer, intent(in) :: worker_id
+  integer, intent(in) :: replica_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: dest_master_rank
+  integer :: pack_ierr
+  integer :: packed_size
+  character(len=arex_mpi_msg_len) :: root_message
+  character(len=arex_mpi_msg_len) :: pack_message
+  real(dp), allocatable :: packed_md(:)
+
+  ierr = ARM_OK
+  message = ''
+  root_ierr = ARM_OK
+  root_message = ''
+  pack_message = ''
+  valid_i = 0
+  dest_master_rank = worker_id
+
+  if (.not. state%is_global_master) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_mpi_send_assigned_state_to_worker: not on global master'
+  else if (.not. state%have_master_comm) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_mpi_send_assigned_state_to_worker: arex_sched_comm is null'
+  else if (worker_id < 1 .or. worker_id > state%nworkers) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_mpi_send_assigned_state_to_worker: invalid worker_id'
+  else if (replica_id < 1 .or. replica_id > state%mgr%nreplicas) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_mpi_send_assigned_state_to_worker: invalid replica_id'
+  else
+    valid_i = 0
+    if (state%mgr%replicas(replica_id)%md%valid) valid_i = 1
+  end if
+
+  call mpi_send(root_ierr, 1, mpi_integer, dest_master_rank, AREX_MPI_TAG_STATE, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(root_message, arex_mpi_msg_len, mpi_character, dest_master_rank, &
+                AREX_MPI_TAG_STATE, arex_sched_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_send(valid_i, 1, mpi_integer, dest_master_rank, AREX_MPI_TAG_STATE, &
+                arex_sched_comm, err_code_mpi)
+
+  if (valid_i /= 0) then
+    packed_size = arex_mpi_md_packed_size(state%mgr%natom)
+    allocate(packed_md(packed_size))
+
+    call arex_mpi_pack_md_snapshot(state%mgr%replicas(replica_id)%md, packed_md, &
+                                   pack_ierr, pack_message)
+    if (pack_ierr /= ARM_OK) then
+      ierr = pack_ierr
+      if (len(message) > 0) message = pack_message(1:len(message))
+      deallocate(packed_md)
+      return
+    end if
+
+    call mpi_send(packed_md, packed_size, mpi_double_precision, dest_master_rank, &
+                  AREX_MPI_TAG_STATE, arex_sched_comm, err_code_mpi)
+
+    deallocate(packed_md)
+  end if
+
+end subroutine arex_mpi_send_assigned_state_to_worker
+
+!===============================================================================
+! Drain any already-queued remote worker-master requests without blocking.
+!
+! This prevents the global-master local worker from starving remote workers
+! simply because its own request can be satisfied immediately.
+!===============================================================================
+subroutine arex_mpi_drain_remote_requests(state, local_worker_id, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: local_worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  logical :: flag
+  integer :: request(2)
+  integer :: requester_id
+  integer :: status(mpi_status_size)
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%is_global_master) return
+  if (.not. state%have_master_comm) return
+  if (state%nworkers <= 1) return
+
+  do
+    call mpi_iprobe(mpi_any_source, AREX_MPI_TAG_REQ, arex_sched_comm, &
+                    flag, status, err_code_mpi)
+    if (.not. flag) exit
+
+    call mpi_recv(request, 2, mpi_integer, status(MPI_SOURCE), &
+                  AREX_MPI_TAG_REQ, arex_sched_comm, status, &
+                  err_code_mpi)
+
+    requester_id = request(2)
+
+    call arex_mpi_process_request(state, request(1), requester_id, ierr, &
+                                  message)
+    if (ierr /= ARM_OK) then
+      call arex_mpi_fail_pending_requests(state, requester_id, ierr, &
+                                          message)
+      return
+    end if
+
+    call arex_mpi_flush_remote_responses(state, local_worker_id, ierr, &
+                                         message)
+    if (ierr /= ARM_OK) return
+  end do
+
+end subroutine arex_mpi_drain_remote_requests
+
+!===============================================================================
+! Service the local worker's request on the global scheduler rank.
+!
+! The local request may not be satisfiable immediately. In that case the
+! global scheduler continues to process remote worker-master requests
+! until the local worker has either a new assignment or campaign
+! completion has been reached.
+!===============================================================================
+subroutine arex_mpi_service_local_request(state, request_kind, done_i, &
+                                          replica_id, slot_id, ierr, &
+                                          message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: request_kind
+  integer, intent(out) :: done_i
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: request(2)
+  integer :: requester_id
+  integer :: status(mpi_status_size)
+  integer :: flush_ierr
+  character(len=arex_mpi_msg_len) :: flush_message
+  logical :: have_local
+
+  ierr = ARM_OK
+  message = ''
+  done_i = 0
+  replica_id = 0
+  slot_id = 0
+  have_local = .false.
+
+  ! First apply the local worker's request on the global master.
+  call arex_mpi_process_request(state, request_kind, state%worker_id, &
+                                ierr, message)
+  if (ierr /= ARM_OK) then
+    call arex_mpi_fail_pending_requests(state, state%worker_id, ierr, &
+                                        message)
+    call arex_mpi_flush_remote_responses(state, state%worker_id, &
+                                         flush_ierr, flush_message)
+    call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                      ierr, message, have_local)
+    return
+  end if
+
+  ! Flush any newly-ready remote responses, then opportunistically drain any
+  ! already-queued remote requests before taking the local response.
+  call arex_mpi_flush_remote_responses(state, state%worker_id, ierr, &
+                                       message)
+  if (ierr /= ARM_OK) return
+
+  call arex_mpi_drain_remote_requests(state, state%worker_id, ierr, &
+                                      message)
+  if (ierr /= ARM_OK) then
+    call arex_mpi_flush_remote_responses(state, state%worker_id, &
+                                         flush_ierr, flush_message)
+    call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                      ierr, message, have_local)
+    return
+  end if
+
+  call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                    ierr, message, have_local)
+  if (ierr /= ARM_OK) return
+  if (have_local) return
+
+  if (.not. state%have_master_comm .or. state%nworkers == 1) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_service_local_request: local response missing'
+    return
+  end if
+
+  ! If the local response is still not ready, continue servicing remote
+  ! requests until the local worker obtains a response.
+  do
+    call mpi_recv(request, 2, mpi_integer, mpi_any_source, &
+                  AREX_MPI_TAG_REQ, arex_sched_comm, status, &
+                  err_code_mpi)
+
+    requester_id = request(2)
+
+    call arex_mpi_process_request(state, request(1), requester_id, ierr, &
+                                  message)
+    if (ierr /= ARM_OK) then
+      call arex_mpi_fail_pending_requests(state, requester_id, ierr, &
+                                          message)
+      call arex_mpi_flush_remote_responses(state, state%worker_id, &
+                                           flush_ierr, flush_message)
+      call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                        ierr, message, have_local)
+      return
+    end if
+
+    call arex_mpi_flush_remote_responses(state, state%worker_id, ierr, &
+                                         message)
+    if (ierr /= ARM_OK) return
+
+    call arex_mpi_drain_remote_requests(state, state%worker_id, ierr, &
+                                        message)
+    if (ierr /= ARM_OK) then
+      call arex_mpi_flush_remote_responses(state, state%worker_id, &
+                                           flush_ierr, flush_message)
+      call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                        ierr, message, have_local)
+      return
+    end if
+
+    call arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                      ierr, message, have_local)
+    if (ierr /= ARM_OK) return
+    if (have_local) exit
+  end do
+
+end subroutine arex_mpi_service_local_request
+
+!===============================================================================
+! Apply one request to the authoritative manager and update pending work.
+!===============================================================================
+subroutine arex_mpi_process_request(state, request_kind, worker_id, ierr, &
+                                    message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: request_kind
+  integer, intent(in) :: worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: nresolved
+  integer :: current_replica
+  integer :: current_slot
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%is_global_master) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_process_request: not on global master'
+    return
+  end if
+
+  if (worker_id < 1 .or. worker_id > state%nworkers) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_process_request: invalid worker_id'
+    return
+  end if
+
+  select case (request_kind)
+  case (AREX_MPI_REQ_ASSIGN)
+    state%pending_request(worker_id) = .true.
+  case (AREX_MPI_REQ_COMPLETE, AREX_MPI_REQ_COMPLETE_STOP)
+    if (request_kind == AREX_MPI_REQ_COMPLETE_STOP) state%stop_requested = .true.
+
+    current_replica = state%mgr%workers(worker_id)%active_replica_id
+    current_slot    = state%mgr%workers(worker_id)%active_slot_id
+
+   !write(0,*) 'AREX MPI DBG GM before arm_mark_segment_complete', &
+   !           ' gm_worker_id=', state%worker_id, &
+   !           ' target_worker=', worker_id, &
+   !           ' active_replica=', current_replica, &
+   !           ' active_slot=', current_slot, &
+   !           ' is_global_master=', state%is_global_master
+
+    call arm_mark_segment_complete(state%mgr, worker_id, ierr, message)
+
+   !write(0,*) 'AREX MPI DBG GM after arm_mark_segment_complete', &
+   !           ' gm_worker_id=', state%worker_id, &
+   !           ' target_worker=', worker_id, &
+   !           ' ierr=', ierr, &
+   !           ' message=', trim(message)
+
+    if (ierr /= ARM_OK) return
+
+    if (allocated(state%resident_valid)) then
+      state%resident_valid(worker_id)   = (current_replica > 0 .and. current_slot > 0)
+      state%resident_replica(worker_id) = current_replica
+      state%resident_slot(worker_id)    = current_slot
+    end if
+
+#ifdef AREX_DEBUG
+    write(6,'(a,i0,a,i0,a,i0,a,i0)') ' AREX> epoch ', state%mgr%epoch, &
+         ': worker ', worker_id, ' completed replica ', current_replica, &
+         ' at slot ', current_slot
+#endif
+
+    if (state%warmup_active) then
+      if (current_replica >= 1 .and. current_replica <= state%mgr%nreplicas) then
+        state%mgr%replicas(current_replica)%exchange_resolved_epoch = state%mgr%epoch
+      end if
+    else
+      call arm_try_resolve_ready_exchanges(state%mgr, nresolved, ierr, &
+                                           message)
+      if (ierr /= ARM_OK) return
+
+#ifdef AREX_DEBUG
+      if (nresolved > 0) then
+        write(6,'(a,i0,a,i0)') ' AREX> epoch ', state%mgr%epoch, &
+             ': resolved exchange pair count = ', nresolved
+      end if
+#endif
+    end if
+
+    state%pending_request(worker_id) = .true.
+
+    if (state%checkpoint_frequency > 0) &
+      state%checkpoint_segments_since_write = &
+        state%checkpoint_segments_since_write + 1
+  case default
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_process_request: invalid request kind'
+    return
+  end select
+
+  call arex_mpi_try_pending_assignments(state, ierr, message)
+  if (ierr /= ARM_OK) return
+
+ end subroutine arex_mpi_process_request
+
+!===============================================================================
+! Try to satisfy all currently pending worker requests.
+!
+! Pending workers remain pending if no new assignment is ready yet. This
+! occurs naturally near the end of an epoch while other workers are still
+! finishing their current segments.
+!===============================================================================
+! Decide once per epoch, before any workers are assigned. All slots in
+! that epoch therefore either write the same numbered set or write nothing.
+subroutine arex_mpi_choose_epoch_restart(state)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer :: i
+  logical :: final_epoch
+
+  state%epoch_restart_number = 0
+  final_epoch = .not. state%warmup_active
+  if (final_epoch) then
+    do i = 1, state%mgr%nreplicas
+      if (state%mgr%replicas(i)%segments_completed + 1 < state%mgr%segments_per_replica) &
+        final_epoch = .false.
+    end do
+  end if
+  if (final_epoch) then
+    state%epoch_restart_number = -1
+  else if (state%checkpoint_frequency > 0) then
+    if (state%checkpoint_segments_since_write + state%mgr%nslots >= state%checkpoint_frequency) &
+      state%epoch_restart_number = state%last_checkpoint_number + 1
+  end if
+end subroutine arex_mpi_choose_epoch_restart
+
+subroutine arex_mpi_try_pending_assignments(state, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: replica_id
+  integer :: slot_id
+  integer :: resident_replica_id
+  integer :: resident_prev_slot
+  integer :: sync_mode
+  logical :: found
+  logical :: epoch_done
+  integer :: chk_ierr
+  character(len=256) :: chk_message
+
+  ierr = ARM_OK
+  message = ''
+  epoch_done = arm_epoch_complete(state%mgr)
+
+  if (epoch_done) then
+    if (state%warmup_active) &
+      state%warmup_segments_completed = state%warmup_segments_completed + 1
+    if (state%epoch_restart_number /= 0) then
+      if (.not. arm_restart_set_ready(state%mgr)) then
+        ierr = ARM_ERR_INVALID
+        message = 'AREX: checkpoint epoch restart set is incomplete'
+        return
+      end if
+      call arex_rst_capture_checkpoint(state%mgr, state%warmup_segments_target, &
+           state%warmup_segments_completed, state%pending_checkpoint, chk_ierr, chk_message)
+      if (chk_ierr /= AREX_RST_OK) then
+        ierr = ARM_ERR_INVALID
+        message = trim(chk_message)
+        return
+      end if
+      state%pending_previous_number = state%last_checkpoint_number
+      state%pending_checkpoint_number = max(0, state%epoch_restart_number)
+      state%last_checkpoint_number = state%pending_checkpoint_number
+      state%checkpoint_segments_since_write = 0
+      state%epoch_restart_number = 0
+    end if
+  end if
+
+  if (state%warmup_active) then
+    if (epoch_done) then
+      if (state%warmup_segments_completed >= state%warmup_segments_target) then
+        call arex_mpi_finish_warmup(state, ierr, message)
+        if (ierr /= ARM_OK) return
+      else
+#ifdef AREX_DEBUG
+        write(6,'(a,i0,a,i0)') ' AREX> completed warmup segment ', &
+             state%warmup_segments_completed, ' of ', &
+             state%warmup_segments_target
+#endif
+
+        call arm_begin_epoch(state%mgr, ierr, message)
+        if (ierr /= ARM_OK) return
+        call arex_mpi_choose_epoch_restart(state)
+      end if
+    end if
+  else
+    if (epoch_done) then
+      call arm_write_exchange_history(state%mgr, ierr, message)
+      if (ierr /= ARM_OK) return
+    end if
+
+    if (arm_campaign_complete(state%mgr)) then
+      do i = 1, state%nworkers
+        if (state%pending_request(i)) then
+          call arex_mpi_set_response(state, i, ARM_OK, 1, 0, 0, 0, &
+                                     AREX_MPI_SYNC_FULL, '')
+        end if
+      end do
+      return
+    end if
+
+    if (epoch_done) then
+      call arm_begin_epoch(state%mgr, ierr, message)
+      if (ierr /= ARM_OK) return
+      call arex_mpi_choose_epoch_restart(state)
+
+#ifdef AREX_DEBUG
+      write(6,'(a,i0,a,i0)') ' AREX> begin epoch ', state%mgr%epoch, &
+           ', parity = ', state%mgr%current_parity
+#endif
+    end if
+  end if
+
+  ! A timlim stop is honored only at a restart-set-safe segment boundary.
+  ! Once requested, let every currently active worker finish its full segment.
+  ! If the resulting standard restart set is not yet self-consistent, resume
+  ! scheduling until it is; then return DONE to every waiting worker.
+  if (state%stop_requested) then
+    if (.not. all(state%mgr%workers(:)%status == ARM_WORKER_IDLE)) return
+
+    if (arm_restart_set_ready(state%mgr)) then
+      do i = 1, state%nworkers
+        if (state%pending_request(i)) then
+          call arex_mpi_set_response(state, i, ARM_OK, 1, 0, 0, 0, &
+                                     AREX_MPI_SYNC_FULL, '')
+        end if
+      end do
+      return
+    end if
+  end if
+
+  do i = 1, state%nworkers
+    if (.not. state%pending_request(i)) cycle
+
+    found = .false.
+    replica_id = 0
+    slot_id = 0
+    sync_mode = AREX_MPI_SYNC_FULL
+    resident_replica_id = 0
+    resident_prev_slot = 0
+
+    ! Reuse-first scheduling:
+    ! If this worker's resident replica is still ready for the new epoch,
+    ! assign it first before falling back to generic slot-order selection.
+    if (allocated(state%resident_valid)) then
+      if (state%resident_valid(i)) then
+        resident_replica_id = state%resident_replica(i)
+        resident_prev_slot  = state%resident_slot(i)
+
+        if (resident_replica_id >= 1 .and. resident_replica_id <= state%mgr%nreplicas) then
+          slot_id = state%mgr%replicas(resident_replica_id)%slot_id
+
+          if (slot_id >= 1 .and. slot_id <= state%mgr%nslots) then
+            if (state%mgr%slot_owner(slot_id) == resident_replica_id .and. &
+                state%mgr%replicas(resident_replica_id)%completed_epoch < state%mgr%epoch .and. &
+                state%mgr%replicas(resident_replica_id)%status == ARM_REPLICA_IDLE) then
+              found = .true.
+              replica_id = resident_replica_id
+            end if
+          end if
+        end if
+      end if
+    end if
+
+    if (.not. found) then
+      call arm_next_ready_replica(state%mgr, found, replica_id, slot_id, &
+                                  ierr, message)
+      if (ierr /= ARM_OK) return
+      if (.not. found) cycle
+    end if
+
+   !write(0,*) 'AREX MPI DBG GM before arm_assign_replica_to_worker', &
+   !           ' gm_worker_id=', state%worker_id, &
+   !           ' target_worker=', i, &
+   !           ' replica=', replica_id, &
+   !           ' slot=', slot_id, &
+   !           ' segs_completed=', state%mgr%replicas(replica_id)%segments_completed, &
+   !           ' is_global_master=', state%is_global_master
+
+    call arm_assign_replica_to_worker(state%mgr, i, replica_id, ierr, &
+                                      message)
+
+   !write(0,*) 'AREX MPI DBG GM after arm_assign_replica_to_worker', &
+   !           ' gm_worker_id=', state%worker_id, &
+   !           ' target_worker=', i, &
+   !           ' replica=', replica_id, &
+   !           ' slot=', slot_id, &
+   !           ' ierr=', ierr, &
+   !           ' message=', trim(message)
+
+    if (ierr /= ARM_OK) return
+
+    if (allocated(state%resident_valid)) then
+      if (state%resident_valid(i) .and. state%resident_replica(i) == replica_id) then
+        if (state%resident_slot(i) == slot_id) then
+          sync_mode = AREX_MPI_SYNC_NOOP
+        else
+          sync_mode = AREX_MPI_SYNC_SLOT_ONLY
+        end if
+      else
+        sync_mode = AREX_MPI_SYNC_FULL
+      end if
+    end if
+
+#ifdef AREX_DEBUG
+    write(6,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,i0,a,i0)') ' AREX> epoch ', state%mgr%epoch, &
+         ': worker ', i, ' assigned replica ', replica_id, ' at slot ', slot_id, &
+         ' after replica segments ', state%mgr%replicas(replica_id)%segments_completed, &
+         ' slot segments ', state%mgr%slot_segments_completed(slot_id), &
+         ' sync_mode ', sync_mode
+#endif
+
+    call arex_mpi_set_response(state, i, ARM_OK, 0, replica_id, slot_id, &
+                               state%mgr%slot_segments_completed(slot_id), &
+                               sync_mode, '')
+
+    if (allocated(state%resident_valid)) then
+      if (sync_mode == AREX_MPI_SYNC_NOOP .or. sync_mode == AREX_MPI_SYNC_SLOT_ONLY) then
+        state%resident_valid(i)   = .true.
+        state%resident_replica(i) = replica_id
+        state%resident_slot(i)    = slot_id
+      else
+        state%resident_valid(i)   = .false.
+        state%resident_replica(i) = 0
+        state%resident_slot(i)    = 0
+      end if
+    end if
+  end do
+end subroutine arex_mpi_try_pending_assignments
+
+!===============================================================================
+! Set a reply for one worker waiting on the global scheduler.
+!===============================================================================
+subroutine arex_mpi_set_response(state, worker_id, ierr_in, done_in, &
+                                 replica_in, slot_in, completed_segments_in, &
+                                 sync_mode_in, message_in)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: worker_id
+  integer, intent(in) :: ierr_in
+  integer, intent(in) :: done_in
+  integer, intent(in) :: replica_in
+  integer, intent(in) :: slot_in
+  integer, intent(in) :: sync_mode_in
+  integer, intent(in) :: completed_segments_in
+  character(len=*), intent(in) :: message_in
+
+  state%pending_request(worker_id)   = .false.
+  state%response_ready(worker_id)    = .true.
+  state%response_ierr(worker_id)     = ierr_in
+  state%response_done(worker_id)     = done_in
+  state%response_replica(worker_id)  = replica_in
+  state%response_slot(worker_id)     = slot_in
+  state%response_completed_segments(worker_id) = completed_segments_in
+  state%response_sync_mode(worker_id)= sync_mode_in
+  state%response_restart_number(worker_id) = 0
+  if (done_in == 0 .and. replica_in > 0 .and. slot_in > 0) &
+    state%response_restart_number(worker_id) = state%epoch_restart_number
+  state%response_msg(worker_id)      = ''
+
+  if (len_trim(message_in) > 0) then
+    state%response_msg(worker_id) = message_in
+  end if
+end subroutine arex_mpi_set_response
+
+subroutine arex_mpi_fail_pending_requests(state, requester_id, ierr_in, &
+                                          message_in)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: requester_id
+  integer, intent(in) :: ierr_in
+  character(len=*), intent(in) :: message_in
+
+  integer :: i
+
+  if (.not. state%is_global_master) return
+
+  do i = 1, state%nworkers
+    if (.not. state%pending_request(i) .and. i /= requester_id) cycle
+    call arex_mpi_set_response(state, i, ierr_in, 0, 0, 0, 0, &
+                               AREX_MPI_SYNC_FULL, message_in)
+    end do
+end subroutine arex_mpi_fail_pending_requests
+
+!===============================================================================
+! Send all remote responses that are ready.
+!===============================================================================
+subroutine arex_mpi_flush_remote_responses(state, local_worker_id, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: local_worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: response(7)
+  character(len=arex_mpi_msg_len) :: response_msg
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%is_global_master) return
+  if (.not. state%have_master_comm) return
+
+  do i = 1, state%nworkers
+    if (.not. state%response_ready(i)) cycle
+    if (i == local_worker_id) cycle
+
+    response(1) = state%response_ierr(i)
+    response(2) = state%response_done(i)
+    response(3) = state%response_replica(i)
+    response(4) = state%response_slot(i)
+    response(5) = state%response_completed_segments(i)
+    response(6) = state%response_sync_mode(i)
+    response(7) = state%response_restart_number(i)
+
+    response_msg = ''
+    if (len_trim(state%response_msg(i)) > 0) response_msg = state%response_msg(i)
+
+    call mpi_send(response, 7, mpi_integer, i, AREX_MPI_TAG_RESP, &
+                  arex_sched_comm, err_code_mpi)
+
+    call mpi_send(response_msg, arex_mpi_msg_len, mpi_character, i, &
+                  AREX_MPI_TAG_MSG, arex_sched_comm, err_code_mpi)
+
+    if (state%response_ierr(i) == ARM_OK .and. state%response_done(i) == 0 .and. &
+        state%response_replica(i) > 0 .and. state%response_slot(i) > 0) then
+
+      if (state%response_sync_mode(i) == AREX_MPI_SYNC_FULL) then
+        call arex_mpi_send_assigned_state_to_worker(state, i, &
+                                                    state%response_replica(i), &
+                                                    ierr, message)
+        if (ierr /= ARM_OK) return
+
+        call arex_pay_phrex_send_assigned_replica_to_worker( &
+             state%response_replica(i), i, ierr, message)
+        if (ierr /= ARM_OK) return
+      end if
+    end if
+
+    if (state%response_done(i) /= 0) then
+      if (allocated(state%worker_finished)) state%worker_finished(i) = .true.
+    end if
+
+    state%response_ready(i) = .false.
+  end do
+
+  ! Replies have been sent: GPU workers can already run the next epoch while
+  ! this scheduler writes the checkpoint captured at the previous boundary.
+  if (state%pending_checkpoint%allocated) then
+    call arex_rst_write_checkpoint(arex_checkpoint_output_name, state%pending_checkpoint, &
+                                   ierr, message, state%pending_checkpoint_number)
+    if (ierr /= AREX_RST_OK) return
+    if (state%pending_previous_number > 0) &
+      call arex_rst_remove_numbered_set(arex_checkpoint_output_name, &
+                                        state%pending_previous_number)
+    state%pending_previous_number = 0
+    state%pending_checkpoint_number = 0
+  end if
+end subroutine arex_mpi_flush_remote_responses
+
+!===============================================================================
+! Extract the local worker's response if one is ready.
+!===============================================================================
+subroutine arex_mpi_take_local_response(state, done_i, replica_id, slot_id, &
+                                        ierr, message, have_local)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: done_i
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  logical, intent(out) :: have_local
+
+  done_i = 0
+  replica_id = 0
+  slot_id = 0
+  ierr = ARM_OK
+  message = ''
+  have_local = .false.
+  state%assigned_completed_segments = 0
+  state%assigned_sync_mode = AREX_MPI_SYNC_FULL
+
+  if (.not. state%is_global_master) return
+  if (state%worker_id < 1 .or. state%worker_id > state%nworkers) return
+  if (.not. state%response_ready(state%worker_id)) return
+
+  have_local = .true.
+  ierr = state%response_ierr(state%worker_id)
+  done_i = state%response_done(state%worker_id)
+  replica_id = state%response_replica(state%worker_id)
+  slot_id = state%response_slot(state%worker_id)
+  state%assigned_completed_segments = state%response_completed_segments(state%worker_id)
+  state%assigned_sync_mode = state%response_sync_mode(state%worker_id)
+  state%assigned_restart_number = state%response_restart_number(state%worker_id)
+
+  if (len(message) > 0) then
+    message = state%response_msg(state%worker_id)(1:len(message))
+  end if
+
+  if (done_i /= 0) then
+    if (allocated(state%worker_finished)) state%worker_finished(state%worker_id) = .true.
+  end if
+
+  state%response_ready(state%worker_id) = .false.
+end subroutine arex_mpi_take_local_response
+
+subroutine arex_mpi_finish_warmup(state, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+
+  ierr = ARM_OK
+  message = ''
+
+  if (.not. state%is_global_master) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_mpi_finish_warmup: not on global master'
+    return
+  end if
+
+  do i = 1, state%mgr%nslots
+    state%mgr%slot_owner(i) = i
+  end do
+
+  do i = 1, state%mgr%nreplicas
+    state%mgr%replicas(i)%slot_id = i
+    state%mgr%replicas(i)%status = ARM_REPLICA_IDLE
+    state%mgr%replicas(i)%assigned_worker_id = 0
+    state%mgr%replicas(i)%segments_completed = 0
+    state%mgr%replicas(i)%completed_epoch = 0
+    state%mgr%replicas(i)%exchange_resolved_epoch = 0
+  end do
+
+  do i = 1, state%mgr%nworkers
+    state%mgr%workers(i)%status = ARM_WORKER_IDLE
+    state%mgr%workers(i)%active_replica_id = 0
+    state%mgr%workers(i)%active_slot_id = 0
+    state%mgr%workers(i)%completed_segments = 0
+  end do
+
+  state%warmup_active = .false.
+
+  ! The manager state has just been rewound to production epoch zero.
+  ! Do not let production reuse warmup resident-worker assumptions.
+  if (allocated(state%resident_valid)) then
+    state%resident_valid(:) = .false.
+    state%resident_replica(:) = 0
+    state%resident_slot(:) = 0
+  end if
+
+  call arm_begin_epoch(state%mgr, ierr, message)
+  if (ierr /= ARM_OK) return
+  call arex_mpi_choose_epoch_restart(state)
+
+#ifdef AREX_DEBUG
+  write(6,'(a,i0,a,i0,a)') ' AREX> warmup complete after ', &
+       state%warmup_segments_completed, &
+       ' segment(s) per replica; starting exchange-enabled production epoch ', &
+       state%mgr%epoch, '.'
+#endif
+
+end subroutine arex_mpi_finish_warmup
+
+subroutine arex_mpi_sync_assigned_state(state, replica_id, slot_id, ierr, message)
+  use prmtop_dat_mod, only : natom
+
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arm_md_snapshot_t) :: sync_md
+  integer :: alloc_ierr
+  integer :: root_ierr
+  integer :: valid_i
+  character(len=arex_mpi_msg_len) :: root_message
+  character(len=arex_mpi_msg_len) :: alloc_message
+
+  ierr = ARM_OK
+  message = ''
+
+  select case (state%assigned_sync_mode)
+  case (AREX_MPI_SYNC_NOOP)
+#ifdef AREX_DEBUG
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0,a,i0,a,i0)') 'AREX DBG sync_assigned_state NOOP: worker ', &
+           state%worker_id, ', replica ', replica_id, ', slot ', slot_id, &
+           ', completed_segments ', state%assigned_completed_segments
+      call flush(0)
+    end if
+#endif
+    call arex_pay_phrex_sync_assigned_replica(replica_id, slot_id, &
+         state%assigned_sync_mode, ierr, message)
+#ifdef AREX_DEBUG
+    if (ierr /= ARM_OK .and. mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG sync_assigned_state NOOP error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+    if (ierr /= ARM_OK) return
+
+    if (arex_emulate_restart == 1) then
+      call arm_emulate_common_restart_boundary(ierr, message)
+#ifdef AREX_DEBUG
+      if (ierr /= ARM_OK .and. mytaskid == 0) then
+        write(0,'(a,a)') 'AREX DBG sync_assigned_state NOOP common restart error: ', &
+             trim(message)
+        call flush(0)
+      end if
+#endif
+      if (ierr /= ARM_OK) return
+    end if
+
+    return
+
+  case (AREX_MPI_SYNC_SLOT_ONLY)
+
+#ifdef AREX_DEBUG
+    if (mytaskid == 0) then
+      write(0,'(a,i0,a,i0,a,i0,a,i0)') 'AREX DBG sync_assigned_state SLOT_ONLY: worker ', &
+           state%worker_id, ', replica ', replica_id, ', slot ', slot_id, &
+           ', completed_segments ', state%assigned_completed_segments
+      call flush(0)
+    end if
+#endif
+    call arex_pay_phrex_sync_assigned_replica(replica_id, slot_id, &
+         state%assigned_sync_mode, ierr, message)
+#ifdef AREX_DEBUG
+    if (ierr /= ARM_OK .and. mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG sync_assigned_state SLOT_ONLY error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+    if (ierr /= ARM_OK) return
+
+    if (arex_emulate_restart == 1) then
+      call arm_emulate_common_restart_boundary(ierr, message)
+#ifdef AREX_DEBUG
+      if (ierr /= ARM_OK .and. mytaskid == 0) then
+        write(0,'(a,a)') 'AREX DBG sync_assigned_state SLOT_ONLY common restart error: ', &
+             trim(message)
+        call flush(0)
+      end if
+#endif
+      if (ierr /= ARM_OK) return
+    end if
+
+    return
+
+  case default
+    continue
+  end select
+
+  alloc_message = ''
+  call arm_snapshot_allocate(sync_md, natom, alloc_ierr, alloc_message)
+  if (alloc_ierr /= ARM_OK) then
+    ierr = alloc_ierr
+    if (len(message) > 0) message = alloc_message(1:len(message))
+    return
+  end if
+
+  root_ierr = ARM_OK
+  root_message = ''
+  valid_i = 0
+
+  if (mytaskid == 0) then
+    if (.not. state%assigned_md_ready) then
+      root_ierr = ARM_ERR_INVALID
+      root_message = 'arex_mpi_sync_assigned_state: assigned_md is not ready on worker-group master'
+    else if (state%assigned_replica_id /= replica_id) then
+      root_ierr = ARM_ERR_INVALID
+      root_message = 'arex_mpi_sync_assigned_state: assigned replica id mismatch on worker-group master'
+    else
+      sync_md%valid = state%assigned_md%valid
+      if (sync_md%valid) then
+        valid_i = 1
+        sync_md%crd      = state%assigned_md%crd
+        sync_md%vel      = state%assigned_md%vel
+        sync_md%last_vel = state%assigned_md%last_vel
+        sync_md%box      = state%assigned_md%box
+        sync_md%alpha    = state%assigned_md%alpha
+        sync_md%beta     = state%assigned_md%beta
+        sync_md%gamma    = state%assigned_md%gamma
+        sync_md%time     = state%assigned_md%time
+      end if
+    end if
+  end if
+
+  call mpi_bcast(root_ierr, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  call mpi_bcast(root_message, arex_mpi_msg_len, mpi_character, 0, &
+                 pmemd_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    call arm_snapshot_deallocate(sync_md)
+    return
+  end if
+
+  call mpi_bcast(valid_i, 1, mpi_integer, 0, pmemd_comm, err_code_mpi)
+  sync_md%valid = (valid_i /= 0)
+
+  if (valid_i /= 0) then
+    call mpi_bcast(sync_md%crd, 3*sync_md%natom, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%vel, 3*sync_md%natom, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%last_vel, 3*sync_md%natom, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+
+    call mpi_bcast(sync_md%box, 3, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%alpha, 1, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%beta, 1, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%gamma, 1, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+    call mpi_bcast(sync_md%time, 1, mpi_double_precision, 0, &
+                   pmemd_comm, err_code_mpi)
+  end if
+
+  call arm_restore_common_md_state(sync_md, ierr, message)
+  if (ierr /= ARM_OK) then
+#ifdef AREX_DEBUG
+    if (mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG sync_assigned_state restore_common_md_state error: ', &
+           trim(message)
+      call flush(0)
+    end if
+#endif
+    call arm_snapshot_deallocate(sync_md)
+    return
+  end if
+
+  call arex_pay_phrex_sync_assigned_replica(replica_id, slot_id, &
+       state%assigned_sync_mode, ierr, message)
+  if (ierr /= ARM_OK) then
+#ifdef AREX_DEBUG
+    if (mytaskid == 0) then
+      write(0,'(a,a)') 'AREX DBG sync_assigned_state payload sync error: ', trim(message)
+      call flush(0)
+    end if
+#endif
+    call arm_snapshot_deallocate(sync_md)
+    return
+  end if
+
+  if (arex_emulate_restart == 1) then
+    call arm_emulate_common_restart_boundary(ierr, message)
+    if (ierr /= ARM_OK) then
+#ifdef AREX_DEBUG
+      if (mytaskid == 0) then
+        write(0,'(a,a)') 'AREX DBG sync_assigned_state FULL common restart error: ', &
+             trim(message)
+        call flush(0)
+      end if
+#endif
+      call arm_snapshot_deallocate(sync_md)
+      return
+    end if
+  end if
+
+#ifdef AREX_DEBUG
+    if (state%assigned_sync_mode == AREX_MPI_SYNC_FULL .and. &
+      state%worker_id == 1 .and. mytaskid == 0) then
+    write(0,'(a,i0,a,i0)') &
+         'AREX DBG W1 payload sync returned: replica ', replica_id, &
+         ', slot ', slot_id
+    call flush(0)
+  end if
+#endif
+
+  if (mytaskid == 0) then
+    state%assigned_md_ready = .false.
+    state%assigned_replica_id = 0
+    if (state%assigned_md%allocated) state%assigned_md%valid = .false.
+  end if
+
+  call arm_snapshot_deallocate(sync_md)
+end subroutine arex_mpi_sync_assigned_state
+
+#else
+
+!===============================================================================
+! Non-MPI stub.
+!===============================================================================
+subroutine arex_mpi_run_scheduler()
+  stop 'arex_mpi_run_scheduler: requires an MPI build'
+end subroutine arex_mpi_run_scheduler
+
+!===============================================================================
+! Non-MPI stub: initialization is not implemented in this file.
+!===============================================================================
+subroutine arex_mpi_init(state, nreplicas, nsegments, natom, payload_api, &
+                         ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nsegments
+  integer, intent(in) :: natom
+  type(arm_payload_api_t), intent(in) :: payload_api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = ARM_ERR_NOT_IMPLEMENTED
+  message = 'arex_mpi_init: requires an MPI build'
+end subroutine arex_mpi_init
+
+!===============================================================================
+! Non-MPI stub.
+!===============================================================================
+subroutine arex_mpi_finalize(state, ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  ierr = ARM_OK
+  message = ''
+  state%initialized = .false.
+end subroutine arex_mpi_finalize
+
+!===============================================================================
+! Non-MPI stub.
+!===============================================================================
+subroutine arex_mpi_begin_worker(state, campaign_done, replica_id, slot_id, &
+                                 ierr, message)
+  type(arex_mpi_state_t), intent(inout) :: state
+  logical, intent(out) :: campaign_done
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  campaign_done = .true.
+  replica_id = 0
+  slot_id = 0
+  ierr = ARM_ERR_NOT_IMPLEMENTED
+  message = 'arex_mpi_begin_worker: requires an MPI build'
+end subroutine arex_mpi_begin_worker
+
+!===============================================================================
+! Non-MPI stub.
+!===============================================================================
+subroutine arex_mpi_complete_segment(state, campaign_done, replica_id, &
+                                     slot_id, ierr, message, stop_after_segment)
+  type(arex_mpi_state_t), intent(inout) :: state
+  logical, intent(out) :: campaign_done
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  logical, intent(in), optional :: stop_after_segment
+
+  campaign_done = .true.
+  replica_id = 0
+  slot_id = 0
+  ierr = ARM_ERR_NOT_IMPLEMENTED
+  message = 'arex_mpi_complete_segment: requires an MPI build'
+end subroutine arex_mpi_complete_segment
+
+#endif
+
+end module arex_mpi_mod
diff --git a/src/pmemd/src/arex_pay.F90 b/src/pmemd/src/arex_pay.F90
new file mode 100644
index 0000000..5bdfc71
--- /dev/null
+++ b/src/pmemd/src/arex_pay.F90
@@ -0,0 +1,52 @@
+!*******************************************************************************
+! Module: arex_pay_mod
+!
+! Payload selector / facade for AREX.
+!
+! Keep this module as the stable entry point used by runmd.F90.
+! Specific payload implementations live in sibling modules such as:
+! - arex_pay_phrex_mod
+! - arex_pay_trex_mod     (future)
+! - arex_pay_hrex_mod     (future)
+!*******************************************************************************
+module arex_pay_mod
+
+  use arex_arm_mod, only : arm_payload_api_t, ARM_OK, ARM_ERR_INVALID
+  use arex_pay_common_mod, only : arex_pay_set_status, arex_pay_tolower
+  use arex_pay_phrex_mod, only : arex_pay_phrex_build_api
+  use mdin_ctrl_dat_mod, only : arex, arex_type
+
+  implicit none
+  private
+
+  public :: arex_pay_build_api
+
+contains
+
+subroutine arex_pay_build_api(api, ierr, message)
+  type(arm_payload_api_t), intent(out) :: api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  character(len=len(arex_type)) :: payload_type
+
+  payload_type = trim(arex_pay_tolower(adjustl(arex_type)))
+
+  if (arex == 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_build_api: AREX is disabled')
+    return
+  end if
+
+  select case (payload_type)
+  case ('phrex')
+    call arex_pay_phrex_build_api(api, ierr, message)
+    return
+  case default
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_build_api: unsupported arex_type=''' // trim(arex_type) // '''')
+    return
+  end select
+end subroutine arex_pay_build_api
+
+end module arex_pay_mod
diff --git a/src/pmemd/src/arex_pay_common.F90 b/src/pmemd/src/arex_pay_common.F90
new file mode 100644
index 0000000..1d4d6b6
--- /dev/null
+++ b/src/pmemd/src/arex_pay_common.F90
@@ -0,0 +1,42 @@
+!*******************************************************************************
+! Module: arex_pay_common_mod
+!
+! Shared helpers for specific AREX payload modules.
+!*******************************************************************************
+module arex_pay_common_mod
+
+  implicit none
+  private
+
+  public :: arex_pay_set_status
+  public :: arex_pay_tolower
+
+contains
+
+subroutine arex_pay_set_status(ierr, message, code, text)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer, intent(in) :: code
+  character(len=*), intent(in) :: text
+
+  ierr = code
+  if (len(message) > 0) message = text
+end subroutine arex_pay_set_status
+
+pure function arex_pay_tolower(text) result(lower)
+  character(len=*), intent(in) :: text
+  character(len=len(text)) :: lower
+
+  integer :: i, c
+
+  do i = 1, len(text)
+    c = iachar(text(i:i))
+    if (c >= iachar('A') .and. c <= iachar('Z')) then
+      lower(i:i) = achar(c + 32)
+    else
+      lower(i:i) = text(i:i)
+    end if
+  end do
+end function arex_pay_tolower
+
+end module arex_pay_common_mod
