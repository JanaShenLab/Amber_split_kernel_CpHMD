+template <bool DoFswitch, bool DoEnergy>
+static __device__ __forceinline__
+void kPMEPHMDComputeLJCorrectionTerms(const kPMEPHMDDirectConst& sim,
+                                      const PMEFloat2 term,
+                                      const PMEFloat r2,
+                                      const PMEFloat r2inv,
+                                      const PMEFloat rinv,
+                                      const PMEFloat r6inv,
+                                      const PMEFloat fnrange,
+                                      const PMEFloat sixth,
+                                      const PMEFloat twelvth,
+                                      PMEFloat& de,
+                                      PMEFloat& ljdf)
+{
+  if (DoFswitch) {
+    const PMEFloat r3inv = rinv * r2inv;
+    const PMEFloat r12inv = r6inv * r6inv;
+
+    PMEFloat df12 = (PMEFloat)(-1.0) * term.x * r2inv * r12inv;
+    PMEFloat df6  = (PMEFloat)(-1.0) * term.y * r2inv * r6inv;
+
+    PMEFloat f12 = term.x * r12inv - term.x * sim.invfswitch6cut6;
+    PMEFloat f6  = term.y * r6inv  - term.y * sim.invfswitch3cut3;
+
+    if (r2 > sim.fswitch2) {
+      df12 = (PMEFloat)(-1.0) *
+             term.x *
+             sim.cut6invcut6minfswitch6 *
+             r2inv *
+             r6inv *
+             (r6inv - sim.cut6inv);
+
+      df6 = (PMEFloat)(-1.0) *
+            term.y *
+            sim.cut3invcut3minfswitch3 *
+            r3inv *
+            r2inv *
+            (r3inv - sim.cut3inv);
+
+      if (DoEnergy) {
+        f12 = term.x *
+              sim.cut6invcut6minfswitch6 *
+              (r6inv - sim.cut6inv) *
+              (r6inv - sim.cut6inv);
+
+        f6 = term.y *
+             sim.cut3invcut3minfswitch3 *
+             (r3inv - sim.cut3inv) *
+             (r3inv - sim.cut3inv);
+      }
+    }
+
+    ljdf = df6 - df12;
+    de = fnrange * (f12 * twelvth - f6 * sixth);
+  }
+  else {
+    const PMEFloat f6 = term.y * r6inv;
+    const PMEFloat f12 = term.x * r6inv * r6inv;
+
+    ljdf = (f12 - f6) * r2inv;
+    de = fnrange * (f12 * twelvth - f6 * sixth);
+  }
+}
+
+static __device__ __forceinline__
+PMEFloat kPMEPHMDDSwitchDx(const kPMEPHMDDirectConst& sim,
+                           const PMEFloat r2)
+{
+  return sim.negTwoEw_coeffRsqrtPI * exp(-sim.ew_coeff2 * r2);
+}
+
+template <bool DoEnergy, bool SwtchAlreadyHasRinv>
+static __device__ __forceinline__
+PMEFloat kPMEPHMDBaseForceDf(const PMEFloat qiqj,
+                             const PMEFloat ljdf,
+                             const PMEFloat swtch,
+                             const PMEFloat rinv,
+                             const PMEFloat r2inv,
+                             const PMEFloat d_swtch_dx)
+{
+  PMEFloat df = ljdf;
+
+  if (DoEnergy) {
+    if (SwtchAlreadyHasRinv) {
+      df += (qiqj * swtch - qiqj * d_swtch_dx) * r2inv;
+    }
+    else {
+      df += (qiqj * swtch * rinv - qiqj * d_swtch_dx) * r2inv;
+    }
+  }
+
+  return df;
+}
+
+template <bool DoFswitch, bool DoEnergy>
+static __device__ __forceinline__
+void kPMEPHMDComputeDistanceTerms(const PMEFloat r2,
+                                  PMEFloat& r2inv,
+                                  PMEFloat& r,
+                                  PMEFloat& rinv)
+{
+  if (DoFswitch) {
+    rinv = rsqrt(r2);
+    r = r2 * rinv;
+    r2inv = rinv * rinv;
+  }
+  else {
+    if (DoEnergy) {
+      // Match old PME_ENERGY / NRG path.
+      rinv = rsqrt(r2);
+      r = r2 * rinv;
+      r2inv = rinv * rinv;
+    }
+    else {
+      // Preserve already-valid force-only A behavior.
+      r2inv = (PMEFloat)1.0 / r2;
+      r = sqrt(r2);
+      rinv = (PMEFloat)1.0 / r;
+    }
+  }
+}
