+subroutine arex_pay_phrex_compute_proton_count(theta_values, proton_count, ierr, message)
+  real(dp), intent(in) :: theta_values(:)
+  real(dp), intent(out) :: proton_count
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  real(dp) :: lambda_i
+
+  proton_count = 0.0_dp
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. allocated(sp_grp)) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_compute_proton_count: sp_grp is not allocated')
+    return
+  end if
+
+  if (ntitr <= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_compute_proton_count: ntitr must be > 0')
+    return
+  end if
+
+  if (size(theta_values) < ntitr) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_compute_proton_count: theta_values is too small')
+    return
+  end if
+
+  do i = 1, ntitr
+    if (sp_grp(i) == 0 .or. sp_grp(i) == 1 .or. sp_grp(i) == 3) then
+      lambda_i = sin(theta_values(i))**2
+      proton_count = proton_count + (1.0_dp - lambda_i)
+    end if
+  end do
+end subroutine arex_pay_phrex_compute_proton_count
+
+subroutine arex_pay_phrex_seed_rng(ierr, message)
+  use mdin_ctrl_dat_mod, only : arex_seed
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer, parameter :: i8 = selected_int_kind(18)
+
+  integer :: n, i, alloc_stat
+  integer, allocatable :: seed_values(:)
+
+  integer(kind=i8) :: clock_count
+  integer(kind=i8) :: clock_rate
+  integer(kind=i8) :: clock_max
+  integer(kind=i8) :: mixed
+  integer(kind=i8) :: int_huge
+  integer :: date_values(8)
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+  ! arex_seed == 0 preserves the existing behavior:
+  ! do not explicitly seed Fortran's RNG.
+  if (arex_seed == 0) return
+
+  call random_seed(size=n)
+
+  allocate(seed_values(n), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arex_pay_phrex_seed_rng: failed to allocate seed_values')
+    return
+  end if
+
+  int_huge = int(huge(1) - 1, kind=i8)
+
+  if (arex_seed > 0) then
+    ! Reproducible deterministic seed.
+    do i = 1, n
+      mixed = int(abs(arex_seed), kind=i8) + 37_i8 * int(i, kind=i8)
+      seed_values(i) = int(mod(mixed, int_huge) + 1_i8)
+    end do
+
+  else
+    ! arex_seed < 0: initialize from wall-clock/system-clock state.
+    call system_clock(count=clock_count, count_rate=clock_rate, &
+                      count_max=clock_max)
+    call date_and_time(values=date_values)
+
+    do i = 1, n
+      mixed = abs(clock_count)                                      &
+            + 104729_i8 * int(i, kind=i8)                           &
+            + 7919_i8   * abs(clock_rate)                           &
+            + 1543_i8   * abs(clock_max)                            &
+            + 37_i8     * int(date_values(8), kind=i8)              &
+            + 101_i8    * int(date_values(7), kind=i8)              &
+            + 1009_i8   * int(date_values(6), kind=i8)              &
+            + 10007_i8  * int(date_values(5), kind=i8)
+
+      seed_values(i) = int(mod(mixed, int_huge) + 1_i8)
+    end do
+  end if
+
+  call random_seed(put=seed_values)
+  deallocate(seed_values)
+end subroutine arex_pay_phrex_seed_rng
+
+subroutine arex_pay_phrex_release_storage()
+  if (allocated(phrex_slot_ladder))   deallocate(phrex_slot_ladder)
+  if (allocated(phrex_theta))         deallocate(phrex_theta)
+  if (allocated(phrex_dtheta))        deallocate(phrex_dtheta)
+  if (allocated(phrex_vtheta))        deallocate(phrex_vtheta)
+  if (allocated(phrex_dphold))        deallocate(phrex_dphold)
+  if (allocated(phrex_vphold))        deallocate(phrex_vphold)
+  if (allocated(phrex_proton_count))  deallocate(phrex_proton_count)
+  if (allocated(phrex_iupdate))       deallocate(phrex_iupdate)
+
+#ifdef CUDA
+  if (allocated(phrex_random_counter)) deallocate(phrex_random_counter)
+  if (allocated(phrex_random))         deallocate(phrex_random)
+  phrex_random_buffer_size = 0
+#endif
+
+  phrex_initialized = .false.
+  phrex_nreplicas   = 0
+  phrex_nslots      = 0
+  phrex_ntitr       = 0
+  phrex_ntheta      = 0
+end subroutine arex_pay_phrex_release_storage
+
+end module arex_pay_phrex_mod
diff --git a/src/pmemd/src/arex_restraint.F90 b/src/pmemd/src/arex_restraint.F90
new file mode 100644
index 0000000..1dc77e2
--- /dev/null
+++ b/src/pmemd/src/arex_restraint.F90
@@ -0,0 +1,314 @@
+#include "copyright.i"
+
+!*******************************************************************************
+!
+! Module: arex_restraint_mod
+!
+! Purpose
+! -------
+! Apply an optional piecewise-constant positional-restraint force schedule at
+! AREX assignment boundaries.
+!
+! The schedule coordinate is the cumulative number of completed MD segments for
+! the assigned condition slot. Slot progress is monotonic across warmup and
+! production and is restored from the AREX checkpoint.
+!
+! Schedule semantics
+! ------------------
+! arex_restraint_segment(i) is a zero-based slot segment boundary.
+! arex_restraint_force(i) applies from that boundary through the segment before
+! the next boundary. The final force persists indefinitely.
+!
+! When arex_restraint_npoints == 0, this module performs no operation and
+! preserves ordinary PMEMD restraint behavior.
+!
+! The enabled schedule applies one absolute, uniform force constant to all atoms
+! in the existing positional-restraint selection. Mask input and GROUP input are
+! both supported when the constructed restraint weights are uniform.
+!
+!*******************************************************************************
+
+module arex_restraint_mod
+
+  use, intrinsic :: ieee_arithmetic, only : ieee_is_finite
+
+  use arex_arm_mod, only : dp, ARM_OK, ARM_ERR_INVALID
+  use constraints_mod, only : natc, atm_weight
+  use file_io_dat_mod, only : mdout
+  use mdin_ctrl_dat_mod, only : arex, ntr, arex_warmup_segments, &
+                                arex_restraint_npoints, &
+                                arex_restraint_segment, &
+                                arex_restraint_force
+#ifdef MPI
+  use parallel_dat_mod, only : mytaskid
+#endif
+
+  implicit none
+  private
+
+  real(dp), parameter :: arex_restraint_uniform_tol = 1.0e-12_dp
+
+  logical :: arex_restraint_runtime_validated = .false.
+  logical :: arex_restraint_force_applied     = .false.
+  real(dp) :: arex_restraint_last_force       = 0.0_dp
+
+  public :: arex_restraint_apply
+
+contains
+
+!===============================================================================
+! Validate the input schedule and the already-constructed positional-restraint
+! atom selection.
+!===============================================================================
+subroutine arex_restraint_validate_runtime(ierr, message)
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  real(dp) :: reference_weight
+  real(dp) :: weight_scale
+
+  ierr = ARM_OK
+  message = ''
+
+  if (arex_restraint_npoints <= 0) return
+
+  if (arex /= 1) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: schedule requires arex = 1'
+    return
+  end if
+
+  if (arex_warmup_segments <= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: schedule requires arex_warmup_segments > 0'
+    return
+  end if
+
+  if (ntr /= 1) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: schedule requires ntr = 1'
+    return
+  end if
+
+  if (arex_restraint_npoints > size(arex_restraint_segment) .or. &
+      arex_restraint_npoints > size(arex_restraint_force)) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: schedule point count exceeds array capacity'
+    return
+  end if
+
+  if (arex_restraint_segment(1) /= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: first schedule segment must be zero'
+    return
+  end if
+
+  do i = 1, arex_restraint_npoints
+
+    if (arex_restraint_segment(i) < 0 .or. &
+        arex_restraint_segment(i) > arex_warmup_segments) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_restraint: schedule segment is outside the warmup range'
+      return
+    end if
+
+    if (.not. ieee_is_finite(arex_restraint_force(i))) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_restraint: schedule force must be finite'
+      return
+    end if
+
+    if (arex_restraint_force(i) < 0.0_dp) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_restraint: schedule force must be nonnegative'
+      return
+    end if
+
+    if (i > 1) then
+      if (arex_restraint_segment(i) <= arex_restraint_segment(i - 1)) then
+        ierr = ARM_ERR_INVALID
+        message = 'arex_restraint: schedule segments must be strictly increasing'
+        return
+      end if
+    end if
+
+  end do
+
+  if (natc <= 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: enabled schedule has no restrained atoms'
+    return
+  end if
+
+  if (.not. allocated(atm_weight)) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: restraint weight array is not allocated'
+    return
+  end if
+
+  if (size(atm_weight) < natc) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: restraint weight array is smaller than natc'
+    return
+  end if
+
+  reference_weight = atm_weight(1)
+
+  if (.not. ieee_is_finite(reference_weight)) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: initial restraint weight must be finite'
+    return
+  end if
+
+  weight_scale = max(1.0_dp, abs(reference_weight))
+
+  do i = 2, natc
+
+    if (.not. ieee_is_finite(atm_weight(i))) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_restraint: initial restraint weights must be finite'
+      return
+    end if
+
+    if (abs(atm_weight(i) - reference_weight) > &
+        arex_restraint_uniform_tol * weight_scale) then
+      ierr = ARM_ERR_INVALID
+      message = 'arex_restraint: positional-restraint weights are not uniform'
+      return
+    end if
+
+  end do
+
+  arex_restraint_runtime_validated = .true.
+
+end subroutine arex_restraint_validate_runtime
+
+!===============================================================================
+! Resolve the piecewise-constant force for one cumulative slot segment count.
+!===============================================================================
+subroutine arex_restraint_resolve_force(completed_segments, force_value, &
+                                        ierr, message)
+
+  integer, intent(in) :: completed_segments
+  real(dp), intent(out) :: force_value
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+
+  ierr = ARM_OK
+  message = ''
+  force_value = 0.0_dp
+
+  if (completed_segments < 0) then
+    ierr = ARM_ERR_INVALID
+    message = 'arex_restraint: assigned completed segment count is negative'
+    return
+  end if
+
+  if (arex_restraint_npoints <= 0) return
+
+  force_value = arex_restraint_force(1)
+
+  do i = 2, arex_restraint_npoints
+    if (completed_segments < arex_restraint_segment(i)) exit
+    force_value = arex_restraint_force(i)
+  end do
+
+end subroutine arex_restraint_resolve_force
+
+!===============================================================================
+! Apply the schedule for the newly assigned slot.
+!===============================================================================
+subroutine arex_restraint_apply(completed_segments, ierr, message)
+
+  integer, intent(in) :: completed_segments
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  logical :: report_transition
+  real(dp) :: new_force
+  real(dp) :: previous_force
+
+#ifdef CUDA
+  integer :: gpu_ierr
+
+  interface
+    subroutine gpu_constraints_update_weights(natc_in, weights_in, ierr_out)
+      import dp
+      integer, intent(in) :: natc_in
+      real(dp), intent(in) :: weights_in(*)
+      integer, intent(out) :: ierr_out
+    end subroutine gpu_constraints_update_weights
+  end interface
+#endif
+
+  ierr = ARM_OK
+  message = ''
+
+  ! Complete compatibility switch.
+  if (arex_restraint_npoints <= 0) return
+
+  if (.not. arex_restraint_runtime_validated) then
+    call arex_restraint_validate_runtime(ierr, message)
+    if (ierr /= ARM_OK) return
+  end if
+
+  call arex_restraint_resolve_force(completed_segments, new_force, &
+                                    ierr, message)
+  if (ierr /= ARM_OK) return
+
+  ! Input schedule values are copied directly, so exact comparison is valid.
+  if (arex_restraint_force_applied) then
+    if (new_force == arex_restraint_last_force) return
+  end if
+
+  previous_force = atm_weight(1)
+  atm_weight(1:natc) = new_force
+
+#ifdef CUDA
+  gpu_ierr = 0
+  call gpu_constraints_update_weights(natc, atm_weight, gpu_ierr)
+
+  if (gpu_ierr /= 0) then
+    ! GPU validation failures occur before upload, so restoring the host value
+    ! keeps host and device restraint state consistent.
+    atm_weight(1:natc) = previous_force
+
+    ierr = ARM_ERR_INVALID
+
+    select case (gpu_ierr)
+    case (1)
+      message = 'arex_restraint: invalid CUDA restraint update arguments'
+    case (2)
+      message = 'arex_restraint: CUDA restraint buffer is not initialized'
+    case (3)
+      message = 'arex_restraint: CUDA restraint buffer count mismatch'
+    case default
+      write(message, '(a,i0)') &
+        'arex_restraint: unknown CUDA restraint update error ', gpu_ierr
+    end select
+
+    return
+  end if
+#endif
+
+  arex_restraint_last_force   = new_force
+  arex_restraint_force_applied = .true.
+
+  report_transition = .true.
+#ifdef MPI
+  report_transition = mytaskid == 0
+#endif
+
+  if (report_transition) then
+    write(mdout, '(a,i0,a,es16.8)') &
+      ' AREX> positional-restraint schedule: slot segment ', &
+      completed_segments, ', force = ', new_force
+  end if
+
+end subroutine arex_restraint_apply
+
+end module arex_restraint_mod
diff --git a/src/pmemd/src/arex_rst.F90 b/src/pmemd/src/arex_rst.F90
new file mode 100644
index 0000000..4f91f11
--- /dev/null
+++ b/src/pmemd/src/arex_rst.F90
@@ -0,0 +1,2866 @@
+#include "copyright.i"
+
+!*******************************************************************************
+!
+! Module: arex_rst_mod
+!
+! Description:
+!   Internal AREX restart/checkpoint support.
+!
+!   This module owns the AREX checkpoint file schema, read/write, validation,
+!   and logical-state restore for AREX campaigns. It is intentionally separate
+!   from arex_io_mod, which owns slot-scoped user-facing output names and
+!   runtime output contexts.
+!
+!   Current scope in this file:
+!     * checkpoint schema/version
+!     * checkpoint read/write for logical AREX campaign state
+!     * inventory/compatibility validation for --arexrst <checkpoint>
+!     * logical manager restore
+!     * explicit placeholder hooks for:
+!         - common-MD seeding from slot restart files
+!         - payload checkpoint capture/apply
+!         - payload seeding from slot restart files
+!
+!   The placeholder hooks are intentional. They make the missing integration
+!   points explicit without burying the restart contract in later edits.
+!
+!*******************************************************************************
+
+module arex_rst_mod
+
+  use, intrinsic :: iso_c_binding, only : c_int, c_char, c_null_char
+  use arex_arm_mod, only : arm_manager_t, arm_md_snapshot_t,                  &
+                           arm_snapshot_allocate, arm_snapshot_deallocate,    &
+                           dp, ARM_PARITY_EVEN, ARM_OK,                     &
+                           ARM_REPLICA_IDLE, ARM_WORKER_IDLE,              &
+                           arm_write_migration_history
+  use arex_io_mod,  only : AREX_IO_OK,                                        &
+                           arex_io_is_enabled, arex_io_get_slot_names,        &
+                           arex_io_get_names_for_ladder_value,                 &
+                           arex_io_bintraj_state_t,                           &
+                           arex_io_get_slot_bintraj_state,                    &
+                           arex_io_set_slot_bintraj_state,                    &
+                           arex_io_get_slot_phmd_output_initialized,          &
+                           arex_io_set_slot_phmd_output_initialized,          &
+                           arex_io_set_slot_restart_initialized
+  use arex_pay_common_mod, only : arex_pay_tolower
+  use arex_pay_phrex_mod, only : arex_pay_phrex_get_checkpoint_shape,         &
+                                 arex_pay_phrex_export_slot_ladder,           &
+                                 arex_pay_phrex_export_checkpoint_state,      &
+                                 arex_pay_phrex_import_checkpoint_state,      &
+                                 arex_pay_phrex_import_checkpoint_state_mapped, &
+                                 arex_pay_phrex_seed_replica_from_restart
+  use binrestart_mod, only : read_nc_restart, read_nc_restart_atoms
+  use file_io_dat_mod, only : max_fn_len
+  use get_cmdline_mod, only : arexrst_specified, arex_append, arex_continuation_part
+  use mdin_ctrl_dat_mod, only : arex, arex_type, arex_segment_steps, arex_ladder, &
+                                arex_ladder_unset, iphmd, ntb, ntxo, ntwx, ntwv,  &
+                                ntwf, dt
+  use prmtop_dat_mod, only : natom
+  use phmd_mod, only : phmd_read_restart_state
+
+  implicit none
+  private
+
+  integer, parameter, public :: AREX_RST_OK                  = 0
+  integer, parameter, public :: AREX_RST_ERR_INVALID         = 1
+  integer, parameter, public :: AREX_RST_ERR_IO              = 2
+  integer, parameter, public :: AREX_RST_ERR_ALLOC           = 3
+  integer, parameter, public :: AREX_RST_ERR_MISMATCH        = 4
+  integer, parameter, public :: AREX_RST_ERR_NOT_IMPLEMENTED = 5
+
+  integer, parameter, public :: AREX_RST_FORMAT_VERSION = 9
+  character(len=*), parameter :: AREX_RST_MAGIC = 'AREX_RST'
+
+  integer, parameter :: AREX_RST_RESTART_FORMAT_UNKNOWN     = 0
+  integer, parameter :: AREX_RST_RESTART_FORMAT_FORMATTED   = 1
+  integer, parameter :: AREX_RST_RESTART_FORMAT_NETCDF      = 2
+  integer, parameter :: AREX_RST_RESTART_FORMAT_UNFORMATTED = 3
+
+  type, public :: arex_rst_slot_files_t
+    integer :: slot_id = 0
+    character(len=max_fn_len) :: restrt_name     = ''
+    character(len=max_fn_len) :: phmdrestrt_out_name = ''
+  end type arex_rst_slot_files_t
+
+  type, public :: arex_rst_replica_state_t
+    integer :: replica_id              = 0
+    integer :: replica_uid             = 0
+    integer :: parent_uid              = 0
+    integer :: slot_id                 = 0
+    integer :: segments_completed      = 0
+    integer :: completed_epoch         = 0
+    integer :: exchange_resolved_epoch = 0
+  end type arex_rst_replica_state_t
+
+    type, public :: arex_rst_slot_output_state_t
+    integer :: slot_id            = 0
+    integer :: restart_replica_id       = 0
+    integer :: restart_replica_segments = 0
+    real(dp) :: restart_time_ps          = 0.0_dp
+    logical :: binary_initialized      = .false.
+    logical :: phmd_output_initialized = .false.
+    integer :: mdcrd_frame             = 1
+    integer :: mdvel_frame             = 1
+    integer :: mdfrc_frame             = 1
+    integer :: mdcrd_logical_steps     = 0
+    integer :: part_start_step         = 0
+    real(dp) :: mdcrd_time_origin_ps   = 0.0_dp
+    real(dp) :: mdcrd_logical_time_ps  = 0.0_dp
+  end type arex_rst_slot_output_state_t
+
+  type, public :: arex_rst_checkpoint_t
+    logical :: allocated = .false.
+
+    character(len=32) :: magic = AREX_RST_MAGIC
+    integer :: format_version   = AREX_RST_FORMAT_VERSION
+
+    character(len=32) :: payload_type = ''
+
+    integer :: natom               = 0
+    integer :: nreplicas           = 0
+    integer :: nslots              = 0
+    integer :: next_replica_uid    = 1
+    integer :: history_generation  = 0
+    integer :: continuation_part   = 0
+    integer :: checkpoint_generation = -1
+    character(len=max_fn_len) :: source_directory = '.'
+    ! Restart snapshots owned by this checkpoint generation, relative to its
+    ! directory. Present in v9; v8 resolves the legacy per-ladder basenames.
+    character(len=max_fn_len), allocatable :: restart_files(:)
+    character(len=max_fn_len), allocatable :: phmd_restart_files(:)
+    integer :: segments_per_replica = 0
+    integer :: epoch                = 0
+    integer :: current_parity       = ARM_PARITY_EVEN
+    integer :: segment_steps        = 0
+
+    integer :: warmup_segments_target    = 0
+    integer :: warmup_segments_completed = 0
+
+    integer :: scheduler_rng_size = 0
+    integer, allocatable :: scheduler_rng(:)
+
+    real(dp), allocatable :: slot_ladder(:)
+    integer,  allocatable :: slot_owner(:)
+    type(arex_rst_replica_state_t), allocatable :: replicas(:)
+    type(arex_rst_slot_output_state_t), allocatable :: slot_output(:)
+
+    logical :: have_payload_checkpoint = .false.
+
+    ! PHREX payload checkpoint block.
+    !
+    ! These fields are part of the restart contract even though the actual
+    ! capture/apply hooks are placeholders in this revision.
+    integer :: phrex_ntheta = 0
+    logical,  allocatable :: phrex_valid(:)
+    integer,  allocatable :: phrex_iupdate(:)
+    real(dp), allocatable :: phrex_proton_count(:)
+    real(dp), allocatable :: phrex_theta(:,:)
+    real(dp), allocatable :: phrex_dtheta(:,:)
+    real(dp), allocatable :: phrex_vtheta(:,:)
+    real(dp), allocatable :: phrex_dphold(:,:)
+    real(dp), allocatable :: phrex_vphold(:,:)
+#ifdef CUDA
+    integer :: phrex_random_buffer_size = 0
+    integer,  allocatable :: phrex_random_counter(:)
+    real(dp), allocatable :: phrex_random(:,:)
+#endif
+  end type arex_rst_checkpoint_t
+
+  public :: arex_rst_release_checkpoint
+  public :: arex_rst_get_required_slot_files
+  public :: arex_rst_validate_restart_inventory
+  public :: arex_rst_capture_checkpoint
+  public :: arex_rst_write_checkpoint
+  public :: arex_rst_remove_numbered_set
+  public :: arex_rst_read_checkpoint
+  public :: arex_rst_get_checkpoint_warmup_state
+  public :: arex_rst_apply_logical_state
+  public :: arex_rst_restore_from_checkpoint
+  public :: arex_rst_ladder_count
+  public :: arex_rst_build_migration_map
+
+  interface
+    integer(c_int) function arex_c_rename(oldpath, newpath) bind(C, name='rename')
+      import :: c_int, c_char
+      character(kind=c_char), intent(in) :: oldpath(*)
+      character(kind=c_char), intent(in) :: newpath(*)
+    end function arex_c_rename
+  end interface
+contains
+
+subroutine arex_rst_set_status(ierr, message, code, text)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer, intent(in) :: code
+  character(len=*), intent(in) :: text
+
+  ierr = code
+  if (len(message) > 0) message = text
+end subroutine arex_rst_set_status
+
+subroutine arex_rst_release_checkpoint(ckpt)
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+
+  if (allocated(ckpt%scheduler_rng))     deallocate(ckpt%scheduler_rng)
+  if (allocated(ckpt%slot_ladder))        deallocate(ckpt%slot_ladder)
+  if (allocated(ckpt%slot_owner))         deallocate(ckpt%slot_owner)
+  if (allocated(ckpt%replicas))           deallocate(ckpt%replicas)
+  if (allocated(ckpt%slot_output))        deallocate(ckpt%slot_output)
+  if (allocated(ckpt%restart_files))      deallocate(ckpt%restart_files)
+  if (allocated(ckpt%phmd_restart_files)) deallocate(ckpt%phmd_restart_files)
+  if (allocated(ckpt%phrex_valid))        deallocate(ckpt%phrex_valid)
+  if (allocated(ckpt%phrex_iupdate))      deallocate(ckpt%phrex_iupdate)
+  if (allocated(ckpt%phrex_proton_count)) deallocate(ckpt%phrex_proton_count)
+  if (allocated(ckpt%phrex_theta))        deallocate(ckpt%phrex_theta)
+  if (allocated(ckpt%phrex_dtheta))       deallocate(ckpt%phrex_dtheta)
+  if (allocated(ckpt%phrex_vtheta))       deallocate(ckpt%phrex_vtheta)
+  if (allocated(ckpt%phrex_dphold))       deallocate(ckpt%phrex_dphold)
+  if (allocated(ckpt%phrex_vphold))       deallocate(ckpt%phrex_vphold)
+#ifdef CUDA
+  if (allocated(ckpt%phrex_random_counter)) deallocate(ckpt%phrex_random_counter)
+  if (allocated(ckpt%phrex_random))         deallocate(ckpt%phrex_random)
+#endif
+
+  ckpt%allocated             = .false.
+  ckpt%magic                 = AREX_RST_MAGIC
+  ckpt%format_version        = AREX_RST_FORMAT_VERSION
+  ckpt%payload_type          = ''
+  ckpt%natom                 = 0
+  ckpt%nreplicas             = 0
+  ckpt%nslots                = 0
+  ckpt%next_replica_uid      = 1
+  ckpt%history_generation    = 0
+  ckpt%continuation_part     = 0
+  ckpt%checkpoint_generation = -1
+  ckpt%source_directory = '.'
+  ckpt%segments_per_replica   = 0
+  ckpt%epoch                  = 0
+  ckpt%current_parity         = ARM_PARITY_EVEN
+  ckpt%segment_steps          = 0
+  ckpt%warmup_segments_target = 0
+  ckpt%warmup_segments_completed = 0
+  ckpt%scheduler_rng_size    = 0
+  ckpt%have_payload_checkpoint = .false.
+  ckpt%phrex_ntheta          = 0
+#ifdef CUDA
+  ckpt%phrex_random_buffer_size = 0
+#endif
+end subroutine arex_rst_release_checkpoint
+
+integer function arex_rst_ladder_count()
+  integer :: i
+
+  arex_rst_ladder_count = 0
+  do i = 1, size(arex_ladder)
+    if (arex_ladder(i) == arex_ladder_unset) exit
+    arex_rst_ladder_count = arex_rst_ladder_count + 1
+  end do
+end function arex_rst_ladder_count
+
+subroutine arex_rst_get_required_slot_files(slot_files, nslots, ierr, message)
+  type(arex_rst_slot_files_t), allocatable, intent(out) :: slot_files(:)
+  integer, intent(out) :: nslots
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: slot_id
+  integer :: io_ierr
+  character(len=256) :: io_message
+  character(len=max_fn_len) :: mdcrd_name
+  character(len=max_fn_len) :: mdvel_name
+  character(len=max_fn_len) :: mdfrc_name
+  character(len=max_fn_len) :: restrt_name
+  character(len=max_fn_len) :: phmdout_name
+  character(len=max_fn_len) :: phmdrestrt_out_name
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  nslots = 0
+  if (allocated(slot_files)) deallocate(slot_files)
+
+  if (arex /= 1) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_get_required_slot_files: AREX is not enabled')
+    return
+  end if
+
+  if (.not. arex_io_is_enabled()) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_get_required_slot_files: AREX I/O is not initialized/enabled')
+    return
+  end if
+
+  nslots = arex_rst_ladder_count()
+  if (nslots <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_get_required_slot_files: invalid AREX slot count from ladder')
+    return
+  end if
+
+  allocate(slot_files(nslots))
+
+  do slot_id = 1, nslots
+    io_ierr = AREX_RST_OK
+    io_message = ''
+
+    call arex_io_get_slot_names(slot_id, mdcrd_name, mdvel_name, mdfrc_name, &
+                                restrt_name, phmdout_name, phmdrestrt_out_name, &
+                                io_ierr, io_message)
+    if (io_ierr /= AREX_RST_OK) then
+      deallocate(slot_files)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+    slot_files(slot_id)%slot_id         = slot_id
+    slot_files(slot_id)%restrt_name     = restrt_name
+    slot_files(slot_id)%phmdrestrt_out_name = phmdrestrt_out_name
+  end do
+end subroutine arex_rst_get_required_slot_files
+
+subroutine arex_rst_derive_slot_output_state(mgr, slot_id, slot_output, ierr, message)
+  type(arm_manager_t), intent(in) :: mgr
+  integer, intent(in) :: slot_id
+  type(arex_rst_slot_output_state_t), intent(out) :: slot_output
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_io_bintraj_state_t) :: bintraj_state
+  integer :: io_ierr
+  integer :: completed_segments
+  integer :: logical_steps
+  character(len=256) :: io_message
+  logical :: initialized
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  slot_output%slot_id                 = slot_id
+  slot_output%restart_replica_id      = 0
+  slot_output%restart_replica_segments = 0
+  slot_output%restart_time_ps          = 0.0_dp
+  slot_output%binary_initialized      = .false.
+  slot_output%phmd_output_initialized = .false.
+  slot_output%mdcrd_frame             = 1
+  slot_output%mdvel_frame             = 1
+  slot_output%mdfrc_frame             = 1
+  slot_output%mdcrd_logical_steps     = 0
+  slot_output%part_start_step         = 0
+  slot_output%mdcrd_time_origin_ps    = 0.0_dp
+  slot_output%mdcrd_logical_time_ps   = 0.0_dp
+
+  if (slot_id < 1 .or. slot_id > mgr%nslots) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_derive_slot_output_state: invalid slot_id')
+    return
+  end if
+
+  ! Preserve the slot time origin from AREX I/O state. This origin is stable
+  ! across the campaign and is restored from checkpoint on continuation.
+  io_ierr = AREX_IO_OK
+  io_message = ''
+  call arex_io_get_slot_bintraj_state(slot_id, bintraj_state, initialized, io_ierr, io_message)
+  if (io_ierr /= AREX_IO_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+    return
+  end if
+
+  slot_output%mdcrd_time_origin_ps = bintraj_state%mdcrd_time_origin_ps
+  slot_output%part_start_step = bintraj_state%part_start_step
+
+  ! Derive authoritative slot progress from the fixed condition slot, not from
+  ! the replica currently occupying that slot.
+  if (.not. allocated(mgr%slot_segments_completed)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot_segments_completed is not allocated')
+    return
+  end if
+
+  if (.not. allocated(mgr%slot_restart_owner)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot_restart_owner is not allocated')
+    return
+  end if
+
+  if (.not. allocated(mgr%slot_restart_replica_segments)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot restart progress is not allocated')
+    return
+  end if
+
+  slot_output%restart_replica_id = mgr%slot_restart_owner(slot_id)
+  slot_output%restart_replica_segments = mgr%slot_restart_replica_segments(slot_id)
+  if (slot_output%restart_replica_id < 1 .or. &
+      slot_output%restart_replica_id > mgr%nreplicas) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot restart owner is invalid')
+    return
+  end if
+
+  if (slot_output%restart_replica_segments /= &
+      mgr%replicas(slot_output%restart_replica_id)%segments_completed) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot restart walker state is stale')
+    return
+  end if
+
+  if (.not. mgr%replicas(slot_output%restart_replica_id)%md%valid) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: slot restart walker MD state is invalid')
+    return
+  end if
+
+  ! The slot-owned MD restart is written with arex_io_active_slot_time(),
+  ! not the running PMEMD t captured in the replica MD snapshot.  Use the
+  ! same slot logical clock for the checkpoint's restart-time validation.
+  completed_segments = mgr%slot_segments_completed(slot_id)
+  if (completed_segments < 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_derive_slot_output_state: negative slot completed segment count')
+    return
+  end if
+
+  logical_steps = completed_segments * arex_segment_steps
+
+  slot_output%mdcrd_logical_steps   = logical_steps
+  slot_output%mdcrd_logical_time_ps = slot_output%mdcrd_time_origin_ps + dble(logical_steps) * dt
+  slot_output%restart_time_ps       = slot_output%mdcrd_logical_time_ps
+
+  if (ntwx > 0) then
+    slot_output%mdcrd_frame = logical_steps / ntwx - slot_output%part_start_step / ntwx + 1
+  else
+    slot_output%mdcrd_frame = 1
+  end if
+
+  if (ntwv > 0) then
+    slot_output%mdvel_frame = logical_steps / ntwv - slot_output%part_start_step / ntwv + 1
+  else if (ntwv < 0) then
+    slot_output%mdvel_frame = slot_output%mdcrd_frame
+  else
+    slot_output%mdvel_frame = 1
+  end if
+
+  if (ntwf > 0) then
+    slot_output%mdfrc_frame = logical_steps / ntwf - slot_output%part_start_step / ntwf + 1
+  else if (ntwf < 0) then
+    slot_output%mdfrc_frame = slot_output%mdcrd_frame
+  else
+    slot_output%mdfrc_frame = 1
+  end if
+
+  ! Process-local NetCDF handles are never authoritative checkpoint state.
+  ! Force local reopen after continuation; append/recreate behavior is driven
+  ! by the restored frame counters above.
+  slot_output%binary_initialized = .false.
+
+  ! PHMD slot-owned text output should append iff the slot has already emitted
+  ! at least one completed segment in the current campaign.
+  slot_output%phmd_output_initialized = (logical_steps > slot_output%part_start_step)
+
+end subroutine arex_rst_derive_slot_output_state
+
+subroutine arex_rst_validate_restart_inventory(checkpoint_name, ierr, message)
+  character(len=*), intent(in) :: checkpoint_name
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_rst_checkpoint_t) :: ckpt
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (len_trim(checkpoint_name) <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_validate_restart_inventory: checkpoint filename is empty')
+    return
+  end if
+
+  if (arex /= 1) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_validate_restart_inventory: -arexrst requires arex=1')
+    return
+  end if
+
+  call arex_rst_read_checkpoint(checkpoint_name, ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  call arex_rst_validate_checkpoint_restart_inventory(ckpt, ierr, message)
+  call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_rst_validate_restart_inventory
+
+subroutine arex_rst_validate_checkpoint_restart_inventory(ckpt, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: slot_id
+  integer :: io_ierr
+  logical :: exists
+  logical :: require_phmd_restarts
+  character(len=max_fn_len) :: mdcrd_name
+  character(len=max_fn_len) :: mdvel_name
+  character(len=max_fn_len) :: mdfrc_name
+  character(len=max_fn_len) :: restrt_name
+  character(len=max_fn_len) :: phmdout_name
+  character(len=max_fn_len) :: phmdrestrt_out_name
+  character(len=256) :: io_message
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (.not. ckpt%allocated .or. ckpt%nslots <= 0 .or. .not. allocated(ckpt%slot_ladder)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_validate_checkpoint_restart_inventory: checkpoint is incomplete')
+    return
+  end if
+
+  require_phmd_restarts = (iphmd > 0) .or. (trim(ckpt%payload_type) == 'phrex')
+
+  do slot_id = 1, ckpt%nslots
+    io_ierr = AREX_IO_OK
+    io_message = ''
+    call arex_rst_source_slot_paths(ckpt, slot_id, restrt_name, &
+                                    phmdrestrt_out_name, io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+    inquire(file=trim(restrt_name), exist=exists)
+    if (.not. exists) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_validate_checkpoint_restart_inventory: missing old-ladder slot restart file')
+      return
+    end if
+
+    if (require_phmd_restarts) then
+      inquire(file=trim(phmdrestrt_out_name), exist=exists)
+      if (.not. exists) then
+        call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+          'arex_rst_validate_checkpoint_restart_inventory: missing old-ladder slot PHMD restart file')
+        return
+      end if
+    end if
+  end do
+end subroutine arex_rst_validate_checkpoint_restart_inventory
+
+subroutine arex_rst_init_checkpoint_from_manager(mgr, warmup_segments_target, &
+                                                 warmup_segments_completed, ckpt, &
+                                                 ierr, message)
+  type(arm_manager_t), intent(in) :: mgr
+  integer, intent(in) :: warmup_segments_target
+  integer, intent(in) :: warmup_segments_completed
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: helper_ierr
+  integer :: rng_size
+  integer :: alloc_stat
+  character(len=256) :: helper_message
+  integer :: slot_id
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  call arex_rst_release_checkpoint(ckpt)
+
+  if (.not. mgr%initialized) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_init_checkpoint_from_manager: manager not initialized')
+    return
+  end if
+
+  if (mgr%nreplicas <= 0 .or. mgr%nslots <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_init_checkpoint_from_manager: invalid manager dimensions')
+    return
+  end if
+
+  allocate(ckpt%slot_ladder(mgr%nslots), ckpt%slot_owner(mgr%nslots),        &
+           ckpt%restart_files(mgr%nslots), ckpt%phmd_restart_files(mgr%nslots), &
+           ckpt%replicas(mgr%nreplicas), ckpt%slot_output(mgr%nslots))
+
+  ckpt%allocated             = .true.
+  ckpt%magic                 = AREX_RST_MAGIC
+  ckpt%format_version        = AREX_RST_FORMAT_VERSION
+  ckpt%payload_type          = trim(arex_pay_tolower(adjustl(arex_type)))
+  ckpt%natom                 = natom
+  ckpt%nreplicas             = mgr%nreplicas
+  ckpt%nslots                = mgr%nslots
+  ckpt%next_replica_uid      = mgr%next_replica_uid
+  ckpt%history_generation    = mgr%history_generation
+  ckpt%continuation_part = arex_continuation_part
+  ckpt%segments_per_replica    = mgr%segments_per_replica
+  ckpt%epoch                   = mgr%epoch
+  ckpt%current_parity          = mgr%current_parity
+  ckpt%segment_steps           = arex_segment_steps
+  ckpt%warmup_segments_target  = warmup_segments_target
+  ckpt%warmup_segments_completed = warmup_segments_completed
+
+  if (trim(ckpt%payload_type) == 'phrex') then
+    helper_ierr = ARM_OK
+    helper_message = ''
+    call arex_pay_phrex_export_slot_ladder(ckpt%slot_ladder, helper_ierr, helper_message)
+    if (helper_ierr /= ARM_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(helper_message))
+      return
+    end if
+  else
+    if (mgr%nslots > arex_rst_ladder_count()) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_init_checkpoint_from_manager: local ladder does not cover manager slot count')
+      return
+    end if
+    ckpt%slot_ladder(:) = arex_ladder(1:mgr%nslots)
+  end if
+
+  ckpt%slot_owner(:)  = mgr%slot_owner(:)
+
+  do i = 1, mgr%nreplicas
+    ckpt%replicas(i)%replica_id              = mgr%replicas(i)%replica_id
+    ckpt%replicas(i)%replica_uid             = mgr%replicas(i)%replica_uid
+    ckpt%replicas(i)%parent_uid              = mgr%replicas(i)%parent_uid
+    ckpt%replicas(i)%slot_id                 = mgr%replicas(i)%slot_id
+    ckpt%replicas(i)%segments_completed      = mgr%replicas(i)%segments_completed
+    ckpt%replicas(i)%completed_epoch         = mgr%replicas(i)%completed_epoch
+    ckpt%replicas(i)%exchange_resolved_epoch = mgr%replicas(i)%exchange_resolved_epoch
+  end do
+
+  do slot_id = 1, mgr%nslots
+    helper_ierr = AREX_RST_OK
+    helper_message = ''
+
+    call arex_rst_derive_slot_output_state(mgr, slot_id, ckpt%slot_output(slot_id), &
+                                           helper_ierr, helper_message)
+    if (helper_ierr /= AREX_RST_OK) then
+      call arex_rst_set_status(ierr, message, helper_ierr, trim(helper_message))
+      return
+    end if
+
+   !write(0,'(a,1x,i4,1x,l1,1x,l1,3(1x,i8),1x,i12,2(1x,f12.4))') &
+   !  'AREX DBG CKPT CAPTURE slot=', slot_id,                               &
+   !  ckpt%slot_output(slot_id)%binary_initialized,                         &
+   !  ckpt%slot_output(slot_id)%phmd_output_initialized,                    &
+   !  ckpt%slot_output(slot_id)%mdcrd_frame,                                &
+   !  ckpt%slot_output(slot_id)%mdvel_frame,                                &
+   !  ckpt%slot_output(slot_id)%mdfrc_frame,                                &
+   !  ckpt%slot_output(slot_id)%mdcrd_logical_steps,                        &
+   !  ckpt%slot_output(slot_id)%mdcrd_time_origin_ps,                       &
+   !  ckpt%slot_output(slot_id)%mdcrd_logical_time_ps
+   !call flush(0)
+  end do
+
+  ! The detached scheduler is the only owner of exchange acceptance RNG state.
+  ! Capture the intrinsic Fortran RNG state only when an AREX checkpoint is
+  ! actually being assembled; this adds no work to the MD or exchange hot path.
+  call random_seed(size=rng_size)
+  if (rng_size <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_init_checkpoint_from_manager: invalid scheduler RNG state size')
+    return
+  end if
+
+  allocate(ckpt%scheduler_rng(rng_size), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_init_checkpoint_from_manager: scheduler RNG allocation failed')
+    return
+  end if
+
+  ckpt%scheduler_rng_size = rng_size
+  call random_seed(get=ckpt%scheduler_rng)
+end subroutine arex_rst_init_checkpoint_from_manager
+
+subroutine arex_rst_payload_capture_checkpoint(ckpt, ierr, message)
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: helper_ierr
+  integer :: phrex_nreplicas_local
+  integer :: phrex_ntheta_local
+  integer :: alloc_failed
+  character(len=256) :: helper_message
+#ifdef CUDA
+  integer :: phrex_random_buffer_size_local
+#endif
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (trim(ckpt%payload_type) /= 'phrex') then
+    ckpt%have_payload_checkpoint = .false.
+    return
+  end if
+
+  helper_ierr = ARM_OK
+  helper_message = ''
+
+#ifdef CUDA
+  call arex_pay_phrex_get_checkpoint_shape(phrex_nreplicas_local, phrex_ntheta_local, &
+                                           phrex_random_buffer_size_local,            &
+                                           helper_ierr, helper_message)
+#else
+  call arex_pay_phrex_get_checkpoint_shape(phrex_nreplicas_local, phrex_ntheta_local, &
+                                           helper_ierr, helper_message)
+#endif
+  if (helper_ierr /= ARM_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(helper_message))
+    return
+  end if
+
+  if (phrex_nreplicas_local /= ckpt%nreplicas) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_payload_capture_checkpoint: PHREX replica count mismatch')
+    return
+  end if
+
+  if (allocated(ckpt%phrex_valid))        deallocate(ckpt%phrex_valid)
+  if (allocated(ckpt%phrex_iupdate))      deallocate(ckpt%phrex_iupdate)
+  if (allocated(ckpt%phrex_proton_count)) deallocate(ckpt%phrex_proton_count)
+  if (allocated(ckpt%phrex_theta))        deallocate(ckpt%phrex_theta)
+  if (allocated(ckpt%phrex_dtheta))       deallocate(ckpt%phrex_dtheta)
+  if (allocated(ckpt%phrex_vtheta))       deallocate(ckpt%phrex_vtheta)
+  if (allocated(ckpt%phrex_dphold))       deallocate(ckpt%phrex_dphold)
+  if (allocated(ckpt%phrex_vphold))       deallocate(ckpt%phrex_vphold)
+#ifdef CUDA
+  if (allocated(ckpt%phrex_random_counter)) deallocate(ckpt%phrex_random_counter)
+  if (allocated(ckpt%phrex_random))         deallocate(ckpt%phrex_random)
+#endif
+
+  ckpt%phrex_ntheta = phrex_ntheta_local
+
+  allocate(ckpt%phrex_valid(ckpt%nreplicas),                          &
+           ckpt%phrex_iupdate(ckpt%nreplicas),                        &
+           ckpt%phrex_proton_count(ckpt%nreplicas),                   &
+           ckpt%phrex_theta(ckpt%phrex_ntheta, ckpt%nreplicas),       &
+           ckpt%phrex_dtheta(ckpt%phrex_ntheta, ckpt%nreplicas),      &
+           ckpt%phrex_vtheta(ckpt%phrex_ntheta, ckpt%nreplicas),      &
+           ckpt%phrex_dphold(ckpt%phrex_ntheta, ckpt%nreplicas),      &
+           ckpt%phrex_vphold(ckpt%phrex_ntheta, ckpt%nreplicas),      &
+           stat=alloc_failed)
+  if (alloc_failed /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_payload_capture_checkpoint: allocation failure')
+    return
+  end if
+
+#ifdef CUDA
+  ckpt%phrex_random_buffer_size = phrex_random_buffer_size_local
+  if (ckpt%phrex_random_buffer_size > 0) then
+    allocate(ckpt%phrex_random_counter(ckpt%nreplicas),                           &
+             ckpt%phrex_random(ckpt%phrex_random_buffer_size, ckpt%nreplicas),    &
+             stat=alloc_failed)
+    if (alloc_failed /= 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+        'arex_rst_payload_capture_checkpoint: CUDA random-state allocation failure')
+      return
+    end if
+  end if
+
+  call arex_pay_phrex_export_checkpoint_state(ckpt%phrex_valid,        &
+                                              ckpt%phrex_theta,        &
+                                              ckpt%phrex_dtheta,       &
+                                              ckpt%phrex_vtheta,       &
+                                              ckpt%phrex_dphold,       &
+                                              ckpt%phrex_vphold,       &
+                                              ckpt%phrex_proton_count, &
+                                              ckpt%phrex_iupdate,      &
+                                              ckpt%phrex_random_counter, &
+                                              ckpt%phrex_random,       &
+                                              helper_ierr, helper_message)
+#else
+  call arex_pay_phrex_export_checkpoint_state(ckpt%phrex_valid,        &
+                                              ckpt%phrex_theta,        &
+                                              ckpt%phrex_dtheta,       &
+                                              ckpt%phrex_vtheta,       &
+                                              ckpt%phrex_dphold,       &
+                                              ckpt%phrex_vphold,       &
+                                              ckpt%phrex_proton_count, &
+                                              ckpt%phrex_iupdate,      &
+                                              helper_ierr, helper_message)
+#endif
+  if (helper_ierr /= ARM_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(helper_message))
+    return
+  end if
+
+  ckpt%have_payload_checkpoint = .true.
+end subroutine arex_rst_payload_capture_checkpoint
+
+
+! The source checkpoint's directory is independent of the current working
+! directory and of the destination scratch/output paths.
+function arex_rst_directory(path) result(directory)
+  character(len=*), intent(in) :: path
+  character(len=max_fn_len) :: directory
+  integer :: slash
+  slash = scan(trim(path), '/', back=.true.)
+  directory = '.'
+  if (slash == 1) directory = '/'
+  if (slash > 1) directory = path(:slash-1)
+end function arex_rst_directory
+
+function arex_rst_basename(path) result(base)
+  character(len=*), intent(in) :: path
+  character(len=max_fn_len) :: base
+  integer :: slash
+  slash = scan(trim(path), '/', back=.true.)
+  base = path(slash+1:)
+end function arex_rst_basename
+
+subroutine arex_rst_source_slot_paths(ckpt, slot_id, md_restart, phmd_restart, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer, intent(in) :: slot_id
+  character(len=*), intent(out) :: md_restart, phmd_restart
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  character(len=max_fn_len) :: mdcrd, mdvel, mdfrc, old_md, phmdout, old_phmd
+  character(len=max_fn_len) :: md_basename, phmd_basename
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  if (slot_id < 1 .or. slot_id > ckpt%nslots) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, 'invalid source slot')
+    return
+  end if
+  if (ckpt%format_version >= 9) then
+    md_basename = ckpt%restart_files(slot_id)
+    phmd_basename = ckpt%phmd_restart_files(slot_id)
+  else
+    ! Legacy v8 did not save restart paths: derive old ladder labels using
+    ! supplied output *basenames*, then anchor them to -arexrst's directory.
+    call arex_io_get_names_for_ladder_value(ckpt%slot_ladder(slot_id), &
+         mdcrd, mdvel, mdfrc, old_md, phmdout, old_phmd, ierr, message)
+    if (ierr /= AREX_RST_OK) return
+    md_basename = arex_rst_basename(old_md)
+    phmd_basename = arex_rst_basename(old_phmd)
+  end if
+  if (trim(md_basename) == '-' .or. len_trim(md_basename) == 0 .or. &
+      scan(trim(md_basename), '/') /= 0 .or. &
+      len_trim(ckpt%source_directory) + len_trim(md_basename) + 1 > len(md_restart)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, 'invalid checkpoint MD restart filename')
+    return
+  end if
+  md_restart = trim(ckpt%source_directory) // '/' // trim(md_basename)
+  phmd_restart = ''
+  if (trim(phmd_basename) /= '-') then
+    if (len_trim(phmd_basename) == 0 .or. scan(trim(phmd_basename), '/') /= 0 .or. &
+        len_trim(ckpt%source_directory) + len_trim(phmd_basename) + 1 > len(phmd_restart)) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, 'invalid checkpoint PHMD restart filename')
+      return
+    end if
+    phmd_restart = trim(ckpt%source_directory) // '/' // trim(phmd_basename)
+  end if
+end subroutine arex_rst_source_slot_paths
+
+! Copy binary NetCDF/formatted restart files as opaque bytes into same-filesystem
+! staging files. A generation is only published after every member was copied.
+subroutine arex_rst_copy_file(source, destination, ierr, message)
+  character(len=*), intent(in) :: source, destination
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer :: input_unit, output_unit, ios, n
+  integer(kind=8) :: size_bytes, offset
+  character(len=1) :: buffer(65536)
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  open(newunit=input_unit, file=trim(source), status='old', action='read', &
+       form='unformatted', access='stream', iostat=ios)
+  if (ios /= 0) goto 900
+  inquire(unit=input_unit, size=size_bytes, iostat=ios)
+  if (ios /= 0) goto 910
+  open(newunit=output_unit, file=trim(destination), status='replace', action='write', &
+       form='unformatted', access='stream', iostat=ios)
+  if (ios /= 0) goto 910
+  offset = 0_8
+  do while (offset < size_bytes)
+    n = int(min(65536_8, size_bytes - offset))
+    read(input_unit, iostat=ios) buffer(1:n)
+    if (ios /= 0) goto 920
+    write(output_unit, iostat=ios) buffer(1:n)
+    if (ios /= 0) goto 920
+    offset = offset + n
+  end do
+  close(output_unit, iostat=ios)
+  if (ios /= 0) goto 910
+  close(input_unit)
+  return
+920 close(output_unit, status='delete')
+910 close(input_unit)
+900 call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+       'AREX: failed copying restart/checkpoint snapshot: ' // trim(source))
+end subroutine arex_rst_copy_file
+
+subroutine arex_rst_atomic_rename(source, destination, ierr, message)
+  character(len=*), intent(in) :: source, destination
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer(c_int) :: rc
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  rc = arex_c_rename(trim(source)//c_null_char, trim(destination)//c_null_char)
+  if (rc /= 0) call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+                          'AREX: failed publishing checkpoint generation: ' // trim(destination))
+end subroutine arex_rst_atomic_rename
+
+! Returns -1 for no previous checkpoint (or for an old v8 checkpoint).
+integer function arex_rst_previous_generation(checkpoint_name)
+  character(len=*), intent(in) :: checkpoint_name
+  integer :: u, ios, version
+  character(len=256) :: discard
+  logical :: exists
+  arex_rst_previous_generation = -1
+  version = -1
+  inquire(file=trim(checkpoint_name), exist=exists)
+  if (.not. exists) return
+  open(newunit=u, file=trim(checkpoint_name), status='old', action='read', iostat=ios)
+  if (ios /= 0) return
+  read(u,'(a)',iostat=ios) discard
+  if (ios == 0) read(u,*,iostat=ios) version
+  if (ios == 0 .and. version == 9) then
+    read(u,'(a)',iostat=ios) discard
+    read(u,'(a)',iostat=ios) discard
+    read(u,'(a)',iostat=ios) discard
+    read(u,'(a)',iostat=ios) discard
+    read(u,'(a)',iostat=ios) discard
+    read(u,'(a)',iostat=ios) discard  ! continuation part
+    if (ios == 0) read(u,*,iostat=ios) arex_rst_previous_generation
+  end if
+  close(u)
+  if (ios /= 0) arex_rst_previous_generation = -1
+end function arex_rst_previous_generation
+
+subroutine arex_rst_prepare_snapshots(checkpoint_name, ckpt, ierr, message)
+  character(len=*), intent(in) :: checkpoint_name
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  character(len=max_fn_len) :: mdcrd, mdvel, mdfrc, restart, phmdout, phmdrst
+  character(len=max_fn_len) :: root_dir, dst
+  character(len=8) :: suffix
+  integer :: i, prev_gen
+  logical :: want_phmd
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  root_dir = arex_rst_directory(checkpoint_name)
+  if (len_trim(checkpoint_name) + 9 > max_fn_len) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'AREX: checkpoint path too long to stage generational snapshots')
+    return
+  end if
+  prev_gen = arex_rst_previous_generation(checkpoint_name)
+  ckpt%checkpoint_generation = mod(prev_gen+1,2)
+  write(suffix,'(".gen",i1)') ckpt%checkpoint_generation
+  want_phmd = (iphmd > 0 .or. trim(ckpt%payload_type) == 'phrex')
+  do i = 1, ckpt%nslots
+    call arex_io_get_slot_names(i, mdcrd, mdvel, mdfrc, restart, phmdout, phmdrst, ierr, message)
+    if (ierr /= AREX_RST_OK) return
+    if (len_trim(root_dir) + len_trim(arex_rst_basename(restart)) + 11 > max_fn_len .or. &
+        (want_phmd .and. len_trim(root_dir) + len_trim(arex_rst_basename(phmdrst)) + 11 > max_fn_len)) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+        'AREX: slot restart path too long for two-generation staging')
+      return
+    end if
+    ckpt%restart_files(i) = trim(arex_rst_basename(restart)) // trim(suffix)
+    if (want_phmd) then
+      ckpt%phmd_restart_files(i) = trim(arex_rst_basename(phmdrst)) // trim(suffix)
+    else
+      ckpt%phmd_restart_files(i) = '-'
+    end if
+    dst = trim(root_dir) // '/' // trim(ckpt%restart_files(i)) // '.tmp'
+    call arex_rst_copy_file(restart, dst, ierr, message)
+    if (ierr /= AREX_RST_OK) return
+    if (want_phmd) then
+      dst = trim(root_dir) // '/' // trim(ckpt%phmd_restart_files(i)) // '.tmp'
+      call arex_rst_copy_file(phmdrst, dst, ierr, message)
+      if (ierr /= AREX_RST_OK) return
+    end if
+  end do
+  ! Existing selected generation is always older than the root checkpoint;
+  ! the other generation remains intact if promotion is interrupted.
+  do i = 1, ckpt%nslots
+    dst = trim(root_dir) // '/' // trim(ckpt%restart_files(i))
+    call arex_rst_atomic_rename(trim(dst)//'.tmp', dst, ierr, message)
+    if (ierr /= AREX_RST_OK) return
+    if (want_phmd) then
+      dst = trim(root_dir) // '/' // trim(ckpt%phmd_restart_files(i))
+      call arex_rst_atomic_rename(trim(dst)//'.tmp', dst, ierr, message)
+      if (ierr /= AREX_RST_OK) return
+    end if
+  end do
+end subroutine arex_rst_prepare_snapshots
+
+! Capture a consistent scheduler checkpoint in memory before starting the
+! next epoch. Disk publication can then overlap with the next MD segment.
+subroutine arex_rst_capture_checkpoint(mgr, warmup_segments_target, &
+                                       warmup_segments_completed, ckpt, ierr, message)
+  type(arm_manager_t), intent(in) :: mgr
+  integer, intent(in) :: warmup_segments_target, warmup_segments_completed
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arex_rst_init_checkpoint_from_manager(mgr, warmup_segments_target, &
+                                             warmup_segments_completed, ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+  call arex_rst_payload_capture_checkpoint(ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_rst_capture_checkpoint
+
+subroutine arex_rst_write_checkpoint(checkpoint_name, ckpt, ierr, message, checkpoint_number)
+  character(len=*), intent(in) :: checkpoint_name
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer, intent(in), optional :: checkpoint_number
+
+  integer :: unitno
+  integer :: i
+  integer :: valid_i
+  integer :: n
+  logical :: exists, want_phmd
+  character(len=max_fn_len) :: mdcrd, mdvel, mdfrc, restrt, phmdout, phmdrst
+  character(len=max_fn_len) :: output_checkpoint, restart_path
+  character(len=16) :: suffix
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (len_trim(checkpoint_name) <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_write_checkpoint: checkpoint filename is empty')
+    return
+  end if
+
+  n = 0
+  if (present(checkpoint_number)) n = checkpoint_number
+  if (n < 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'AREX: negative checkpoint number')
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+  suffix = ''
+  if (n > 0) write(suffix, '(".",i0)') n
+  if (len_trim(checkpoint_name) + len_trim(suffix) > max_fn_len) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'AREX: numbered checkpoint path exceeds filename limit')
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+  output_checkpoint = trim(checkpoint_name) // trim(suffix)
+
+  ! Workers have already written and closed this epoch's slot restarts.
+  ! Only list their filenames; do not copy the same data on the scheduler.
+  ckpt%checkpoint_generation = 0  ! Keep the existing v9 metadata layout.
+  want_phmd = (iphmd > 0 .or. trim(ckpt%payload_type) == 'phrex')
+  do i = 1, ckpt%nslots
+    call arex_io_get_slot_names(i, mdcrd, mdvel, mdfrc, restrt, phmdout, phmdrst, ierr, message)
+    if (ierr /= AREX_RST_OK) exit
+    ckpt%restart_files(i) = trim(arex_rst_basename(restrt)) // trim(suffix)
+    restart_path = trim(restrt) // trim(suffix)
+    inquire(file=trim(restart_path), exist=exists)
+    if (.not. exists) exit
+    if (want_phmd) then
+      ckpt%phmd_restart_files(i) = trim(arex_rst_basename(phmdrst)) // trim(suffix)
+      restart_path = trim(phmdrst) // trim(suffix)
+      inquire(file=trim(restart_path), exist=exists)
+      if (.not. exists) exit
+    else
+      ckpt%phmd_restart_files(i) = '-'
+    end if
+  end do
+  if (ierr /= AREX_RST_OK .or. i <= ckpt%nslots) then
+    if (ierr == AREX_RST_OK) call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+      'AREX: missing completed slot restart for checkpoint')
+    call arex_rst_release_checkpoint(ckpt)
+    return
+  end if
+
+  ! Write checkpoint metadata last; an interrupted write leaves the previous
+  ! numbered checkpoint set available for manual continuation.
+  open(newunit=unitno, file=trim(output_checkpoint), status='REPLACE', action='WRITE', &
+       form='FORMATTED', iostat=i)
+  if (i /= 0) then
+    call arex_rst_release_checkpoint(ckpt)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+      'arex_rst_write_checkpoint: failed to open checkpoint file for write')
+    return
+  end if
+
+  write(unitno, '(a)') trim(ckpt%magic)
+  write(unitno, '(i0)') ckpt%format_version
+  write(unitno, '(a)') trim(ckpt%payload_type)
+  write(unitno, '(7(1x,i0))') ckpt%natom, ckpt%nreplicas, ckpt%nslots, &
+                               ckpt%segments_per_replica, ckpt%epoch, &
+                               ckpt%current_parity, ckpt%segment_steps
+  write(unitno, '(2(1x,i0))') ckpt%warmup_segments_target, &
+                              ckpt%warmup_segments_completed
+  write(unitno, '(i0)') ckpt%next_replica_uid
+  write(unitno, '(i0)') ckpt%history_generation
+  write(unitno, '(i0)') ckpt%continuation_part
+  write(unitno, '(i0)') ckpt%checkpoint_generation
+  write(unitno, '(i0)') ckpt%scheduler_rng_size
+  write(unitno, '(*(1x,i0))') ckpt%scheduler_rng(:)
+  write(unitno, '(*(1x,es24.16))') ckpt%slot_ladder(:)
+  write(unitno, '(*(1x,i0))') ckpt%slot_owner(:)
+
+  do i = 1, ckpt%nreplicas
+    write(unitno, '(7(1x,i0))') ckpt%replicas(i)%replica_id, &
+                                ckpt%replicas(i)%replica_uid, &
+                                ckpt%replicas(i)%parent_uid, &
+                                ckpt%replicas(i)%slot_id, &
+                                ckpt%replicas(i)%segments_completed, &
+                                ckpt%replicas(i)%completed_epoch, &
+                                ckpt%replicas(i)%exchange_resolved_epoch
+  end do
+
+  do i = 1, ckpt%nslots
+    write(unitno, '(10(1x,i0))') ckpt%slot_output(i)%slot_id,                     &
+                                ckpt%slot_output(i)%restart_replica_id,            &
+                                ckpt%slot_output(i)%restart_replica_segments,      &
+                                merge(1, 0, ckpt%slot_output(i)%binary_initialized), &
+                                merge(1, 0, ckpt%slot_output(i)%phmd_output_initialized), &
+                                ckpt%slot_output(i)%mdcrd_frame,                  &
+                                ckpt%slot_output(i)%mdvel_frame,                  &
+                                ckpt%slot_output(i)%mdfrc_frame,                  &
+                                ckpt%slot_output(i)%mdcrd_logical_steps, &
+                                ckpt%slot_output(i)%part_start_step
+    write(unitno, '(3(1x,es24.16))') ckpt%slot_output(i)%restart_time_ps,       &
+                                     ckpt%slot_output(i)%mdcrd_time_origin_ps,    &
+                                     ckpt%slot_output(i)%mdcrd_logical_time_ps
+  end do
+
+  do i = 1, ckpt%nslots
+    write(unitno, '(a)') trim(ckpt%restart_files(i))
+    write(unitno, '(a)') trim(ckpt%phmd_restart_files(i))
+  end do
+
+  if (ckpt%have_payload_checkpoint) then
+    valid_i = 1
+  else
+    valid_i = 0
+  end if
+  write(unitno, '(i0)') valid_i
+
+  if (trim(ckpt%payload_type) == 'phrex' .and. ckpt%have_payload_checkpoint) then
+    write(unitno, '(i0)') ckpt%phrex_ntheta
+
+    do i = 1, ckpt%nreplicas
+      if (ckpt%phrex_valid(i)) then
+        valid_i = 1
+      else
+        valid_i = 0
+      end if
+      write(unitno, '(i0)') valid_i
+    end do
+
+    write(unitno, '(*(1x,i0))') ckpt%phrex_iupdate(:)
+    write(unitno, '(*(1x,es24.16))') ckpt%phrex_proton_count(:)
+
+    do i = 1, ckpt%nreplicas
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_theta(:, i)
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_dtheta(:, i)
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_vtheta(:, i)
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_dphold(:, i)
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_vphold(:, i)
+    end do
+#ifdef CUDA
+    write(unitno, '(i0)') ckpt%phrex_random_buffer_size
+    write(unitno, '(*(1x,i0))') ckpt%phrex_random_counter(:)
+    do i = 1, ckpt%nreplicas
+      write(unitno, '(*(1x,es24.16))') ckpt%phrex_random(:, i)
+    end do
+#endif
+  end if
+
+  close(unitno, iostat=i)
+  if (i /= 0) call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+    'AREX: checkpoint close failed')
+  call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_rst_write_checkpoint
+
+! Remove only the previous numbered checkpoint set, after publishing its
+! successor. These files are never used during an active MD segment.
+subroutine arex_rst_remove_numbered_set(checkpoint_name, checkpoint_number)
+  character(len=*), intent(in) :: checkpoint_name
+  integer, intent(in) :: checkpoint_number
+  integer :: slot_id, io_ierr, u, ios
+  character(len=256) :: io_message
+  character(len=max_fn_len) :: mdcrd, mdvel, mdfrc, restrt, phmdout, phmdrst
+  character(len=max_fn_len) :: filename
+  character(len=16) :: suffix
+  logical :: exists
+
+  if (checkpoint_number <= 0) return
+  write(suffix, '(".",i0)') checkpoint_number
+  do slot_id = 1, arex_rst_ladder_count()
+    call arex_io_get_slot_names(slot_id, mdcrd, mdvel, mdfrc, restrt, &
+         phmdout, phmdrst, io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) return
+    filename = trim(restrt) // trim(suffix)
+    inquire(file=trim(filename), exist=exists)
+    if (exists) then
+      open(newunit=u, file=trim(filename), status='old', iostat=ios)
+      if (ios == 0) close(u, status='delete', iostat=ios)
+    end if
+    if (iphmd > 0 .or. trim(arex_pay_tolower(adjustl(arex_type))) == 'phrex') then
+      filename = trim(phmdrst) // trim(suffix)
+      inquire(file=trim(filename), exist=exists)
+      if (exists) then
+        open(newunit=u, file=trim(filename), status='old', iostat=ios)
+        if (ios == 0) close(u, status='delete', iostat=ios)
+      end if
+    end if
+  end do
+  filename = trim(checkpoint_name) // trim(suffix)
+  inquire(file=trim(filename), exist=exists)
+  if (exists) then
+    open(newunit=u, file=trim(filename), status='old', iostat=ios)
+    if (ios == 0) close(u, status='delete', iostat=ios)
+  end if
+end subroutine arex_rst_remove_numbered_set
+
+subroutine arex_rst_read_checkpoint(checkpoint_name, ckpt, ierr, message)
+  character(len=*), intent(in) :: checkpoint_name
+  type(arex_rst_checkpoint_t), intent(inout) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: unitno
+  integer :: ios
+  integer :: i
+  integer :: have_payload_i
+  integer :: valid_i
+  integer :: alloc_stat
+  character(len=32) :: magic_buf
+  character(len=32) :: payload_buf
+  integer :: binary_initialized_i
+  integer :: phmd_output_initialized_i
+  character(len=512) :: slot_line
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  call arex_rst_release_checkpoint(ckpt)
+
+  if (len_trim(checkpoint_name) <= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_read_checkpoint: checkpoint filename is empty')
+    return
+  end if
+
+  open(newunit=unitno, file=trim(checkpoint_name), status='OLD', action='READ', &
+       form='FORMATTED', iostat=ios)
+  if (ios /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+      'arex_rst_read_checkpoint: failed to open checkpoint file')
+    return
+  end if
+
+  read(unitno, '(a)', iostat=ios) magic_buf
+  if (ios /= 0) goto 900
+  if (trim(magic_buf) /= AREX_RST_MAGIC) then
+    close(unitno)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_read_checkpoint: invalid AREX checkpoint magic')
+    return
+  end if
+
+  read(unitno, *, iostat=ios) ckpt%format_version
+  if (ios /= 0) goto 900
+  if (ckpt%format_version /= 8 .and. ckpt%format_version /= AREX_RST_FORMAT_VERSION) then
+    close(unitno)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_read_checkpoint: unsupported AREX checkpoint format version')
+    return
+  end if
+
+  read(unitno, '(a)', iostat=ios) payload_buf
+  if (ios /= 0) goto 900
+
+  read(unitno, *, iostat=ios) ckpt%natom, ckpt%nreplicas, ckpt%nslots, &
+                               ckpt%segments_per_replica, ckpt%epoch, &
+                               ckpt%current_parity, ckpt%segment_steps
+  if (ios /= 0) goto 900
+
+  read(unitno, *, iostat=ios) ckpt%warmup_segments_target, &
+                               ckpt%warmup_segments_completed
+  if (ios /= 0) goto 900
+
+  read(unitno, *, iostat=ios) ckpt%next_replica_uid
+  if (ios /= 0) goto 900
+
+  read(unitno, *, iostat=ios) ckpt%history_generation
+  if (ios /= 0) goto 900
+  if (ckpt%format_version >= 9) then
+    read(unitno, *, iostat=ios) ckpt%continuation_part
+    if (ios /= 0) goto 900
+    read(unitno, *, iostat=ios) ckpt%checkpoint_generation
+    if (ios /= 0) goto 900
+    if (ckpt%continuation_part < 0 .or. ckpt%continuation_part > 9999 .or. &
+        ckpt%checkpoint_generation < 0 .or. ckpt%checkpoint_generation > 1) goto 900
+  end if
+  ckpt%source_directory = arex_rst_directory(checkpoint_name)
+
+  read(unitno, *, iostat=ios) ckpt%scheduler_rng_size
+  if (ios /= 0) goto 900
+  if (ckpt%scheduler_rng_size <= 0) then
+    close(unitno)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_read_checkpoint: invalid scheduler RNG state size')
+    return
+  end if
+
+  allocate(ckpt%scheduler_rng(ckpt%scheduler_rng_size), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    close(unitno)
+    call arex_rst_release_checkpoint(ckpt)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_read_checkpoint: scheduler RNG allocation failed')
+    return
+  end if
+  read(unitno, *, iostat=ios) ckpt%scheduler_rng(:)
+  if (ios /= 0) goto 900
+
+  if (ckpt%nreplicas <= 0 .or. ckpt%nslots <= 0) then
+    close(unitno)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_read_checkpoint: invalid checkpoint dimensions')
+    return
+  end if
+
+  allocate(ckpt%slot_ladder(ckpt%nslots), ckpt%slot_owner(ckpt%nslots),         &
+           ckpt%replicas(ckpt%nreplicas), ckpt%slot_output(ckpt%nslots), &
+           ckpt%restart_files(ckpt%nslots), ckpt%phmd_restart_files(ckpt%nslots))
+
+  read(unitno, *, iostat=ios) ckpt%slot_ladder(:)
+  if (ios /= 0) goto 900
+  read(unitno, *, iostat=ios) ckpt%slot_owner(:)
+  if (ios /= 0) goto 900
+
+  do i = 1, ckpt%nreplicas
+    read(unitno, *, iostat=ios) ckpt%replicas(i)%replica_id, &
+                                ckpt%replicas(i)%replica_uid, &
+                                ckpt%replicas(i)%parent_uid, &
+                                ckpt%replicas(i)%slot_id, &
+                                ckpt%replicas(i)%segments_completed, &
+                                ckpt%replicas(i)%completed_epoch, &
+                                ckpt%replicas(i)%exchange_resolved_epoch
+    if (ios /= 0) goto 900
+  end do
+
+  do i = 1, ckpt%nslots
+    read(unitno, '(a)', iostat=ios) slot_line
+    if (ios /= 0) goto 900
+    if (ckpt%format_version >= 9) then
+      read(slot_line, *, iostat=ios) ckpt%slot_output(i)%slot_id, &
+           ckpt%slot_output(i)%restart_replica_id, &
+           ckpt%slot_output(i)%restart_replica_segments, &
+           binary_initialized_i, phmd_output_initialized_i, &
+           ckpt%slot_output(i)%mdcrd_frame, ckpt%slot_output(i)%mdvel_frame, &
+           ckpt%slot_output(i)%mdfrc_frame, ckpt%slot_output(i)%mdcrd_logical_steps, &
+           ckpt%slot_output(i)%part_start_step
+    else
+      read(slot_line, *, iostat=ios) ckpt%slot_output(i)%slot_id, &
+           ckpt%slot_output(i)%restart_replica_id, &
+           ckpt%slot_output(i)%restart_replica_segments, &
+           binary_initialized_i, phmd_output_initialized_i, &
+           ckpt%slot_output(i)%mdcrd_frame, ckpt%slot_output(i)%mdvel_frame, &
+           ckpt%slot_output(i)%mdfrc_frame, ckpt%slot_output(i)%mdcrd_logical_steps
+    end if
+    if (ios /= 0) goto 900
+    read(unitno, *, iostat=ios) ckpt%slot_output(i)%restart_time_ps, &
+                                ckpt%slot_output(i)%mdcrd_time_origin_ps, &
+                                ckpt%slot_output(i)%mdcrd_logical_time_ps
+    if (ios /= 0) goto 900
+
+    ckpt%slot_output(i)%binary_initialized      = (binary_initialized_i /= 0)
+    ckpt%slot_output(i)%phmd_output_initialized = (phmd_output_initialized_i /= 0)
+
+   !write(0,'(a,1x,i4,1x,l1,1x,l1,3(1x,i8),1x,i12,2(1x,f12.4))') &
+   !  'AREX DBG CKPT READ slot=', i,                                &
+   !  ckpt%slot_output(i)%binary_initialized,                       &
+   !  ckpt%slot_output(i)%phmd_output_initialized,                  &
+   !  ckpt%slot_output(i)%mdcrd_frame,                              &
+   !  ckpt%slot_output(i)%mdvel_frame,                              &
+   !  ckpt%slot_output(i)%mdfrc_frame,                              &
+   !  ckpt%slot_output(i)%mdcrd_logical_steps,                      &
+   !  ckpt%slot_output(i)%mdcrd_time_origin_ps,                     &
+   !  ckpt%slot_output(i)%mdcrd_logical_time_ps
+   !call flush(0)
+  end do
+
+  if (ckpt%format_version >= 9) then
+    do i = 1, ckpt%nslots
+      read(unitno, '(a)', iostat=ios) ckpt%restart_files(i)
+      if (ios /= 0) goto 900
+      read(unitno, '(a)', iostat=ios) ckpt%phmd_restart_files(i)
+      if (ios /= 0) goto 900
+      if (len_trim(ckpt%restart_files(i)) == 0 .or. &
+          trim(ckpt%restart_files(i)) == '.' .or. &
+          trim(ckpt%restart_files(i)) == '..' .or. &
+          scan(trim(ckpt%restart_files(i)), '/\') /= 0 .or. &
+          scan(trim(ckpt%phmd_restart_files(i)), '/\') /= 0) goto 900
+    end do
+  else
+    ckpt%restart_files(:) = ''
+    ckpt%phmd_restart_files(:) = ''
+  end if
+
+  read(unitno, *, iostat=ios) have_payload_i
+  if (ios /= 0) goto 900
+
+  ckpt%allocated               = .true.
+  ckpt%magic                   = AREX_RST_MAGIC
+  ckpt%payload_type            = trim(arex_pay_tolower(adjustl(payload_buf)))
+  ckpt%have_payload_checkpoint = (have_payload_i /= 0)
+
+  if (trim(ckpt%payload_type) == 'phrex' .and. ckpt%have_payload_checkpoint) then
+    read(unitno, *, iostat=ios) ckpt%phrex_ntheta
+    if (ios /= 0) goto 900
+
+    if (ckpt%phrex_ntheta <= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_read_checkpoint: invalid PHREX payload block')
+      return
+    end if
+
+    allocate(ckpt%phrex_valid(ckpt%nreplicas), ckpt%phrex_iupdate(ckpt%nreplicas), &
+             ckpt%phrex_proton_count(ckpt%nreplicas), &
+             ckpt%phrex_theta(ckpt%phrex_ntheta, ckpt%nreplicas), &
+             ckpt%phrex_dtheta(ckpt%phrex_ntheta, ckpt%nreplicas), &
+             ckpt%phrex_vtheta(ckpt%phrex_ntheta, ckpt%nreplicas), &
+             ckpt%phrex_dphold(ckpt%phrex_ntheta, ckpt%nreplicas), &
+             ckpt%phrex_vphold(ckpt%phrex_ntheta, ckpt%nreplicas))
+
+    do i = 1, ckpt%nreplicas
+      read(unitno, *, iostat=ios) valid_i
+      if (ios /= 0) goto 900
+      ckpt%phrex_valid(i) = (valid_i /= 0)
+    end do
+
+    read(unitno, *, iostat=ios) ckpt%phrex_iupdate(:)
+    if (ios /= 0) goto 900
+    read(unitno, *, iostat=ios) ckpt%phrex_proton_count(:)
+    if (ios /= 0) goto 900
+
+    do i = 1, ckpt%nreplicas
+      read(unitno, *, iostat=ios) ckpt%phrex_theta(:, i)
+      if (ios /= 0) goto 900
+      read(unitno, *, iostat=ios) ckpt%phrex_dtheta(:, i)
+      if (ios /= 0) goto 900
+      read(unitno, *, iostat=ios) ckpt%phrex_vtheta(:, i)
+      if (ios /= 0) goto 900
+      read(unitno, *, iostat=ios) ckpt%phrex_dphold(:, i)
+      if (ios /= 0) goto 900
+      read(unitno, *, iostat=ios) ckpt%phrex_vphold(:, i)
+      if (ios /= 0) goto 900
+    end do
+#ifdef CUDA
+    read(unitno, *, iostat=ios) ckpt%phrex_random_buffer_size
+    if (ios /= 0) goto 900
+    if (ckpt%phrex_random_buffer_size > 0) then
+      allocate(ckpt%phrex_random_counter(ckpt%nreplicas), &
+               ckpt%phrex_random(ckpt%phrex_random_buffer_size, ckpt%nreplicas))
+      read(unitno, *, iostat=ios) ckpt%phrex_random_counter(:)
+      if (ios /= 0) goto 900
+      do i = 1, ckpt%nreplicas
+        read(unitno, *, iostat=ios) ckpt%phrex_random(:, i)
+        if (ios /= 0) goto 900
+      end do
+    end if
+#endif
+  end if
+
+  close(unitno)
+  return
+
+900 continue
+  close(unitno)
+  call arex_rst_release_checkpoint(ckpt)
+  call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+    'arex_rst_read_checkpoint: failed while parsing checkpoint file')
+end subroutine arex_rst_read_checkpoint
+
+subroutine arex_rst_get_checkpoint_warmup_state(checkpoint_name, &
+                                                warmup_segments_target, &
+                                                warmup_segments_completed, &
+                                                ierr, message)
+  character(len=*), intent(in) :: checkpoint_name
+  integer, intent(out) :: warmup_segments_target
+  integer, intent(out) :: warmup_segments_completed
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_rst_checkpoint_t) :: ckpt
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  warmup_segments_target = 0
+  warmup_segments_completed = 0
+
+  call arex_rst_read_checkpoint(checkpoint_name, ckpt, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  warmup_segments_target = ckpt%warmup_segments_target
+  warmup_segments_completed = ckpt%warmup_segments_completed
+
+  call arex_rst_release_checkpoint(ckpt)
+end subroutine arex_rst_get_checkpoint_warmup_state
+
+logical function arex_rst_checkpoint_ladder_matches_current(ckpt)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer :: ladder_count
+
+  arex_rst_checkpoint_ladder_matches_current = .false.
+  if (.not. ckpt%allocated) return
+
+  ladder_count = arex_rst_ladder_count()
+  if (ladder_count /= ckpt%nslots) return
+  if (ladder_count <= 0) return
+
+  arex_rst_checkpoint_ladder_matches_current = &
+    all(abs(ckpt%slot_ladder(:) - arex_ladder(1:ladder_count)) <= 1.0e-12_dp)
+end function arex_rst_checkpoint_ladder_matches_current
+
+subroutine arex_rst_validate_checkpoint_compatibility(ckpt, mgr, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  type(arm_manager_t), intent(in) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: ladder_count
+  integer :: i, j
+  integer :: max_replica_uid
+  integer :: current_rng_size
+  integer :: restart_replica_id
+  integer :: owner
+  character(len=32) :: payload_type
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_validate_checkpoint_compatibility: manager not initialized')
+    return
+  end if
+
+  payload_type = trim(arex_pay_tolower(adjustl(arex_type)))
+  ladder_count = arex_rst_ladder_count()
+
+  if (.not. ckpt%allocated) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_validate_checkpoint_compatibility: checkpoint not loaded')
+    return
+  end if
+
+  if (ckpt%natom /= natom) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: natom mismatch')
+    return
+  end if
+
+  if (ckpt%nreplicas <= 0 .or. ckpt%nreplicas /= ckpt%nslots) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: invalid checkpoint replica/slot dimensions')
+    return
+  end if
+
+  if (ladder_count <= 0 .or. mgr%nreplicas /= ladder_count .or. mgr%nslots /= ladder_count) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: current manager/ladder dimensions are inconsistent')
+    return
+  end if
+
+  do i = 1, ckpt%nslots
+    owner = ckpt%slot_owner(i)
+    if (owner < 1 .or. owner > ckpt%nreplicas) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid checkpoint slot owner')
+      return
+    end if
+    do j = i + 1, ckpt%nslots
+      if (owner == ckpt%slot_owner(j)) then
+        call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+          'arex_rst_validate_checkpoint_compatibility: checkpoint slot_owner is not a permutation')
+        return
+      end if
+    end do
+
+    if (ckpt%slot_output(i)%slot_id /= i) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid slot output index')
+      return
+    end if
+
+    restart_replica_id = ckpt%slot_output(i)%restart_replica_id
+    if (restart_replica_id < 1 .or. restart_replica_id > ckpt%nreplicas) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid slot restart owner')
+      return
+    end if
+
+    if (ckpt%slot_output(i)%restart_replica_segments /= &
+        ckpt%replicas(restart_replica_id)%segments_completed) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: slot restart walker state is stale')
+      return
+    end if
+
+    if (ckpt%slot_output(i)%mdcrd_logical_steps < 0 .or. &
+        ckpt%slot_output(i)%part_start_step < 0 .or. &
+        ckpt%slot_output(i)%part_start_step > ckpt%slot_output(i)%mdcrd_logical_steps) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid slot restart/part progress')
+      return
+    end if
+    if (abs(ckpt%slot_output(i)%restart_time_ps - &
+        (ckpt%slot_output(i)%mdcrd_time_origin_ps + &
+         dble(ckpt%slot_output(i)%mdcrd_logical_steps)*dt)) > max(1.0e-2_dp, 2.0_dp*dt)) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'AREX checkpoint timestamp disagrees with logical step/time origin; repair source checkpoint first')
+      return
+    end if
+
+    do j = i + 1, ckpt%nslots
+      if (restart_replica_id == ckpt%slot_output(j)%restart_replica_id) then
+        call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+          'arex_rst_validate_checkpoint_compatibility: slot restart set does not cover each replica once')
+        return
+      end if
+    end do
+  end do
+
+  max_replica_uid = 0
+  do i = 1, ckpt%nreplicas
+    if (ckpt%replicas(i)%replica_id /= i) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: replica_id is not a dense runtime index')
+      return
+    end if
+
+    if (ckpt%replicas(i)%slot_id < 1 .or. ckpt%replicas(i)%slot_id > ckpt%nslots .or. &
+        ckpt%slot_owner(ckpt%replicas(i)%slot_id) /= i) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: replica/slot inverse mapping mismatch')
+      return
+    end if
+
+    if (ckpt%replicas(i)%replica_uid <= 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid replica_uid')
+      return
+    end if
+
+    if (ckpt%replicas(i)%parent_uid < 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_validate_checkpoint_compatibility: invalid parent_uid')
+      return
+    end if
+
+    max_replica_uid = max(max_replica_uid, ckpt%replicas(i)%replica_uid)
+
+    do j = i + 1, ckpt%nreplicas
+      if (ckpt%replicas(i)%replica_uid == ckpt%replicas(j)%replica_uid) then
+        call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+          'arex_rst_validate_checkpoint_compatibility: duplicate active replica_uid')
+        return
+      end if
+    end do
+  end do
+
+  if (ckpt%next_replica_uid <= max_replica_uid) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: invalid next_replica_uid')
+    return
+  end if
+
+  if (ckpt%history_generation < 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: invalid history generation')
+    return
+  end if
+
+  call random_seed(size=current_rng_size)
+  if (.not. allocated(ckpt%scheduler_rng)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: scheduler RNG state is missing')
+    return
+  end if
+  if (ckpt%scheduler_rng_size /= current_rng_size .or. &
+      size(ckpt%scheduler_rng) /= current_rng_size) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: scheduler RNG state size mismatch')
+    return
+  end if
+
+  if (trim(payload_type) /= trim(ckpt%payload_type)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: payload type mismatch')
+    return
+  end if
+
+  if (ckpt%segment_steps /= arex_segment_steps) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_validate_checkpoint_compatibility: arex_segment_steps mismatch')
+    return
+  end if
+end subroutine arex_rst_validate_checkpoint_compatibility
+
+subroutine arex_rst_apply_logical_state(ckpt, mgr, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: io_ierr
+  character(len=256) :: io_message
+
+  call arex_rst_validate_checkpoint_compatibility(ckpt, mgr, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  if (.not. arex_rst_checkpoint_ladder_matches_current(ckpt)) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+      'arex_rst_apply_logical_state: exact restore requires an unchanged ladder')
+    return
+  end if
+
+  mgr%epoch                = ckpt%epoch
+  mgr%current_parity       = ckpt%current_parity
+  mgr%next_replica_uid     = ckpt%next_replica_uid
+  mgr%history_generation   = ckpt%history_generation
+  mgr%slot_owner(:)        = ckpt%slot_owner(:)
+  mgr%exchange_history_last_epoch = ckpt%epoch
+
+  do i = 1, mgr%nslots
+    mgr%slot_segments_completed(i) = &
+      ckpt%slot_output(i)%mdcrd_logical_steps / ckpt%segment_steps
+    mgr%slot_restart_owner(i) = ckpt%slot_output(i)%restart_replica_id
+    mgr%slot_restart_replica_segments(i) = &
+      ckpt%slot_output(i)%restart_replica_segments
+  end do
+
+  do i = 1, mgr%nreplicas
+    mgr%replicas(i)%replica_id              = ckpt%replicas(i)%replica_id
+    mgr%replicas(i)%replica_uid             = ckpt%replicas(i)%replica_uid
+    mgr%replicas(i)%parent_uid              = ckpt%replicas(i)%parent_uid
+    mgr%replicas(i)%slot_id                 = ckpt%replicas(i)%slot_id
+    mgr%replicas(i)%segments_completed      = ckpt%replicas(i)%segments_completed
+    mgr%replicas(i)%completed_epoch         = ckpt%replicas(i)%completed_epoch
+    mgr%replicas(i)%exchange_resolved_epoch = ckpt%replicas(i)%exchange_resolved_epoch
+    mgr%replicas(i)%status                  = 0
+    mgr%replicas(i)%assigned_worker_id      = 0
+  end do
+
+  do i = 1, mgr%nworkers
+    mgr%workers(i)%status             = 0
+    mgr%workers(i)%active_replica_id  = 0
+    mgr%workers(i)%active_slot_id     = 0
+  end do
+
+  ! A restored AREX checkpoint requires valid slot restart files before this
+  ! point.  Mark each slot restart as initialized so the next write updates the
+  ! restored file instead of trying to create it again.
+  do i = 1, mgr%nslots
+    io_ierr = AREX_IO_OK
+    io_message = ''
+    call arex_io_set_slot_restart_initialized(i, &
+         (.not. arexrst_specified .or. arex_append), io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+  end do
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+end subroutine arex_rst_apply_logical_state
+
+subroutine arex_rst_detect_common_restart_format(filename, restart_format, ierr, message)
+  character(len=*), intent(in) :: filename
+  integer, intent(out) :: restart_format
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: unitno
+  integer :: ios
+  integer :: natom_probe
+  integer :: zero_natom
+  integer :: inpcrd_version
+  logical :: exists
+  character(len=8)  :: magic8
+  character(len=80) :: title_buf
+  character(len=80) :: header_buf
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  restart_format = AREX_RST_RESTART_FORMAT_UNKNOWN
+  unitno = -1
+  ios = 0
+  natom_probe = 0
+  zero_natom = 0
+  inpcrd_version = 0
+  exists = .false.
+  magic8 = ''
+  title_buf = ''
+  header_buf = ''
+
+  inquire(file=trim(filename), exist=exists)
+  if (.not. exists) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+      'arex_rst_detect_common_restart_format: restart file does not exist')
+    return
+  end if
+
+  open(newunit=unitno, file=trim(filename), status='OLD', access='STREAM', &
+       form='UNFORMATTED', action='READ', iostat=ios)
+  if (ios == 0) then
+    read(unitno, pos=1, iostat=ios) magic8
+    close(unitno)
+
+    if (ios == 0) then
+      if (magic8(1:3) == 'CDF') then
+        restart_format = AREX_RST_RESTART_FORMAT_NETCDF
+        return
+      end if
+
+      if (iachar(magic8(1:1)) == 137 .and. magic8(2:4) == 'HDF' .and. &
+          iachar(magic8(5:5)) == 13 .and. iachar(magic8(6:6)) == 10 .and. &
+          iachar(magic8(7:7)) == 26 .and. iachar(magic8(8:8)) == 10) then
+        restart_format = AREX_RST_RESTART_FORMAT_NETCDF
+        return
+      end if
+    end if
+  end if
+
+  open(newunit=unitno, file=trim(filename), status='OLD', form='FORMATTED', &
+       action='READ', iostat=ios)
+  if (ios == 0) then
+    read(unitno, '(a80)', iostat=ios) title_buf
+    if (ios == 0) then
+      read(unitno, '(a80)', iostat=ios) header_buf
+      if (ios == 0) then
+        natom_probe = 0
+        read(header_buf, *, iostat=ios) natom_probe
+        if (ios == 0 .and. natom_probe > 0) then
+          close(unitno)
+          restart_format = AREX_RST_RESTART_FORMAT_FORMATTED
+          return
+        end if
+
+        ios = 0
+        zero_natom = 0
+        inpcrd_version = 0
+        natom_probe = 0
+        read(header_buf, *, iostat=ios) zero_natom, inpcrd_version, natom_probe
+        if (ios == 0 .and. zero_natom == 0 .and. inpcrd_version == 2 .and. &
+            natom_probe > 0) then
+          close(unitno)
+          restart_format = AREX_RST_RESTART_FORMAT_FORMATTED
+          return
+        end if
+      end if
+    end if
+    close(unitno)
+  end if
+
+  restart_format = AREX_RST_RESTART_FORMAT_UNFORMATTED
+end subroutine arex_rst_detect_common_restart_format
+
+subroutine arex_rst_read_common_restart(filename, snapshot, ierr, message)
+  character(len=*), intent(in) :: filename
+  type(arm_md_snapshot_t), intent(inout) :: snapshot
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: unitno
+  integer :: ios
+  integer :: i
+  integer :: natom_local
+  integer :: zero_natom
+  integer :: inpcrd_version
+  integer :: arm_ierr
+  integer :: restart_format
+  character(len=80)  :: title
+  character(len=80)  :: read_buf
+  character(len=256) :: line_buf
+  character(len=256) :: arm_message
+  real(dp) :: tt
+  real(dp) :: dummy_remd_values(1)
+  logical :: box_found
+  logical :: velocities_found
+  logical :: angles_found
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  natom_local = 0
+  zero_natom = 0
+  inpcrd_version = 0
+  tt = 0.0_dp
+  dummy_remd_values(1) = 0.0_dp
+  box_found = .false.
+  velocities_found = .false.
+  angles_found = .false.
+  title = ''
+  read_buf = ''
+  line_buf = ''
+
+  call arex_rst_detect_common_restart_format(filename, restart_format, ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  select case (restart_format)
+
+  case (AREX_RST_RESTART_FORMAT_NETCDF)
+    call read_nc_restart_atoms(filename, natom_local)
+
+    if (natom_local <= 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+        'arex_rst_read_common_restart: invalid natom in NetCDF restart')
+      return
+    end if
+
+    if (snapshot%allocated .and. snapshot%natom /= natom_local) then
+      call arm_snapshot_deallocate(snapshot)
+    end if
+
+    arm_ierr = ARM_OK
+    arm_message = ''
+    call arm_snapshot_allocate(snapshot, natom_local, arm_ierr, arm_message)
+    if (arm_ierr /= ARM_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, trim(arm_message))
+      return
+    end if
+
+    call read_nc_restart(filename, title, natom_local, snapshot%crd, snapshot%vel, &
+                         dummy_remd_values, 1, tt, snapshot%box, snapshot%alpha,    &
+                         snapshot%beta, snapshot%gamma, box_found, velocities_found)
+
+  case (AREX_RST_RESTART_FORMAT_FORMATTED)
+    open(newunit=unitno, file=trim(filename), status='OLD', form='FORMATTED', &
+         action='READ', iostat=ios)
+    if (ios /= 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to open formatted restart file')
+      return
+    end if
+
+    read(unitno, '(a80)', iostat=ios) title
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read formatted restart title')
+      return
+    end if
+
+    read(unitno, '(a80)', iostat=ios) read_buf
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read formatted restart header')
+      return
+    end if
+
+    read(read_buf, *, iostat=ios) natom_local, tt
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to parse formatted restart header')
+      return
+    end if
+
+    if (natom_local == 0) then
+      read(read_buf, *, iostat=ios) zero_natom, inpcrd_version, natom_local, tt
+      if (ios /= 0 .or. inpcrd_version /= 2) then
+        close(unitno)
+        call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+          'arex_rst_read_common_restart: unsupported formatted restart header')
+        return
+      end if
+    end if
+
+    if (natom_local <= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+        'arex_rst_read_common_restart: invalid natom in formatted restart')
+      return
+    end if
+
+    rewind(unitno)
+    read(unitno, '(a80)', iostat=ios) title
+    read(unitno, '(a80)', iostat=ios) read_buf
+
+    if (snapshot%allocated .and. snapshot%natom /= natom_local) then
+      call arm_snapshot_deallocate(snapshot)
+    end if
+
+    arm_ierr = ARM_OK
+    arm_message = ''
+    call arm_snapshot_allocate(snapshot, natom_local, arm_ierr, arm_message)
+    if (arm_ierr /= ARM_OK) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, trim(arm_message))
+      return
+    end if
+
+    snapshot%crd      = 0.0_dp
+    snapshot%vel      = 0.0_dp
+    snapshot%last_vel = 0.0_dp
+    snapshot%box      = 0.0_dp
+    snapshot%alpha    = 0.0_dp
+    snapshot%beta     = 0.0_dp
+    snapshot%gamma    = 0.0_dp
+    snapshot%time     = 0.0_dp
+    snapshot%valid    = .false.
+
+    read(unitno, *, iostat=ios) (snapshot%crd(1:3, i), i = 1, natom_local)
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read formatted restart coordinates')
+      return
+    end if
+
+    read(unitno, *, iostat=ios) (snapshot%vel(1:3, i), i = 1, natom_local)
+    if (ios == 0) then
+      velocities_found = .true.
+
+      read(unitno, '(a256)', iostat=ios) line_buf
+      if (ios == 0) then
+        read(line_buf, *, iostat=ios) snapshot%box(1), snapshot%box(2), snapshot%box(3), &
+                                      snapshot%alpha, snapshot%beta, snapshot%gamma
+        if (ios == 0) then
+          box_found = .true.
+        else
+          ios = 0
+          snapshot%box   = 0.0_dp
+          snapshot%alpha = 0.0_dp
+          snapshot%beta  = 0.0_dp
+          snapshot%gamma = 0.0_dp
+          read(line_buf, *, iostat=ios) snapshot%box(1), snapshot%box(2), snapshot%box(3)
+          if (ios == 0) box_found = .true.
+          ios = 0
+        end if
+      else
+        ios = 0
+      end if
+    else
+      ios = 0
+      velocities_found = .false.
+      if (natom_local >= 2 .and. snapshot%vel(1,1) /= 0.0_dp) then
+        box_found = .true.
+        snapshot%box(1:3) = snapshot%vel(1:3, 1)
+        snapshot%alpha    = snapshot%vel(1, 2)
+        snapshot%beta     = snapshot%vel(2, 2)
+        snapshot%gamma    = snapshot%vel(3, 2)
+      end if
+    end if
+
+    close(unitno)
+
+  case default
+    open(newunit=unitno, file=trim(filename), status='OLD', form='UNFORMATTED', &
+         action='READ', iostat=ios)
+    if (ios /= 0) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to open unformatted restart file')
+      return
+    end if
+
+    read(unitno, iostat=ios) title
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read unformatted restart title')
+      return
+    end if
+
+    read(unitno, iostat=ios) natom_local, tt
+    if (ios /= 0 .or. natom_local <= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read unformatted restart header')
+      return
+    end if
+
+    if (snapshot%allocated .and. snapshot%natom /= natom_local) then
+      call arm_snapshot_deallocate(snapshot)
+    end if
+
+    arm_ierr = ARM_OK
+    arm_message = ''
+    call arm_snapshot_allocate(snapshot, natom_local, arm_ierr, arm_message)
+    if (arm_ierr /= ARM_OK) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, trim(arm_message))
+      return
+    end if
+
+    snapshot%crd      = 0.0_dp
+    snapshot%vel      = 0.0_dp
+    snapshot%last_vel = 0.0_dp
+    snapshot%box      = 0.0_dp
+    snapshot%alpha    = 0.0_dp
+    snapshot%beta     = 0.0_dp
+    snapshot%gamma    = 0.0_dp
+    snapshot%time     = 0.0_dp
+    snapshot%valid    = .false.
+
+    read(unitno, iostat=ios) (snapshot%crd(1:3, i), i = 1, natom_local)
+    if (ios /= 0) then
+      close(unitno)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, &
+        'arex_rst_read_common_restart: failed to read unformatted restart coordinates')
+      return
+    end if
+
+    read(unitno, iostat=ios) (snapshot%vel(1:3, i), i = 1, natom_local)
+    if (ios == 0) then
+      velocities_found = .true.
+      read(unitno, iostat=ios) snapshot%box(1:3), snapshot%alpha, snapshot%beta, snapshot%gamma
+      if (ios == 0) box_found = .true.
+      ios = 0
+    else
+      ios = 0
+      velocities_found = .false.
+      if (natom_local >= 2 .and. snapshot%vel(1,1) /= 0.0_dp) then
+        box_found = .true.
+        snapshot%box(1:3) = snapshot%vel(1:3, 1)
+        snapshot%alpha    = snapshot%vel(1, 2)
+        snapshot%beta     = snapshot%vel(2, 2)
+        snapshot%gamma    = snapshot%vel(3, 2)
+      end if
+    end if
+
+    close(unitno)
+
+  end select
+
+  if (velocities_found .and. .not. box_found .and. ntb /= 0 .and. natom_local == 2) then
+    velocities_found = .false.
+    box_found = .true.
+    snapshot%box(1:3) = snapshot%vel(1:3, 1)
+    snapshot%alpha    = snapshot%vel(1, 2)
+    snapshot%beta     = snapshot%vel(2, 2)
+    snapshot%gamma    = snapshot%vel(3, 2)
+    snapshot%vel(:,:) = 0.0_dp
+  end if
+
+  if (.not. velocities_found) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_read_common_restart: restart file does not contain velocities required for AREX continuation')
+    return
+  end if
+
+  if (.not. box_found .and. ntb /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_read_common_restart: restart file does not contain box data required for periodic AREX continuation')
+    return
+  end if
+
+  if (snapshot%alpha /= 0.0_dp) then
+    if (snapshot%beta == 0.0_dp .or. snapshot%gamma == 0.0_dp) then
+      snapshot%beta  = snapshot%alpha
+      snapshot%alpha = 90.0_dp
+      snapshot%gamma = 90.0_dp
+    end if
+    angles_found = .true.
+  end if
+
+  if (.not. angles_found) then
+    snapshot%alpha = 90.0_dp
+    snapshot%beta  = 90.0_dp
+    snapshot%gamma = 90.0_dp
+  end if
+
+  ! Match the normal PMEMD continuation path, which seeds last_vel from the
+  ! restart velocities before time integration resumes.
+  snapshot%last_vel = snapshot%vel
+  snapshot%time     = tt
+  snapshot%valid    = .true.
+end subroutine arex_rst_read_common_restart
+
+subroutine arex_rst_seed_common_snapshot_from_slot_restart(ckpt, mgr, slot_id, restart_ladder_value, &
+                                                              replica_id, expected_time_ps, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: slot_id
+  real(dp), intent(in) :: restart_ladder_value
+  integer, intent(in) :: replica_id
+  real(dp), intent(in) :: expected_time_ps
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  character(len=max_fn_len) :: mdcrd_name
+  character(len=max_fn_len) :: mdvel_name
+  character(len=max_fn_len) :: mdfrc_name
+  character(len=max_fn_len) :: restrt_name
+  character(len=max_fn_len) :: phmdout_name
+  character(len=max_fn_len) :: phmdrestrt_out_name
+  integer :: io_ierr
+  real(dp), parameter :: restart_time_tolerance_ps = 1.0e-6_dp
+  character(len=256) :: io_message
+  character(len=256) :: local_message
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_seed_common_snapshot_from_slot_restart: manager not initialized')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > mgr%nreplicas) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_seed_common_snapshot_from_slot_restart: invalid replica_id')
+    return
+  end if
+
+  io_ierr = 0
+  io_message = ''
+  call arex_rst_source_slot_paths(ckpt, slot_id, restrt_name, &
+                                  phmdrestrt_out_name, io_ierr, io_message)
+  if (io_ierr /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+    return
+  end if
+
+  call arex_rst_read_common_restart(trim(restrt_name), mgr%replicas(replica_id)%md, &
+                                    ierr, message)
+  if (ierr /= AREX_RST_OK) return
+
+  if (abs(mgr%replicas(replica_id)%md%time - expected_time_ps) > &
+      restart_time_tolerance_ps) then
+    write(local_message, '(a,i0,a,es14.6,a,es14.6)') &
+      'arex_rst_seed_common_snapshot_from_slot_restart: slot ', slot_id, &
+      ' restart time ', mgr%replicas(replica_id)%md%time, &
+      ' does not match checkpoint time ', expected_time_ps
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, trim(local_message))
+    return
+  end if
+end subroutine arex_rst_seed_common_snapshot_from_slot_restart
+
+subroutine arex_rst_seed_payload_from_slot_restart(ckpt, slot_id, restart_ladder_value, replica_id, &
+                                                    payload_type, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer, intent(in) :: slot_id
+  real(dp), intent(in) :: restart_ladder_value
+  integer, intent(in) :: replica_id
+  character(len=*), intent(in) :: payload_type
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  character(len=max_fn_len) :: mdcrd_name
+  character(len=max_fn_len) :: mdvel_name
+  character(len=max_fn_len) :: mdfrc_name
+  character(len=max_fn_len) :: restrt_name
+  character(len=max_fn_len) :: phmdout_name
+  character(len=max_fn_len) :: phmdrestrt_out_name
+  integer :: io_ierr
+  integer :: helper_ierr
+  integer :: phrex_nreplicas_local
+  integer :: phrex_ntheta_local
+  integer :: alloc_failed
+  character(len=256) :: io_message
+  character(len=256) :: helper_message
+  real(dp), allocatable :: theta_tmp(:)
+  real(dp), allocatable :: vtheta_tmp(:)
+#ifdef CUDA
+  integer :: phrex_random_buffer_size_local
+#endif
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (trim(arex_pay_tolower(adjustl(payload_type))) /= 'phrex') then
+    return
+  end if
+
+  io_ierr = 0
+  io_message = ''
+  call arex_rst_source_slot_paths(ckpt, slot_id, restrt_name, &
+                                  phmdrestrt_out_name, io_ierr, io_message)
+  if (io_ierr /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+    return
+  end if
+
+#ifdef CUDA
+  call arex_pay_phrex_get_checkpoint_shape(phrex_nreplicas_local, phrex_ntheta_local, &
+                                           phrex_random_buffer_size_local,            &
+                                           helper_ierr, helper_message)
+#else
+  call arex_pay_phrex_get_checkpoint_shape(phrex_nreplicas_local, phrex_ntheta_local, &
+                                           helper_ierr, helper_message)
+#endif
+  if (helper_ierr /= ARM_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(helper_message))
+    return
+  end if
+
+  allocate(theta_tmp(phrex_ntheta_local), vtheta_tmp(phrex_ntheta_local), stat=alloc_failed)
+  if (alloc_failed /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_seed_payload_from_slot_restart: allocation failure')
+    return
+  end if
+
+  call phmd_read_restart_state(phmdrestrt_out_name, theta_tmp, vtheta_tmp, helper_ierr, helper_message)
+  if (helper_ierr /= 0) then
+    deallocate(theta_tmp, vtheta_tmp)
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_IO, trim(helper_message))
+    return
+  end if
+
+  call arex_pay_phrex_seed_replica_from_restart(replica_id, theta_tmp, vtheta_tmp, &
+                                                helper_ierr, helper_message)
+  deallocate(theta_tmp, vtheta_tmp)
+
+  if (helper_ierr /= ARM_OK) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(helper_message))
+    return
+  end if
+end subroutine arex_rst_seed_payload_from_slot_restart
+
