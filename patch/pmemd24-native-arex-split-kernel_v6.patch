+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+  if (trim(ckpt%payload_type) /= 'phrex' .or. .not. ckpt%have_payload_checkpoint) return
+
+#ifdef CUDA
+  call arex_pay_phrex_import_checkpoint_state_mapped(source_old_replica, &
+       ckpt%phrex_valid, ckpt%phrex_theta, ckpt%phrex_dtheta, ckpt%phrex_vtheta, &
+       ckpt%phrex_dphold, ckpt%phrex_vphold, ckpt%phrex_proton_count, &
+       ckpt%phrex_iupdate, ckpt%phrex_random_counter, ckpt%phrex_random, &
+       helper_ierr, helper_message)
+#else
+  call arex_pay_phrex_import_checkpoint_state_mapped(source_old_replica, &
+       ckpt%phrex_valid, ckpt%phrex_theta, ckpt%phrex_dtheta, ckpt%phrex_vtheta, &
+       ckpt%phrex_dphold, ckpt%phrex_vphold, ckpt%phrex_proton_count, &
+       ckpt%phrex_iupdate, helper_ierr, helper_message)
