+subroutine arex_pay_phrex_send_assigned_replica_to_worker(replica_id, dest_master_rank, &
+                                                          ierr, message)
+
+#ifdef MPI
+  use parallel_dat_mod, only : arex_sched_comm, mpi_integer, mpi_double_precision, &
+                               mpi_character, err_code_mpi
+#endif
+
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: dest_master_rank
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: pack_ierr
+  integer :: packed_int_size
+  integer :: packed_real_size
+  character(len=256) :: root_message
+  character(len=256) :: pack_message
+  integer, allocatable :: packed_int(:)
+  real(dp), allocatable :: packed_real(:)
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+#ifndef MPI
+  call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arex_pay_phrex_send_assigned_replica_to_worker: requires MPI')
+  return
+#else
+
+  root_ierr = ARM_OK
+  root_message = ''
+  pack_message = ''
+  valid_i = 0
+
+  if (.not. phrex_initialized) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_pay_phrex_send_assigned_replica_to_worker: payload not initialized'
+  else if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_pay_phrex_send_assigned_replica_to_worker: invalid replica_id'
+  else
+    if (phrex_replica_valid(replica_id)) valid_i = 1
+  end if
+
+  call mpi_send(root_ierr, 1, mpi_integer, dest_master_rank, AREX_PHREX_MPI_TAG_STATE, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(root_message, len(root_message), mpi_character, dest_master_rank, &
+                AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_send(valid_i, 1, mpi_integer, dest_master_rank, AREX_PHREX_MPI_TAG_STATE, &
+                arex_sched_comm, err_code_mpi)
+
+  if (valid_i /= 0) then
+    packed_int_size = arex_pay_phrex_assigned_int_packed_size()
+    packed_real_size = arex_pay_phrex_assigned_real_packed_size()
+
+    allocate(packed_int(packed_int_size), packed_real(packed_real_size))
+
+    call arex_pay_phrex_pack_assigned_replica(replica_id, packed_int, packed_real, &
+                                              pack_ierr, pack_message)
+    if (pack_ierr /= ARM_OK) then
+      ierr = pack_ierr
+      if (len(message) > 0) message = pack_message(1:len(message))
+      deallocate(packed_int, packed_real)
+      return
+    end if
+
+    call mpi_send(packed_int, packed_int_size, mpi_integer, dest_master_rank, &
+                  AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, err_code_mpi)
+    call mpi_send(packed_real, packed_real_size, mpi_double_precision, dest_master_rank, &
+                  AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, err_code_mpi)
+
+    deallocate(packed_int, packed_real)
+  end if
+#endif
+end subroutine arex_pay_phrex_send_assigned_replica_to_worker
+
+subroutine arex_pay_phrex_send_completed_replica_to_scheduler(replica_id, slot_id, worker_id, &
+                                                              dest_master_rank, ierr, message)
+
+#ifdef MPI
+  use parallel_dat_mod, only : arex_sched_comm, mpi_integer, mpi_double_precision, &
+                               mpi_character, err_code_mpi
+#endif
+
+  integer, intent(in) :: replica_id
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: worker_id
+  integer, intent(in) :: dest_master_rank
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: pack_ierr
+  integer :: packed_int_size
+  integer :: packed_real_size
+  character(len=256) :: root_message
+  character(len=256) :: capture_message
+  character(len=256) :: pack_message
+  integer, allocatable :: packed_int(:)
+  real(dp), allocatable :: packed_real(:)
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+#ifndef MPI
+  call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arex_pay_phrex_send_completed_replica_to_scheduler: requires MPI')
+  return
+#else
+
+  capture_message = ''
+  call arex_pay_phrex_capture_from_worker(replica_id, slot_id, worker_id, ierr, capture_message)
+  if (ierr /= ARM_OK) then
+    if (len(message) > 0) message = capture_message(1:len(message))
+    return
+  end if
+
+  root_ierr = ARM_OK
+  root_message = ''
+  pack_message = ''
+  valid_i = 0
+
+  if (.not. phrex_initialized) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_pay_phrex_send_completed_replica_to_scheduler: payload not initialized'
+  else if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    root_ierr = ARM_ERR_INVALID
+    root_message = 'arex_pay_phrex_send_completed_replica_to_scheduler: invalid replica_id'
+  else
+    if (phrex_replica_valid(replica_id)) valid_i = 1
+  end if
+
+  call mpi_send(root_ierr, 1, mpi_integer, dest_master_rank, AREX_PHREX_MPI_TAG_COMPLETE, &
+                arex_sched_comm, err_code_mpi)
+  call mpi_send(root_message, len(root_message), mpi_character, dest_master_rank, &
+                AREX_PHREX_MPI_TAG_COMPLETE, arex_sched_comm, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_send(valid_i, 1, mpi_integer, dest_master_rank, AREX_PHREX_MPI_TAG_COMPLETE, &
+                arex_sched_comm, err_code_mpi)
+
+  if (valid_i /= 0) then
+    packed_int_size = arex_pay_phrex_completed_int_packed_size()
+    packed_real_size = arex_pay_phrex_completed_real_packed_size()
+
+    allocate(packed_int(packed_int_size), packed_real(packed_real_size))
+
+    call arex_pay_phrex_pack_completed_replica(replica_id, packed_int, packed_real, &
+                                               pack_ierr, pack_message)
+    if (pack_ierr /= ARM_OK) then
+      ierr = pack_ierr
+      if (len(message) > 0) message = pack_message(1:len(message))
+      deallocate(packed_int, packed_real)
+      return
+    end if
+
+    call mpi_send(packed_int, packed_int_size, mpi_integer, dest_master_rank, &
+                  AREX_PHREX_MPI_TAG_COMPLETE, arex_sched_comm, err_code_mpi)
+    call mpi_send(packed_real, packed_real_size, mpi_double_precision, dest_master_rank, &
+                  AREX_PHREX_MPI_TAG_COMPLETE, arex_sched_comm, err_code_mpi)
+
+    deallocate(packed_int, packed_real)
+  end if
+#endif
+end subroutine arex_pay_phrex_send_completed_replica_to_scheduler
+
+subroutine arex_pay_phrex_recv_assigned_replica_from_global(replica_id, ierr, message)
+
+  integer, intent(in) :: replica_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: root_ierr
+  integer :: valid_i
+  integer :: ladder_count
+  integer :: unpack_ierr
+  integer :: packed_int_size
+  integer :: packed_real_size
+  character(len=256) :: root_message
+  character(len=256) :: unpack_message
+  integer, allocatable :: packed_int(:)
+  real(dp), allocatable :: packed_real(:)
+
+  call arex_pay_set_status(ierr, message, ARM_OK, '')
+
+#ifndef MPI
+  call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arex_pay_phrex_recv_assigned_replica_from_global: requires MPI')
+  return
+#else
+
+  if (.not. phrex_initialized) then
+    call arex_pay_phrex_get_ladder_count(ladder_count, ierr, message)
+    if (ierr /= ARM_OK) return
+
+    call arex_pay_phrex_initialize(ladder_count, ladder_count, ierr, message)
+    if (ierr /= ARM_OK) return
+  end if
+
+  if (replica_id < 1 .or. replica_id > phrex_nreplicas) then
+    call arex_pay_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arex_pay_phrex_recv_assigned_replica_from_global: invalid replica_id')
+    return
+  end if
+
+  root_ierr = ARM_OK
+  root_message = ''
+  unpack_message = ''
+
+  call mpi_recv(root_ierr, 1, mpi_integer, 0, AREX_PHREX_MPI_TAG_STATE, &
+                arex_sched_comm, MPI_STATUS_IGNORE, err_code_mpi)
+  call mpi_recv(root_message, len(root_message), mpi_character, 0, &
+                AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, MPI_STATUS_IGNORE, err_code_mpi)
+
+  if (root_ierr /= ARM_OK) then
+    ierr = root_ierr
+    if (len(message) > 0) message = root_message(1:len(message))
+    return
+  end if
+
+  call mpi_recv(valid_i, 1, mpi_integer, 0, AREX_PHREX_MPI_TAG_STATE, &
+                arex_sched_comm, MPI_STATUS_IGNORE, err_code_mpi)
+
+  if (valid_i == 0) then
+    phrex_replica_valid(replica_id) = .false.
+    return
+  end if
+
+  packed_int_size = arex_pay_phrex_assigned_int_packed_size()
+  packed_real_size = arex_pay_phrex_assigned_real_packed_size()
+
+  allocate(packed_int(packed_int_size), packed_real(packed_real_size))
+
+  call mpi_recv(packed_int, packed_int_size, mpi_integer, 0, &
+                AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, MPI_STATUS_IGNORE, err_code_mpi)
+  call mpi_recv(packed_real, packed_real_size, mpi_double_precision, 0, &
+                AREX_PHREX_MPI_TAG_STATE, arex_sched_comm, MPI_STATUS_IGNORE, err_code_mpi)
+
+  call arex_pay_phrex_unpack_assigned_replica(replica_id, packed_int, packed_real, &
+                                              unpack_ierr, unpack_message)
+  deallocate(packed_int, packed_real)
+
+  if (unpack_ierr /= ARM_OK) then
+    ierr = unpack_ierr
+    if (len(message) > 0) message = unpack_message(1:len(message))
+    return
+  end if
+
+  phrex_replica_valid(replica_id) = .true.
+#endif
+end subroutine arex_pay_phrex_recv_assigned_replica_from_global
+
