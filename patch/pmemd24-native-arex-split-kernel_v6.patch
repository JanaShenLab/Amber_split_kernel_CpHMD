+__global__ void
+kPHMDSumChargePartial_kernel(PMEDouble2* __restrict__ pPartial)
+{
+  extern __shared__ PMEDouble2 sSum[];
+
+  const unsigned int tid = threadIdx.x;
+  const unsigned int base = blockIdx.x * blockDim.x * 2u + tid;
+
+  double sumq = 0.0;
+  double sumq2 = 0.0;
+
+  unsigned int idx = base;
+  if (idx < cSim.atoms) {
+    const double q = static_cast<double>(cSim.pAtomChargeSP[idx]);
+    sumq += q;
+    sumq2 += q * q;
+  }
+
+  idx = base + blockDim.x;
+  if (idx < cSim.atoms) {
+    const double q = static_cast<double>(cSim.pAtomChargeSP[idx]);
+    sumq += q;
+    sumq2 += q * q;
+  }
+
+  sSum[tid].x = sumq;
+  sSum[tid].y = sumq2;
+
+  __syncthreads();
+
+  for (unsigned int offset = blockDim.x >> 1; offset > 0u; offset >>= 1) {
+    if (tid < offset) {
+      sSum[tid].x += sSum[tid + offset].x;
+      sSum[tid].y += sSum[tid + offset].y;
+    }
+    __syncthreads();
+  }
+
+  if (tid == 0u) {
+    pPartial[blockIdx.x] = sSum[0];
+  }
+}
