+static inline long long kPMEPHMDRawAccumulatorDelta(const PMEAccumulator a,
+                                                    const PMEAccumulator b)
+{
+  return static_cast<long long>(
+    static_cast<unsigned long long>(a) -
+    static_cast<unsigned long long>(b));
+}
+
+static inline unsigned long long kPMEPHMDAbsLongLong(const long long value)
+{
+  return (value < 0) ?
+    static_cast<unsigned long long>(-(value + 1)) + 1ull :
+    static_cast<unsigned long long>(value);
+}
+
+static void kPMEPHMDCompareMissingCorrectionStats(const char* label,
+                                                  const PMEAccumulator* pRefFinal,
+                                                  const PMEAccumulator* pRefBase,
+                                                  const PMEAccumulator* pTestFinal,
+                                                  const PMEAccumulator* pTestBase,
+                                                  const unsigned int count,
+                                                  const unsigned long long tol)
+{
+  const size_t bytes = static_cast<size_t>(count) * sizeof(PMEAccumulator);
+
+  PMEAccumulator* hRefFinal  = static_cast<PMEAccumulator*>(malloc(bytes));
+  PMEAccumulator* hRefBase   = static_cast<PMEAccumulator*>(malloc(bytes));
+  PMEAccumulator* hTestFinal = static_cast<PMEAccumulator*>(malloc(bytes));
+  PMEAccumulator* hTestBase  = static_cast<PMEAccumulator*>(malloc(bytes));
+
+  if ((hRefFinal == nullptr) || (hRefBase == nullptr) ||
+      (hTestFinal == nullptr) || (hTestBase == nullptr)) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareMissingCorrectionStats: host malloc failed for %s\n",
+                 label);
+    std::abort();
+  }
+
+  cudaError_t status;
+
+  status = cudaMemcpy(hRefFinal, pRefFinal, bytes, cudaMemcpyDeviceToHost);
+  RTERROR(status, "cudaMemcpy hRefFinal failed in kPMEPHMDCompareMissingCorrectionStats");
+
+  status = cudaMemcpy(hRefBase, pRefBase, bytes, cudaMemcpyDeviceToHost);
+  RTERROR(status, "cudaMemcpy hRefBase failed in kPMEPHMDCompareMissingCorrectionStats");
+
+  status = cudaMemcpy(hTestFinal, pTestFinal, bytes, cudaMemcpyDeviceToHost);
+  RTERROR(status, "cudaMemcpy hTestFinal failed in kPMEPHMDCompareMissingCorrectionStats");
+
+  status = cudaMemcpy(hTestBase, pTestBase, bytes, cudaMemcpyDeviceToHost);
+  RTERROR(status, "cudaMemcpy hTestBase failed in kPMEPHMDCompareMissingCorrectionStats");
+
+  unsigned long long missingZeroCount = 0ull;
+  unsigned long long missingZeroAboveTolCount = 0ull;
+  unsigned long long missingZeroLeTolCount = 0ull;
+  unsigned long long missingZeroLe10TolCount = 0ull;
+  unsigned long long missingZeroLe100TolCount = 0ull;
+  unsigned long long missingZeroGt100TolCount = 0ull;
+
+  unsigned long long maxAbsMissingRefDelta = 0ull;
+  long double sumAbsMissingRefDelta = 0.0L;
+
+  const unsigned long long tol10 =
+    (tol > (~0ull / 10ull)) ? ~0ull : tol * 10ull;
+  const unsigned long long tol100 =
+    (tol > (~0ull / 100ull)) ? ~0ull : tol * 100ull;
+
+  for (unsigned int i = 0; i < count; i++) {
+    const long long refDelta =
+      kPMEPHMDRawAccumulatorDelta(hRefFinal[i], hRefBase[i]);
+
+    const long long testDelta =
+      kPMEPHMDRawAccumulatorDelta(hTestFinal[i], hTestBase[i]);
+
+    if ((refDelta != 0ll) && (testDelta == 0ll)) {
+      const unsigned long long absRefDelta = kPMEPHMDAbsLongLong(refDelta);
+
+      missingZeroCount++;
+      sumAbsMissingRefDelta += static_cast<long double>(absRefDelta);
+
+      if (absRefDelta > maxAbsMissingRefDelta) {
+        maxAbsMissingRefDelta = absRefDelta;
+      }
+
+      if (absRefDelta > tol) {
+        missingZeroAboveTolCount++;
+      }
+
+      if (absRefDelta <= tol) {
+        missingZeroLeTolCount++;
+      }
+      else if (absRefDelta <= tol10) {
+        missingZeroLe10TolCount++;
+      }
+      else if (absRefDelta <= tol100) {
+        missingZeroLe100TolCount++;
+      }
+      else {
+        missingZeroGt100TolCount++;
+      }
+    }
+  }
+
+  const long double avgAbsMissingRefDelta =
+    (missingZeroCount > 0ull) ?
+    (sumAbsMissingRefDelta / static_cast<long double>(missingZeroCount)) :
+    0.0L;
+
+  std::printf("%s missing correction stats\n", label);
+  std::printf("  refDeltaRaw != 0 and testDeltaRaw == 0 count: %llu\n",
+              missingZeroCount);
+  std::printf("  above current tol count: %llu\n",
+              missingZeroAboveTolCount);
+  std::printf("  max abs refDeltaRaw among missing-zero slots: %llu\n",
+              maxAbsMissingRefDelta);
+  std::printf("  avg abs refDeltaRaw among missing-zero slots: %.6Le\n",
+              avgAbsMissingRefDelta);
+  std::printf("  abs refDeltaRaw buckets: <=tol %llu, <=10tol %llu, <=100tol %llu, >100tol %llu\n",
+              missingZeroLeTolCount,
+              missingZeroLe10TolCount,
+              missingZeroLe100TolCount,
+              missingZeroGt100TolCount);
+  std::fflush(stdout);
+
+  free(hRefFinal);
+  free(hRefBase);
+  free(hTestFinal);
+  free(hTestBase);
+}
