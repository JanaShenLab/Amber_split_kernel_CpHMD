+  call arex_rebase_output(mden_name)
+  call arex_rebase_output(restrt_name)
+  call arex_rebase_output(logfile_name)
+  call arex_rebase_output(phmdout_name)
+  call arex_rebase_output(phmdrestrt_out_name)
+  call arex_rebase_output(cpout_name)
+  call arex_rebase_output(cprestrt_name)
+  call arex_rebase_output(ceout_name)
+  call arex_rebase_output(cerestrt_name)
+  call arex_rebase_output(cpeout_name)
