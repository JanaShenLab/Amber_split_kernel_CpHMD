+//---------------------------------------------------------------------------------------------
+// gpu_pharex_capture_: capture exact CUDA PHMD continuation state for one logical replica.
+//
+// Arguments:
+//   ph_theta:           host buffer, length >= gpu->sim.ntitr
+//   dph_theta:          host buffer, length >= gpu->sim.ntitr
+//   vph_theta:          host buffer, length >= gpu->sim.ntitr
+//   dphold:             host buffer, length >= gpu->sim.ntitr
+//   vphold:             host buffer, length >= gpu->sim.ntitr
+//   randomCounterPHMD:  host scalar
+//   randomPHMD:         host buffer, length >= gpu->sim.randomNumbersPHMD
+//---------------------------------------------------------------------------------------------
+extern "C" void gpu_pharex_capture_(double ph_theta[], double dph_theta[],
+                                    double vph_theta[], double dphold[],
+                                    double vphold[], int *randomCounterPHMD,
+                                    double randomPHMD[])
+{
+  PRINTMETHOD("gpu_pharex_capture");
+
+  cudaDeviceSynchronize();
+
+  gpu->ph_theta->Download();
+  gpu->dph_theta->Download();
+  gpu->vph_theta->Download();
+  gpu->dphold->Download();
+  gpu->vphold->Download();
+  gpu->pbRandomPHMD->Download();
+
+  for (int i = 0; i < gpu->sim.ntitr; i++) {
+    ph_theta[i]  = gpu->ph_theta->_pSysData[i];
+    dph_theta[i] = gpu->dph_theta->_pSysData[i];
+    vph_theta[i] = gpu->vph_theta->_pSysData[i];
+    dphold[i]    = gpu->dphold->_pSysData[i];
+    vphold[i]    = gpu->vphold->_pSysData[i];
+  }
+
+  *randomCounterPHMD = static_cast<int>(gpu->randomCounterPHMD);
+
+  for (int i = 0; i < gpu->sim.randomNumbersPHMD; i++) {
+    randomPHMD[i] = gpu->pbRandomPHMD->_pSysData[i];
+  }
+}
+
+//---------------------------------------------------------------------------------------------
+// gpu_pharex_random_buffer_size_: return the exact PHMD random-buffer length required to
+// capture and restore stochastic continuation state for one logical replica.
+//
+// Arguments:
+//   nrandom:    number of doubles in pbRandomPHMD / sim.randomNumbersPHMD
+//---------------------------------------------------------------------------------------------
+extern "C" void gpu_pharex_random_buffer_size_(int *nrandom)
+{
+  PRINTMETHOD("gpu_pharex_random_buffer_size");
+  *nrandom = gpu->sim.randomNumbersPHMD;
+}
+
+//---------------------------------------------------------------------------------------------
+// gpu_pharex_restore_: restore exact CUDA PHMD continuation state for one logical replica.
+//
+// Arguments:
+//   ph_theta:           host buffer, length >= gpu->sim.ntitr
+//   dph_theta:          host buffer, length >= gpu->sim.ntitr
+//   vph_theta:          host buffer, length >= gpu->sim.ntitr
+//   dphold:             host buffer, length >= gpu->sim.ntitr
+//   vphold:             host buffer, length >= gpu->sim.ntitr
+//   charge_phmd:        host buffer, length >= gpu->sim.atoms
+//   randomCounterPHMD:  host scalar
+//   randomPHMD:         host buffer, length >= gpu->sim.randomNumbersPHMD
+//
+// Notes:
+//   - The padded PHMD lanes [ntitr, phmd_padded_ntitr) are explicitly zeroed.
+//   - The padded atom lanes [atoms, paddedNumberOfAtoms) for PHMD charges are
+//     explicitly zeroed.
+//   - This routine restores PHMD device-side continuation state only.
+//     The live MD charge array upload remains a separate Fortran-side path
+//     using the existing gpu_upload_charges_* CpHMD helpers.
+//---------------------------------------------------------------------------------------------
+extern "C" void gpu_pharex_restore_(double ph_theta[], double dph_theta[],
+                                    double vph_theta[], double dphold[],
+                                    double vphold[], double charge_phmd[],
+                                    int *randomCounterPHMD,
+                                    double randomPHMD[])
+{
+  PRINTMETHOD("gpu_pharex_restore");
+
+  for (int i = 0; i < gpu->sim.ntitr; i++) {
+    gpu->ph_theta->_pSysData[i]  = static_cast<PMEFloat>(ph_theta[i]);
+    gpu->dph_theta->_pSysData[i] = static_cast<PMEFloat>(dph_theta[i]);
+    gpu->vph_theta->_pSysData[i] = static_cast<PMEFloat>(vph_theta[i]);
+    gpu->dphold->_pSysData[i]    = static_cast<PMEFloat>(dphold[i]);
+    gpu->vphold->_pSysData[i]    = static_cast<PMEFloat>(vphold[i]);
+  }
+
+  for (int i = gpu->sim.ntitr; i < gpu->sim.phmd_padded_ntitr; i++) {
+    gpu->ph_theta->_pSysData[i]  = static_cast<PMEFloat>(0.0);
+    gpu->dph_theta->_pSysData[i] = static_cast<PMEFloat>(0.0);
+    gpu->vph_theta->_pSysData[i] = static_cast<PMEFloat>(0.0);
+    gpu->dphold->_pSysData[i]    = static_cast<PMEFloat>(0.0);
+    gpu->vphold->_pSysData[i]    = static_cast<PMEFloat>(0.0);
+  }
+
+  /*
+   * AREX PHREX restore:
+   *
+   * charge_phmd is atom-indexed.
+   * ImageCharge_phmd is image-indexed in the neighbor-list path.
+   *
+   * ImageCharge_phmd has two image-charge planes in this build. Use
+   * paddedNumberOfAtoms as the plane length, not gpu->sim.stride. The observed
+   * buffer length is 2 * paddedNumberOfAtoms.
+   */
+  const int phmd_image_plane_len = gpu->sim.paddedNumberOfAtoms;
+
+  for (int i = 0; i < gpu->sim.paddedNumberOfAtoms; i++) {
+    gpu->charge_phmd->_pSysData[i] = static_cast<PMEFloat>(0.0);
+  }
+
+  if (gpu->bNeighborList && gpu->pbImageIndex != NULL) {
+    gpu->pbImageIndex->Download();
+
+    unsigned int* pImageAtomLookup =
+      &(gpu->pbImageIndex->_pSysData[gpu->sim.imageStride * 2]);
+
+    PMEFloat* pImageChargePHMD_base = gpu->ImageCharge_phmd->_pSysData;
+    PMEFloat* pImageChargePHMD_alt  = gpu->ImageCharge_phmd->_pSysData + phmd_image_plane_len;
+
+    for (int i = 0; i < phmd_image_plane_len; i++) {
+      pImageChargePHMD_base[i] = static_cast<PMEFloat>(0.0);
+      pImageChargePHMD_alt[i]  = static_cast<PMEFloat>(0.0);
+    }
+
+    for (int i = 0; i < gpu->sim.atoms; i++) {
+      PMEFloat q = static_cast<PMEFloat>(charge_phmd[i]);
+      int image_index = static_cast<int>(pImageAtomLookup[i]);
+
+      gpu->charge_phmd->_pSysData[i] = q;
+
+      if (image_index >= 0 && image_index < phmd_image_plane_len) {
+        pImageChargePHMD_base[image_index] = q;
+        pImageChargePHMD_alt[image_index]  = q;
+      }
+      else {
+        fprintf(stderr,
+                "AREX ERROR gpu_pharex_restore invalid PHMD image lookup atom=%d image=%d plane_len=%d paddedAtoms=%d imageStride=%d\n",
+                i,
+                image_index,
+                phmd_image_plane_len,
+                gpu->sim.paddedNumberOfAtoms,
+                gpu->sim.imageStride);
+        fflush(stderr);
+      }
+    }
+  }
+  else {
+    for (int i = 0; i < gpu->sim.paddedNumberOfAtoms; i++) {
+      gpu->ImageCharge_phmd->_pSysData[i] = static_cast<PMEFloat>(0.0);
+    }
+
+    for (int i = 0; i < gpu->sim.atoms; i++) {
+      PMEFloat q = static_cast<PMEFloat>(charge_phmd[i]);
+      gpu->charge_phmd->_pSysData[i] = q;
+      gpu->ImageCharge_phmd->_pSysData[i] = q;
+    }
+  }
+  for (int i = 0; i < gpu->sim.randomNumbersPHMD; i++) {
+    gpu->pbRandomPHMD->_pSysData[i] = randomPHMD[i];
+  }
+  if (*randomCounterPHMD < 0) {
+    gpu->randomCounterPHMD = 0;
+  }
+  else {
+    gpu->randomCounterPHMD = static_cast<unsigned int>(*randomCounterPHMD);
+  }
+
+  if (gpu->sim.randomSteps > 0 &&
+      gpu->randomCounterPHMD >= static_cast<unsigned int>(gpu->sim.randomSteps)) {
+    gpu->randomCounterPHMD %= static_cast<unsigned int>(gpu->sim.randomSteps);
+  }
+
+  gpu->ph_theta->Upload();
+  gpu->dph_theta->Upload();
+  gpu->vph_theta->Upload();
+  gpu->dphold->Upload();
+  gpu->vphold->Upload();
+  gpu->charge_phmd->Upload();
+  gpu->ImageCharge_phmd->Upload();
+  gpu->pbRandomPHMD->Upload();
+
+  cudaError_t status = cudaDeviceSynchronize();
+  RTERROR(status, "cudaDeviceSynchronize: gpu_pharex_restore failed");
+}
