+subroutine arex_rst_apply_output_state(ckpt, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_io_bintraj_state_t) :: bintraj_state
+  integer :: slot_id
+  integer :: io_ierr
+  character(len=256) :: io_message
+  logical :: initialized
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (.not. ckpt%allocated) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_apply_output_state: checkpoint not loaded')
+    return
+  end if
+
+  do slot_id = 1, ckpt%nslots
+    bintraj_state%valid = .false.
+
+    ! Process-local NetCDF handles and IDs must never be restored as valid.
+    bintraj_state%mdcrd_ncid         = -1
+    bintraj_state%coord_var_id       = -1
+    bintraj_state%cell_length_var_id = -1
+    bintraj_state%cell_angle_var_id  = -1
+    bintraj_state%mdcrd_time_var_id  = -1
+    bintraj_state%mdcrd_veloc_var_id = -1
+    bintraj_state%mdcrd_frc_var_id   = -1
+    bintraj_state%remd_indices_var_id = -1
+    bintraj_state%remd_values_var_id  = -1
+    bintraj_state%remd_types_var_id   = -1
+    bintraj_state%repidx_var_id       = -1
+    bintraj_state%crdidx_var_id       = -1
+    bintraj_state%frame_dim_id        = -1
+    bintraj_state%mdvel_ncid          = -1
+    bintraj_state%mdvel_time_var_id   = -1
+    bintraj_state%mdvel_veloc_var_id  = -1
+    bintraj_state%mdfrc_ncid          = -1
+    bintraj_state%mdfrc_time_var_id   = -1
+    bintraj_state%mdfrc_frc_var_id    = -1
+
+    ! Restore authoritative slot-owned append/restart metadata.
+    bintraj_state%mdcrd_frame         = ckpt%slot_output(slot_id)%mdcrd_frame
+    bintraj_state%mdvel_frame         = ckpt%slot_output(slot_id)%mdvel_frame
+    bintraj_state%mdfrc_frame         = ckpt%slot_output(slot_id)%mdfrc_frame
+    bintraj_state%mdcrd_logical_steps = ckpt%slot_output(slot_id)%mdcrd_logical_steps
+    bintraj_state%part_start_step = ckpt%slot_output(slot_id)%part_start_step
+    if (arexrst_specified .and. .not. arex_append) then
+      bintraj_state%part_start_step = bintraj_state%mdcrd_logical_steps
+      bintraj_state%mdcrd_frame = 1
+      bintraj_state%mdvel_frame = 1
+      bintraj_state%mdfrc_frame = 1
+    end if
+    bintraj_state%mdcrd_time_origin_ps = ckpt%slot_output(slot_id)%mdcrd_time_origin_ps
+    bintraj_state%mdcrd_logical_time_ps = ckpt%slot_output(slot_id)%mdcrd_logical_time_ps
+    bintraj_state%atom_wrt_cnt        = 0
+
+    ! Always force local reopen after continuation. Frame counters above decide
+    ! whether the worker recreates or appends the slot-owned NetCDF outputs.
+    initialized = .false.
+
+    call arex_io_set_slot_bintraj_state(slot_id, bintraj_state, initialized, io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+    call arex_io_set_slot_phmd_output_initialized(slot_id, &
+         ckpt%slot_output(slot_id)%phmd_output_initialized .and. &
+         (.not. arexrst_specified .or. arex_append), io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+   !write(0,'(a,1x,i4,1x,l1,1x,l1,3(1x,i8),1x,i12,2(1x,f12.4))') &
+   !  'AREX DBG CKPT APPLY slot=', slot_id,                               &
+   !  initialized,                                                        &
+   !  ckpt%slot_output(slot_id)%phmd_output_initialized,                  &
+   !  ckpt%slot_output(slot_id)%mdcrd_frame,                              &
+   !  ckpt%slot_output(slot_id)%mdvel_frame,                              &
+   !  ckpt%slot_output(slot_id)%mdfrc_frame,                              &
+   !  ckpt%slot_output(slot_id)%mdcrd_logical_steps,                      &
+   !  ckpt%slot_output(slot_id)%mdcrd_time_origin_ps,                     &
+   !  ckpt%slot_output(slot_id)%mdcrd_logical_time_ps
+   !call flush(0)
+  end do
+end subroutine arex_rst_apply_output_state
+
+subroutine arex_rst_build_migration_map(ckpt, source_old_slot, source_old_replica, &
+                                         source_restart_slot, retained, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  integer, intent(out) :: source_old_slot(:)
+  integer, intent(out) :: source_old_replica(:)
+  integer, intent(out) :: source_restart_slot(:)
+  logical, intent(out) :: retained(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: new_slot
+  integer :: old_slot
+  integer :: old_replica
+  integer :: restart_slot
+  integer :: best_slot
+  integer :: alloc_stat
+  real(dp) :: distance
+  real(dp) :: best_distance
+  real(dp), parameter :: ladder_tolerance = 1.0e-12_dp
+  logical :: exact_match
+  logical, allocatable :: old_replica_retained(:)
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  if (size(source_old_slot) /= arex_rst_ladder_count() .or. &
+      size(source_old_replica) /= arex_rst_ladder_count() .or. &
+      size(source_restart_slot) /= arex_rst_ladder_count() .or. &
+      size(retained) /= arex_rst_ladder_count()) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, &
+      'arex_rst_build_migration_map: new-ladder mapping size mismatch')
+    return
+  end if
+
+  allocate(old_replica_retained(ckpt%nreplicas), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arex_rst_set_status(ierr, message, AREX_RST_ERR_ALLOC, &
+      'arex_rst_build_migration_map: mapping allocation failed')
+    return
+  end if
+  old_replica_retained(:) = .false.
+
+  do new_slot = 1, size(source_old_slot)
+    best_slot = 0
+    best_distance = huge(1.0_dp)
+    exact_match = .false.
+
+    do old_slot = 1, ckpt%nslots
+      distance = abs(arex_ladder(new_slot) - ckpt%slot_ladder(old_slot))
+      if (distance <= ladder_tolerance) then
+        best_slot = old_slot
+        best_distance = distance
+        exact_match = .true.
+        exit
+      end if
+      if (distance < best_distance - ladder_tolerance) then
+        best_slot = old_slot
+        best_distance = distance
+      end if
+    end do
+
+    if (best_slot <= 0) then
+      deallocate(old_replica_retained)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_build_migration_map: failed to select an old ladder source')
+      return
+    end if
+
+    old_replica = ckpt%slot_owner(best_slot)
+    restart_slot = 0
+    do old_slot = 1, ckpt%nslots
+      if (ckpt%slot_output(old_slot)%restart_replica_id == old_replica) then
+        restart_slot = old_slot
+        exit
+      end if
+    end do
+
+    if (restart_slot <= 0) then
+      deallocate(old_replica_retained)
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_MISMATCH, &
+        'arex_rst_build_migration_map: source walker has no matching restart file')
+      return
+    end if
+
+    source_old_slot(new_slot) = best_slot
+    source_old_replica(new_slot) = old_replica
+    source_restart_slot(new_slot) = restart_slot
+
+    retained(new_slot) = exact_match .and. .not. old_replica_retained(old_replica)
+    if (retained(new_slot)) old_replica_retained(old_replica) = .true.
+  end do
+
+  deallocate(old_replica_retained)
+end subroutine arex_rst_build_migration_map
+
+subroutine arex_rst_apply_migration_output_state(ckpt, mgr, source_old_slot, &
+                                                  source_restart_slot, retained, &
+                                                  ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: source_old_slot(:)
+  integer, intent(in) :: source_restart_slot(:)
+  logical, intent(in) :: retained(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  type(arex_io_bintraj_state_t) :: bintraj_state
+  integer :: new_slot
+  integer :: old_slot
+  integer :: restart_slot
+  integer :: io_ierr
+  character(len=256) :: io_message
+
+  call arex_rst_set_status(ierr, message, AREX_RST_OK, '')
+
+  do new_slot = 1, mgr%nslots
+    bintraj_state%valid = .false.
+    bintraj_state%mdcrd_ncid = -1
+    bintraj_state%coord_var_id = -1
+    bintraj_state%cell_length_var_id = -1
+    bintraj_state%cell_angle_var_id = -1
+    bintraj_state%mdcrd_time_var_id = -1
+    bintraj_state%mdcrd_veloc_var_id = -1
+    bintraj_state%mdcrd_frc_var_id = -1
+    bintraj_state%remd_indices_var_id = -1
+    bintraj_state%remd_values_var_id = -1
+    bintraj_state%remd_types_var_id = -1
+    bintraj_state%repidx_var_id = -1
+    bintraj_state%crdidx_var_id = -1
+    bintraj_state%frame_dim_id = -1
+    bintraj_state%mdvel_ncid = -1
+    bintraj_state%mdvel_time_var_id = -1
+    bintraj_state%mdvel_veloc_var_id = -1
+    bintraj_state%mdvel_frame = 1
+    bintraj_state%mdfrc_ncid = -1
+    bintraj_state%mdfrc_time_var_id = -1
+    bintraj_state%mdfrc_frc_var_id = -1
+    bintraj_state%mdfrc_frame = 1
+    bintraj_state%mdcrd_frame = 1
+    bintraj_state%mdcrd_logical_steps = 0
+    bintraj_state%atom_wrt_cnt = 0
+
+    if (retained(new_slot) .and. arex_append) then
+      old_slot = source_old_slot(new_slot)
+      bintraj_state%mdcrd_frame = ckpt%slot_output(old_slot)%mdcrd_frame
+      bintraj_state%mdvel_frame = ckpt%slot_output(old_slot)%mdvel_frame
+      bintraj_state%mdfrc_frame = ckpt%slot_output(old_slot)%mdfrc_frame
+      bintraj_state%mdcrd_logical_steps = ckpt%slot_output(old_slot)%mdcrd_logical_steps
+      bintraj_state%mdcrd_time_origin_ps = ckpt%slot_output(old_slot)%mdcrd_time_origin_ps
+      bintraj_state%mdcrd_logical_time_ps = ckpt%slot_output(old_slot)%mdcrd_logical_time_ps
+      mgr%slot_segments_completed(new_slot) = &
+        ckpt%slot_output(old_slot)%mdcrd_logical_steps / ckpt%segment_steps
+    else
+      restart_slot = source_restart_slot(new_slot)
+      bintraj_state%mdcrd_time_origin_ps = ckpt%slot_output(restart_slot)%restart_time_ps
+      bintraj_state%mdcrd_logical_time_ps = ckpt%slot_output(restart_slot)%restart_time_ps
+      mgr%slot_segments_completed(new_slot) = 0
+    end if
+
+    io_ierr = AREX_IO_OK
+    io_message = ''
+    call arex_io_set_slot_bintraj_state(new_slot, bintraj_state, .false., io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+    call arex_io_set_slot_phmd_output_initialized(new_slot, &
+         arex_append .and. retained(new_slot) .and. &
+         ckpt%slot_output(source_old_slot(new_slot))%phmd_output_initialized, &
+         io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+
+    call arex_io_set_slot_restart_initialized(new_slot, .false., io_ierr, io_message)
+    if (io_ierr /= AREX_IO_OK) then
+      call arex_rst_set_status(ierr, message, AREX_RST_ERR_INVALID, trim(io_message))
+      return
+    end if
+  end do
+end subroutine arex_rst_apply_migration_output_state
+
+subroutine arex_rst_apply_payload_checkpoint_mapped(ckpt, source_old_replica, ierr, message)
+  type(arex_rst_checkpoint_t), intent(in) :: ckpt
