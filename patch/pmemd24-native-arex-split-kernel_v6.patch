+! Binary .lmb files use a short text header followed by raw one-byte frames.
+! The eight LF-terminated lines are: LMB1, ntitr, step0, stride, and the
+! four original PHMD header lines.  Each subsequent frame is ntitr bytes.
+! The number of frames is inferred from the remaining file length.
+subroutine phmd_output_filename(original_name, output_name)
+   implicit none
+   character(len=*), intent(in) :: original_name
+   character(len=*), intent(out) :: output_name
+   integer :: n
+
+   output_name = original_name
+   if (.not. lambda_binary_output) return
+   n = len_trim(original_name)
+   if (n .ge. 7) then
+      if (original_name(n-6:n) .eq. '.lambda') then
+         output_name = original_name(:n-7) // '.lmb'
+         return
+      end if
+   end if
+   if (n .ge. 4) then
+      if (original_name(n-3:n) .eq. '.lmb') return
+   end if
+   output_name = trim(original_name) // '.lmb'
+end subroutine phmd_output_filename
+
+subroutine phmd_open_lmb(filename, mode)
+   use file_io_dat_mod, only : phmdout_unit
+   implicit none
+   character(len=*), intent(in) :: filename, mode
+   integer :: nbytes
+
+   select case (mode)
+   case ('new')
+      open(unit=phmdout_unit, file=trim(filename), status='NEW', &
+           access='STREAM', form='UNFORMATTED')
+      lambda_header_written = .false.
+   case ('replace')
+      open(unit=phmdout_unit, file=trim(filename), status='REPLACE', &
+           access='STREAM', form='UNFORMATTED')
+      lambda_header_written = .false.
+   case ('append')
+      open(unit=phmdout_unit, file=trim(filename), status='OLD', &
+           access='STREAM', form='UNFORMATTED', position='APPEND')
+      inquire(unit=phmdout_unit, size=nbytes)
+      lambda_header_written = nbytes .gt. 0
+   end select
+end subroutine phmd_open_lmb
+
+subroutine phmd_write_lmb_header(first_step)
+   use file_io_dat_mod, only : phmdout_unit
+   implicit none
+   integer, intent(in) :: first_step
+   integer :: i
+   character(len=32) :: fmt00
+   character(len=20) :: fmt120
+   character(len=16+11*MAX_TITR_STATES) :: line
+
+   write(phmdout_unit) 'LMB1' // achar(10)
+   write(line,'(a,i0)') '# ntitr ', ntitr
+   write(phmdout_unit) trim(line) // achar(10)
+   write(line,'(a,i0)') '# step0 ', first_step
+   write(phmdout_unit) trim(line) // achar(10)
+   write(line,'(a,i0)') '# stride ', nprint_phmd
+   write(phmdout_unit) trim(line) // achar(10)
+
+   write(fmt00,'("(a,",i4,"(1x,i10))")') ntitr
+   write(fmt120,'("(a, ",i4,"(f8.3))")') ntitr
+   write(line,fmt00) '# ititr ', (i,i=1,ntitr)
+   write(phmdout_unit) trim(line) // achar(10)
+   write(line,fmt00) '#  ires ', (titrres(i),i=1,ntitr)
+   write(phmdout_unit) trim(line) // achar(10)
+   write(line,fmt00) '# itauto', (sp_grp(i),i=1,ntitr)
+   write(phmdout_unit) trim(line) // achar(10)
+   write(line,fmt120) '# ParK', (park(i),i=1,ntitr)
+   write(phmdout_unit) trim(line) // achar(10)
+end subroutine phmd_write_lmb_header
+
