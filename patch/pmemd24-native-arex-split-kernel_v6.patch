+!*******************************************************************************
+!
+! Subroutine:  pre_read_startup_mdin_ctrl_dat
+!
+! Description: Early mdin pre-read used only for startup decisions that must
+!              happen before setup_groups() finishes communicator formation.
+!              This routine must stay side-effect-light. The normal
+!              init_mdin_ctrl_dat() path remains authoritative later.
+!
+!*******************************************************************************
+
+subroutine pre_read_startup_mdin_ctrl_dat
+
+  use file_io_mod,      only : amopen, nmlsrc
+  use pmemd_lib_mod,    only : mexit
+
+  implicit none
+
+  integer :: ifind
+  integer :: ios
+
+  ! Safe defaults for the small set of controls consulted before the normal
+  ! full mdin initialization path runs.
+  arex = 0
+  arex_num_workers = 0
+  usemidpoint = .false.
+
+  call amopen(mdin, mdin_name, 'O', 'F', 'R')
+
+  rewind(mdin)
+  call nmlsrc('cntrl', mdin, ifind)
+
+  if (ifind .eq. 0) then
+    write(0,'(a)') 'pre_read_startup_mdin_ctrl_dat: Could not find cntrl namelist'
+    call mexit(6, 1)
+  end if
+
+  read(mdin, nml=cntrl, iostat=ios)
+  close(mdin)
+
+  if (ios .ne. 0) then
+    write(0,'(a,i0)') 'pre_read_startup_mdin_ctrl_dat: cntrl namelist read failed, iostat=', ios
+    call mexit(6, 1)
+  end if
+
+  return
+
+end subroutine pre_read_startup_mdin_ctrl_dat
