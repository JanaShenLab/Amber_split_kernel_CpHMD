+
+// -----------------------------------------------------------------------------
+// kPMEPHMDBuildNLEntryMask_kernel
+//
+// One thread scans one NLEntry.  This is intentionally simple because this mask
+// is built only after neighbor-list rebuilds and only in iphmd == 3 mode.
+//
+// Mask bits:
+//   PME_PHMD_NL_Y_HAS_PHMD
+//   PME_PHMD_NL_X_HAS_PHMD
+// -----------------------------------------------------------------------------
+
+__global__ void
+kPMEPHMDBuildNLEntryMask_kernel(const NLEntry* __restrict__ pNLEntry,
+                                const unsigned int* __restrict__ pNLAtomList,
+                                const unsigned int* __restrict__ pNLEntries,
+                                const int* __restrict__ pImageGrplist,
+                                unsigned int* __restrict__ pNLEntryPHMDMask,
+                                unsigned int* __restrict__ pNLEntryPHMDYAtomMask,
+                                unsigned int* __restrict__ pNLEntryPHMDList,
+                                unsigned int* __restrict__ pNLEntryPHMDCount,
+                                unsigned int* __restrict__ pNLAtomListPHMDMask,
+                                const unsigned int nlAtomsPerWarp)
+{
+  const unsigned int nentries = *pNLEntries;
+
+  for (unsigned int nlpos = blockIdx.x * blockDim.x + threadIdx.x;
+       nlpos < nentries;
+       nlpos += blockDim.x * gridDim.x) {
+
+    const NLEntry entry = pNLEntry[nlpos];
+
+    unsigned int flags = 0u;
+
+    // Scan y-side image atoms and preserve the per-lane PHMD mask.
+    const unsigned int ypos = entry.NL.ypos;
+    const unsigned int ymax = kPMEPHMDDecodeYMax(entry);
+    const unsigned int rawYCount = (ymax > ypos) ? (ymax - ypos) : 0u;
+    const unsigned int yCount =
+      (rawYCount < nlAtomsPerWarp) ? rawYCount : nlAtomsPerWarp;
+
+    unsigned int yPHMDMask = 0u;
+
+    for (unsigned int lane = 0u; lane < yCount; lane++) {
+      const unsigned int y = ypos + lane;
+      if (kPMEPHMDIsImageAtomPHMDRelevant(pImageGrplist, y)) {
+        yPHMDMask |= (1u << lane);
+      }
+    }
+
+    if (yPHMDMask != 0u) {
+      flags |= PME_PHMD_NL_Y_HAS_PHMD;
+    }
+
+    pNLEntryPHMDYAtomMask[nlpos] = yPHMDMask;
+
+    // Scan x-side atom records.
+    //
+    // kNLCPNE.h consumes pNLAtomList like this:
+    //
+    //   offset = entry.NL.offset;
+    //
+    //   if home-cell:
+    //     read first-tile exclusion block at offset
+    //     offset += nlAtomsPerWarp
+    //
+    //   for tx in xatoms by GRID:
+    //     atom records at offset ... offset + GRID - 1
+    //     offset += GRID
+    //     exclusion masks at offset
+    //     offset += nlAtomsPerWarp * sizeof(PMEMask) / sizeof(unsigned int)
+    //
+    unsigned int offset = entry.NL.offset;
+
+    if (kPMEPHMDEntryHasHomeCell(entry)) {
+      offset += nlAtomsPerWarp;
+    }
+
+    const unsigned int maskWords = kPMEPHMDMaskBlockWords(nlAtomsPerWarp);
+
+    for (unsigned int tx = 0; tx < entry.NL.xatoms; tx += GRID) {
+      const unsigned int swathOffset = offset;
+      const unsigned int atomsThisSwath =
+        ((entry.NL.xatoms - tx) < GRID) ? (entry.NL.xatoms - tx) : GRID;
+
+      unsigned int xPHMDMask = 0u;
+
+      for (unsigned int lane = 0; lane < atomsThisSwath; lane++) {
+        const unsigned int record = pNLAtomList[offset + lane];
+        const unsigned int atom = kPMEPHMDAtomFromNLAtomRecord(record);
+
+        if (kPMEPHMDIsImageAtomPHMDRelevant(pImageGrplist, atom)) {
+          xPHMDMask |= (1u << lane);
+        }
+      }
+
+      if (xPHMDMask != 0u) {
+        flags |= PME_PHMD_NL_X_HAS_PHMD;
+      }
+
+      pNLAtomListPHMDMask[swathOffset] = xPHMDMask;
+
+      offset += GRID;
+      offset += maskWords;
+    }
+    pNLEntryPHMDMask[nlpos] = flags;
+
+    if (flags != 0u) {
+      const unsigned int slot = atomicAdd(pNLEntryPHMDCount, 1u);
+      pNLEntryPHMDList[slot] = nlpos;
+    }
+  }
+}
+
+// -----------------------------------------------------------------------------
+// Diagnostics
+// -----------------------------------------------------------------------------
+
+enum {
+  PME_PHMD_DIAG_TOTAL_ENTRIES = 0,
+  PME_PHMD_DIAG_MASKED_ENTRIES = 1,
+  PME_PHMD_DIAG_Y_ENTRIES = 2,
+  PME_PHMD_DIAG_X_ENTRIES = 3,
+  PME_PHMD_DIAG_BOTH_ENTRIES = 4,
+
+  PME_PHMD_DIAG_Y_ONLY_ENTRIES = 5,
+  PME_PHMD_DIAG_X_ONLY_ENTRIES = 6,
+
+  PME_PHMD_DIAG_HOME_ENTRIES = 7,
+  PME_PHMD_DIAG_HOME_MASKED_ENTRIES = 8,
+  PME_PHMD_DIAG_HOME_Y_ENTRIES = 9,
+  PME_PHMD_DIAG_HOME_MASKED_NO_Y_ENTRIES = 10,
+
+  // Deeper diagnostics over entries that the direct correction kernel actually visits.
+  PME_PHMD_DIAG_MASKED_Y_ATOMS = 11,
+  PME_PHMD_DIAG_MASKED_Y_PHMD_ATOMS = 12,
+  PME_PHMD_DIAG_MASKED_X_ATOMS = 13,
+  PME_PHMD_DIAG_MASKED_X_PHMD_ATOMS = 14,
+
+  PME_PHMD_DIAG_MASKED_X_SWATHS = 15,
+  PME_PHMD_DIAG_MASKED_X_SWATHS_WITH_X_PHMD = 16,
+  PME_PHMD_DIAG_MASKED_X_SWATHS_NO_X_PHMD = 17,
+
+  PME_PHMD_DIAG_X_ONLY_X_SWATHS = 18,
+  PME_PHMD_DIAG_X_ONLY_X_SWATHS_WITH_X_PHMD = 19,
+  PME_PHMD_DIAG_X_ONLY_X_SWATHS_NO_X_PHMD = 20,
+
+  PME_PHMD_DIAG_HOME_PAIR_CANDIDATES = 21,
+  PME_PHMD_DIAG_HOME_PAIR_PHMD_RELEVANT = 22,
+
+  PME_PHMD_DIAG_X_PAIR_CANDIDATES = 23,
+  PME_PHMD_DIAG_X_PAIR_PHMD_RELEVANT = 24,
+
+  PME_PHMD_DIAG_X_ONLY_PAIR_CANDIDATES = 25,
+  PME_PHMD_DIAG_X_ONLY_PAIR_PHMD_RELEVANT = 26,
+
+  PME_PHMD_DIAG_COUNT = 27
+};
+
+__global__ void
+kPMEPHMDMaskDiagnostics_kernel(const NLEntry* __restrict__ pNLEntry,
+                               const unsigned int* __restrict__ pNLAtomList,
+                               const unsigned int* __restrict__ pNLEntries,
+                               const int* __restrict__ pImageGrplist,
+                               const unsigned int* __restrict__ pNLEntryPHMDMask,
+                               unsigned long long* __restrict__ pCounts,
+                               const unsigned int nlAtomsPerWarp)
+{
+  const unsigned int nentries = *pNLEntries;
+  const unsigned int maskWords = kPMEPHMDMaskBlockWords(nlAtomsPerWarp);
+
+  for (unsigned int nlpos = blockIdx.x * blockDim.x + threadIdx.x;
+       nlpos < nentries;
+       nlpos += blockDim.x * gridDim.x) {
+
+    const NLEntry entry = pNLEntry[nlpos];
+    const unsigned int mask = pNLEntryPHMDMask[nlpos];
+
+    const bool yHasPHMD = (mask & PME_PHMD_NL_Y_HAS_PHMD) != 0u;
+    const bool xHasPHMD = (mask & PME_PHMD_NL_X_HAS_PHMD) != 0u;
+    const bool masked = (mask != 0u);
+    const bool home = (kPMEPHMDEntryHasHomeCell(entry) != 0u);
+
+    atomicAdd(&pCounts[PME_PHMD_DIAG_TOTAL_ENTRIES], 1ull);
+
+    if (masked) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_ENTRIES], 1ull);
+    }
+    if (yHasPHMD) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_Y_ENTRIES], 1ull);
+    }
+    if (xHasPHMD) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_X_ENTRIES], 1ull);
+    }
+    if (yHasPHMD && xHasPHMD) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_BOTH_ENTRIES], 1ull);
+    }
+    if (yHasPHMD && !xHasPHMD) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_Y_ONLY_ENTRIES], 1ull);
+    }
+    if (xHasPHMD && !yHasPHMD) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_ENTRIES], 1ull);
+    }
+
+    if (home) {
+      atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_ENTRIES], 1ull);
+      if (masked) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_MASKED_ENTRIES], 1ull);
+      }
+      if (masked && yHasPHMD) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_Y_ENTRIES], 1ull);
+      }
+      if (masked && !yHasPHMD) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_MASKED_NO_Y_ENTRIES], 1ull);
+      }
+    }
+
+    // The deeper diagnostics below are only for entries visited by
+    // kPMEPHMDDirectCorrections16_kernel.
+    if (!masked) {
+      continue;
+    }
+
+    const unsigned int ypos = entry.NL.ypos;
+    const unsigned int ymax = kPMEPHMDDecodeYMax(entry);
+    const unsigned int rawYCount = (ymax > ypos) ? (ymax - ypos) : 0u;
+    const unsigned int yCount =
+      (rawYCount < nlAtomsPerWarp) ? rawYCount : nlAtomsPerWarp;
+
+    unsigned int yPHMDMask = 0u;
+    unsigned int yPHMDCount = 0u;
+
+    for (unsigned int lane = 0u; lane < yCount; lane++) {
+      const unsigned int yAtom = ypos + lane;
+      if (kPMEPHMDIsImageAtomPHMDRelevant(pImageGrplist, yAtom)) {
+        yPHMDMask |= (1u << lane);
+        yPHMDCount++;
+      }
+    }
+
+    atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_Y_ATOMS],
+              static_cast<unsigned long long>(yCount));
+    atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_Y_PHMD_ATOMS],
+              static_cast<unsigned long long>(yPHMDCount));
+
+    if (home) {
+      const unsigned long long homePairs =
+        static_cast<unsigned long long>(yCount) *
+        static_cast<unsigned long long>((yCount > 0u) ? (yCount - 1u) : 0u) /
+        2ull;
+
+      const unsigned int nonPHMDYCount = yCount - yPHMDCount;
+      const unsigned long long nonPHMDHomePairs =
+        static_cast<unsigned long long>(nonPHMDYCount) *
+        static_cast<unsigned long long>((nonPHMDYCount > 0u) ? (nonPHMDYCount - 1u) : 0u) /
+        2ull;
+
+      const unsigned long long relevantHomePairs =
+        homePairs - nonPHMDHomePairs;
+
+      atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_PAIR_CANDIDATES], homePairs);
+      atomicAdd(&pCounts[PME_PHMD_DIAG_HOME_PAIR_PHMD_RELEVANT],
+                relevantHomePairs);
+    }
+
+    unsigned int offset = entry.NL.offset;
+    if (home) {
+      offset += nlAtomsPerWarp;
+    }
+
+    for (unsigned int tx = 0u; tx < entry.NL.xatoms; tx += GRID) {
+      const unsigned int remaining = entry.NL.xatoms - tx;
+      const unsigned int xCount = (remaining < GRID) ? remaining : GRID;
+
+      unsigned int xPHMDCount = 0u;
+
+      for (unsigned int lane = 0u; lane < xCount; lane++) {
+        const unsigned int record = pNLAtomList[offset + lane];
+        const unsigned int atom = kPMEPHMDAtomFromNLAtomRecord(record);
+
+        if (kPMEPHMDIsImageAtomPHMDRelevant(pImageGrplist, atom)) {
+          xPHMDCount++;
+        }
+      }
+
+      const bool swathHasXPHMD = (xPHMDCount > 0u);
+
+      atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_X_SWATHS], 1ull);
+      if (swathHasXPHMD) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_X_SWATHS_WITH_X_PHMD], 1ull);
+      }
+      else {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_X_SWATHS_NO_X_PHMD], 1ull);
+      }
+
+      if (xHasPHMD && !yHasPHMD) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS], 1ull);
+        if (swathHasXPHMD) {
+          atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS_WITH_X_PHMD], 1ull);
+        }
+        else {
+          atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS_NO_X_PHMD], 1ull);
+        }
+      }
+
+      atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_X_ATOMS],
+                static_cast<unsigned long long>(xCount));
+      atomicAdd(&pCounts[PME_PHMD_DIAG_MASKED_X_PHMD_ATOMS],
+                static_cast<unsigned long long>(xPHMDCount));
+
+      const unsigned long long xPairs =
+        static_cast<unsigned long long>(yCount) *
+        static_cast<unsigned long long>(xCount);
+
+      // Logical pair relevance:
+      //   relevant if y atom is PHMD OR x atom is PHMD.
+      //
+      // Count without double-counting pairs where both sides are PHMD:
+      //   relevant = yPHMDCount*xCount + nonPHMDYCount*xPHMDCount
+      const unsigned int nonPHMDYCount = yCount - yPHMDCount;
+      const unsigned long long relevantXPairs =
+        static_cast<unsigned long long>(yPHMDCount) *
+        static_cast<unsigned long long>(xCount) +
+        static_cast<unsigned long long>(nonPHMDYCount) *
+        static_cast<unsigned long long>(xPHMDCount);
+
+      atomicAdd(&pCounts[PME_PHMD_DIAG_X_PAIR_CANDIDATES], xPairs);
+      atomicAdd(&pCounts[PME_PHMD_DIAG_X_PAIR_PHMD_RELEVANT],
+                relevantXPairs);
+
+      if (xHasPHMD && !yHasPHMD) {
+        atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_PAIR_CANDIDATES], xPairs);
+        atomicAdd(&pCounts[PME_PHMD_DIAG_X_ONLY_PAIR_PHMD_RELEVANT],
+                  relevantXPairs);
+      }
+
+      offset += GRID;
+      offset += maskWords;
+    }
+  }
+}
+
+// -----------------------------------------------------------------------------
+// Host launch helpers
+// -----------------------------------------------------------------------------
+
+static inline unsigned int kPMEPHMDChooseBlocks(const unsigned int nitems,
+                                                const unsigned int threads)
+{
+  if (nitems == 0u) {
+    return 1u;
+  }
+
+  unsigned int blocks = (nitems + threads - 1u) / threads;
+
+  // Keep this modest.  Both mask build and diagnostics are lightweight compared
+  // with force kernels, and excessive blocks can add overhead.
+  if (blocks > 1024u) {
+    blocks = 1024u;
+  }
+  if (blocks == 0u) {
+    blocks = 1u;
+  }
+
+  return blocks;
+}
+
+// -----------------------------------------------------------------------------
+// Public host API
+// -----------------------------------------------------------------------------
+
+extern "C" void
+kPMEPHMDBuildNLEntryMask(gpuContext gpu)
+{
+  if (gpu == nullptr) {
+    return;
+  }
+
+  if (gpu->iphmd != 3) {
+    return;
+  }
+
+  if (gpu->sim.pNLEntryPHMDMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: pNLEntryPHMDMask is null. "
+                 "Did you add and allocate pbNLEntryPHMDMask?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDYAtomMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: pNLEntryPHMDYAtomMask is null. "
+                 "Did you add and allocate pbNLEntryPHMDYAtomMask?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDList == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: pNLEntryPHMDList is null. "
+                 "Did you add and allocate pbNLEntryPHMDList?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDCount == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: pNLEntryPHMDCount is null. "
+                 "Did you add and allocate pbNLEntryPHMDCount?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLAtomListPHMDMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: pNLAtomListPHMDMask is null. "
+                 "Did you add and allocate pbNLAtomListPHMDMask?\n");
+    std::abort();
+  }
+
+  const unsigned int threads = PME_PHMD_DIAG_THREADS_PER_BLOCK;
+
+  // We do not want to copy pNLEntries to the host just to size the launch.
+  // NLMaxEntries is an upper bound, and the kernel uses *pNLEntries internally.
+  const unsigned int blocks =
+    kPMEPHMDChooseBlocks(static_cast<unsigned int>(gpu->sim.NLMaxEntries),
+                         threads);
+
+  cudaError_t status =
+    cudaMemset(gpu->sim.pNLEntryPHMDCount, 0, sizeof(unsigned int));
+
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDBuildNLEntryMask: cudaMemset pNLEntryPHMDCount failed: %s\n",
+                 cudaGetErrorString(status));
+    std::abort();
+  }
+
+  kPMEPHMDBuildNLEntryMask_kernel<<<blocks, threads>>>(
+   gpu->sim.pNLEntry,
+   gpu->sim.pNLAtomList,
+   gpu->sim.pNLEntries,
+   gpu->sim.pImageGrplist,
+   gpu->sim.pNLEntryPHMDMask,
+   gpu->sim.pNLEntryPHMDYAtomMask,
+   gpu->sim.pNLEntryPHMDList,
+   gpu->sim.pNLEntryPHMDCount,
+   gpu->sim.pNLAtomListPHMDMask,
+   gpu->sim.NLAtomsPerWarp);
+
+  LAUNCHERROR("kPMEPHMDBuildNLEntryMask");
+
+#if defined(PME_PHMD_COMPARE_DIRECT) && PME_PHMD_COMPARE_MASK_DIAGNOSTICS
+  kPMEPHMDMaskDiagnostics(gpu);
+#endif
+}
+
+extern "C" void
+kPMEPHMDMaskDiagnostics(gpuContext gpu)
+{
+  if (gpu == nullptr) {
+    return;
+  }
+
+  if (gpu->iphmd != 3) {
+    std::printf("kPMEPHMDMaskDiagnostics: iphmd != 3; no PHMD PME mask active.\n");
+    return;
+  }
+
+  if (gpu->sim.pNLEntryPHMDMask == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pNLEntryPHMDMask is null. "
+                 "Did you add and allocate pbNLEntryPHMDMask?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDList == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pNLEntryPHMDList is null. "
+                 "Did you add and allocate pbNLEntryPHMDList?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntryPHMDCount == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pNLEntryPHMDCount is null. "
+                 "Did you add and allocate pbNLEntryPHMDCount?\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLAtomList == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pNLAtomList is null.\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pNLEntries == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pNLEntries is null.\n");
+    std::abort();
+  }
+
+  if (gpu->sim.pImageGrplist == nullptr) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: pImageGrplist is null.\n");
+    std::abort();
+  }
+
+  unsigned long long* dCounts = nullptr;
+  unsigned long long hCounts[PME_PHMD_DIAG_COUNT];
+
+  std::memset(hCounts, 0, sizeof(hCounts));
+
+  cudaError_t status = cudaMalloc(reinterpret_cast<void**>(&dCounts),
+                                  PME_PHMD_DIAG_COUNT * sizeof(unsigned long long));
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: cudaMalloc failed: %s\n",
+                 cudaGetErrorString(status));
+    std::abort();
+  }
+
+  status = cudaMemset(dCounts, 0, PME_PHMD_DIAG_COUNT * sizeof(unsigned long long));
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: cudaMemset failed: %s\n",
+                 cudaGetErrorString(status));
+    cudaFree(dCounts);
+    std::abort();
+  }
+
+  const unsigned int threads = PME_PHMD_DIAG_THREADS_PER_BLOCK;
+  const unsigned int blocks =
+    kPMEPHMDChooseBlocks(static_cast<unsigned int>(gpu->sim.NLMaxEntries),
+                         threads);
+
+  kPMEPHMDMaskDiagnostics_kernel<<<blocks, threads>>>(
+    gpu->sim.pNLEntry,
+    gpu->sim.pNLAtomList,
+    gpu->sim.pNLEntries,
+    gpu->sim.pImageGrplist,
+    gpu->sim.pNLEntryPHMDMask,
+    dCounts,
+    gpu->sim.NLAtomsPerWarp
+  );
+
+  LAUNCHERROR("kPMEPHMDMaskDiagnostics_kernel");
+
+  status = cudaMemcpy(hCounts,
+                      dCounts,
+                      PME_PHMD_DIAG_COUNT * sizeof(unsigned long long),
+                      cudaMemcpyDeviceToHost);
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDMaskDiagnostics: cudaMemcpy failed: %s\n",
+                 cudaGetErrorString(status));
+    cudaFree(dCounts);
+    std::abort();
+  }
+
+  cudaFree(dCounts);
+
+  const unsigned long long total =
+    hCounts[PME_PHMD_DIAG_TOTAL_ENTRIES];
+  const unsigned long long masked =
+    hCounts[PME_PHMD_DIAG_MASKED_ENTRIES];
+
+  const unsigned long long homeMasked =
+    hCounts[PME_PHMD_DIAG_HOME_MASKED_ENTRIES];
+  const unsigned long long homeMaskedNoY =
+    hCounts[PME_PHMD_DIAG_HOME_MASKED_NO_Y_ENTRIES];
+
+  const unsigned long long maskedXSwaths =
+    hCounts[PME_PHMD_DIAG_MASKED_X_SWATHS];
+  const unsigned long long maskedXSwathsWithXPHMD =
+    hCounts[PME_PHMD_DIAG_MASKED_X_SWATHS_WITH_X_PHMD];
+  const unsigned long long maskedXSwathsNoXPHMD =
+    hCounts[PME_PHMD_DIAG_MASKED_X_SWATHS_NO_X_PHMD];
+
+  const unsigned long long xOnlyXSwaths =
+    hCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS];
+  const unsigned long long xOnlyXSwathsWithXPHMD =
+    hCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS_WITH_X_PHMD];
+  const unsigned long long xOnlyXSwathsNoXPHMD =
+    hCounts[PME_PHMD_DIAG_X_ONLY_X_SWATHS_NO_X_PHMD];
+
+  const unsigned long long homePairs =
+    hCounts[PME_PHMD_DIAG_HOME_PAIR_CANDIDATES];
+  const unsigned long long homeRelevantPairs =
+    hCounts[PME_PHMD_DIAG_HOME_PAIR_PHMD_RELEVANT];
