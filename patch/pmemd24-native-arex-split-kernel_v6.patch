+  const unsigned long long xPairs =
+    hCounts[PME_PHMD_DIAG_X_PAIR_CANDIDATES];
+  const unsigned long long xRelevantPairs =
+    hCounts[PME_PHMD_DIAG_X_PAIR_PHMD_RELEVANT];
+
+  const unsigned long long xOnlyPairs =
+    hCounts[PME_PHMD_DIAG_X_ONLY_PAIR_CANDIDATES];
+  const unsigned long long xOnlyRelevantPairs =
+    hCounts[PME_PHMD_DIAG_X_ONLY_PAIR_PHMD_RELEVANT];
+
+  const unsigned long long totalPairs = homePairs + xPairs;
+  const unsigned long long totalRelevantPairs = homeRelevantPairs + xRelevantPairs;
+
+  const double maskedFraction =
+    (total > 0ull) ? static_cast<double>(masked) / static_cast<double>(total) : 0.0;
+
+  const double homeSkipFraction =
+    (homeMasked > 0ull) ?
+    static_cast<double>(homeMaskedNoY) / static_cast<double>(homeMasked) : 0.0;
+
+  const double maskedXSwathAnyXFraction =
+    (maskedXSwaths > 0ull) ?
+    static_cast<double>(maskedXSwathsWithXPHMD) /
+    static_cast<double>(maskedXSwaths) : 0.0;
+
+  const double xOnlySwathSkipFraction =
+    (xOnlyXSwaths > 0ull) ?
+    static_cast<double>(xOnlyXSwathsNoXPHMD) /
+    static_cast<double>(xOnlyXSwaths) : 0.0;
+
+  const double homeRelevantPairFraction =
+    (homePairs > 0ull) ?
+    static_cast<double>(homeRelevantPairs) / static_cast<double>(homePairs) : 0.0;
+
+  const double xRelevantPairFraction =
+    (xPairs > 0ull) ?
+    static_cast<double>(xRelevantPairs) / static_cast<double>(xPairs) : 0.0;
+
+  const double xOnlyRelevantPairFraction =
+    (xOnlyPairs > 0ull) ?
+    static_cast<double>(xOnlyRelevantPairs) / static_cast<double>(xOnlyPairs) : 0.0;
+
+  const double totalRelevantPairFraction =
+    (totalPairs > 0ull) ?
+    static_cast<double>(totalRelevantPairs) / static_cast<double>(totalPairs) : 0.0;
+
+  std::printf("PME-PHMD NLEntry mask diagnostics:\n");
+  std::printf("  total NLEntries:        %llu\n", total);
+  std::printf("  PHMD-masked NLEntries:  %llu\n", masked);
+  std::printf("  masked fraction:        %.6f\n", maskedFraction);
+
+  std::printf("  y-side PHMD entries:    %llu\n",
+              hCounts[PME_PHMD_DIAG_Y_ENTRIES]);
+  std::printf("  x-side PHMD entries:    %llu\n",
