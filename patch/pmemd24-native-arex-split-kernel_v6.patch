diff --git a/src/pmemd/src/arex_arm.F90 b/src/pmemd/src/arex_arm.F90
new file mode 100644
index 0000000..34e5072
--- /dev/null
+++ b/src/pmemd/src/arex_arm.F90
@@ -0,0 +1,2334 @@
+!*******************************************************************************
+! Module: arex_arm_mod
+!
+! ARM = Asynchronous Replica Manager
+!
+! Purpose
+! -------
+! This module is the generic async scheduler core for native replica exchange in
+! PMEMD. It is intentionally generic: the manager owns scheduling, worker state,
+! replica/slot bookkeeping, exchange epoch/parity bookkeeping, and manager-side
+! checkpoint metadata. Payload-specific state and exchange math live behind a
+! fixed callback table supplied by a payload module.
+!
+! Current contract locked in
+! --------------------------
+! 1. Fixed-length segment execution.
+! 2. Oversubscribed asynchronous scheduling across a smaller worker pool.
+! 3. Exchange attempts only at segment boundaries.
+! 4. Wrapper-equivalent odd/even nearest-neighbor exchange schedule.
+! 5. Exchange updates slot/replica mapping rather than requiring physical
+!    coordinate swaps as the primary abstraction whenever that is equivalent.
+! 6. Generic physical continuation state is restored/captured here for the live
+!    PMEMD MD arrays. Forces, neighbor lists, and other runtime caches remain
+!    rebuildable runtime state by design.
+!
+! What this file is COMPLETE for
+! ------------------------------
+! - manager data model
+! - worker / replica / slot bookkeeping
+! - epoch/parity bookkeeping
+! - pair-local exchange resolution logic
+! - payload callback API
+! - common physical MD-state bridge for:
+!     * atm_crd
+!     * atm_vel
+!     * atm_last_vel
+!     * box lengths / angles metadata capture
+!     * bounded same-shape/common-scale box restore using the existing PMEMD
+!       scale/update path
+!     * CUDA upload/download hooks and neighbor-list invalidation
+! - manager metadata checkpoint stub
+!
+! What this file intentionally does NOT finish yet
+! -----------------------------------------------
+! - initial seeding of per-replica snapshots before first assignment
+! - full logical run-history bridge from runmd host-side counters/averages
+! - arbitrary absolute box restore with changed shape/angles
+! - payload-specific restore/capture logic
+! - final checkpoint file format
+! - input parsing / top-level pmemd integration
+!
+! Notes
+! -----
+! 1. If a replica snapshot is not yet valid, the common restore path is a no-op.
+!    This preserves whatever live state the worker already holds, which is the
+!    current safe behavior until top-level initial seeding is finished.
+! 2. The first real payload is PHREX/CpHMD. Payload-owned state such as
+!    ph_theta, vph_theta, iupdate, dphold, and vphold stays in the payload
+!    module, not here.
+!*******************************************************************************
+
+module arex_arm_mod
+
+  use iso_fortran_env, only : int32, real64
+  use get_cmdline_mod, only : arex_output_directory
+
+  implicit none
+  private
+
+  !--------------------------------------------------------------------------
+  ! Public constants
+  !--------------------------------------------------------------------------
+
+  integer, parameter, public :: dp = real64
+
+  integer, parameter, public :: ARM_OK                  = 0
+  integer, parameter, public :: ARM_ERR_INVALID         = 1
+  integer, parameter, public :: ARM_ERR_ALLOC           = 2
+  integer, parameter, public :: ARM_ERR_NOT_READY       = 3
+  integer, parameter, public :: ARM_ERR_NOT_IMPLEMENTED = 4
+  integer, parameter, public :: ARM_ERR_PAYLOAD         = 5
+
+  integer, parameter, public :: ARM_REPLICA_IDLE     = 0
+  integer, parameter, public :: ARM_REPLICA_QUEUED   = 1
+  integer, parameter, public :: ARM_REPLICA_RUNNING  = 2
+  integer, parameter, public :: ARM_REPLICA_COMPLETE = 3
+
+  integer, parameter, public :: ARM_WORKER_IDLE = 0
+  integer, parameter, public :: ARM_WORKER_BUSY = 1
+
+  integer, parameter, public :: ARM_PARITY_EVEN = 0
+  integer, parameter, public :: ARM_PARITY_ODD  = 1
+
+  !--------------------------------------------------------------------------
+  ! Generic physical MD continuation snapshot.
+  !
+  ! This manager-side container now bridges the common physical continuation
+  ! state that we can round-trip generically:
+  !   - coordinates
+  !   - velocities
+  !   - previous-step velocities
+  !   - box lengths / angles metadata
+  !
+  ! Forces are intentionally not part of the required continuation state here;
+  ! they are rebuildable runtime state.
+  !
+  ! The time field remains reserved for a later logical run-history bridge.
+  ! It is not yet populated/restored by the common bridge implemented here.
+  !--------------------------------------------------------------------------
+
+  type, public :: arm_md_snapshot_t
+    logical :: allocated = .false.
+    logical :: valid     = .false.
+    integer :: natom     = 0
+
+    real(dp), allocatable :: crd(:,:)      ! (3, natom)
+    real(dp), allocatable :: vel(:,:)      ! (3, natom)
+    real(dp), allocatable :: last_vel(:,:) ! (3, natom)
+
+    real(dp) :: box(3) = 0.0_dp
+    real(dp) :: alpha  = 0.0_dp
+    real(dp) :: beta   = 0.0_dp
+    real(dp) :: gamma  = 0.0_dp
+    real(dp) :: time   = 0.0_dp
+  end type arm_md_snapshot_t
+
+  !--------------------------------------------------------------------------
+  ! Payload callback interfaces.
+  !
+  ! The payload module owns payload-specific state and exchange math.
+  ! ARM passes replica/slot/worker IDs and expects the payload module to use
+  ! those IDs to access its own stored state.
+  !--------------------------------------------------------------------------
+  abstract interface
+
+    subroutine arm_payload_initialize_iface(nreplicas, nslots, ierr, message)
+      import
+      integer, intent(in) :: nreplicas
+      integer, intent(in) :: nslots
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_initialize_iface
+
+    subroutine arm_payload_finalize_iface(ierr, message)
+      import
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_finalize_iface
+
+    subroutine arm_payload_restore_to_worker_iface(replica_id, slot_id, worker_id, ierr, message)
+      import
+      integer, intent(in) :: replica_id
+      integer, intent(in) :: slot_id
+      integer, intent(in) :: worker_id
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_restore_to_worker_iface
+
+    subroutine arm_payload_capture_from_worker_iface(replica_id, slot_id, worker_id, ierr, message)
+      import
+      integer, intent(in) :: replica_id
+      integer, intent(in) :: slot_id
+      integer, intent(in) :: worker_id
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_capture_from_worker_iface
+
+    subroutine arm_payload_evaluate_exchange_iface(replica_a, slot_a, replica_b, slot_b, accept, ierr, message)
+      import
+      integer, intent(in) :: replica_a
+      integer, intent(in) :: slot_a
+      integer, intent(in) :: replica_b
+      integer, intent(in) :: slot_b
+      logical, intent(out) :: accept
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_evaluate_exchange_iface
+
+    subroutine arm_payload_post_exchange_iface(replica_a, old_slot_a, new_slot_a, &
+                                               replica_b, old_slot_b, new_slot_b, &
+                                               ierr, message)
+      import
+      integer, intent(in) :: replica_a
+      integer, intent(in) :: old_slot_a
+      integer, intent(in) :: new_slot_a
+      integer, intent(in) :: replica_b
+      integer, intent(in) :: old_slot_b
+      integer, intent(in) :: new_slot_b
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_post_exchange_iface
+
+    subroutine arm_payload_checkpoint_iface(replica_id, slot_id, unitno, ierr, message)
+      import
+      integer, intent(in) :: replica_id
+      integer, intent(in) :: slot_id
+      integer, intent(in) :: unitno
+      integer, intent(out) :: ierr
+      character(len=*), intent(out) :: message
+    end subroutine arm_payload_checkpoint_iface
+
+  end interface
+
+  !--------------------------------------------------------------------------
+  ! Payload callback table
+  !--------------------------------------------------------------------------
+  type, public :: arm_payload_api_t
+    procedure(arm_payload_initialize_iface),        pointer, nopass :: initialize          => null()
+    procedure(arm_payload_finalize_iface),          pointer, nopass :: finalize            => null()
+    procedure(arm_payload_restore_to_worker_iface), pointer, nopass :: restore_to_worker   => null()
+    procedure(arm_payload_capture_from_worker_iface), pointer, nopass :: capture_from_worker => null()
+    procedure(arm_payload_evaluate_exchange_iface), pointer, nopass :: evaluate_exchange   => null()
+    procedure(arm_payload_post_exchange_iface),     pointer, nopass :: post_exchange       => null()
+    procedure(arm_payload_checkpoint_iface),        pointer, nopass :: checkpoint_replica  => null()
+  end type arm_payload_api_t
+
+  !--------------------------------------------------------------------------
+  ! Worker-side metadata
+  !--------------------------------------------------------------------------
+  type, public :: arm_worker_state_t
+    integer :: worker_id          = 0
+    integer :: status             = ARM_WORKER_IDLE
+    integer :: active_replica_id  = 0
+    integer :: active_slot_id     = 0
+    integer :: completed_segments = 0
+  end type arm_worker_state_t
+
+  !--------------------------------------------------------------------------
+  ! Replica-side metadata.
+  !
+  ! The MD snapshot belongs to the logical continuation state. Slot ownership is
+  ! tracked separately so accepted exchanges can be implemented as mapping swaps.
+  !--------------------------------------------------------------------------
+  type, public :: arm_replica_state_t
+    integer :: replica_id              = 0
+    integer :: replica_uid             = 0
+    integer :: parent_uid              = 0
+    integer :: slot_id                 = 0
+    integer :: status                  = ARM_REPLICA_IDLE
+    integer :: assigned_worker_id      = 0
+
+    integer :: segments_completed      = 0
+    integer :: completed_epoch         = 0
+    integer :: exchange_resolved_epoch = 0
+
+    type(arm_md_snapshot_t) :: md
+  end type arm_replica_state_t
+
+  !--------------------------------------------------------------------------
+  ! Top-level manager
+  !--------------------------------------------------------------------------
+  type, public :: arm_manager_t
+    logical :: initialized         = .false.
+    logical :: payload_registered  = .false.
+
+    integer :: natom               = 0
+    integer :: nreplicas           = 0
+    integer :: nslots              = 0
+    integer :: nworkers            = 0
+    integer :: next_replica_uid    = 1
+    integer :: segments_per_replica = 0
+
+    integer :: epoch               = 0
+    integer :: current_parity      = ARM_PARITY_EVEN
+
+    integer :: exchange_history_unit       = -1
+    logical :: exchange_history_open       = .false.
+    integer :: exchange_history_last_epoch = -1
+    integer :: history_generation          = 0
+
+    ! slot_owner(slot_id) = replica_id currently occupying that condition slot.
+    integer, allocatable :: slot_owner(:)
+
+    ! Slot-owned output progress. This must follow the fixed pH/condition slot,
+    ! not the logical replica currently occupying that slot.
+    integer, allocatable :: slot_segments_completed(:)
+
+    ! replica_id whose most recent completed physical state is stored in each
+    ! slot-owned standard restart file. This can differ from slot_owner after
+    ! an accepted exchange and is part of the exact continuation contract.
+    integer, allocatable :: slot_restart_owner(:)
+    integer, allocatable :: slot_restart_replica_segments(:)
+
+    type(arm_replica_state_t), allocatable :: replicas(:)
+    type(arm_worker_state_t),  allocatable :: workers(:)
+
+    type(arm_payload_api_t) :: payload
+  end type arm_manager_t
+
+  public :: arm_manager_init
+  public :: arm_manager_finalize
+  public :: arm_set_segments_per_replica
+  public :: arm_campaign_complete
+  public :: arm_register_payload
+  public :: arm_seed_initial_snapshots
+  public :: arm_begin_epoch
+  public :: arm_next_ready_replica
+  public :: arm_assign_replica_to_worker
+  public :: arm_mark_segment_complete
+  public :: arm_try_resolve_ready_exchanges
+  public :: arm_epoch_complete
+  public :: arm_restart_set_ready
+  public :: arm_write_exchange_history
+  public :: arm_write_migration_history
+  public :: arm_partner_slot
+  public :: arm_swap_slot_occupants
+  public :: arm_checkpoint_metadata
+  public :: arm_snapshot_allocate
+  public :: arm_snapshot_deallocate
+  public :: arm_capture_common_md_state
+  public :: arm_restore_common_md_state
+  public :: arm_emulate_common_restart_boundary
+
+contains
+
+!===============================================================================
+! Internal helper: set status/message
+!===============================================================================
+subroutine arm_set_status(ierr, message, code, text)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer, intent(in) :: code
+  character(len=*), intent(in) :: text
+
+  ierr = code
+  if (len(message) > 0) message = text
+end subroutine arm_set_status
+
+!===============================================================================
+! Capture the common physical MD continuation state from the live PMEMD arrays.
+!
+! Current scope:
+! - atm_crd
+! - atm_vel
+! - atm_last_vel
+! - pbc_box / pbc_alpha / pbc_beta / pbc_gamma
+!
+! Not yet bridged here:
+! - logical run-history time/counters from runmd
+! - payload-specific state
+!===============================================================================
+subroutine arm_capture_common_md_state(snapshot, ierr, message)
+  use inpcrd_dat_mod, only : atm_crd, atm_vel, atm_last_vel
+  use pbc_mod, only : pbc_box, pbc_alpha, pbc_beta, pbc_gamma
+  use mdin_ctrl_dat_mod, only : t
+
+  type(arm_md_snapshot_t), intent(inout) :: snapshot
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+#ifdef CUDA
+  interface
+    subroutine gpu_download_crd(atm_crd)
+      import dp
+      real(dp), intent(out) :: atm_crd(3,*)
+    end subroutine gpu_download_crd
+
+    subroutine gpu_download_vel(atm_vel)
+      import dp
+      real(dp), intent(out) :: atm_vel(3,*)
+    end subroutine gpu_download_vel
+
+    subroutine gpu_download_last_vel(atm_last_vel)
+      import dp
+      real(dp), intent(out) :: atm_last_vel(3,*)
+    end subroutine gpu_download_last_vel
+  end interface
+#endif
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. snapshot%allocated) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_capture_common_md_state: snapshot is not allocated')
+    return
+  end if
+
+  if (.not. allocated(atm_crd) .or. .not. allocated(atm_vel) .or. &
+      .not. allocated(atm_last_vel)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_capture_common_md_state: live PMEMD MD arrays are not allocated')
+    return
+  end if
+
+  if (size(atm_crd,1) /= 3 .or. size(atm_vel,1) /= 3 .or. &
+      size(atm_last_vel,1) /= 3) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_capture_common_md_state: live PMEMD MD arrays have invalid leading dimension')
+    return
+  end if
+
+  if (size(atm_crd,2) /= snapshot%natom .or. &
+      size(atm_vel,2) /= snapshot%natom .or. &
+      size(atm_last_vel,2) /= snapshot%natom) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_capture_common_md_state: live PMEMD MD array sizes do not match snapshot natom')
+    return
+  end if
+
+#ifdef CUDA
+  call gpu_download_crd(atm_crd)
+  call gpu_download_vel(atm_vel)
+  call gpu_download_last_vel(atm_last_vel)
+#endif
+
+  snapshot%crd      = atm_crd
+  snapshot%vel      = atm_vel
+  snapshot%last_vel = atm_last_vel
+
+  snapshot%box   = pbc_box
+  snapshot%alpha = pbc_alpha
+  snapshot%beta  = pbc_beta
+  snapshot%gamma = pbc_gamma
+  snapshot%time  = t
+
+  snapshot%valid = .true.
+
+end subroutine arm_capture_common_md_state
+
+!===============================================================================
+! Quietly rebuild PMEMD PBC metadata from an absolute AREX snapshot box.
+!
+! This is the AREX restore-time equivalent of the mathematical rebuild performed
+! by pbc_mod:init_pbc, but without mdout chatter, mexit(), or CUDA
+! initialization-style side effects.  The caller remains responsible for any
+! CUDA-side lightweight cell upload after a successful restore.
+!
+! Supports:
+!   - orthogonal boxes
+!   - non-orthogonal boxes
+!   - anisotropic/semiisotropic box length changes
+!   - changed box angles
+!===============================================================================
+subroutine arm_rebuild_pbc_from_snapshot_box(snapshot, max_cutoff, ierr, message)
+  use pbc_mod, only : is_orthog, pbc_box, pbc_alpha, pbc_beta, pbc_gamma, &
+                      ucell, recip, cut_factor, reclng, uc_volume,       &
+                      uc_sphere, old_pbc, last_recip
+
+#ifdef MPI
+  use mdin_ctrl_dat_mod, only : usemidpoint
+  use processor_mod, only : box_len
+#endif
+
+  type(arm_md_snapshot_t), intent(in) :: snapshot
+  real(dp), intent(in) :: max_cutoff
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: new_is_orthog
+
+  real(dp) :: a
+  real(dp) :: b
+  real(dp) :: c
+  real(dp) :: alpha
+  real(dp) :: beta
+  real(dp) :: gamma
+
+  real(dp) :: factor
+  real(dp) :: sin_alpha
+  real(dp) :: sin_beta
+  real(dp) :: sin_gamma
+  real(dp) :: cos_alpha
+  real(dp) :: cos_beta
+  real(dp) :: cos_gamma
+  real(dp) :: ucell33_sq
+  real(dp) :: result
+  real(dp) :: distance
+  real(dp) :: recip_norm
+
+  real(dp) :: new_ucell(3,3)
+  real(dp) :: new_recip(3,3)
+  real(dp) :: new_cut_factor(3)
+  real(dp) :: new_reclng(3)
+  real(dp) :: new_uc_volume
+  real(dp) :: new_uc_sphere
+
+  real(dp) :: u23(3)
+  real(dp) :: u31(3)
+  real(dp) :: u12(3)
+
+  real(dp), parameter :: tiny_cell = 1.0e-12_dp
+  real(dp), parameter :: angle_tol = 1.0e-10_dp
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  a     = snapshot%box(1)
+  b     = snapshot%box(2)
+  c     = snapshot%box(3)
+  alpha = snapshot%alpha
+  beta  = snapshot%beta
+  gamma = snapshot%gamma
+
+  if (a <= tiny_cell .or. b <= tiny_cell .or. c <= tiny_cell) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_rebuild_pbc_from_snapshot_box: invalid snapshot box lengths')
+    return
+  end if
+
+  if (alpha <= tiny_cell .or. beta <= tiny_cell .or. gamma <= tiny_cell) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_rebuild_pbc_from_snapshot_box: invalid snapshot box angles')
+    return
+  end if
+
+  new_ucell(:,:) = 0.0_dp
+  new_recip(:,:) = 0.0_dp
+  new_cut_factor(:) = 1.0_dp
+  new_reclng(:) = 0.0_dp
+  new_uc_volume = 0.0_dp
+  new_uc_sphere = 0.0_dp
+
+  if (abs(alpha - 90.0_dp) <= angle_tol .and. &
+      abs(beta  - 90.0_dp) <= angle_tol .and. &
+      abs(gamma - 90.0_dp) <= angle_tol) then
+
+    new_is_orthog = 1
+
+    new_ucell(1,1) = a
+    new_ucell(2,2) = b
+    new_ucell(3,3) = c
+
+    new_recip(1,1) = 1.0_dp / a
+    new_recip(2,2) = 1.0_dp / b
+    new_recip(3,3) = 1.0_dp / c
+
+    new_reclng(1) = a
+    new_reclng(2) = b
+    new_reclng(3) = c
+
+    new_uc_volume = a * b * c
+    new_uc_sphere = 0.5_dp * min(a, b, c)
+
+  else
+
+    new_is_orthog = 0
+
+    factor = acos(-1.0_dp) / 180.0_dp
+
+    sin_alpha = sin(factor * alpha)
+    sin_beta  = sin(factor * beta)
+    sin_gamma = sin(factor * gamma)
+
+    cos_alpha = cos(factor * alpha)
+    cos_beta  = cos(factor * beta)
+    cos_gamma = cos(factor * gamma)
+
+    if (abs(sin_alpha) <= tiny_cell .or. &
+        abs(sin_beta)  <= tiny_cell .or. &
+        abs(sin_gamma) <= tiny_cell) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_rebuild_pbc_from_snapshot_box: degenerate snapshot box angles')
+      return
+    end if
+
+    new_ucell(1,1) = a
+    new_ucell(2,1) = 0.0_dp
+    new_ucell(3,1) = 0.0_dp
+
+    new_ucell(1,2) = b * cos_gamma
+    new_ucell(2,2) = b * sin_gamma
+    new_ucell(3,2) = 0.0_dp
+
+    if (abs(new_ucell(2,2)) <= tiny_cell) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_rebuild_pbc_from_snapshot_box: degenerate snapshot unit cell')
+      return
+    end if
+
+    new_ucell(1,3) = c * cos_beta
+    new_ucell(2,3) = (b * c * cos_alpha - new_ucell(1,3) * &
+                      new_ucell(1,2)) / new_ucell(2,2)
+
+    ucell33_sq = c * c - new_ucell(1,3) * new_ucell(1,3) - &
+                 new_ucell(2,3) * new_ucell(2,3)
+
+    if (ucell33_sq <= tiny_cell) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_rebuild_pbc_from_snapshot_box: non-positive snapshot unit-cell z component')
+      return
+    end if
+
+    new_ucell(3,3) = sqrt(ucell33_sq)
+
+    new_cut_factor(1) = 1.0_dp / (sin_beta  * sin_gamma)
+    new_cut_factor(2) = 1.0_dp / (sin_alpha * sin_gamma)
+    new_cut_factor(3) = 1.0_dp / (sin_alpha * sin_beta)
+
+    ! u23 = cross(ucell(:,2), ucell(:,3))
+    u23(1) = new_ucell(2,2) * new_ucell(3,3) - &
+             new_ucell(3,2) * new_ucell(2,3)
+    u23(2) = new_ucell(3,2) * new_ucell(1,3) - &
+             new_ucell(1,2) * new_ucell(3,3)
+    u23(3) = new_ucell(1,2) * new_ucell(2,3) - &
+             new_ucell(2,2) * new_ucell(1,3)
+
+    ! u31 = cross(ucell(:,3), ucell(:,1))
+    u31(1) = new_ucell(2,3) * new_ucell(3,1) - &
+             new_ucell(3,3) * new_ucell(2,1)
+    u31(2) = new_ucell(3,3) * new_ucell(1,1) - &
+             new_ucell(1,3) * new_ucell(3,1)
+    u31(3) = new_ucell(1,3) * new_ucell(2,1) - &
+             new_ucell(2,3) * new_ucell(1,1)
+
+    ! u12 = cross(ucell(:,1), ucell(:,2))
+    u12(1) = new_ucell(2,1) * new_ucell(3,2) - &
+             new_ucell(3,1) * new_ucell(2,2)
+    u12(2) = new_ucell(3,1) * new_ucell(1,2) - &
+             new_ucell(1,1) * new_ucell(3,2)
+    u12(3) = new_ucell(1,1) * new_ucell(2,2) - &
+             new_ucell(2,1) * new_ucell(1,2)
+
+    new_uc_volume = new_ucell(1,1) * u23(1) + &
+                    new_ucell(2,1) * u23(2) + &
+                    new_ucell(3,1) * u23(3)
+
+    if (new_uc_volume <= tiny_cell) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_rebuild_pbc_from_snapshot_box: non-positive snapshot unit-cell volume')
+      return
+    end if
+
+    do i = 1, 3
+      new_recip(i,1) = u23(i) / new_uc_volume
+      new_recip(i,2) = u31(i) / new_uc_volume
+      new_recip(i,3) = u12(i) / new_uc_volume
+    end do
+
+    do i = 1, 3
+      recip_norm = sqrt(new_recip(1,i) * new_recip(1,i) + &
+                        new_recip(2,i) * new_recip(2,i) + &
+                        new_recip(3,i) * new_recip(3,i))
+
+      if (recip_norm <= tiny_cell) then
+        call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+          'arm_rebuild_pbc_from_snapshot_box: degenerate reciprocal cell')
+        return
+      end if
+
+      new_reclng(i) = 1.0_dp / recip_norm
+    end do
+
+    new_uc_sphere = a + b + c
+
+    do i = 1, 3
+      result = new_recip(1,i) * new_ucell(1,i) + &
+               new_recip(2,i) * new_ucell(2,i) + &
+               new_recip(3,i) * new_ucell(3,i)
+
+      distance = result * new_reclng(i)
+      if (distance < new_uc_sphere) new_uc_sphere = distance
+    end do
+
+    new_uc_sphere = 0.5_dp * new_uc_sphere
+
+  end if
+
+  if (new_uc_sphere <= tiny_cell) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_rebuild_pbc_from_snapshot_box: invalid unit-cell inscribed sphere')
+    return
+  end if
+
+  if (max_cutoff > new_uc_sphere) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_rebuild_pbc_from_snapshot_box: max cutoff exceeds restored unit-cell sphere')
+    return
+  end if
+
+  old_pbc(:) = pbc_box(:)
+  last_recip(:,:) = recip(:,:)
+
+  pbc_box(1) = a
+  pbc_box(2) = b
+  pbc_box(3) = c
+
+  pbc_alpha = alpha
+  pbc_beta  = beta
+  pbc_gamma = gamma
+
+  is_orthog = new_is_orthog
+
+  ucell(:,:) = new_ucell(:,:)
+  recip(:,:) = new_recip(:,:)
+  cut_factor(:) = new_cut_factor(:)
+  reclng(:) = new_reclng(:)
+
+  uc_volume = new_uc_volume
+  uc_sphere = new_uc_sphere
+
+#ifdef MPI
+  if (usemidpoint) box_len(:) = pbc_box(:)
+#endif
+
+end subroutine arm_rebuild_pbc_from_snapshot_box
+
+!===============================================================================
+! Restore host-side PMEMD box state from the absolute box stored in an AREX
+! snapshot.
+!
+! Restore scope:
+! - no box restore if the snapshot box is unset/zero
+! - no-op fast path if snapshot box lengths and angles match live PBC state
+! - full absolute rebuild for orthogonal and non-orthogonal boxes
+! - anisotropic/semiisotropic box length changes are supported
+! - changed box angles are supported when the restored cell is valid
+!===============================================================================
+subroutine arm_restore_common_box_state(snapshot, did_restore, ierr, message)
+  use pbc_mod, only : pbc_box, pbc_alpha, pbc_beta, pbc_gamma, cut_factor
+  use mdin_ctrl_dat_mod, only : vdw_cutoff
+  use mdin_ewald_dat_mod, only : skinnb
+#ifndef CUDA
+  use cit_mod, only : set_cit_tbl_dims
+#endif
+
+  type(arm_md_snapshot_t), intent(in) :: snapshot
+  logical, intent(out) :: did_restore
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  logical :: same_box
+  logical :: same_angles
+
+  real(dp) :: box_scale
+  real(dp) :: max_cutoff
+  real(dp) :: angle_delta
+
+  integer :: rebuild_ierr
+  character(len=256) :: rebuild_message
+
+  real(dp), parameter :: tiny_box = 1.0e-12_dp
+  real(dp), parameter :: same_box_tol = 1.0e-10_dp
+  real(dp), parameter :: same_angle_tol = 1.0e-10_dp
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+  did_restore = .false.
+
+  ! Preserve prior behavior for unset snapshots.
+  if (all(abs(snapshot%box) <= tiny_box)) return
+
+  if (any(snapshot%box <= tiny_box)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_box_state: invalid snapshot box lengths')
+    return
+  end if
+
+  if (snapshot%alpha <= tiny_box .or. &
+      snapshot%beta  <= tiny_box .or. &
+      snapshot%gamma <= tiny_box) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_box_state: invalid snapshot box angles')
+    return
+  end if
+
+  box_scale = max(1.0_dp, maxval(abs(pbc_box)), maxval(abs(snapshot%box)))
+
+  same_box = maxval(abs(snapshot%box - pbc_box)) <= same_box_tol * box_scale
+
+  angle_delta = max(abs(snapshot%alpha - pbc_alpha), &
+                    abs(snapshot%beta  - pbc_beta),  &
+                    abs(snapshot%gamma - pbc_gamma))
+
+  same_angles = angle_delta <= same_angle_tol
+
+  ! Fast path: no rebuild, no trig, no CUDA cell update.
+  if (same_box .and. same_angles) return
+
+  max_cutoff = vdw_cutoff + skinnb
+
+  rebuild_message = ''
+  call arm_rebuild_pbc_from_snapshot_box(snapshot, max_cutoff, &
+                                         rebuild_ierr, rebuild_message)
+
+  if (rebuild_ierr /= ARM_OK) then
+    call arm_set_status(ierr, message, rebuild_ierr, trim(rebuild_message))
+    return
+  end if
+
+#ifndef CUDA
+  call set_cit_tbl_dims(pbc_box, max_cutoff, cut_factor)
+#endif
+
+  did_restore = .true.
+
+end subroutine arm_restore_common_box_state
+
+!===============================================================================
+! Refresh molecule centers of mass after restoring coordinates / box state.
+!
+! This follows the same helper logic already used by HREMD.
+!===============================================================================
+subroutine arm_update_mol_com_after_restore(crd)
+  use mol_list_mod,      only : gbl_mol_cnt
+  use dynamics_dat_mod,  only : my_mol_cnt, gbl_mol_mass_inv, gbl_my_mol_lst, gbl_mol_com
+  use prmtop_dat_mod,    only : atm_mass
+  use dynamics_mod,      only : get_mol_com
+#ifdef MPI
+  use dynamics_mod,      only : get_mol_com_midpoint
+#endif
+  use mdin_ctrl_dat_mod, only : usemidpoint
+  use pbc_mod,           only : old_pbc
+
+  implicit none
+  real(dp), intent(in) :: crd(3,*)
+
+#ifdef MPI
+  if (usemidpoint) then
+    call get_mol_com_midpoint(gbl_mol_cnt, crd, atm_mass, gbl_mol_mass_inv, gbl_mol_com, old_pbc)
+  else
+    call get_mol_com(my_mol_cnt, crd, atm_mass, gbl_mol_mass_inv, gbl_my_mol_lst, gbl_mol_com)
+  end if
+#else
+  call get_mol_com(my_mol_cnt, crd, atm_mass, gbl_mol_mass_inv, gbl_mol_com)
+#endif
+end subroutine arm_update_mol_com_after_restore
+
+!===============================================================================
+! Restore the common physical MD continuation state into the live PMEMD arrays.
+!
+! Current scope:
+! - atm_crd
+! - atm_vel
+! - atm_last_vel
+! - bounded box restore
+! - CUDA upload and neighbor-list invalidation
+!
+! If snapshot%valid is false, this is intentionally a no-op. That preserves the
+! existing live worker state until top-level initial seeding is finished.
+!===============================================================================
+subroutine arm_restore_common_md_state(snapshot, ierr, message)
+  use inpcrd_dat_mod, only : atm_crd, atm_vel, atm_last_vel
+  use pbc_mod, only : ucell, recip, uc_volume
+  use mdin_ctrl_dat_mod, only : t
+
+  type(arm_md_snapshot_t), intent(in) :: snapshot
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  logical :: did_restore_box
+  integer :: status_code
+  character(len=256) :: local_msg
+
+#ifdef CUDA
+  interface
+    subroutine gpu_upload_crd(atm_crd)
+      import dp
+      real(dp), intent(in) :: atm_crd(3,*)
+    end subroutine gpu_upload_crd
+
+    subroutine gpu_upload_vel(atm_vel)
+      import dp
+      real(dp), intent(in) :: atm_vel(3,*)
+    end subroutine gpu_upload_vel
+
+    subroutine gpu_upload_last_vel(atm_last_vel)
+      import dp
+      real(dp), intent(in) :: atm_last_vel(3,*)
+    end subroutine gpu_upload_last_vel
+
+    subroutine gpu_ucell_set(ucell, recip, uc_volume)
+      import dp
+      real(dp), intent(in) :: ucell(3,3)
+      real(dp), intent(in) :: recip(3,3)
+      real(dp), intent(in) :: uc_volume
+    end subroutine gpu_ucell_set
+
+    subroutine gpu_force_new_neighborlist()
+    end subroutine gpu_force_new_neighborlist
+  end interface
+#endif
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. snapshot%allocated) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_md_state: snapshot is not allocated')
+    return
+  end if
+
+  if (.not. snapshot%valid) then
+    call arm_set_status(ierr, message, ARM_OK, '')
+    return
+  end if
+
+  if (.not. allocated(atm_crd) .or. .not. allocated(atm_vel) .or. &
+      .not. allocated(atm_last_vel)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_md_state: live PMEMD MD arrays are not allocated')
+    return
+  end if
+
+  if (size(atm_crd,1) /= 3 .or. size(atm_vel,1) /= 3 .or. &
+      size(atm_last_vel,1) /= 3) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_md_state: live PMEMD MD arrays have invalid leading dimension')
+    return
+  end if
+
+  if (size(atm_crd,2) /= snapshot%natom .or. &
+      size(atm_vel,2) /= snapshot%natom .or. &
+      size(atm_last_vel,2) /= snapshot%natom) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_restore_common_md_state: live PMEMD MD array sizes do not match snapshot natom')
+    return
+  end if
+
+  atm_crd      = snapshot%crd
+  atm_vel      = snapshot%vel
+  atm_last_vel = snapshot%last_vel
+
+  call arm_restore_common_box_state(snapshot, did_restore_box, ierr, local_msg)
+  if (ierr /= ARM_OK) then
+    status_code = ierr
+    call arm_set_status(ierr, message, status_code, trim(local_msg))
+    return
+  end if
+
+  call arm_update_mol_com_after_restore(atm_crd)
+
+#ifdef CUDA
+  call gpu_upload_crd(atm_crd)
+  call gpu_upload_vel(atm_vel)
+  call gpu_upload_last_vel(atm_last_vel)
+
+  if (did_restore_box) then
+    call gpu_ucell_set(ucell, recip, uc_volume)
+  end if
+
+  ! Mark the neighbor list dirty. The next PME force call will rebuild it.
+  call gpu_force_new_neighborlist()
+#endif
+
+  t = snapshot%time
+end subroutine arm_restore_common_md_state
+
+subroutine arm_emulate_common_restart_boundary(ierr, message)
+  use inpcrd_dat_mod, only : atm_vel, atm_last_vel
+
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+#ifdef CUDA
+  interface
+    subroutine gpu_upload_last_vel(last_vel_in)
+      double precision, intent(in) :: last_vel_in(*)
+    end subroutine gpu_upload_last_vel
+  end interface
+#endif
+
+  ierr = ARM_OK
+  message = ''
+
+  ! Emulate irest=1/ntx=5 run startup behavior:
+  ! restart velocities become the current half-step velocity history.
+  atm_last_vel(:,:) = atm_vel(:,:)
+
+#ifdef CUDA
+  call gpu_upload_last_vel(atm_last_vel)
+#endif
+
+end subroutine arm_emulate_common_restart_boundary
+
+!===============================================================================
+! Allocate a generic MD snapshot
+!===============================================================================
+subroutine arm_snapshot_allocate(snapshot, natom, ierr, message)
+  type(arm_md_snapshot_t), intent(inout) :: snapshot
+  integer, intent(in) :: natom
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+  integer :: alloc_stat
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (natom <= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_snapshot_allocate: natom must be > 0')
+    return
+  end if
+
+  if (snapshot%allocated) then
+    call arm_set_status(ierr, message, ARM_OK, '')
+    return
+  end if
+
+  if (allocated(snapshot%crd))      deallocate(snapshot%crd)
+  if (allocated(snapshot%vel))      deallocate(snapshot%vel)
+  if (allocated(snapshot%last_vel)) deallocate(snapshot%last_vel)
+
+  snapshot%natom     = 0
+  snapshot%allocated = .false.
+  snapshot%valid     = .false.
+  snapshot%box       = 0.0_dp
+  snapshot%alpha     = 0.0_dp
+  snapshot%beta      = 0.0_dp
+  snapshot%gamma     = 0.0_dp
+  snapshot%time      = 0.0_dp
+
+  allocate(snapshot%crd(3, natom), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_snapshot_allocate: failed to allocate crd')
+    goto 900
+  end if
+
+  allocate(snapshot%vel(3, natom), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_snapshot_allocate: failed to allocate vel')
+    goto 900
+  end if
+
+  allocate(snapshot%last_vel(3, natom), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_snapshot_allocate: failed to allocate last_vel')
+    goto 900
+  end if
+
+  snapshot%natom     = natom
+  snapshot%allocated = .true.
+  snapshot%valid     = .false.
+
+  snapshot%crd      = 0.0_dp
+  snapshot%vel      = 0.0_dp
+  snapshot%last_vel = 0.0_dp
+
+  snapshot%box   = 0.0_dp
+  snapshot%alpha = 0.0_dp
+  snapshot%beta  = 0.0_dp
+  snapshot%gamma = 0.0_dp
+  snapshot%time  = 0.0_dp
+  return
+
+900 continue
+  if (allocated(snapshot%crd))      deallocate(snapshot%crd)
+  if (allocated(snapshot%vel))      deallocate(snapshot%vel)
+  if (allocated(snapshot%last_vel)) deallocate(snapshot%last_vel)
+
+  snapshot%natom     = 0
+  snapshot%allocated = .false.
+  snapshot%valid     = .false.
+  snapshot%box       = 0.0_dp
+  snapshot%alpha     = 0.0_dp
+  snapshot%beta      = 0.0_dp
+  snapshot%gamma     = 0.0_dp
+  snapshot%time      = 0.0_dp
+end subroutine arm_snapshot_allocate
+
+!===============================================================================
+! Deallocate a generic MD snapshot
+!===============================================================================
+subroutine arm_snapshot_deallocate(snapshot)
+  type(arm_md_snapshot_t), intent(inout) :: snapshot
+
+  if (allocated(snapshot%crd))      deallocate(snapshot%crd)
+  if (allocated(snapshot%vel))      deallocate(snapshot%vel)
+  if (allocated(snapshot%last_vel)) deallocate(snapshot%last_vel)
+
+  snapshot%allocated = .false.
+  snapshot%valid     = .false.
+  snapshot%natom     = 0
+  snapshot%box       = 0.0_dp
+  snapshot%alpha     = 0.0_dp
+  snapshot%beta      = 0.0_dp
+  snapshot%gamma     = 0.0_dp
+  snapshot%time      = 0.0_dp
+end subroutine arm_snapshot_deallocate
+
+!===============================================================================
+! Validate that the required payload callbacks have been registered.
+!
+! Required now:
+! - initialize
+! - restore_to_worker
+! - capture_from_worker
+! - evaluate_exchange
+! - post_exchange
+! finalize/checkpoint_replica are optional in this skeleton.
+!===============================================================================
+subroutine arm_validate_payload_api(api, ierr, message)
+  type(arm_payload_api_t), intent(in) :: api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. associated(api%initialize)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'ARM payload API missing initialize callback')
+    return
+  end if
+
+  if (.not. associated(api%restore_to_worker)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'ARM payload API missing restore_to_worker callback')
+    return
+  end if
+
+  if (.not. associated(api%capture_from_worker)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'ARM payload API missing capture_from_worker callback')
+    return
+  end if
+
+  if (.not. associated(api%evaluate_exchange)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'ARM payload API missing evaluate_exchange callback')
+    return
+  end if
+
+  if (.not. associated(api%post_exchange)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'ARM payload API missing post_exchange callback')
+    return
+  end if
+end subroutine arm_validate_payload_api
+
+!===============================================================================
+! Initialize manager storage and identity slot mapping.
+!
+! Current default mapping:
+!   slot i is initially occupied by replica i
+!
+! This is the right default for a ladder with fixed slots/conditions.
+!===============================================================================
+subroutine arm_manager_init(mgr, nreplicas, nworkers, natom, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: nreplicas
+  integer, intent(in) :: nworkers
+  integer, intent(in) :: natom
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i, alloc_stat
+  character(len=256) :: local_msg
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (nreplicas <= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_manager_init: nreplicas must be > 0')
+    return
+  end if
+
+  if (nworkers <= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_manager_init: nworkers must be > 0')
+    return
+  end if
+
+  if (natom <= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_manager_init: natom must be > 0')
+    return
+  end if
+
+  if (mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_manager_init: manager already initialized')
+    return
+  end if
+
+  if (allocated(mgr%replicas)) then
+    do i = 1, size(mgr%replicas)
+      call arm_snapshot_deallocate(mgr%replicas(i)%md)
+    end do
+    deallocate(mgr%replicas)
+  end if
+
+  if (allocated(mgr%workers))                 deallocate(mgr%workers)
+  if (allocated(mgr%slot_owner))              deallocate(mgr%slot_owner)
+  if (allocated(mgr%slot_segments_completed)) deallocate(mgr%slot_segments_completed)
+  if (allocated(mgr%slot_restart_owner))       deallocate(mgr%slot_restart_owner)
+  if (allocated(mgr%slot_restart_replica_segments)) &
+    deallocate(mgr%slot_restart_replica_segments)
+
+  if (mgr%exchange_history_open) then
+    close(mgr%exchange_history_unit)
+  end if
+
+  mgr%initialized          = .false.
+  mgr%payload_registered   = .false.
+  mgr%natom                = natom
+  mgr%nreplicas            = nreplicas
+  mgr%nslots               = nreplicas
+  mgr%nworkers             = nworkers
+  mgr%next_replica_uid     = nreplicas + 1
+  mgr%segments_per_replica = 0
+  mgr%epoch                = 0
+  mgr%current_parity       = ARM_PARITY_EVEN
+  mgr%exchange_history_unit       = -1
+  mgr%exchange_history_open       = .false.
+  mgr%exchange_history_last_epoch = -1
+  mgr%history_generation          = 0
+
+  allocate(mgr%slot_owner(mgr%nslots), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate slot_owner')
+    goto 900
+  end if
+
+  allocate(mgr%slot_segments_completed(mgr%nslots), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate slot_segments_completed')
+    goto 900
+  end if
+
+  allocate(mgr%slot_restart_owner(mgr%nslots), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate slot_restart_owner')
+    goto 900
+  end if
+
+  allocate(mgr%slot_restart_replica_segments(mgr%nslots), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate slot_restart_replica_segments')
+    goto 900
+  end if
+
+  allocate(mgr%replicas(mgr%nreplicas), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate replicas')
+    goto 900
+  end if
+
+  allocate(mgr%workers(mgr%nworkers), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_manager_init: failed to allocate workers')
+    goto 900
+  end if
+
+  do i = 1, mgr%nslots
+    mgr%slot_owner(i) = i
+  end do
+
+  mgr%slot_segments_completed(:) = 0
+  mgr%slot_restart_owner(:)            = 0
+  mgr%slot_restart_replica_segments(:) = 0
+
+  do i = 1, mgr%nreplicas
+    mgr%replicas(i)%replica_id              = i
+    mgr%replicas(i)%replica_uid             = i
+    mgr%replicas(i)%parent_uid              = 0
+    mgr%replicas(i)%slot_id                 = i
+    mgr%replicas(i)%status                  = ARM_REPLICA_IDLE
+    mgr%replicas(i)%assigned_worker_id      = 0
+    mgr%replicas(i)%segments_completed      = 0
+    mgr%replicas(i)%completed_epoch         = 0
+    mgr%replicas(i)%exchange_resolved_epoch = 0
+
+    call arm_snapshot_allocate(mgr%replicas(i)%md, natom, ierr, local_msg)
+    if (ierr /= ARM_OK) then
+      if (len(message) > 0) message = trim(local_msg)
+      goto 900
+    end if
+  end do
+
+  do i = 1, mgr%nworkers
+    mgr%workers(i)%worker_id          = i
+    mgr%workers(i)%status             = ARM_WORKER_IDLE
+    mgr%workers(i)%active_replica_id  = 0
+    mgr%workers(i)%active_slot_id     = 0
+    mgr%workers(i)%completed_segments = 0
+  end do
+
+  mgr%initialized = .true.
+  return
+
+900 continue
+  if (allocated(mgr%replicas)) then
+    do i = 1, size(mgr%replicas)
+      call arm_snapshot_deallocate(mgr%replicas(i)%md)
+    end do
+    deallocate(mgr%replicas)
+  end if
+
+  if (allocated(mgr%workers))                 deallocate(mgr%workers)
+  if (allocated(mgr%slot_owner))              deallocate(mgr%slot_owner)
+  if (allocated(mgr%slot_segments_completed)) deallocate(mgr%slot_segments_completed)
+  if (allocated(mgr%slot_restart_owner))       deallocate(mgr%slot_restart_owner)
+  if (allocated(mgr%slot_restart_replica_segments)) &
+    deallocate(mgr%slot_restart_replica_segments)
+
+  if (mgr%exchange_history_open) then
+    close(mgr%exchange_history_unit)
+  end if
+
+  mgr%initialized          = .false.
+  mgr%payload_registered   = .false.
+  mgr%natom                = 0
+  mgr%nreplicas            = 0
+  mgr%nslots               = 0
+  mgr%nworkers             = 0
+  mgr%next_replica_uid     = 1
+  mgr%segments_per_replica = 0
+  mgr%epoch                = 0
+  mgr%current_parity       = ARM_PARITY_EVEN
+  mgr%exchange_history_unit       = -1
+  mgr%exchange_history_open       = .false.
+  mgr%exchange_history_last_epoch = -1
+  mgr%history_generation          = 0
+end subroutine arm_manager_init
+
+!===============================================================================
+! Set the required number of completed segments for each logical replica.
+!
+! This value defines when the full AREX campaign is complete. It is kept
+! separate from epoch bookkeeping because an epoch tracks one exchange
+! phase, while the full campaign spans many epochs.
+!===============================================================================
+subroutine arm_set_segments_per_replica(mgr, nsegments, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: nsegments
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_set_segments_per_replica: manager not initialized')
+    return
+  end if
+
+  if (nsegments <= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_set_segments_per_replica: nsegments must be > 0')
+    return
+  end if
+
+  mgr%segments_per_replica = nsegments
+end subroutine arm_set_segments_per_replica
+
+!===============================================================================
+! Register payload callback table.
+!===============================================================================
+subroutine arm_register_payload(mgr, api, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  type(arm_payload_api_t), intent(in) :: api
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  call arm_validate_payload_api(api, ierr, message)
+  if (ierr /= ARM_OK) return
+
+  mgr%payload%initialize          => api%initialize
+  if (associated(api%finalize))            mgr%payload%finalize           => api%finalize
+  mgr%payload%restore_to_worker   => api%restore_to_worker
+  mgr%payload%capture_from_worker => api%capture_from_worker
+  mgr%payload%evaluate_exchange   => api%evaluate_exchange
+  mgr%payload%post_exchange       => api%post_exchange
+  if (associated(api%checkpoint_replica))  mgr%payload%checkpoint_replica => api%checkpoint_replica
+
+  mgr%payload_registered = .true.
+  call arm_set_status(ierr, message, ARM_OK, '')
+end subroutine arm_register_payload
+
+!===============================================================================
+! Seed all of the replicas with initial snapshots
+!===============================================================================
+
+subroutine arm_seed_initial_snapshots(mgr, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: replica_id
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_seed_initial_snapshots: manager not initialized')
+    return
+  end if
+
+  ! In the dedicated-scheduler design, initial replica state is seeded later
+  ! from worker-owned live state. The authoritative manager only allocates and
+  ! tracks snapshot containers here.
+  do replica_id = 1, mgr%nreplicas
+    mgr%replicas(replica_id)%md%valid = .false.
+  end do
+end subroutine arm_seed_initial_snapshots
+
+!===============================================================================
+! Begin a new exchange epoch.
+!
+! This resets per-epoch completion flags and toggles parity by epoch:
+!   epoch 1 -> even pairs: (1,2), (3,4), ...
+!   epoch 2 -> odd  pairs: (2,3), (4,5), ...
+!
+! This matches the wrapper-style odd/even neighbor schedule.
+!===============================================================================
+subroutine arm_begin_epoch(mgr, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'arm_begin_epoch: manager not initialized')
+    return
+  end if
+
+  if (.not. mgr%payload_registered) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'arm_begin_epoch: payload not registered')
+    return
+  end if
+
+  mgr%epoch = mgr%epoch + 1
+  mgr%current_parity = mod(mgr%epoch - 1, 2)
+
+  do i = 1, mgr%nreplicas
+    mgr%replicas(i)%status = ARM_REPLICA_IDLE
+    mgr%replicas(i)%assigned_worker_id = 0
+  end do
+
+end subroutine arm_begin_epoch
+
+!===============================================================================
+! Return the next replica that still needs to run its segment for the current
+! epoch. ARM queues work by replica, but slot ownership is fixed separately.
+!
+! This is intentionally simple. Load-balancing policy can be improved later.
+!===============================================================================
+subroutine arm_next_ready_replica(mgr, found, replica_id, slot_id, ierr, message)
+  type(arm_manager_t), intent(in) :: mgr
+  logical, intent(out) :: found
+  integer, intent(out) :: replica_id
+  integer, intent(out) :: slot_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: slot, rep
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+  found      = .false.
+  replica_id = 0
+  slot_id    = 0
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'arm_next_ready_replica: manager not initialized')
+    return
+  end if
+
+  do slot = 1, mgr%nslots
+    rep = mgr%slot_owner(slot)
+
+    if (mgr%replicas(rep)%completed_epoch < mgr%epoch .and. &
+        mgr%replicas(rep)%status == ARM_REPLICA_IDLE) then
+      found      = .true.
+      replica_id = rep
+      slot_id    = slot
+      return
+    end if
+  end do
+end subroutine arm_next_ready_replica
+
+!===============================================================================
+! Assign a replica to a worker.
+!
+! This now performs:
+!   1. manager bookkeeping for worker/replica ownership
+!   2. common physical state restore for the live PMEMD MD arrays
+!   3. payload-specific restore callback
+!
+! Common restore implemented here:
+! - atm_crd
+! - atm_vel
+! - atm_last_vel
+! - bounded box restore through the existing PMEMD scale/update path
+! - CUDA upload hooks and neighbor-list invalidation
+!
+! Still intentionally NOT handled here:
+! - initial seeding of per-replica snapshots before first assignment
+! - logical run-history restore from runmd host-side counters/averages
+! - payload-specific restore details
+!===============================================================================
+subroutine arm_assign_replica_to_worker(mgr, worker_id, replica_id, ierr, &
+                                        message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: worker_id
+  integer, intent(in) :: replica_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: slot_id
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: manager not initialized')
+    return
+  end if
+
+  if (.not. mgr%payload_registered) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: payload not registered')
+    return
+  end if
+
+  if (worker_id < 1 .or. worker_id > mgr%nworkers) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: invalid worker_id')
+    return
+  end if
+
+  if (replica_id < 1 .or. replica_id > mgr%nreplicas) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: invalid replica_id')
+    return
+  end if
+
+  if (mgr%workers(worker_id)%status /= ARM_WORKER_IDLE) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: worker is not idle')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%status == ARM_REPLICA_RUNNING) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: replica already running')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%assigned_worker_id /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: replica worker state is dirty')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%completed_epoch == mgr%epoch) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: replica already ran this epoch')
+    return
+  end if
+
+  slot_id = mgr%replicas(replica_id)%slot_id
+
+  if (slot_id < 1 .or. slot_id > mgr%nslots) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: invalid slot mapping')
+    return
+  end if
+
+  if (mgr%slot_owner(slot_id) /= replica_id) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: slot_owner mismatch')
+    return
+  end if
+
+  if (.not. mgr%replicas(replica_id)%md%allocated) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_assign_replica_to_worker: MD snapshot not allocated')
+    return
+  end if
+
+  mgr%workers(worker_id)%status            = ARM_WORKER_BUSY
+  mgr%workers(worker_id)%active_replica_id = replica_id
+  mgr%workers(worker_id)%active_slot_id    = slot_id
+
+  mgr%replicas(replica_id)%status             = ARM_REPLICA_RUNNING
+  mgr%replicas(replica_id)%assigned_worker_id = worker_id
+end subroutine arm_assign_replica_to_worker
+
+!===============================================================================
+! Mark a worker's current segment as complete and capture state back into the
+! manager.
+!
+! This now performs:
+!   1. common physical state capture from the live PMEMD MD arrays
+!   2. payload-specific capture callback
+!   3. manager bookkeeping for replica/worker completion
+!
+! Common capture implemented here:
+! - atm_crd
+! - atm_vel
+! - atm_last_vel
+! - box lengths / angles metadata
+!
+! Forces, neighbor lists, and other runtime caches are intentionally treated as
+! rebuildable runtime state and are not required continuation state here.
+!
+! Still intentionally NOT handled here:
+! - logical run-history capture from runmd host-side counters/averages
+! - payload-specific capture details beyond the payload callback
+!===============================================================================
+subroutine arm_mark_segment_complete(mgr, worker_id, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: worker_id
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: replica_id
+  integer :: slot_id
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: manager not initialized')
+    return
+  end if
+
+  if (.not. mgr%payload_registered) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: payload not registered')
+    return
+  end if
+
+  if (worker_id < 1 .or. worker_id > mgr%nworkers) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: invalid worker_id')
+    return
+  end if
+
+  if (mgr%workers(worker_id)%status /= ARM_WORKER_BUSY) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: worker is not busy')
+    return
+  end if
+
+  replica_id = mgr%workers(worker_id)%active_replica_id
+  slot_id    = mgr%workers(worker_id)%active_slot_id
+
+  if (replica_id < 1 .or. replica_id > mgr%nreplicas) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: worker has invalid replica_id')
+    return
+  end if
+
+  if (slot_id < 1 .or. slot_id > mgr%nslots) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: worker has invalid slot_id')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%status /= ARM_REPLICA_RUNNING) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: replica is not running')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%assigned_worker_id /= worker_id) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: replica/worker mismatch')
+    return
+  end if
+
+  if (mgr%replicas(replica_id)%slot_id /= slot_id) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: replica/slot mismatch')
+    return
+  end if
+
+  if (mgr%slot_owner(slot_id) /= replica_id) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_mark_segment_complete: slot_owner mismatch')
+    return
+  end if
+
+  mgr%replicas(replica_id)%status             = ARM_REPLICA_COMPLETE
+  mgr%replicas(replica_id)%assigned_worker_id = 0
+  mgr%replicas(replica_id)%segments_completed = &
+    mgr%replicas(replica_id)%segments_completed + 1
+
+  mgr%slot_segments_completed(slot_id) = &
+    mgr%slot_segments_completed(slot_id) + 1
+
+  ! runmd writes the slot-owned standard restart immediately before reporting
+  ! this segment completion to the scheduler. Preserve which walker that file
+  ! contains; a subsequent exchange may change slot_owner.
+  mgr%slot_restart_owner(slot_id) = replica_id
+  mgr%slot_restart_replica_segments(slot_id) = &
+    mgr%replicas(replica_id)%segments_completed
+
+  mgr%replicas(replica_id)%completed_epoch    = mgr%epoch
+  mgr%workers(worker_id)%status             = ARM_WORKER_IDLE
+  mgr%workers(worker_id)%active_replica_id  = 0
+  mgr%workers(worker_id)%active_slot_id     = 0
+  mgr%workers(worker_id)%completed_segments = &
+    mgr%workers(worker_id)%completed_segments + 1
+
+  call arm_mark_unpaired_slot_resolved(mgr, slot_id)
+end subroutine arm_mark_segment_complete
+
+!===============================================================================
+! Determine partner slot under current odd/even parity.
+!
+! For ARM_PARITY_EVEN:
+!   (1,2), (3,4), (5,6), ...
+!
+! For ARM_PARITY_ODD:
+!   (2,3), (4,5), (6,7), ...
+!===============================================================================
+subroutine arm_partner_slot(slot_id, nslots, parity, has_partner, partner_id)
+  integer, intent(in) :: slot_id
+  integer, intent(in) :: nslots
+  integer, intent(in) :: parity
+  logical, intent(out) :: has_partner
+  integer, intent(out) :: partner_id
+
+  has_partner = .false.
+  partner_id  = 0
+
+  if (slot_id < 1 .or. slot_id > nslots) return
+
+  select case (parity)
+  case (ARM_PARITY_EVEN)
+    if (mod(slot_id, 2) == 1) then
+      partner_id = slot_id + 1
+    else
+      partner_id = slot_id - 1
+    end if
+  case (ARM_PARITY_ODD)
+    if (mod(slot_id, 2) == 0) then
+      partner_id = slot_id + 1
+    else
+      partner_id = slot_id - 1
+    end if
+  case default
+    partner_id = 0
+  end select
+
+  if (partner_id >= 1 .and. partner_id <= nslots) has_partner = .true.
+end subroutine arm_partner_slot
+
+!===============================================================================
+! Mark an unpaired slot as exchange-resolved for the current epoch.
+!===============================================================================
+subroutine arm_mark_unpaired_slot_resolved(mgr, slot_id)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: slot_id
+
+  logical :: has_partner
+  integer :: partner_id, rep
+
+  call arm_partner_slot(slot_id, mgr%nslots, mgr%current_parity, has_partner, partner_id)
+  if (.not. has_partner) then
+    rep = mgr%slot_owner(slot_id)
+    mgr%replicas(rep)%exchange_resolved_epoch = mgr%epoch
+  end if
+end subroutine arm_mark_unpaired_slot_resolved
+
+!===============================================================================
+! Swap slot occupants and update inverse replica->slot mapping.
+!
+! This is the canonical metadata/mapping swap used by ARM.
+!===============================================================================
+subroutine arm_swap_slot_occupants(mgr, slot_a, slot_b)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: slot_a
+  integer, intent(in) :: slot_b
+
+  integer :: rep_a, rep_b
+
+  rep_a = mgr%slot_owner(slot_a)
+  rep_b = mgr%slot_owner(slot_b)
+
+  mgr%slot_owner(slot_a) = rep_b
+  mgr%slot_owner(slot_b) = rep_a
+
+  mgr%replicas(rep_a)%slot_id = slot_b
+  mgr%replicas(rep_b)%slot_id = slot_a
+end subroutine arm_swap_slot_occupants
+
+!===============================================================================
+! Resolve all ready exchange pairs for the current epoch.
+!
+! This is intentionally pair-local and does not require a global barrier.
+! A pair is resolved once:
+! - both member replicas have completed the current epoch segment
+! - the payload callback has evaluated the exchange
+! - the mapping has been swapped if accepted
+! - post-exchange payload hook has run
+!
+! This mirrors the wrapper's practical pipelined behavior while preserving the
+! epoch/parity exchange semantics.
+!===============================================================================
+subroutine arm_try_resolve_ready_exchanges(mgr, nresolved, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: nresolved
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: slot_a, slot_b, rep_a, rep_b
+  logical :: accept
+  character(len=256) :: payload_msg
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+  nresolved = 0
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'arm_try_resolve_ready_exchanges: manager not initialized')
+    return
+  end if
+
+  if (.not. mgr%payload_registered) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_try_resolve_ready_exchanges: payload not registered')
+    return
+  end if
+
+  do slot_a = 1 + mgr%current_parity, mgr%nslots, 2
+    slot_b = slot_a + 1
+
+    if (slot_b > mgr%nslots) cycle
+
+    rep_a = mgr%slot_owner(slot_a)
+    rep_b = mgr%slot_owner(slot_b)
+
+    if (mgr%replicas(rep_a)%completed_epoch /= mgr%epoch) cycle
+    if (mgr%replicas(rep_b)%completed_epoch /= mgr%epoch) cycle
+
+    if (mgr%replicas(rep_a)%exchange_resolved_epoch == mgr%epoch) cycle
+    if (mgr%replicas(rep_b)%exchange_resolved_epoch == mgr%epoch) cycle
+
+    call mgr%payload%evaluate_exchange(rep_a, slot_a, rep_b, slot_b, accept, ierr, payload_msg)
+    if (ierr /= ARM_OK) then
+      call arm_set_status(ierr, message, ARM_ERR_PAYLOAD, trim(payload_msg))
+      return
+    end if
+
+    if (accept) then
+      call mgr%payload%post_exchange(rep_a, slot_a, slot_b, rep_b, slot_b, &
+                                     slot_a, ierr, payload_msg)
+      if (ierr /= ARM_OK) then
+        call arm_set_status(ierr, message, ARM_ERR_PAYLOAD, trim(payload_msg))
+        return
+      end if
+
+      call arm_swap_slot_occupants(mgr, slot_a, slot_b)
+    else
+      call mgr%payload%post_exchange(rep_a, slot_a, slot_a, rep_b, slot_b, &
+                                     slot_b, ierr, payload_msg)
+      if (ierr /= ARM_OK) then
+        call arm_set_status(ierr, message, ARM_ERR_PAYLOAD, trim(payload_msg))
+        return
+      end if
+    end if
+
+    mgr%replicas(rep_a)%exchange_resolved_epoch = mgr%epoch
+    mgr%replicas(rep_b)%exchange_resolved_epoch = mgr%epoch
+    nresolved = nresolved + 2
+  end do
+end subroutine arm_try_resolve_ready_exchanges
+
+!===============================================================================
+! Return .true. when the full current epoch has finished.
+!
+! "Finished" means:
+! - every replica has completed its segment for this epoch
+! - every replica has had its exchange state resolved for this epoch
+!===============================================================================
+logical function arm_epoch_complete(mgr)
+  type(arm_manager_t), intent(in) :: mgr
+  integer :: i
+
+  arm_epoch_complete = .false.
+
+  if (.not. mgr%initialized) return
+
+  do i = 1, mgr%nreplicas
+    if (mgr%replicas(i)%completed_epoch /= mgr%epoch) return
+    if (mgr%replicas(i)%exchange_resolved_epoch /= mgr%epoch) return
+  end do
+
+  arm_epoch_complete = .true.
+end function arm_epoch_complete
+
+!===============================================================================
+! Return .true. when the current set of slot-owned standard restart files
+! contains exactly one latest physical state for every active replica.
+!
+! A mid-epoch accepted exchange can temporarily make two slot restart files
+! contain the same walker while another walker has not yet written its new
+! slot. Checkpoint writing must be deferred until this set is a permutation of
+! the dense active replica indices.
+!===============================================================================
+logical function arm_restart_set_ready(mgr)
+  type(arm_manager_t), intent(in) :: mgr
+  integer :: i, j
+
+  arm_restart_set_ready = .false.
+
+  if (.not. mgr%initialized) return
+  if (mgr%nslots /= mgr%nreplicas) return
+  if (.not. allocated(mgr%slot_restart_owner)) return
+  if (.not. allocated(mgr%slot_restart_replica_segments)) return
+  if (size(mgr%slot_restart_owner) /= mgr%nslots) return
+  if (size(mgr%slot_restart_replica_segments) /= mgr%nslots) return
+
+  do i = 1, mgr%nslots
+    if (mgr%slot_restart_owner(i) < 1 .or. &
+        mgr%slot_restart_owner(i) > mgr%nreplicas) return
+
+    if (mgr%slot_restart_replica_segments(i) /= &
+        mgr%replicas(mgr%slot_restart_owner(i))%segments_completed) return
+
+    do j = i + 1, mgr%nslots
+      if (mgr%slot_restart_owner(i) == mgr%slot_restart_owner(j)) return
+    end do
+  end do
+
+  arm_restart_set_ready = .true.
+end function arm_restart_set_ready
+
+!===============================================================================
+! Write UID-based replica -> slot exchange history as a TSV file.
+!
+! Output format:
+!   generation  epoch  replica_uid  replica_index  slot_id  parent_uid
+!
+! Fresh campaigns replace any stale history and record the initial identity
+! mapping at epoch 0. Continuations append a marked UID-format section to any
+! existing history and do not rewrite the checkpoint epoch.
+!===============================================================================
+subroutine arm_write_exchange_history(mgr, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: ios
+  integer :: replica_id
+  integer :: slot_id
+  logical :: history_exists
+  logical :: continuing_history
+  character(len=256) :: io_msg
+  character(len=256) :: history_filename
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+  history_filename = 'arex.history.tsv'
+  if (len_trim(arex_output_directory) > 0) &
+    history_filename = trim(arex_output_directory) // '/arex.history.tsv'
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_exchange_history: manager not initialized')
+    return
+  end if
+
+  if (.not. allocated(mgr%slot_owner)) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_exchange_history: slot_owner is not allocated')
+    return
+  end if
+
+  if (size(mgr%slot_owner) /= mgr%nslots) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_exchange_history: slot_owner size mismatch')
+    return
+  end if
+
+  if (.not. mgr%exchange_history_open) then
+    continuing_history = (mgr%exchange_history_last_epoch >= 0)
+    inquire(file=history_filename, exist=history_exists)
+
+    if (continuing_history .and. history_exists) then
+      open(newunit=mgr%exchange_history_unit, file=history_filename, &
+           status='old', position='append', action='write', iostat=ios, iomsg=io_msg)
+    else
+      open(newunit=mgr%exchange_history_unit, file=history_filename, &
+           status='replace', action='write', iostat=ios, iomsg=io_msg)
+    end if
+
+    if (ios /= 0) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_write_exchange_history: failed to open arex.history.tsv: ' // trim(io_msg))
+      return
+    end if
+
+    mgr%exchange_history_open = .true.
+
+    if (continuing_history .and. history_exists) then
+      write(mgr%exchange_history_unit, '(a,i0,a,i0)', iostat=ios) &
+        '# AREX_HISTORY_V3 continuation generation=', mgr%history_generation, &
+        ' from_epoch=', mgr%exchange_history_last_epoch
+    else
+      write(mgr%exchange_history_unit, '(a)', iostat=ios) '# AREX_HISTORY_V3'
+    end if
+    if (ios /= 0) goto 900
+
+    write(mgr%exchange_history_unit, '(a)', iostat=ios) &
+      '# generation' // achar(9) // 'epoch' // achar(9) // 'replica_uid' // achar(9) // &
+      'replica_index' // achar(9) // 'slot_id' // achar(9) // 'parent_uid'
+    if (ios /= 0) goto 900
+
+    if (.not. continuing_history) then
+      do replica_id = 1, mgr%nreplicas
+        write(mgr%exchange_history_unit, '(i0,a,i0,a,i0,a,i0,a,i0,a,i0)', iostat=ios) &
+          mgr%history_generation, achar(9), 0, achar(9), &
+          mgr%replicas(replica_id)%replica_uid, achar(9), replica_id, achar(9), &
+          replica_id, achar(9), mgr%replicas(replica_id)%parent_uid
+        if (ios /= 0) goto 900
+      end do
+      mgr%exchange_history_last_epoch = 0
+    else if (.not. history_exists) then
+      ! If the prior history file was lost, begin the replacement history from
+      ! the restored checkpoint state instead of inventing earlier records.
+      mgr%exchange_history_last_epoch = -1
+    end if
+  end if
+
+  if (mgr%epoch <= mgr%exchange_history_last_epoch) return
+
+  do replica_id = 1, mgr%nreplicas
+    slot_id = mgr%replicas(replica_id)%slot_id
+
+    if (slot_id < 1 .or. slot_id > mgr%nslots) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_write_exchange_history: invalid slot id in replica state')
+      return
+    end if
+
+    if (mgr%slot_owner(slot_id) /= replica_id) then
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_write_exchange_history: replica/slot inverse mapping mismatch')
+      return
+    end if
+
+    write(mgr%exchange_history_unit, '(i0,a,i0,a,i0,a,i0,a,i0,a,i0)', iostat=ios) &
+      mgr%history_generation, achar(9), mgr%epoch, achar(9), &
+      mgr%replicas(replica_id)%replica_uid, achar(9), replica_id, achar(9), &
+      slot_id, achar(9), mgr%replicas(replica_id)%parent_uid
+    if (ios /= 0) goto 900
+  end do
+
+  mgr%exchange_history_last_epoch = mgr%epoch
+  return
+
+900 continue
+  call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arm_write_exchange_history: failed to write arex.history.tsv')
+end subroutine arm_write_exchange_history
+
+!===============================================================================
+! Append provenance for a ladder migration and keep the history stream open.
+!===============================================================================
+subroutine arm_write_migration_history(mgr, old_generation, old_epoch, old_replica_uids, &
+                                       old_ladder, new_ladder, source_old_slots, &
+                                       source_old_replicas, retained, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(in) :: old_generation
+  integer, intent(in) :: old_epoch
+  integer, intent(in) :: old_replica_uids(:)
+  real(dp), intent(in) :: old_ladder(:)
+  real(dp), intent(in) :: new_ladder(:)
+  integer, intent(in) :: source_old_slots(:)
+  integer, intent(in) :: source_old_replicas(:)
+  logical, intent(in) :: retained(:)
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: ios
+  integer :: i
+  integer :: old_replica_id
+  integer :: alloc_stat
+  logical :: history_exists
+  logical, allocatable :: old_retained(:)
+  character(len=256) :: io_msg
+  character(len=256) :: history_filename
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+  history_filename = 'arex.history.tsv'
+  if (len_trim(arex_output_directory) > 0) &
+    history_filename = trim(arex_output_directory) // '/arex.history.tsv'
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_migration_history: manager not initialized')
+    return
+  end if
+
+  if (size(source_old_slots) /= mgr%nreplicas .or. &
+      size(source_old_replicas) /= mgr%nreplicas .or. &
+      size(retained) /= mgr%nreplicas .or. &
+      size(old_ladder) /= size(old_replica_uids) .or. &
+      size(new_ladder) /= mgr%nslots) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_migration_history: migration mapping size mismatch')
+    return
+  end if
+
+  allocate(old_retained(size(old_replica_uids)), stat=alloc_stat)
+  if (alloc_stat /= 0) then
+    call arm_set_status(ierr, message, ARM_ERR_ALLOC, &
+      'arm_write_migration_history: failed to allocate migration bookkeeping')
+    return
+  end if
+  old_retained(:) = .false.
+
+  do i = 1, mgr%nreplicas
+    if (source_old_replicas(i) < 1 .or. &
+        source_old_replicas(i) > size(old_replica_uids)) then
+      deallocate(old_retained)
+      call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+        'arm_write_migration_history: invalid source old replica')
+      return
+    end if
+  end do
+
+  inquire(file=history_filename, exist=history_exists)
+  if (history_exists) then
+    open(newunit=mgr%exchange_history_unit, file=history_filename, status='old', &
+         position='append', action='write', iostat=ios, iomsg=io_msg)
+  else
+    open(newunit=mgr%exchange_history_unit, file=history_filename, status='replace', &
+         action='write', iostat=ios, iomsg=io_msg)
+  end if
+
+  if (ios /= 0) then
+    deallocate(old_retained)
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+      'arm_write_migration_history: failed to open arex.history.tsv: ' // trim(io_msg))
+    return
+  end if
+
+  mgr%exchange_history_open = .true.
+
+  if (.not. history_exists) then
+    write(mgr%exchange_history_unit, '(a)', iostat=ios) '# AREX_HISTORY_V3'
+    if (ios /= 0) goto 900
+    write(mgr%exchange_history_unit, '(a)', iostat=ios) &
+      '# generation' // achar(9) // 'epoch' // achar(9) // 'replica_uid' // achar(9) // &
+      'replica_index' // achar(9) // 'slot_id' // achar(9) // 'parent_uid'
+    if (ios /= 0) goto 900
+  end if
+
+  write(mgr%exchange_history_unit, '(a,i0,a,i0,a,i0,a,i0,a,i0,a)', iostat=ios) &
+    '# MIGRATION generation=', mgr%history_generation, &
+    ' from_generation=', old_generation, ' checkpoint_epoch=', old_epoch, &
+    ' old_n=', size(old_replica_uids), ' new_n=', mgr%nreplicas, ' progress_reset=1'
+  if (ios /= 0) goto 900
+
+  write(mgr%exchange_history_unit, '(a,i0,a,*(1x,es16.8))', iostat=ios) &
+    '# OLD_LADDER generation=', old_generation, ' values=', old_ladder(:)
+  if (ios /= 0) goto 900
+  write(mgr%exchange_history_unit, '(a,i0,a,*(1x,es16.8))', iostat=ios) &
+    '# NEW_LADDER generation=', mgr%history_generation, ' values=', new_ladder(:)
+  if (ios /= 0) goto 900
+
+  do i = 1, mgr%nreplicas
+    old_replica_id = source_old_replicas(i)
+
+    if (retained(i)) then
+      old_retained(old_replica_id) = .true.
+      write(mgr%exchange_history_unit, '(a,i0,a,i0,a,i0,a,i0,a,i0,a,i0)', iostat=ios) &
+        '# RETAIN generation=', mgr%history_generation, ' uid=', &
+        mgr%replicas(i)%replica_uid, ' old_replica_index=', old_replica_id, &
+        ' old_slot=', source_old_slots(i), ' new_slot=', i, ' replica_index=', i
+    else
+      write(mgr%exchange_history_unit, '(a,i0,a,i0,a,i0,a,i0,a,i0,a,i0,a,i0)', iostat=ios) &
+        '# SPAWN generation=', mgr%history_generation, ' uid=', &
+        mgr%replicas(i)%replica_uid, ' parent_uid=', mgr%replicas(i)%parent_uid, &
+        ' source_old_replica=', old_replica_id, ' source_old_slot=', source_old_slots(i), &
+        ' new_slot=', i, ' replica_index=', i
+    end if
+    if (ios /= 0) goto 900
+  end do
+
+  do old_replica_id = 1, size(old_replica_uids)
+    if (old_retained(old_replica_id)) cycle
+    write(mgr%exchange_history_unit, '(a,i0,a,i0,a,i0)', iostat=ios) &
+      '# RETIRE generation=', mgr%history_generation, ' uid=', old_replica_uids(old_replica_id), &
+      ' old_replica_index=', old_replica_id
+    if (ios /= 0) goto 900
+  end do
+
+  mgr%exchange_history_last_epoch = 0
+  deallocate(old_retained)
+  return
+
+900 continue
+  if (mgr%exchange_history_open) then
+    close(mgr%exchange_history_unit)
+    mgr%exchange_history_unit = -1
+    mgr%exchange_history_open = .false.
+  end if
+  deallocate(old_retained)
+  call arm_set_status(ierr, message, ARM_ERR_INVALID, &
+    'arm_write_migration_history: failed to write arex.history.tsv')
+end subroutine arm_write_migration_history
+
+!===============================================================================
+! Return .true. when the full AREX campaign has completed.
+!
+! A campaign is complete once every logical replica has finished the
+! required number of fixed-length segments.
+!===============================================================================
+logical function arm_campaign_complete(mgr)
+  type(arm_manager_t), intent(in) :: mgr
+  integer :: i
+
+  arm_campaign_complete = .false.
+
+  if (.not. mgr%initialized) return
+  if (mgr%segments_per_replica <= 0) return
+
+  do i = 1, mgr%nreplicas
+    if (mgr%replicas(i)%segments_completed < &
+        mgr%segments_per_replica) return
+  end do
+
+  arm_campaign_complete = .true.
+end function arm_campaign_complete
+
+!===============================================================================
+! Write a simple manager metadata checkpoint.
+!
+! This is intentionally plain and incomplete. It is enough to lock down the
+! manager-side state contract while the final binary/text format is still open.
+!===============================================================================
+subroutine arm_checkpoint_metadata(mgr, unitno, ierr, message)
+  type(arm_manager_t), intent(in) :: mgr
+  integer, intent(in) :: unitno
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  character(len=256) :: payload_msg
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  if (.not. mgr%initialized) then
+    call arm_set_status(ierr, message, ARM_ERR_INVALID, 'arm_checkpoint_metadata: manager not initialized')
+    return
+  end if
+
+  write(unitno, '(a)') '# ARM metadata checkpoint'
+  write(unitno, '(a,1x,i0)') 'epoch',          mgr%epoch
+  write(unitno, '(a,1x,i0)') 'current_parity', mgr%current_parity
+  write(unitno, '(a,1x,i0)') 'nreplicas',      mgr%nreplicas
+  write(unitno, '(a,1x,i0)') 'nworkers',       mgr%nworkers
+  write(unitno, '(a)') '# slot_id replica_id'
+
+  do i = 1, mgr%nslots
+    write(unitno, '(2(1x,i0))') i, mgr%slot_owner(i)
+  end do
+
+  write(unitno, '(a)') '# replica_id slot_id segments_completed completed_epoch exchange_resolved_epoch'
+
+  do i = 1, mgr%nreplicas
+    write(unitno, '(5(1x,i0))') mgr%replicas(i)%replica_id, &
+                                mgr%replicas(i)%slot_id, &
+                                mgr%replicas(i)%segments_completed, &
+                                mgr%replicas(i)%completed_epoch, &
+                                mgr%replicas(i)%exchange_resolved_epoch
+  end do
+
+  if (associated(mgr%payload%checkpoint_replica)) then
+    write(unitno, '(a)') '# payload checkpoints begin'
+    do i = 1, mgr%nreplicas
+      call mgr%payload%checkpoint_replica(mgr%replicas(i)%replica_id, &
+                                          mgr%replicas(i)%slot_id,   &
+                                          unitno, ierr, payload_msg)
+      if (ierr /= ARM_OK) then
+        call arm_set_status(ierr, message, ARM_ERR_PAYLOAD, trim(payload_msg))
+        return
+      end if
+    end do
+    write(unitno, '(a)') '# payload checkpoints end'
+  end if
+end subroutine arm_checkpoint_metadata
+
+!===============================================================================
+! Finalize manager storage.
+!===============================================================================
+subroutine arm_manager_finalize(mgr, ierr, message)
+  type(arm_manager_t), intent(inout) :: mgr
+  integer, intent(out) :: ierr
+  character(len=*), intent(out) :: message
+
+  integer :: i
+  integer :: payload_ierr
+  character(len=256) :: payload_msg
+
+  call arm_set_status(ierr, message, ARM_OK, '')
+
+  payload_ierr = ARM_OK
+  payload_msg = ''
+
+  if (mgr%payload_registered) then
+    if (associated(mgr%payload%finalize)) then
+      call mgr%payload%finalize(payload_ierr, payload_msg)
+    end if
+  end if
+
+  if (mgr%exchange_history_open) then
+    close(mgr%exchange_history_unit)
+  end if
+
+  if (allocated(mgr%replicas)) then
+    do i = 1, size(mgr%replicas)
+      call arm_snapshot_deallocate(mgr%replicas(i)%md)
+    end do
+    deallocate(mgr%replicas)
+  end if
+
+  if (allocated(mgr%workers))                 deallocate(mgr%workers)
+  if (allocated(mgr%slot_owner))              deallocate(mgr%slot_owner)
+  if (allocated(mgr%slot_segments_completed)) deallocate(mgr%slot_segments_completed)
+  if (allocated(mgr%slot_restart_owner))       deallocate(mgr%slot_restart_owner)
+  if (allocated(mgr%slot_restart_replica_segments)) &
+    deallocate(mgr%slot_restart_replica_segments)
+
+  mgr%initialized          = .false.
+  mgr%payload_registered   = .false.
+  mgr%natom                = 0
+  mgr%nreplicas            = 0
+  mgr%nslots               = 0
+  mgr%nworkers             = 0
+  mgr%next_replica_uid     = 1
+  mgr%segments_per_replica = 0
+  mgr%epoch                = 0
+  mgr%current_parity       = ARM_PARITY_EVEN
+  mgr%exchange_history_unit       = -1
+  mgr%exchange_history_open       = .false.
+  mgr%exchange_history_last_epoch = -1
+  mgr%history_generation          = 0
+
+  if (payload_ierr /= ARM_OK) then
+    call arm_set_status(ierr, message, ARM_ERR_PAYLOAD, trim(payload_msg))
+  else
+    call arm_set_status(ierr, message, ARM_OK, '')
+  end if
+end subroutine arm_manager_finalize
+
+end module arex_arm_mod
