+static __device__ __forceinline__
+PMEFloat kPMEPHMDInternalFmad(PMEFloat a, PMEFloat b, PMEFloat c)
+{
+#ifdef use_DPFP
+  return a * b + c;
+#else
+  return __fmaf_rn(a, b, c);
+#endif
+}
+
+static __device__ __forceinline__
+PMEFloat kPMEPHMDErfcSwitch(const kPMEPHMDDirectConst& sim, const PMEFloat r)
+{
+#ifdef use_DPFP
+  return erfc(sim.ew_coeffSP * r);
+#else
+  PMEFloat t;
+  const PMEFloat x = r;
+
+  t = sim.erfcCoeffs.c0;
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c1);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c2);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c3);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c4);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c5);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c6);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c7);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c8);
+  t = kPMEPHMDInternalFmad(t, x, sim.erfcCoeffs.c9);
+  t = t * x;
+
+  return exp2f(t);
+#endif
+}
