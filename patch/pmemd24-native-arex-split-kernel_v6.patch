+static __device__ __forceinline__
+unsigned long long kPMEPHMDAbsULLDiff(const unsigned long long reference,
+                                      const unsigned long long test)
+{
+  const unsigned long long diffRaw = test - reference;
+
+  if (diffRaw & 0x8000000000000000ull) {
+    return (~diffRaw) + 1ull;
+  }
+
+  return diffRaw;
+}
