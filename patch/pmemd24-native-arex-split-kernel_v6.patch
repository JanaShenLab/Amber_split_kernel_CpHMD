+!*******************************************************************************
+! Build a user-facing AREX slot label.
+!
+! Current behavior:
+!   * For PHREX slots with a valid ladder value, emit "phX_Y" style labels.
+!     Examples: ph7_0, ph7_5, ph10_0
+!   * Fall back to "slotNNNN" if the ladder entry is not available.
+!
+! This preserves a meaningful fixed-condition label for user-facing outputs
+! while keeping the internal slot id as the stable ownership key.
+!*******************************************************************************
+subroutine arex_io_make_slot_label(slot_id, slot_label)
+  integer, intent(in)           :: slot_id
+  character(len=*), intent(out) :: slot_label
+
+  double precision :: ladder_value
+
+  slot_label = ''
+
+  if (slot_id < 1) return
+
+  if (slot_id <= size(arex_ladder)) then
+    ladder_value = arex_ladder(slot_id)
+
+    if (ladder_value /= arex_ladder_unset) then
+      call arex_io_format_ph_label(ladder_value, slot_label)
+      return
+    end if
+  end if
+
+  ! Conservative fallback for cases where no ladder value is available.
+  write(slot_label, '("slot",i4.4)') slot_id
+end subroutine arex_io_make_slot_label
+
+!*******************************************************************************
+! Convert a PHREX ladder value into a canonical filename label.
+!
+! Rules:
+!   * keep at least one decimal place
+!   * trim redundant trailing zeros
+!   * replace the decimal point with an underscore
+!
+! Examples:
+!   7.0   -> ph7_0
+!   7.5   -> ph7_5
+!   7.25  -> ph7_25
+!   10.0  -> ph10_0
+!*******************************************************************************
+subroutine arex_io_format_ph_label(ph_value, ph_label)
+  double precision, intent(in)  :: ph_value
+  character(len=*), intent(out) :: ph_label
+
+  character(len=64) :: value_buf
+  integer :: i
+  integer :: iend
+
+  ph_label = ''
+  value_buf = ''
+
+  ! Use a fixed decimal write, then canonicalize the text.
+  write(value_buf, '(f12.4)') ph_value
+  value_buf = adjustl(value_buf)
+  iend = len_trim(value_buf)
+
+  ! Trim trailing zeros but keep one decimal place.
+  do while (iend > 0 .and. value_buf(iend:iend) == '0')
+    iend = iend - 1
+  end do
+
+  if (iend > 0 .and. value_buf(iend:iend) == '.') then
+    iend = iend + 1
+    value_buf(iend:iend) = '0'
+  end if
+
+  write(ph_label, '("ph",a)') trim(value_buf(1:iend))
+
+  do i = 1, len_trim(ph_label)
+    if (ph_label(i:i) == '.') ph_label(i:i) = '_'
+  end do
+end subroutine arex_io_format_ph_label
+
+!*******************************************************************************
+! Build a slot-scoped filename by inserting a user-facing AREX slot label
+! before the final extension, if one exists.
+!
+! Examples:
+!   arex_tst.nc        -> arex_tst.ph7_5.nc
+!   arex_tst.lambda    -> arex_tst.ph7_5.lambda
+!   arex_tst.mdrst     -> arex_tst.ph7_5.mdrst
+!   arex_tst           -> arex_tst.ph7_5
+!
+! The label itself is payload-facing metadata; the internal slot id remains the
+! authoritative ownership key.
+!*******************************************************************************
+subroutine arex_io_make_slot_name(base_name, slot_id, slot_name)
+  character(len=*), intent(in)  :: base_name
+  integer, intent(in)           :: slot_id
+  character(len=*), intent(out) :: slot_name
+
+  integer :: i
+  integer :: iend
+  integer :: last_dot
+  integer :: last_sep
+  character(len=32) :: slot_label
+
+  slot_name = ''
+
+  iend = len_trim(base_name)
+  if (iend <= 0) return
+
+  call arex_io_make_slot_label(slot_id, slot_label)
+  if (len_trim(slot_label) <= 0) return
+
+  last_dot = 0
+  last_sep = 0
+
+  do i = 1, iend
+    if (base_name(i:i) == '/' .or. base_name(i:i) == '\') last_sep = i
+    if (base_name(i:i) == '.') last_dot = i
+  end do
+
+  if (last_dot > last_sep) then
+    write(slot_name, '(a,".",a,a)') trim(base_name(1:last_dot-1)), &
+                                    trim(slot_label), &
+                                    trim(base_name(last_dot:iend))
+  else
+    write(slot_name, '(a,".",a)') trim(base_name(1:iend)), trim(slot_label)
+  end if
+
+end subroutine arex_io_make_slot_name
+
+subroutine arex_io_make_ladder_name(base_name, ladder_value, slot_name)
+  character(len=*), intent(in)  :: base_name
+  double precision, intent(in)  :: ladder_value
+  character(len=*), intent(out) :: slot_name
+
+  integer :: i
+  integer :: iend
+  integer :: last_dot
+  integer :: last_sep
+  character(len=32) :: slot_label
+
+  slot_name = ''
+  iend = len_trim(base_name)
+  if (iend <= 0) return
+
+  call arex_io_format_ph_label(ladder_value, slot_label)
+  if (len_trim(slot_label) <= 0) return
+
+  last_dot = 0
+  last_sep = 0
+  do i = 1, iend
+    if (base_name(i:i) == '/' .or. base_name(i:i) == '\') last_sep = i
+    if (base_name(i:i) == '.') last_dot = i
+  end do
+
+  if (last_dot > last_sep) then
+    write(slot_name, '(a,".",a,a)') trim(base_name(1:last_dot-1)), &
+                                    trim(slot_label), &
+                                    trim(base_name(last_dot:iend))
+  else
+    write(slot_name, '(a,".",a)') trim(base_name(1:iend)), trim(slot_label)
+  end if
+end subroutine arex_io_make_ladder_name
+
+end module arex_io_mod
