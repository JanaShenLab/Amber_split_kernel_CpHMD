+static __device__ __forceinline__
+unsigned long long kPMEPHMDAbsAccumulatorDiff(const PMEAccumulator reference,
+                                              const PMEAccumulator test)
+{
+  // PME fixed-point accumulators are updated through unsigned 64-bit atomics,
+  // but the stored values represent signed two's-complement fixed-point values.
+  // Compute test-reference modulo 2^64, then take the two's-complement absolute
+  // value without signed overflow.
+  const unsigned long long refRaw =
+    static_cast<unsigned long long>(reference);
+  const unsigned long long testRaw =
+    static_cast<unsigned long long>(test);
+
+  const unsigned long long diffRaw = testRaw - refRaw;
+
+  if (diffRaw & 0x8000000000000000ull) {
+    return (~diffRaw) + 1ull;
+  }
+
+  return diffRaw;
+}
+
+__global__ void
+kPMEPHMDCompareAccumulatorBuffers_kernel(const PMEAccumulator* __restrict__ reference,
+                                         const PMEAccumulator* __restrict__ test,
+                                         unsigned int count,
+                                         unsigned long long tolerance,
+                                         unsigned long long* __restrict__ result,
+                                         int compareId)
+{
+  // result[0] = max absolute difference
+  // result[1] = count above tolerance
+  for (unsigned int pos = blockIdx.x * blockDim.x + threadIdx.x;
+       pos < count;
+       pos += blockDim.x * gridDim.x) {
+const unsigned long long refRaw =
+  static_cast<unsigned long long>(reference[pos]);
+const unsigned long long testRaw =
+  static_cast<unsigned long long>(test[pos]);
+
+const unsigned long long adiff =
+  kPMEPHMDAbsAccumulatorDiff(reference[pos], test[pos]);
+
+atomicMax(&result[0], adiff);
+
+if (adiff > tolerance) {
+  const unsigned long long slot = atomicAdd(&result[1], 1ull);
+
+  if (slot < 16ull) {
+    union {
+      unsigned long long u;
+      long long s;
+    } refConv, testConv;
+
+    refConv.u = refRaw;
+    testConv.u = testRaw;
+
+    printf("PME-PHMD compare mismatch sample: "
+       "compareId=%d pos=%u refRaw=%llu testRaw=%llu "
+       "refSigned=%lld testSigned=%lld adiff=%llu\n",
+       compareId,
+       pos,
+       refRaw,
+       testRaw,
+       refConv.s,
+       testConv.s,
+       adiff);
+  }
+}
+  }
+}
