+extern "C" void
+kPMEPHMDCompareAccumulatorDeltas(const char* label,
+                                 const PMEAccumulator* referenceFinal,
+                                 const PMEAccumulator* referenceBase,
+                                 const PMEAccumulator* testFinal,
+                                 const PMEAccumulator* testBase,
+                                 unsigned int count,
+                                 unsigned long long tolerance)
+{
+  unsigned long long* dResult = nullptr;
+  unsigned long long hResult[2] = {0ull, 0ull};
+
+  cudaError_t status = cudaMalloc(reinterpret_cast<void**>(&dResult),
+                                  2 * sizeof(unsigned long long));
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareAccumulatorDeltas: cudaMalloc failed: %s\n",
+                 cudaGetErrorString(status));
+    std::abort();
+  }
+
+  status = cudaMemset(dResult, 0, 2 * sizeof(unsigned long long));
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareAccumulatorDeltas: cudaMemset failed: %s\n",
+                 cudaGetErrorString(status));
+    cudaFree(dResult);
+    std::abort();
+  }
+
+  const unsigned int threads = PME_PHMD_COMPARE_THREADS_PER_BLOCK;
+  unsigned int blocks = (count + threads - 1u) / threads;
+  if (blocks == 0u) {
+    blocks = 1u;
+  }
+  if (blocks > 1024u) {
+    blocks = 1024u;
+  }
+
+  int compareId = 10;
+  if (label != nullptr && strcmp(label, "NB force correction delta") == 0) {
+    compareId = 10;
+  }
+
+  kPMEPHMDCompareAccumulatorDeltas_kernel<<<blocks, threads>>>(
+    referenceFinal,
+    referenceBase,
+    testFinal,
+    testBase,
+    count,
+    tolerance,
+    dResult,
+    compareId
+  );
+
+  LAUNCHERROR("kPMEPHMDCompareAccumulatorDeltas_kernel launch");
+
+  status = cudaDeviceSynchronize();
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareAccumulatorDeltas_kernel execution failed for %s: %s\n",
+                 label,
+                 cudaGetErrorString(status));
+    cudaFree(dResult);
+    std::abort();
+  }
+
+  status = cudaMemcpy(hResult,
+                      dResult,
+                      2 * sizeof(unsigned long long),
+                      cudaMemcpyDeviceToHost);
+  if (status != cudaSuccess) {
+    std::fprintf(stderr,
+                 "kPMEPHMDCompareAccumulatorDeltas: cudaMemcpy failed: %s\n",
+                 cudaGetErrorString(status));
+    cudaFree(dResult);
+    std::abort();
+  }
+
+  cudaFree(dResult);
+
+  std::printf("PME-PHMD direct delta compare: %s\n", label);
+  std::printf("  count:                 %u\n", count);
+  std::printf("  tolerance:             %llu fixed-point units\n", tolerance);
+  std::printf("  max abs difference:    %llu fixed-point units\n", hResult[0]);
+  std::printf("  count above tolerance: %llu\n", hResult[1]);
+  std::fflush(stdout);
+}
